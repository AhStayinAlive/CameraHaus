  {%- comment -%}
    checkoutBlocked override: use cart-page TOS checkbox first
  {%- endcomment -%}
  <script>
    document.addEventListener('DOMContentLoaded', function () {
      if (typeof window.checkoutBlocked !== 'function') return;

      var originalCheckoutBlocked = window.checkoutBlocked;

      window.checkoutBlocked = function () {
        var form =
          document.querySelector('form[action="/cart"]') ||
          document.querySelector('form.cart');

        if (form) {
          var box =
            form.querySelector('#rterms-1') ||
            form.querySelector('#rterms') ||
            form.querySelector('#agree-terms') ||
            form.querySelector('#agree') ||
            form.querySelector('.cart__policies input[type="checkbox"]');

          if (box) {
            // true = block checkout if box is NOT checked
            return !box.checked;
          }
        }

        // Fallback to original behaviour (e.g. mini-cart logic)
        return originalCheckoutBlocked();
      };
    });
  </script>
<style>
