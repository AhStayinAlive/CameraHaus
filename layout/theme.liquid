  <!-- Global Page Skeleton Preloader (Except Home) -->
  {% unless request.page_type == 'index' %}
  {% render 'ch-page-preloader' %}
  <script>
    (function(){
      // Failsafe: if load takes too long, unblock anyway
      var t = setTimeout(function(){ document.body.classList.add('site-loaded'); }, 3000);
      
      window.addEventListener('load', function(){
        clearTimeout(t);
        document.body.classList.add('site-loaded');
      });
      
      // Also check if already loaded
      if(document.readyState === 'complete'){
        clearTimeout(t);
        document.body.classList.add('site-loaded');
      }
    })();
  </script>
  {% endunless %}
