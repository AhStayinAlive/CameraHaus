    /* Checkbox size + accent */
    form[action="/cart"] .terms-relentless input[type="checkbox"],
    form[action="/cart"] .cart__policies input[type="checkbox"],
    .ch-panel[data-ch-panel="cart"] .terms-relentless input[type="checkbox"],
    .ch-panel[data-ch-panel="cart"] .cart__policies input[type="checkbox"],
    #CartDrawer .cart__policies input[type="checkbox"],
