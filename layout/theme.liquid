    Clean final cart styling: checkbox + TOS alignment and color
  {%- endcomment -%}
  <style>
    /* Cart heading color (drawer + custom cart panel) */
    .ch-panel[data-ch-panel="cart"] .cart-head .cart-title,
    #CartDrawer .drawer__heading,
    .cart-drawer .drawer__heading {
      color: var(--heading-color, #4b5563) !important;
    }

    /* TOS wrapper: checkbox + text on one line, vertically centered */
    form[action="/cart"] .terms-relentless,
    form[action="/cart"] .cart__policies,
    .ch-panel[data-ch-panel="cart"] .terms-relentless,
    .ch-panel[data-ch-panel="cart"] .cart__policies,
    #CartDrawer .cart__policies,
    .cart-drawer .cart__policies,
    #CartDrawer .ajaxcart__agree,
    .cart-drawer .ajaxcart__agree {
      display: flex !important;
      align-items: center !important;
      gap: 8px !important;
      margin-top: 4px !important;
    }

    /* TOS label text: small gray, same tone as "Taxes and shipping..." */
    form[action="/cart"] .terms-relentless label,
    form[action="/cart"] .cart__policies label,
    .ch-panel[data-ch-panel="cart"] .terms-relentless label,
    .ch-panel[data-ch-panel="cart"] .cart__policies label,
    #CartDrawer .cart__policies label,
    .cart-drawer .cart__policies label,
    #CartDrawer .ajaxcart__agree label,
    .cart-drawer .ajaxcart__agree label {
      display: inline-flex !important;
      align-items: center !important;
      gap: 6px !important;
      font-size: 12px !important;
      font-weight: 400 !important;
      color: #6B7280 !important;
      text-transform: none !important;
      letter-spacing: 0 !important;
      line-height: 1.3;
    }

    /* TOS link: gray + underline, no weird casing */
    form[action="/cart"] .terms-relentless label a,
    form[action="/cart"] .cart__policies label a,
    .ch-panel[data-ch-panel="cart"] .terms-relentless label a,
    .ch-panel[data-ch-panel="cart"] .cart__policies label a,
    #CartDrawer .cart__policies label a,
    .cart-drawer .cart__policies label a,
    #CartDrawer .ajaxcart__agree label a,
    .cart-drawer .ajaxcart__agree label a {
      color: #6B7280 !important;
      text-decoration: underline;
