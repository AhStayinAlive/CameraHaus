  <script>
    (function() {
      // Option B: Target the wrapper + Body Padding + Robust Scroll Logic
      var headerWrapper = document.getElementById('shopify-section-header');
      if(!headerWrapper) return;

      // 1. Calculate height for body padding
      // 1. Calculate height for body padding (CSS Variable for smoother interaction)
      // 1. Calculate height (Precise + Tight Fit)
      function setHeight() {
        // Use getBoundingClientRect for sub-pixel accuracy
        var rect = headerWrapper.getBoundingClientRect();
        // Subtract 1px to ensure overlap/flush fit, preventing hairline gaps
        var h = rect.height > 0 ? (rect.height - 1) : headerWrapper.offsetHeight; 
        document.body.style.setProperty('--ch-header-h', h + 'px');
      }
      
      setHeight();
      window.addEventListener('resize', setHeight);
      window.addEventListener('scroll', function(){ if(!window.scrollY) setHeight(); }, {once:true, passive:true});
      
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', setHeight);
      } else {
        setTimeout(setHeight, 200);
        setTimeout(setHeight, 1000); // Failsafe for lazy assets
      }

      var lastScrollY = window.scrollY;
      var tick = false;
      var threshold = 40; // Wait until below this point to start hiding
      var tolerance = 5;  // Minimum scroll distance to trigger change

      function onScroll() {
        if (!tick) {
          window.requestAnimationFrame(function() {
            var currentScrollY = window.scrollY;
            var diff = currentScrollY - lastScrollY;

            // Only run logic if we are past the static threshold
            if (currentScrollY > threshold) {
              
              // SCROLL DOWN (diff > tolerance)
              if (diff > tolerance) {
                headerWrapper.classList.add('is-shy-hidden');
              } 
              // SCROLL UP (diff < -tolerance) - Show immediately
              else if (diff < -tolerance) {
                headerWrapper.classList.remove('is-shy-hidden');
              }
              
            } else {
              // We are at the very top: Always show
              headerWrapper.classList.remove('is-shy-hidden');
            }

            // Update lastScrollY, preventing negative values (iOS rubber banding)
            lastScrollY = currentScrollY > 0 ? currentScrollY : 0;
            tick = false;
          });
          tick = true;
        }
      }

      window.addEventListener('scroll', onScroll, {passive: true});
    })();

    // AG Fix: Move drawers to body to solve Z-Index/Transform/Event issues
    (function(){
      function moveDrawers(){
        // Selectors for Menu Drawer, Cart Drawer Panel, and Cart Drawer Wrapper
        const drawers = document.querySelectorAll('#ch-menu-drawer, .ch-panel[data-ch-panel="cart"], #CartDrawer, .cart-drawer');
        const header = document.getElementById('shopify-section-header');
        
        drawers.forEach(d => {
          // If the drawer exists and is not a direct child of body, move it.
          if(d && d.parentElement !== document.body){
            document.body.appendChild(d);
          }
        });
      }
      // Run immediately (if DOM ready), on Load, and on DOMContentLoaded
      moveDrawers();
      if(document.readyState !== 'loading') moveDrawers();
      document.addEventListener('DOMContentLoaded', moveDrawers);
      window.addEventListener('load', moveDrawers);
    })();
  </script>

