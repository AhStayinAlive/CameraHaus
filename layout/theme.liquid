  body { margin: 0; padding-top: var(--ch-header-h); }
  
  /* Hide skip-to-content link completely */
  .skip-link,
  a.skip-link,
  .in-page-link {
    display: none !important;
    visibility: hidden !important;
  }
</style>
<script>
  (function () {
    function setHeaderH(){
      const h = document.querySelector('#shopify-section-header');
      if(!h) return;
      const px = Math.ceil(h.getBoundingClientRect().height);
      document.documentElement.style.setProperty('--ch-header-h', px + 'px');
    }

    // as early as possible
    document.addEventListener('DOMContentLoaded', setHeaderH);
    window.addEventListener('load', setHeaderH);
    window.addEventListener('resize', setHeaderH);

    // Shopify section lifecycle (helps in editor)
    document.addEventListener('shopify:section:load', setHeaderH);
  })();
</script>

