<style>
  /* Layout */
  .auth-wrapper {
    min-height: 60vh;
    display: flex;
    align-items: flex-start;
  }
  .auth-card {
    width: 100%;
    max-width: 360px;
    margin: 40px auto;
  }
  .text-center {
    text-align: center;
  }

  /* Headings */
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .auth-title{
    margin: 0 0 24px;
    font-weight: 700;
    letter-spacing: -.01em;
    line-height: 1.15;
    font-size: clamp(24px, 3vw + 8px, 32px);
    color: var(--heading-color, inherit);
    font-family: inherit;
    text-align: center;
  }

  /* Form + fields */
  .auth-form .form-field {
    margin-bottom: 16px;
  }
  .auth-form label {
    display: block;
    font-size: 14px;
    line-height: 1.2;
    margin: 0 0 6px;
    font-weight: 500;
  }
  .auth-form label.required::after {
    content: " *";
    color: #e11d2a;
  }
  .auth-form input[type="email"],
  .auth-form input[type="password"] {
    width: 100%;
    height: 44px;
    border: 1px solid #d9d9d9;
    border-radius: 4px;
    padding: 0 12px;
    font-size: 14px;
    background: #fff;
  }
  .auth-form input:focus {
    outline: none;
    border-color: #bdbdbd;
    box-shadow: 0 0 0 2px rgba(226, 61, 45, 0.15);
  }

  /* Links → gray, underlined */
  .auth-form a {
    color: #6b7280;
    text-decoration: underline;
  }
  .auth-form a:hover {
    color: #4b5563;
  }
  .auth-form .forgot-link {
    margin: 8px 0 16px;
  }

  /* Button */
  .auth-form .btn {
    display: inline-block;
    width: 100%;
    height: 48px;
    border: 0;
    border-radius: 8px;
    background: #e23d2d;
    color: #fff;
    font-weight: 600;
    font-size: 16px;
    cursor: pointer;
  }
  .auth-form .btn:hover {
    opacity: 0.95;
  }

  .auth-form .new-customer {
    margin-top: 14px;
    font-size: 14px;
  }

  /* Messages */
  .form-success {
    background: #f0fff4;
    color: #1b5e20;
    border: 1px solid #c8e6c9;
    padding: 10px 12px;
    border-radius: 4px;
    margin-bottom: 16px;
  }
  .errors,
  .form-message--error {
    background: #fff5f5;
    color: #b00020;
    border: 1px solid #ffcdd2;
    padding: 10px 12px;
    border-radius: 4px;
    margin: 0 0 16px;
  }
  .input--error {
    border-color: #ff6b6b;
  }

  .hide {
    display: none;
  }
</style>

<div class="page-width">
  <div class="grid">
    <div class="grid__item medium-up--one-half medium-up--push-one-quarter">
      <div class="auth-card">

        <div class="form-success hide" id="ResetSuccess">
          {{ 'customer.recover_password.success' | t }}
        </div>

        <!-- Login -->
        <div id="CustomerLoginForm" class="auth-form">
          {% form 'customer_login' %}
            <h1 class="auth-title">{{ 'customer.login.title' | t }}</h1>

            {{ form.errors | default_errors }}

            <div class="form-field">
              <label for="CustomerEmail" class="required">{{ 'customer.login.email' | t }}</label>
              <input
                type="email"
                name="customer[email]"
                id="CustomerEmail"
                class="{% if form.errors contains 'email' %}input--error{% endif %}"
                autocorrect="off"
                autocapitalize="off"
                autofocus
                required
              >
            </div>

            {% if form.password_needed %}
              <div class="form-field">
                <label for="CustomerPassword" class="required">{{ 'customer.login.password' | t }}</label>
                <input
                  type="password"
                  name="customer[password]"
                  id="CustomerPassword"
                  class="{% if form.errors contains 'password' %}input--error{% endif %}"
                  required
                >
              </div>

              <p class="forgot-link">
                <a href="#recover" id="RecoverPassword">{{ 'customer.login.forgot_password' | t }}</a>
              </p>
            {% endif %}

            <p>
              <button type="submit" class="btn">{{ 'customer.login.sign_in' | t }}</button>
            </p>

            <p class="new-customer">
              <span>New customer?</span>
              <a href="{{ routes.account_register_url }}">
                Create your account
              </a>
            </p>
          {% endform %}
        </div>

        <!-- Password recovery -->
        <div id="RecoverPasswordForm" class="hide auth-form">
          <h2 class="sr-only">{{ 'customer.recover_password.title' | t }}</h2>
          <p>{{ 'customer.recover_password.subtext' | t }}</p>

          <div class="form-vertical">
            {% form 'recover_customer_password' %}
              {{ form.errors | default_errors }}

              {% if form.posted_successfully? %}
                <span class="hide reset-password-success"></span>
              {% endif %}

              <div class="form-field">
                <label for="RecoverEmail" class="required">{{ 'customer.recover_password.email' | t }}</label>
                <input
                  type="email"
                  name="email"
                  id="RecoverEmail"
                  autocorrect="off"
                  autocapitalize="off"
                  required
                >
              </div>

              <p>
                <input
                  type="submit"
                  class="btn"
                  value="{{ 'customer.recover_password.submit' | t }}"
                >
              </p>

              <button
                type="button"
                id="HideRecoverPasswordLink"
                class="text-link"
              >
                {{ 'customer.recover_password.cancel' | t }}
              </button>
            {% endform %}
          </div>
        </div>

        {% if shop.checkout.guest_login %}
          <div class="text-center" style="margin-top:28px">
            <h2 class="sr-only">{{ 'customer.login.guest_title' | t }}</h2>
            {% form 'guest_login' %}
              <input
                type="submit"
                class="btn"
                value="{{ 'customer.login.guest_continue' | t }}"
              >
            {% endform %}
          </div>
        {% endif %}

      </div>
    </div>
  </div>
</div>
