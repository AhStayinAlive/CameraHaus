{%- comment -%}
  Section: main-collection (Dawn OS 2.0)
  - Contained layout (NO full-bleed)
  - Inter font everywhere
  - Heading + subtitle first, then breadcrumbs (HAVIT-style)
  - Hard grid (no flex clipping), AJAX pagination, skeletons
{%- endcomment -%}

{%- paginate collection.products by 20 -%}
<section id="ch-collection-{{ section.id }}" class="ch-collection" data-section-id="{{ section.id }}">
  <style>
    /* ====== Base / tokens ====== */
    #ch-collection-{{ section.id }}{
      --panel: #ffffff;
      --ink: #111111;
      --muted: #6B7280;
      --line: rgba(17,17,17,.10);
      --radius: 14px;
      --shadow: 0 10px 30px rgba(17,17,17,.10);
      --focus: 0 0 0 3px rgba(32,94,214,.35);
      --grid-gap: 20px;
    }
    #ch-collection-{{ section.id }} *, 
    #ch-collection-{{ section.id }} *::before, 
    #ch-collection-{{ section.id }} *::after{
      box-sizing: border-box;
      font-family:var(--font-sans);
    }
    /* ====== Top filters block (kept from theme) ====== */
    #ch-collection-{{ section.id }} .ch-topfilters{ 
      margin: 10px 0 18px; /* space between filters/sort and grid */
    }

    /* ====== HARD GRID (replace Dawn flex grid) ====== */
    #ch-collection-{{ section.id }} #CollectionProductGrid{
      display:grid;
      grid-template-columns: repeat(2, minmax(0,1fr));
      gap: var(--grid-gap);
      align-items: stretch;
      min-height: 120px;
    }
    @media (min-width: 750px){
      #ch-collection-{{ section.id }} #CollectionProductGrid{ 
        grid-template-columns: repeat(4, minmax(0,1fr)); 
      }
    }
    @media (min-width: 1100px){
      #ch-collection-{{ section.id }} #CollectionProductGrid{ 
        grid-template-columns: repeat(4, minmax(0,1fr)); 
      }
    }
    /* Neutralize theme grid utilities inside our grid */
    #ch-collection-{{ section.id }} #CollectionProductGrid .grid__item,
    #ch-collection-{{ section.id }} #CollectionProductGrid [class*="medium-up--"],
    #ch-collection-{{ section.id }} #CollectionProductGrid [class*="small--"]{
      all: unset;
      display:block;
    }
    #ch-collection-{{ section.id }} #CollectionProductGrid .ch-cell{ height:100%; min-height:0; }
    #ch-collection-{{ section.id }} #CollectionProductGrid .chcard{ height:100%; }

    /* ====== Pagination (existing pill styles kept) ====== */
    #ch-collection-{{ section.id }} .pagination{ 
      margin:22px 0 0; 
      display:flex; flex-wrap:wrap; gap:8px; 
    }
    #ch-collection-{{ section.id }} .pagination a,
    #ch-collection-{{ section.id }} .pagination span{
      padding:8px 12px; 
      border:1px solid var(--line); 
      border-radius: 10px; 
      text-decoration:none; 
      color:var(--ink); 
      font-size:14px;
      line-height:1;
      background:#fff;
    }
    #ch-collection-{{ section.id }} .pagination .current{ 
      background:#F6F7F8; 
      font-weight:600; 
    }

    /* ====== Pagination — numbers only (non-destructive override) ====== */
    #ch-collection-{{ section.id }} .pagination.numbers-only{
      margin: 28px 0 0;
      padding-top: 14px;
      border-top: 1px solid var(--line);   /* faint line */
      display: flex;
      justify-content: center;
      gap: 0; /* handled by list */
    }
    #ch-collection-{{ section.id }} .pagination.numbers-only .pag-list{
      display: flex;
      gap: 14px;
      list-style: none;
      margin: 0;
      padding: 0;
    }
    #ch-collection-{{ section.id }} .pagination.numbers-only a,
    #ch-collection-{{ section.id }} .pagination.numbers-only span{
      border: none !important;
      background: none !important;
      border-radius: 0 !important;
      padding: 6px 2px;
      min-width: 28px;
      text-align: center;
      line-height: 1;
      font-size: 14px;
      text-decoration: none;
    }
    #ch-collection-{{ section.id }} .pagination.numbers-only a{
      color: var(--muted);
    }
    #ch-collection-{{ section.id }} .pagination.numbers-only a:hover{
      color: var(--ink);
      text-decoration: underline;
    }
    #ch-collection-{{ section.id }} .pagination.numbers-only .is-current > span{
      color: #e11d48;
      font-weight: 700;
    }
    #ch-collection-{{ section.id }} .pagination.numbers-only .ellipsis > span{
      color: var(--muted);
      opacity: .65;
      pointer-events: none;
      user-select: none;
    }

    /* ====== Skeleton ====== */
    #ch-collection-{{ section.id }} .ch-skeleton-grid{
      display:grid; grid-template-columns: repeat(2, 1fr); gap:var(--grid-gap);
    }
    @media (min-width: 750px){
      #ch-collection-{{ section.id }} .ch-skeleton-grid{ grid-template-columns: repeat(4, 1fr); }
    }
    #ch-collection-{{ section.id }} .ch-skel-card{
      border:1px solid var(--line); border-radius: 12px; overflow:hidden; background:#fff; padding:10px;
    }
    #ch-collection-{{ section.id }} .skel-media{
      height: 160px; border-radius:10px;
      background: linear-gradient(90deg, #eee 25%, #f5f5f5 37%, #eee 63%);
      background-size:400% 100%;
      animation: ch-skel 1.1s ease-in-out infinite;
    }
    #ch-collection-{{ section.id }} .skel-line{
      height: 12px; margin:10px 6px; border-radius: 8px;
      background: linear-gradient(90deg, #eee 25%, #f5f5f5 37%, #eee 63%);
      background-size:400% 100%;
      animation: ch-skel 1.1s ease-in-out infinite;
    }
    #ch-collection-{{ section.id }} .skel-line.skel-short{ width: 60%; }
    #ch-collection-{{ section.id }} .skel-cta{
      height:36px; margin:10px 6px 4px; border-radius: 10px;
      background: linear-gradient(90deg, #eee 25%, #f5f5f5 37%, #eee 63%);
      background-size:400% 100%;
      animation: ch-skel 1.1s ease-in-out infinite;
    }
    @keyframes ch-skel{ 0%{background-position:100% 50%} 100%{background-position:0 50%} }

    /* ===== HAVIT-style heading block ===== */
    #ch-collection-{{ section.id }} .ch-header{
      margin: 24px 0 8px;          
      padding-top: 2px;
    }

    /* Nuke Dawn's top padding on this section */
    #ch-collection-{{ section.id }}.shopify-section,
    #ch-collection-{{ section.id }}.section,
    #ch-collection-{{ section.id }},
    #ch-collection-{{ section.id }} .page-width{
      padding-top: 0 !important;
      margin-top: 0 !important;
    }
    #ch-collection-{{ section.id }} .ch-header{ margin-top: 0 !important; }
    #ch-collection-{{ section.id }} .ch-title{ margin-top: 0 !important; }
    #MainContent > .shopify-section:has(#ch-collection-{{ section.id }}) {
      padding-top: 0 !important;
    }
    #MainContent { scroll-margin-top: var(--header-height, 64px); }
    #ch-collection-{{ section.id }} .ch-desc,
    #ch-collection-{{ section.id }} .ch-desc.rte,
    #ch-collection-{{ section.id }} .ch-desc p {
      margin-left: 0 !important;
      padding-left: 0 !important;
      text-indent: 0 !important;
    }
    #ch-collection-{{ section.id }} .ch-desc ul,
    #ch-collection-{{ section.id }} .ch-desc ol {
      margin-left: 0 !important;
      padding-left: 1.25rem;
    }
    #ch-collection-{{ section.id }} .ch-header {
      margin-top: 0 !important;
      margin-bottom: 12px; 
    }
    #ch-collection-{{ section.id }} .ch-title {
      margin: 0 0 6px !important;
      line-height: 1.15;
    }
    #ch-collection-{{ section.id }} .ch-desc {
      margin: 0 !important;
      line-height: 1.55;
    }

    /* FIX 1 */
    #MainContent > .shopify-section:has(#ch-collection-{{ section.id }}) ,
    #MainContent > .shopify-section:has(#ch-collection-{{ section.id }}) .page-width,
    #ch-collection-{{ section.id }},
    #ch-collection-{{ section.id }} .page-width{
      padding-top: 0 !important;
      margin-top: 0 !important;
    }
    #ch-collection-{{ section.id }} .ch-header{ padding-top: 1px !important; margin-top: 0 !important; }
    @supports not (selector(:has(*))) {
      body.template-collection #MainContent .shopify-section,
      body.template-collection #MainContent .shopify-section .page-width{
        padding-top: 0 !important;
        margin-top: 0 !important;
      }
    }
    /* FIX 2 */
    #ch-collection-{{ section.id }} .ch-sub,
    #ch-collection-{{ section.id }} .ch-sub *,
    #ch-collection-{{ section.id }} .ch-sub p{
      margin-left: 0 !important;
      padding-left: 0 !important;
      text-indent: 0 !important;
    }
    #ch-collection-{{ section.id }} .ch-title{
      margin: 0 0 10px !important;
      font-weight: 900;
      letter-spacing: -0.02em;
      line-height: 1.12;
    }
    #ch-collection-{{ section.id }} .ch-sub{
      margin: 0 !important;
      line-height: 1.6;
      color: #111;
    }
    /* make page numbers obviously clickable */
#ch-collection-{{ section.id }} .pagination.numbers-only a { cursor: pointer; }
#ch-collection-{{ section.id }} .pagination.numbers-only .is-current > span,
#ch-collection-{{ section.id }} .pagination.numbers-only .ellipsis > span { cursor: default; }

/* optional: subtle disabled style while loading */
#ch-collection-{{ section.id }} .pagination.is-loading { opacity: .7; pointer-events: none; }

  </style>

  <div class="page-width">
    {%- comment -%} ---------- Category subtitles ---------- {%- endcomment -%}
    {%- assign h = collection.handle | downcase -%}
    {%- assign sub = '' -%}

    {%- if h == 'instant-camera' or h == 'instant-cameras' -%}
      {%- assign sub = 'Point-and-shoot cameras that print on the spot—fun, portable, and perfect for keepsakes.' -%}
    {%- elsif h == 'compact-camera' or h == 'compact-cameras' -%}
      {%- assign sub = 'Pocketable cameras with bigger sensors than phones for easy, everyday shooting.' -%}
    {%- elsif h == 'mirrorless-camera' or h == 'mirrorless-cameras' -%}
      {%- assign sub = 'Interchangeable-lens cameras with fast autofocus and modern creator features.' -%}
    {%- elsif h == 'lens' or h == 'lenses' -%}
      {%- assign sub = 'Prime and zoom lenses for every mount—go wider, get closer, or shoot in low light.' -%}
    {%- elsif h == 'action-camera' or h == 'action-cameras' -%}
      {%- assign sub = 'Rugged, stabilized cameras built for travel, sports, and adventure.' -%}
    {%- elsif h == 'film-camera' or h == 'film-cameras' -%}
      {%- assign sub = '35mm and medium-format bodies for a timeless analog look.' -%}
    {%- elsif h == 'films-consumables' or h == 'film-consumables' or h == 'films-and-consumables' -%}
      {%- assign sub = 'Instant packs, 35mm rolls, and the essentials you burn through often.' -%}
    {%- elsif h == 'professional-lighting' or h == 'pro-lighting' -%}
      {%- assign sub = 'LED panels, COB lights, and modifiers for studio-grade control.' -%}
    {%- elsif h == 'flash' or h == 'flashes' or h == 'speedlights' -%}
      {%- assign sub = 'Speedlights and triggers for crisp, controllable light on the go.' -%}
    {%- elsif h == 'storage' -%}
      {%- assign sub = 'Memory cards, SSDs, and readers to keep your shoots flowing.' -%}
    {%- elsif h == 'binoculars-and-scopes' or h == 'binoculars' -%}
      {%- assign sub = 'See farther with bright, rugged optics for nature and sport.' -%}
    {%- elsif h == 'drones' or h == 'drone' -%}
      {%- assign sub = 'Aerial cameras with smart flight modes for sweeping, stabilized shots.' -%}
    {%- elsif h == 'gimbals' or h == 'gimbal' -%}
      {%- assign sub = '3-axis stabilizers for silky video—from phone to cinema rigs.' -%}
    {%- elsif h == 'tripods' or h == 'tripod' -%}
      {%- assign sub = 'Lightweight travel sticks to rock-solid studio support.' -%}
    {%- elsif h == 'camera-bag' or h == 'camera-bags' or h == 'bags' -%}
      {%- assign sub = 'Backpacks, slings, and cases that protect and organize your gear.' -%}
    {%- elsif h == '360-camera' or h == '360-cameras' -%}
      {%- assign sub = 'Capture everything in one go—immersive video and VR-ready photos.' -%}
    {%- elsif h == 'microphone' or h == 'microphones' or h == 'mics' -%}
      {%- assign sub = 'On-camera mics, lavs, and USB/XLR options for clean, clear audio.' -%}
    {%- elsif h == 'cinema' -%}
      {%- assign sub = 'Pro video bodies, cages, and accessories for production workflows.' -%}
    {%- elsif h == 'kids-camera' or h == 'kids-cameras' -%}
      {%- assign sub = 'Simple, durable cameras made for little hands and big imaginations.' -%}
    {%- endif -%}

    {%- if sub == '' and collection.description != blank -%}
      {%- assign sub = collection.description | strip_html | strip -%}
    {%- endif -%}

    <!-- Heading + subtitle (HAVIT order) -->
    <header class="ch-header">
      <h1 class="ch-title">
        {{ collection.title }}{% if current_tags %} – {{ current_tags | join: ', ' }}{% endif %}
      </h1>
      {% if sub != '' %}
        <p class="ch-sub">{{ sub }}</p>
      {% endif %}
    </header>

    <!-- TOP FILTERS (theme section output) -->
    <div class="ch-topfilters">
      {% section 'collection-filters' %}
    </div>

    <!-- Product grid + pagination (contained) -->
    <div class="ch-grid-wrap">
      <div id="CollectionProductGrid">
        {%- for product in collection.products -%}
          <div class="ch-cell">
            {% render 'product-card', product: product %}
          </div>
        {%- else -%}
          {%- if shop.products_count == 0 -%}
            {%- for i in (1..10) -%}
              <div class="ch-cell">
                <a href="/admin/products" class="product-card" style="display:block;border:1px solid var(--line);border-radius:12px;padding:10px;background:#fff">
                  <div style="aspect-ratio:1/1;background:#f5f5f5;border-radius:8px;display:flex;align-items:center;justify-content:center">
                    {%- capture current -%}{% cycle 1,2,3,4,5,6 %}{%- endcapture -%}
                    {{ 'product-' | append: current | placeholder_svg_tag: 'placeholder-svg' }}
                  </div>
                  <div style="margin-top:8px;font-weight:700">{{ 'homepage.onboarding.product_title' | t }}</div>
                  <div>$19.99</div>
                </a>
              </div>
            {%- endfor -%}
          {%- else -%}
            <div class="ch-cell" style="grid-column:1/-1;text-align:center">
              <p>{{ 'collections.general.no_matches' | t }}</p>
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>

      {%- if paginate.pages > 1 -%}
        <!-- Numbers-only pager: keeps AJAX and accessibility, just removes Prev/Next -->
        <nav class="pagination numbers-only" role="navigation" aria-label="Pagination">
          <ol class="pag-list" role="list">
            {%- for part in paginate.parts -%}
              {%- if part.is_link -%}
                <li><a href="{{ part.url }}" data-page="{{ part.title }}" aria-label="Go to page {{ part.title }}">{{ part.title }}</a></li>
              {%- elsif part.title == paginate.current_page -%}
                <li class="is-current"><span aria-current="page">{{ part.title }}</span></li>
              {%- else -%}
                <li class="ellipsis" aria-hidden="true"><span>&hellip;</span></li>
              {%- endif -%}
            {%- endfor -%}
          </ol>
        </nav>
      {%- endif -%}
    </div>
  </div>

<script>
(function () {
  const root = document.getElementById('ch-collection-{{ section.id }}');
  const SID  = root.dataset.sectionId;

  const GRID_SEL = '#CollectionProductGrid';
  const PAG_SEL  = 'nav.pagination';

  const gridEl = () => root.querySelector(GRID_SEL);
  const normalize = (url) => new URL(url, window.location.origin).toString();
  const withSection = (url) => {
    const u = new URL(url, window.location.origin);
    u.searchParams.set('section_id', SID);
    return u.toString();
  };

  const cache = new Map(); // url -> {gridHTML, pagHTML}
  let controller = null;
  let isLoading = false;
  let watchdog = null;

  function makeSkeleton() {
    const g = gridEl();
    const cols = (getComputedStyle(g).gridTemplateColumns || '').split(' ').length || 4;
    const n = Math.max(cols * 1, 6);
    const wrap = document.createElement('div'); wrap.className = 'ch-skeleton-grid';
    for (let i = 0; i < n; i++) {
      const c = document.createElement('div'); c.className = 'ch-skel-card';
      c.innerHTML = '<div class="skel-media"></div><div class="skel-line"></div><div class="skel-line skel-short"></div><div class="skel-cta"></div>';
      wrap.appendChild(c);
    }
    return wrap;
  }

  function setLoading(state) {
    isLoading = state;
    const pag = root.querySelector('.pagination');
    if (pag) {
      pag.setAttribute('aria-busy', state ? 'true' : 'false');
      pag.classList.toggle('is-loading', !!state);
    }
  }

  function startWatchdog(href) {
    clearTimeout(watchdog);
    // If AJAX swap hasn't completed in 2500ms, hard-nav to keep UX alive
    watchdog = setTimeout(() => { window.location.assign(href); }, 2500);
  }
  function stopWatchdog() { clearTimeout(watchdog); }

  async function fetchPage(url) {
    const key = normalize(url);
    if (cache.has(key)) return cache.get(key);

    if (controller) controller.abort();
    controller = new AbortController();

    const res = await fetch(withSection(key), {
      headers: { 'X-Requested-With': 'XMLHttpRequest', 'Accept': 'text/html' },
      signal: controller.signal,
      credentials: 'same-origin',
      cache: 'no-store'
    });
    const html = await res.text();

    // Parse and scope to the returned section root
    const tpl = document.createElement('template');
    tpl.innerHTML = html.trim();
    const frag = tpl.content;
    const sectionRoot = frag.querySelector('#ch-collection-{{ section.id }}') || frag;

    const freshGrid = sectionRoot.querySelector(GRID_SEL);
    const freshPag  = sectionRoot.querySelector(PAG_SEL);

    if (!freshGrid) throw new Error('Returned HTML did not contain ' + GRID_SEL);

    const payload = {
      gridHTML: freshGrid.outerHTML,
      pagHTML:  freshPag ? freshPag.outerHTML : ''
    };
    cache.set(key, payload);
    return payload;
  }

  async function swapFrom(url) {
    startWatchdog(url);
    setLoading(true);

    const g = gridEl();
    if (g) { g.innerHTML = ''; g.appendChild(makeSkeleton()); }

    try {
      const payload = await fetchPage(url);
      if (!payload) return;

      const existingGrid = gridEl();
      if (existingGrid && payload.gridHTML) existingGrid.outerHTML = payload.gridHTML;

      const oldPag = root.querySelector(PAG_SEL);
      if (oldPag && payload.pagHTML) {
        oldPag.outerHTML = payload.pagHTML;
      } else if (!oldPag && payload.pagHTML) {
        root.querySelector('.ch-grid-wrap').insertAdjacentHTML('beforeend', payload.pagHTML);
      }

      bindPagination();
      prefetchNext();
    } catch (err) {
      console.error('Pager swap failed → hard navigation', err);
      window.location.assign(url);  // safety net
    } finally {
      stopWatchdog();
      setLoading(false);
    }
  }

  function onPagerClick(e) {
    const a = e.target.closest('a[href]');
    if (!a || a.target === '_blank' || e.metaKey || e.ctrlKey) return;
    e.preventDefault();

    if (isLoading && controller) controller.abort(); // newest click wins
    history.pushState({}, '', a.href);
    swapFrom(a.href);
  }

  function bindPagination() {
    const pag = root.querySelector('.pagination');
    if (!pag) return;
    pag.removeEventListener('click', onPagerClick, true);
    pag.addEventListener('click', onPagerClick, true);
  }

  function prefetchNext() {
    const list = root.querySelector('.pagination.numbers-only .pag-list');
    if (!list) return;

    const current = list.querySelector('.is-current span');
    const nextLi  = current && current.parentElement.nextElementSibling;
    const nextA   = nextLi && nextLi.querySelector('a[href]');
    const nextUrl = nextA && nextA.href;
    if (!nextUrl || cache.has(normalize(nextUrl))) return;

    const doPrefetch = () => fetchPage(nextUrl).catch(() => {});
    if ('requestIdleCallback' in window) {
      requestIdleCallback(doPrefetch, { timeout: 1000 });
    } else {
      setTimeout(doPrefetch, 250);
    }

    try {
      const hint = document.createElement('link');
      hint.rel = 'prefetch';
      hint.href = withSection(nextUrl);
      hint.as = 'fetch';
      hint.crossOrigin = 'anonymous';
      document.head.appendChild(hint);
    } catch(_) {}
  }

  window.addEventListener('popstate', () => swapFrom(window.location.href));
  bindPagination();
  prefetchNext();
})();
</script>

</section>
{%- endpaginate -%}
