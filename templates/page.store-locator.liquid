<style>
:root{
  --brand: #d12f24;
  --brand-dk: #b5281f;
  --pin:   #ED1B24;
  --pin-dk:#c2161d;

  --ink:#0a0a0a;
  --muted:rgba(0,0,0,.65);
  --hair:#e6e7ee;
  --card:#fff;
  --radius:12px;
  --radius-lg:14px;
  --shadow:0 1px 2px rgba(0,0,0,.06), 0 8px 24px rgba(0,0,0,.06);
  --focus:0 0 0 3px rgba(17,17,17,.2);
  --maxw:1280px;

  /* add this once */
  --ink-strong:#2b2f36;
}


  /* Base */
  .locator{
    max-width:var(--maxw);
    margin:0 auto;
    padding:16px 16px 24px;
    color:var(--ink);
    font:14px/1.43 system-ui,-apple-system,"Segoe UI",Roboto,Arial;
  }

  /* New header styles */
.catc__top{
  display:flex;
  align-items:flex-end;
  justify-content:space-between;
  gap:16px;
  padding:8px 0 10px;
  border-bottom:1px solid var(--hair);
  margin-bottom:16px;
}

.catc__heading{
  font-size:clamp(24px, 2.4vw + 8px, 34px);
  font-weight: var(--font-heading-weight, 600); /* theme-driven weight */
  letter-spacing:-0.01em;
  line-height:1.1;
  margin:0;
  color: var(--heading-color, var(--ink-strong, #2b2f36)); /* theme > strong-ink */
}


  .skip{ position:absolute; left:-10000px; width:1px; height:1px; overflow:hidden; }
  .skip:focus{
    position:static; display:inline-block; padding:6px 10px; background:#fff;
    border:1px solid #111; border-radius:8px; margin-bottom:8px;
  }

  /* Layout */
  .sl-shell{
    display:grid;
    gap:24px;
    grid-template-columns:minmax(360px,420px) 1fr;
    align-items:stretch; /* ensure equal column heights */
  }
  /* Make rail end where the map ends on desktop */
  .rail{
    height:80vh;
    min-height:520px;
    display:flex;
    flex-direction:column;
  }
  .rail-body{
    flex:1;
    min-height:0;
    overflow:auto;
    margin-top:16px;
    padding-right:8px;
  }
  .map{
    height:80vh;
    min-height:520px;
    border-radius:var(--radius);
    overflow:hidden;
    box-shadow:var(--shadow);
  }
  .leaflet-container{ background:#f5f6fa; }

  /* Controls panel */
  .controls{
    position:sticky;
    top:16px;
    z-index:5;
    background:var(--card);
    border-radius:var(--radius);
    box-shadow:var(--shadow);
    padding:12px;
  }
  .control-row{ display:flex; flex-direction:column; gap:12px; }

  /* Search group */
  .search{
    display:flex; align-items:center;
    border:1px solid #111; border-radius:10px;
    background:#fff; height:40px; overflow:hidden;
  }
  .search-icon{
    flex:none; width:40px; height:100%;
    background:var(--brand); color:#fff;  /* white icon */
    display:flex; align-items:center; justify-content:center;
  }
  .search-icon .icon{ color:#fff; width:20px; height:20px; }
  .search input{
    flex:1; height:100%; border:0; outline:0; font-size:14px; padding:0 8px;
    background:#fff; color:#444;
  }
  .search input::placeholder{ color:#444; }
  .clear{
    flex:none; border:0; background:transparent; width:32px; height:100%;
    line-height:1; border-left:1px solid #ccc; cursor:pointer; color:#555; font-size:16px;
  }
  .clear:hover{ background:#f3f3f6; }

  .meta{ display:flex; justify-content:space-between; align-items:center; margin-top:10px; }
  .count{ color:var(--muted); }
  .assist{ margin:.5rem 0 0; color:var(--muted); font-size:12.5px; }

  /* List / cards */
  .store-list{
    list-style:none; margin:0; padding:0; display:grid; gap:12px;
  }

  /* Entrance animation */
  .store-card{
    background:var(--card);
    border-radius:var(--radius-lg);
    box-shadow:var(--shadow);
    padding:16px;
    border:1px solid transparent;
    transition:transform .18s ease, box-shadow .18s ease, border-color .18s ease, opacity .18s ease;
    opacity:0; transform:translateY(6px);
    animation:sl-in .24s ease forwards;
  }
  @keyframes sl-in{ to{ opacity:1; transform:translateY(0);} }

  /* Hover: only lift + tiny scale (no color change) */
  .store-card:hover{
    transform:translateY(-2px) scale(1.01);
    box-shadow:0 2px 3px rgba(0,0,0,.06), 0 10px 28px rgba(0,0,0,.09);
  }

  /* Active/selected: darker red, all text white (incl. name) */
  .store-card[aria-selected="true"]{
    background:var(--brand-dk);
    color:#fff;
    border-color:var(--brand-dk);
  }
  .store-card[aria-selected="true"] .store-name{ color:#fff; }
  .store-card[aria-selected="true"] .locality{ color:#fff; }
  .store-card[aria-selected="true"] .loc-ico{ color:#fff; }
  .store-card[aria-selected="true"] .status{
    background:rgba(255,255,255,.16);
    color:#fff;
  }

  .store-card:focus-within{ outline:none; box-shadow:var(--focus); }

  .row{ display:flex; gap:8px; align-items:flex-start; justify-content:space-between; }
  .store-name{ font-size:19px; font-weight:600; line-height:28px; margin:0; }
  .locality{
    color:var(--muted); line-height:20px; margin-top:6px; white-space:nowrap; overflow:hidden; text-overflow:ellipsis;
    display:flex; align-items:center; gap:6px;
  }
  .loc-ico{ width:16px; height:16px; color:var(--brand); flex:0 0 16px; }

  .status{
    flex:none; font-size:12px; padding:4px 8px; border-radius:999px; background:#f6f6f8; color:#111; line-height:1;
  }
  .status.open{ background:#eaf7ee; color:#12683b; }

  .store-card button.toggle{ all:unset; display:block; width:100%; cursor:pointer; }
  .store-card button.toggle:focus-visible{ outline:none; box-shadow:var(--focus); border-radius:10px; }

  /* Custom clusters (Camerahaus-red bubble with white number) */
  .marker-cluster-small, .marker-cluster-medium, .marker-cluster-large{ background:transparent !important; }
  .marker-cluster div{ background:transparent !important; border:none !important; }
  .ch-cluster{
    width:40px; height:40px; border-radius:999px;
    background:var(--brand); color:#fff; border:2px solid #fff;
    display:flex; align-items:center; justify-content:center; font-weight:700;
    box-shadow:0 2px 10px rgba(0,0,0,.18);
  }

  /* Camerahaus pins (circular badge with logo) */
  .ch-pin{
    position:relative;
    width:34px; height:34px; border-radius:999px;
    background:#fff center/70% no-repeat; /* image fills 70% */
    border:3px solid var(--brand);
    box-shadow:0 2px 10px rgba(0,0,0,.18);
  }
  .ch-pin--active{ transform:scale(1.08); border-color:var(--brand-dk); }

  /* Mobile */
  @media (max-width:980px){
    .locator{ font-size:12.5px; }

    .sl-shell{
      grid-template-rows:auto minmax(240px,40vh) minmax(200px,50vh);
      grid-template-columns:1fr;
      gap:0;
    }
    .rail{ display:contents; height:auto; min-height:unset; }

    .controls{
      grid-area:1/1;
      position:sticky; top:0; z-index:30; padding:10px 12px 8px;
      border-radius:0; box-shadow:0 6px 24px rgba(0,0,0,.06);
    }
    .control-row{ display:block; }

    .search{ height:44px; border-radius:10px; }
    .search-icon{ width:44px; }

    .map{
      grid-area:2/1; height:40vh; min-height:240px; width:100%;
      border-radius:0; box-shadow:none;
    }
    .rail-body{
      grid-area:3/1; max-height:50vh; overflow:auto; padding:10px 12px 16px;
    }
    .store-card{ border-radius:16px; padding:14px; }
    .store-name{ font-size:16px; line-height:24px; }
    .locality{ font-size:12.5px; line-height:18px; }
  }

  @media (prefers-reduced-motion:reduce){
    .store-card,.clear{ transition:none !important; }
    .store-card{ animation:none !important; opacity:1 !important; transform:none !important; }
  }
  /* Existing hover gets upgraded to full brand color + white text */
.store-card:hover{
  background:var(--brand);         /* #d12f24 */
  color:#fff;
  transform:translateY(-2px) scale(1.01);
  box-shadow:0 2px 3px rgba(0,0,0,.06), 0 10px 28px rgba(0,0,0,.12);
  border-color:var(--brand);
}

/* Ensure all text/icons flip to white on hover */
.store-card:hover .store-name{ color:#fff; }
.store-card:hover .locality{ color:#fff; }
.store-card:hover .loc-ico{ color:#fff; }

/* Make the status pill harmonize on hover */
.store-card:hover .status{
  background:rgba(255,255,255,.16);
  color:#fff;
}

/* Keep selected state as-is (still darker) */
.store-card[aria-selected="true"]{
  background:var(--brand-dk);
  color:#fff;
  border-color:var(--brand-dk);
}
.store-card[aria-selected="true"] .store-name,
.store-card[aria-selected="true"] .locality,
.store-card[aria-selected="true"] .loc-ico,
.store-card[aria-selected="true"] .status{ color:#fff; }
