  /* ===== DOM refs ===== */
  const els = {
    list: document.getElementById('sl-list'),
    search: document.getElementById('sl-search'),
    clear: document.getElementById('sl-clear'),
    count: document.getElementById('sl-count'),
    map: document.getElementById('sl-map'),
  };
  const isMobile = matchMedia('(max-width:980px)').matches;

  /* ===== Leaflet map setup ===== */
  const PH_BOUNDS = [[4.3,116.0],[21.3,127.3]];
  const map = L.map(els.map, {
    scrollWheelZoom: !isMobile,
    touchZoom: true,
    preferCanvas: true,
    maxBounds: PH_BOUNDS,
    maxBoundsViscosity: .7
  });

  L.tileLayer('https://{s}.basemaps.cartocdn.com/light_nolabels/{z}/{x}/{y}{r}.png', {
    maxZoom: 19,
    attribution: '&copy; OpenStreetMap &copy; CARTO'
  }).addTo(map);

  L.tileLayer('https://{s}.basemaps.cartocdn.com/light_only_labels/{z}/{x}/{y}{r}.png', {
    maxZoom: 19,
    pane: 'overlayPane'
  }).addTo(map);

  // Camerahaus cluster bubbles (red with white number)
  const cluster = L.markerClusterGroup({
    spiderfyOnMaxZoom:true,
    iconCreateFunction: (c) => {
      const count = c.getChildCount();
      const size = count >= 50 ? 54 : count >= 10 ? 46 : 40;
      const html = `<div class="ch-cluster" style="width:${size}px;height:${size}px;font-size:${Math.max(12, Math.min(18, size*0.38))}px">${count}</div>`;
      return L.divIcon({ html, className:'', iconSize:[size, size] });
    }
  });
// Open a child popup after clicking a cluster bubble
cluster.on('clusterclick', (e) => {
  const children = e.layer.getAllChildMarkers();
  if (!children || !children.length) return;

  // If we’re already max-zoomed, just spiderfy and open the first child
  if (map.getZoom() >= map.getMaxZoom()){
    e.layer.spiderfy();
    setTimeout(() => children[0].openPopup(), 0);
    return;
  }

  // Otherwise zoom to it, then open when the move finishes
  map.once('moveend', () => {
    // if the cluster resolved to individual markers, open the first
    const first = children[0];
    if (first) first.openPopup();
  });
  e.layer.zoomToBounds(); // or e.layer.spiderfy() if you prefer spiderfy-first
});

function camIcon(active=false){
  const src = "{{ chicon }}"; // or your absolute URL
  const html = `
    <div class="ch-pin ${active ? 'ch-pin--active' : ''}">
      <img class="ch-pin-img" src="${src}" alt="">
    </div>`;
  return L.divIcon({ className:'', html, iconSize:[34,34], iconAnchor:[17,34], popupAnchor:[0,-30] });
}


  // popup sizing
  const POPUP_MAX = isMobile ? 240 : 360;
  const POPUP_MIN = isMobile ? 180 : 280;

  const markersById = new Map();
  let activeId = null;

  function popupHTML(s){
    const addrText = `${s.address}, ${s.city}`;
    const dest = encodeURIComponent(addrText);

    const phoneHtml = s.phones?.length
      ? `<div style="margin-top:6px;"><strong>Phone</strong><br>${s.phones.map(p=>`<a href="tel:${p.replace(/[^0-9+]/g,'')}" style="color:#2563eb">${p}</a>`).join(' · ')}</div>`
      : '';

    const hoursHtml = s.hours
      ? `<div style="margin-top:6px;"><strong>Hours</strong><br><pre style="margin:0; font-family:inherit; white-space:pre-line;">${s.hours}</pre></div>`
      : '';

    return `
      <div style="min-width:${POPUP_MIN-20}px; max-width:${POPUP_MAX-20}px; font-size:${isMobile?'12px':'13px'}; line-height:1.4;">
        <div style="font-weight:700; margin-bottom:4px">${s.name}</div>
        <div style="color:rgba(0,0,0,.7)">${addrText}</div>
        ${phoneHtml}
        ${hoursHtml}
        <div style="margin-top:10px; display:flex; gap:8px; flex-wrap:wrap">
          <a href="https://www.google.com/maps/dir/?api=1&destination=${dest}" target="_blank" rel="noopener"
             style="background:#d12f24; color:#fff; padding:6px 10px; border-radius:999px; text-decoration:none; font-weight:700; font-size:${isMobile?'12px':'13px'}; line-height:1.2;">
            Get directions
          </a>
          <button class="sl-copy" data-copy="${addrText}"
             style="border:1px solid #ddd; background:#fff; padding:6px 10px; border-radius:999px; cursor:pointer; font-size:${isMobile?'12px':'13px'}; line-height:1.2;">
            Copy address
          </button>
        </div>
      </div>
    `;
  }

// create markers
STORE_DATA.forEach(s => {
  if (!s.coords) return;

  const m = L.marker([s.coords.lat, s.coords.lng], {
    icon: camIcon(false),
    keyboard: false,
    riseOnHover: true
  });

  // Always ensure it's visible via the cluster, then open its popup
  m.on('click', function () {
    // (optional) keep your selection styling
    activeId = s.id;
    markersById.forEach((mk, mid) => mk.setIcon(camIcon(mid === s.id)));

    cluster.zoomToShowLayer(this, () => {
      this.setPopupContent(popupHTML(s));
      this.openPopup();
    });
  });

  m.bindPopup(popupHTML(s), {
    className: 'sl-popup',
    maxWidth: POPUP_MAX,
    minWidth: POPUP_MIN,
    autoPan: true,
    autoPanPaddingTopLeft: [20,20],
    autoPanPaddingBottomRight: [20,20]
  });

  cluster.addLayer(m);
  markersById.set(s.id, m);
});


  map.addLayer(cluster);

  map.whenReady(() => setTimeout(()=> map.invalidateSize(), 60));
  try {
    map.fitBounds(cluster.getBounds().pad(0.2));
  } catch(_) {
    map.setView([12.8797,121.7740], 5);
  }
  window.addEventListener('orientationchange', () => setTimeout(()=> map.invalidateSize(), 120), {passive:true});

  /* ===== Search + list rendering ===== */
  let query = '';
  let timer;

  const localityText = s => [s.address?.split(',')[0]||'', s.city||''].filter(Boolean).join(', ');

const statusPill = s => {
  const open = isOpenNow(s.schedule);
  return `<span class="status ${open ? 'open' : 'closed'}">${open ? 'Open' : 'Closed'}</span>`;
};

  // red location/building icon beside the locality
  const locIcon = `
    <svg class="loc-ico" viewBox="0 0 24 24" fill="none" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
      <path stroke-linecap="round" stroke-linejoin="round"
            d="M13.5 21v-7.5a.75.75 0 0 1 .75-.75h3a.75.75 0 0 1 .75.75V21m-4.5 0H2.36m11.14 0H18m0 0h3.64m-1.39 0V9.349M3.75 21V9.349m0 0a3.001 3.001 0 0 0 3.75-.615A2.993 2.993 0 0 0 9.75 9.75c.896 0 1.7-.393 2.25-1.016a2.993 2.993 0 0 0 2.25 1.016c.896 0 1.7-.393 2.25-1.015a3.001 3.001 0 0 0 3.75.614m-16.5 0a3.004 3.004 0 0 1-.621-4.72l1.189-1.19A1.5 1.5 0 0 1 5.378 3h13.243a1.5 1.5 0 0 1 1.06.44l1.19 1.189a3 3 0 0 1-.621 4.72M6.75 18h3.75a.75.75 0 0 0 .75-.75V13.5a.75.75 0 0 0-.75-.75H6.75a.75.75 0 0 0-.75.75v3.75c0 .414.336.75.75.75Z"/>
    </svg>`;

  function storeCard(s, i){
    return `
      <li class="store-card" style="animation-delay:${i*40}ms" data-id="${s.id}" aria-selected="${activeId===s.id?'true':'false'}">
        <button class="toggle" aria-label="Show ${s.name} on map" data-id="${s.id}">
          <div class="row">
            <h3 class="store-name">${s.name}</h3>
            ${statusPill(s)}
          </div>
          <div class="locality" title="${localityText(s)}">${locIcon}${localityText(s)}</div>
        </button>
      </li>
    `;
  }

  function filtered(){
    const q = query.trim().toLowerCase();
    if (!q) return STORE_DATA;
    return STORE_DATA.filter(s =>
      s.name.toLowerCase().includes(q) ||
      (s.city||'').toLowerCase().includes(q) ||
      (s.address||'').toLowerCase().includes(q)
    );
  }

  function renderList(items){
    els.list.innerHTML = items.map((s,i)=>storeCard(s,i)).join('');
    els.count.textContent = `${items.length} result${items.length!==1?'s':''}`;

    els.list.querySelectorAll('.toggle').forEach(btn=>{
      btn.addEventListener('click', () => selectStore(btn.dataset.id, {center:true, open:true}));
      btn.addEventListener('keydown', e=>{
        if (e.key==='Enter' || e.key===' '){ e.preventDefault(); btn.click(); }
      });
    });
  }

  renderList(filtered());

  /* search events with gentle debounce */
  els.search.addEventListener('input', ()=>{
    clearTimeout(timer);
    timer = setTimeout(()=>{
      query = els.search.value;
      renderList(filtered());    // re-renders with entrance animation
    }, 160);
  });

  els.clear.addEventListener('click', ()=>{
    els.search.value=''; query=''; renderList(filtered()); els.search.focus();
  });

  /* ===== selectStore ===== */
  function selectStore(id, opts={center:false, open:false}){
    activeId = id;
    document.querySelectorAll('.store-card')
      .forEach(c => c.setAttribute('aria-selected', c.dataset.id===id?'true':'false'));
    markersById.forEach((m, mid)=> m.setIcon(camIcon(mid===id)));

    const m = markersById.get(id);
    if (!m) return;

    cluster.zoomToShowLayer(m, function(){
      if (opts.center){ map.setView(m.getLatLng(), Math.max(map.getZoom(), 15), {animate:true}); }
      if (opts.open){
        const s = STORE_DATA.find(x=>x.id===id);
        m.setPopupContent(popupHTML(s));
        m.openPopup();
      }
      if (isMobile){
        const top = window.scrollY + els.map.getBoundingClientRect().top - 8;
        window.scrollTo({top, behavior:'smooth'});
      }
    });
  }

  // Copy button in popup
  document.addEventListener('click', async (e)=>{
    const btn = e.target.closest('.sl-copy');
    if (!btn) return;
    try{
      await navigator.clipboard.writeText(btn.dataset.copy);
      btn.textContent='Copied!';
      setTimeout(()=>btn.textContent='Copy address',1200);
    }catch(_){}
  });

  // If background images fail, show the “C” fallback once the DOM is ready
  window.addEventListener('load', () => {
    document.querySelectorAll('.ch-pin').forEach(el => {
      const hasImg = getComputedStyle(el).backgroundImage !== 'none';
      if(!hasImg){ const f=el.querySelector('.ch-pin-fallback'); if(f) f.style.display='flex'; }
    });
  });

  // Refresh open/closed every 60s
  setInterval(()=> renderList(filtered()), 60000);
})();
</script>
