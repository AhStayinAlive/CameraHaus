{% comment %}
Camerahaus — Store Locator (UX+Accessibility)
- Leaflet + MarkerCluster (no paid keys)
- Keyboard nav, ARIA roles, SR-only labels, high-contrast focus states
- Filters appear if your stores include "services" tags (e.g., ["Open 24 hours","Free WiFi"])
- Geolocation: client-side only; not stored; can be toggled off if desired
- For best performance, keep AUTOGEOCODE=false and provide lat/lng per store.
{% endcomment %}

<section id="ch-store-locator" class="chsl container" aria-label="Store Locator">
  <a class="chsl__skip" href="#chsl-map">Skip to map</a>

  <div class="chsl__controls" role="search" aria-label="Search and filters">
    <div class="chsl__searchwrap">
      <label class="sr-only" for="chsl-search">Search by city, store or address</label>
      <input id="chsl-search" type="search" inputmode="search" autocomplete="off"
             placeholder="Search city, store or address…" aria-describedby="chsl-results-count">
      <button id="chsl-clear" class="chsl__iconbtn" type="button" aria-label="Clear search">×</button>
    </div>

    <div class="chsl__chipwrap" id="chsl-chips" aria-label="Filters"><!-- chips inserted here --></div>

    <div class="chsl__actions">
      <button id="chsl-geolocate" type="button" class="btn" aria-describedby="chsl-privacy-note">
        Use my location
      </button>
      <span id="chsl-status" class="chsl__status" aria-live="polite"></span>
    </div>
    <p id="chsl-privacy-note" class="chsl__note">Location is used only to sort results locally on your device.</p>
  </div>

  <div class="chsl__layout">
    <aside class="chsl__list" id="chsl-list" role="list" aria-label="Store results"
           aria-describedby="chsl-results-count" tabindex="0"></aside>
    <div class="chsl__map" id="chsl-map" role="region" aria-label="Map of store locations"></div>
  </div>
  <div id="chsl-results-count" class="sr-only" aria-live="polite"></div>
</section>

<!-- Leaflet + MarkerCluster -->
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" crossorigin=""/>
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" crossorigin=""></script>
<link rel="stylesheet" href="https://unpkg.com/leaflet.markercluster@1.5.3/dist/MarkerCluster.css">
<link rel="stylesheet" href="https://unpkg.com/leaflet.markercluster@1.5.3/dist/MarkerCluster.Default.css">
<script src="https://unpkg.com/leaflet.markercluster@1.5.3/dist/leaflet.markercluster.js"></script>

<style>
  /* ===== Brand & base ===== */
  .chsl { --brand:#d62a2a; --ink:#111827; --muted:#6b7280; --bg:#ffffff; --line:#e5e7eb; --ring:#1d4ed8;
          --chip:#f3f4f6; --chipOn:#fee2e2; --chipOnBorder:#fca5a5; --radius:12px; padding:8px 0; }
  .chsl * { box-sizing:border-box; }
  .sr-only { position:absolute !important; width:1px; height:1px; padding:0; margin:-1px; overflow:hidden; clip:rect(0,0,0,0); white-space:nowrap; border:0; }

  .chsl__skip { position:absolute; left:-9999px; top:auto; width:1px; height:1px; overflow:hidden; }
  .chsl__skip:focus { position:static; width:auto; height:auto; padding:4px 8px; background:#fff; border:2px solid var(--ring); border-radius:8px; }

  .chsl__controls { display:grid; gap:10px; margin-bottom:12px; grid-template-columns: 1fr auto; align-items:center; }
  .chsl__searchwrap { position:relative; grid-column:1 / span 1; }
  #chsl-search { width:100%; padding:12px 40px 12px 12px; border:1px solid var(--line); border-radius:var(--radius); font-size:16px; }
  #chsl-search:focus { outline:none; box-shadow:0 0 0 3px rgba(29,78,216,.3); border-color:var(--ring); }
  .chsl__iconbtn { position:absolute; right:6px; top:6px; border:0; background:transparent; font-size:20px; width:28px; height:28px; border-radius:8px; cursor:pointer; color:var(--muted); }
  .chsl__iconbtn:hover { background:#f3f4f6; }

  .chsl__chipwrap { display:flex; flex-wrap:wrap; gap:8px; grid-column:1 / span 1; }
  .chip { font-size:14px; padding:6px 10px; border-radius:999px; border:1px solid var(--line); background:var(--chip); cursor:pointer; }
  .chip[aria-pressed="true"] { background:var(--chipOn); border-color:var(--chipOnBorder); color:#991b1b; }
  .chip:focus-visible { outline:3px solid rgba(29,78,216,.35); outline-offset:2px; }

  .chsl__actions { display:flex; gap:8px; grid-column:2 / span 1; align-items:center; justify-content:flex-end; }
  .btn { background:var(--brand); color:#fff; border:none; padding:10px 12px; border-radius:10px; cursor:pointer; font-weight:600; }
  .btn:hover { filter:brightness(.95); }
  .chsl__status { font-size:13px; color:var(--muted); margin-left:8px; }
  .chsl__note { grid-column:1 / -1; color:var(--muted); font-size:12px; margin:0; }

  .chsl__layout { display:grid; grid-template-columns: 380px 1fr; gap:14px; }
  .chsl__list { max-height: 72vh; overflow:auto; border:1px solid var(--line); border-radius:var(--radius); background:var(--bg); padding:8px; }
  .chsl__card { padding:12px 10px; border-left:4px solid transparent; border-bottom:1px solid var(--line); outline:none; }
  .chsl__card:last-child { border-bottom:none; }
  .chsl__card:focus, .chsl__card[aria-selected="true"] { border-left-color:var(--brand); box-shadow:inset 0 0 0 2px rgba(214,42,42,.08); }
  .chsl__title { font-weight:700; color:var(--ink); margin:0 0 4px; }
  .chsl__meta { font-size:13px; color:var(--muted); line-height:1.4; white-space:pre-line; }
  .chsl__distance { font-size:12px; color:#1d4ed8; margin-top:4px; }

  .chsl__map { height:72vh; min-height:360px; border:1px solid var(--line); border-radius:var(--radius); overflow:hidden; }

  /* MarkerCluster color tweak (brand) */
  .marker-cluster-small { background: rgba(214,42,42,.2); }
  .marker-cluster-small div { background: rgba(214,42,42,.8); color:#fff; }

  @media (max-width: 980px){
    .chsl__layout { grid-template-columns: 1fr; }
    .chsl__list { max-height:40vh; }
  }
</style>

<script>
(function(){
  /* ===== Config ===== */
  const AUTOGEOCODE = false;             // keep false for speed; true only if you need to auto-fill coords
  const PH_BOUNDS   = [[4.3,116.0],[21.3,127.3]];
  const INITIAL     = [12.8797,121.7740]; // PH center
  /* ================== */

  // ——— Data (add services as needed for filter chips) ———
  const stores = [
    { title:"CameraHaus Ayala Malls Manila Bay", address:"4F, Bay Area Bldg, Macapagal Blvd., Tambo, Parañaque City, Philippines", phone:"SmartCel: (0998) 9690980 · Tel: (02) 7943-0196", hours:"Mon–Wed 10:00–21:00\nThu–Sun 10:00–22:00", city:"Parañaque", lat:14.5233, lng:120.9884, services:[] },
    { title:"CameraHaus Plus SM North EDSA", address:"5F, Cyberzone Annex, SM City North EDSA, Quezon City, Philippines", phone:"Tel/Fax: (02) 8332-8927 · Mobile: (0998) 969-0655", hours:"Daily 10:00–22:00", city:"Quezon City", lat:14.657027, lng:121.030479, services:["Free WiFi"] },
    { title:"CameraHaus Plus Megamall", address:"4F, Building B, Cyberzone, SM Megamall, Mandaluyong City, Philippines", phone:"Tel/Fax: (02) 8635-6039 · Mobile: (0998) 969-0652", hours:"Daily 10:00–22:00", city:"Mandaluyong", lat:14.585735, lng:121.057037, services:[] },
    { title:"CameraHaus Plus SM Mall of Asia", address:"2F, Cyberzone, SM Mall of Asia, Pasay City, Philippines", phone:"Tel/Fax: (02) 8889-0795 · Mobile: (0998) 969-0656", hours:"Mon–Fri 11:00–21:00\nSat–Sun 10:00–22:00", city:"Pasay", lat:14.535067, lng:120.982155, services:[] },
    { title:"CameraHaus Glorietta 2", address:"3F, Ayala Center, Makati City, Philippines", phone:"Tel/Fax: (02) 7625-3756 · Mobile: (0998) 969-0654", hours:"Mon–Thu 10:00–21:00\nSat–Sun 10:00–22:00", city:"Makati", lat:14.550664, lng:121.021833, services:[] },
    { title:"CameraHaus Plus SM Aura", address:"4F, SM Aura Premier, BGC, Taguig, Philippines", phone:"Tel/Fax: (02) 8847-9676 · Mobile: (0998) 969-0651", hours:"Daily 10:00–22:00", city:"Taguig", lat:14.546748, lng:121.05455, services:[] },
    { title:"CameraHaus Robinsons Place Ermita", address:"3F, Pedro Gil Wing, Robinsons Place Manila, Ermita, Manila, Philippines", phone:"Tel/Fax: (02) 8732-0126 · Mobile: (0998) 969-0646", hours:"Daily 10:00–22:00", city:"Manila", lat:14.57604, lng:120.984186, services:[] },
    { title:"CameraHaus SM Baguio", address:"3F, SM City Baguio, Baguio City, Philippines", phone:"Mobile: (0998) 969-0648", hours:"Mon–Thu 10:00–21:00\nFri–Sun 10:00–22:00", city:"Baguio", lat:16.408887, lng:120.596625, services:[] },
    { title:"CameraHaus SM Iloilo", address:"3F, SM City Iloilo, Iloilo City, Philippines", phone:"Tel/Fax: (033) 320-3631 · Mobile: (0998) 969-0974", hours:"Daily 10:00–22:00", city:"Iloilo", lat:10.714054, lng:122.550585, services:[] },
    { title:"CameraHaus SM Cebu", address:"UGF, SM City Cebu, Cebu City, Philippines", phone:"Tel/Fax: (032) 239-5878 · Mobile: (0998) 969-0973", hours:"Daily 10:00–21:00", city:"Cebu City", lat:10.312338, lng:123.920024, services:[] },
    { title:"CameraHaus SM Davao", address:"G/F, SM City Davao, Davao City, Philippines", phone:"Tel/Fax: (082) 297-8460 · Mobile: (0933) 147-9365", hours:"Daily 10:00–20:00", city:"Davao", lat:7.0499, lng:125.5880, services:[] },
    { title:"CameraHaus Abreeza Davao", address:"3F, Abreeza Mall, Davao City, Philippines", phone:"Tel/Fax: (082) 321-4298 · Mobile: (0933) 518-8378", hours:"", city:"Davao", lat:7.091444, lng:125.610942, services:[] },
    { title:"CameraHaus Gensan", address:"IL148, G/F Veranza Mall, General Santos City, Philippines", phone:"Tel/Fax: (085) 815-4438 · Mobile: (0946) 268-2940", hours:"Daily 10:00–21:00", city:"General Santos", lat:6.1165, lng:125.18796, services:[] },
    { title:"CameraHaus Butuan", address:"VCDU Bldg, J.C. Aquino Ave. cor Elloso St, Brgy Imadejas, Butuan City, Philippines", phone:"Tel/Fax: (083) 552-6588 · Mobile: (0998) 866-6399", hours:"Daily 10:00–21:00", city:"Butuan", lat:8.942967, lng:125.519723, services:[] },
    { title:"Camerahaus Cagayan de Oro", address:"3F, SM CDO Downtown Premier, Cagayan de Oro City, Philippines", phone:"Mobile: 0906 383 0283 / 0968 855 9855", hours:"Daily 10:00–21:00", city:"Cagayan de Oro", lat:8.484514, lng:124.654351, services:[] },
    { title:"Fujifilm Concept Store — Ayala Malls Manila Bay", address:"4F, Bay Area Bldg, Macapagal Blvd., Tambo, Parañaque City, Philippines", phone:"SmartCel: (0998) 9690980 · Tel: (02) 7943-0196", hours:"Mon–Wed 10:00–21:00\nThu–Sun 10:00–22:00", city:"Parañaque", lat:14.5233, lng:120.9884, services:[] },
    { title:"Canon — SM Megamall", address:"4F, Canon Image Square, Cyberzone, Bldg B, SM Megamall, Mandaluyong City, Philippines", phone:"Tel/Fax: (02) 8681-4468 · Mobile: (0998) 969-0653", hours:"Daily 10:00–22:00", city:"Mandaluyong", lat:14.585735, lng:121.057037, services:[] },
    { title:"Camerahaus Online (HQ)", address:"Philippines (online support)", phone:"Email: online@camerahaus.com · Mobile: 0998 969 0972", hours:"", city:"", lat:null, lng:null, services:[] }
  ].filter(s => s.lat && s.lng);

  // ====== UI bootstrap (lazy) ======
  const boot = () => { if (boot._ran) return; boot._ran = true; main(); };
  if ('IntersectionObserver' in window){
    const io = new IntersectionObserver(e=>{ if (e[0].isIntersecting){ io.disconnect(); boot(); } }, {rootMargin:'200px'});
    io.observe(document.getElementById('ch-store-locator'));
  } else { boot(); }

  // ====== Main ======
  function main(){
    const els = {
      list: document.getElementById('chsl-list'),
      map:  document.getElementById('chsl-map'),
      search: document.getElementById('chsl-search'),
      clear: document.getElementById('chsl-clear'),
      chips: document.getElementById('chsl-chips'),
      geo: document.getElementById('chsl-geolocate'),
      status: document.getElementById('chsl-status'),
      count: document.getElementById('chsl-results-count')
    };

    // Map init with PH bounds
    const map = L.map(els.map, { scrollWheelZoom:true, preferCanvas:true, maxBounds:PH_BOUNDS, maxBoundsViscosity:.7 });
    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', { maxZoom:19, attribution:'&copy; OpenStreetMap' }).addTo(map);
    map.setView(INITIAL, 5);

    // Brand marker icon
    const Pin = L.divIcon({
      className:'chsl-pin',
      html:`<svg width="26" height="36" viewBox="0 0 26 36" role="img" aria-label="Store marker" xmlns="http://www.w3.org/2000/svg">
              <path fill="#d62a2a" d="M13 0c7.2 0 13 5.8 13 13 0 8.2-10.1 17.2-12.3 19-0.4 0.3-1 .3-1.4 0C10.1 30.2 0 21.2 0 13 0 5.8 5.8 0 13 0z"/>
              <circle cx="13" cy="13" r="5.2" fill="#fff"/>
            </svg>`,
      iconSize:[26,36], iconAnchor:[13,36], popupAnchor:[0,-34]
    });
    const cluster = L.markerClusterGroup();
    map.addLayer(cluster);

    // Add markers
    stores.forEach((s,i)=> { s._idx=i; });
    const markers = stores.map((s)=> {
      const m = L.marker([s.lat,s.lng], {icon:Pin, keyboard:false}).bindPopup(popupHTML(s), {autoPan:true});
      cluster.addLayer(m);
      return m;
    });
    try { map.fitBounds(cluster.getBounds().pad(0.2)); } catch(_){}

    // Service chips (from data)
    const allServices = Array.from(new Set(stores.flatMap(s => s.services || [])));
    const activeServices = new Set();
    if (allServices.length){
      allServices.forEach(name => {
        const chip = document.createElement('button');
        chip.className='chip';
        chip.type='button';
        chip.setAttribute('aria-pressed','false');
        chip.textContent = name;
        chip.addEventListener('click', ()=>{
          const on = chip.getAttribute('aria-pressed') === 'true';
          chip.setAttribute('aria-pressed', on ? 'false':'true');
          on ? activeServices.delete(name) : activeServices.add(name);
          render();
        });
        els.chips.appendChild(chip);
      });
    }

    // List render
    function render(items){
      const result = items || applyFilters();
      els.list.innerHTML = result.map(s => cardHTML(s)).join('');
      els.count.textContent = `${result.length} store${result.length!==1?'s':''} shown`;
      // keyboardability: each card focusable
      els.list.querySelectorAll('.chsl__card').forEach((el,idx)=>{
        el.addEventListener('click', ()=>focusStore(+el.dataset.idx));
        el.addEventListener('keydown', (e)=>{
          if (e.key==='Enter' || e.key===' '){ e.preventDefault(); focusStore(+el.dataset.idx); }
          if (e.key==='ArrowDown'){ e.preventDefault(); nextCard(el).focus(); }
          if (e.key==='ArrowUp'){ e.preventDefault(); prevCard(el).focus(); }
        });
      });
    }
    function cardHTML(s){
      const tel = s.phone && s.phone.match(/\d/) ? `<a href="tel:${s.phone.replace(/[^\d+]/g,'')}" aria-label="Call ${s.title}">${s.phone}</a>` : (s.phone||'');
      const addrQ = encodeURIComponent(s.address||`${s.lat},${s.lng}`);
      const svc = (s.services && s.services.length) ? `<div class="chsl__meta">${s.services.join(' • ')}</div>` : '';
      const dist = s._distanceKm!=null ? `<div class="chsl__distance">${s._distanceKm.toFixed(1)} km away</div>` : '';
      return `<div class="chsl__card" role="listitem" tabindex="0" data-idx="${s._idx}" aria-label="${s.title}">
        <h3 class="chsl__title">${s.title}</h3>
        <div class="chsl__meta">${s.address||''}</div>
        <div class="chsl__meta">${tel}</div>
        ${s.hours ? `<div class="chsl__meta">${s.hours}</div>`:''}
        ${svc}${dist}
        <div class="chsl__meta"><a href="https://www.google.com/maps/dir/?api=1&destination=${addrQ}" target="_blank" rel="noopener">Directions</a></div>
      </div>`;
    }
    function popupHTML(s){
      const addrQ = encodeURIComponent(s.address||`${s.lat},${s.lng}`);
      return `<div style="min-width:220px">
        <div style="font-weight:700;margin-bottom:4px">${s.title}</div>
        <div style="font-size:13px;line-height:1.35;white-space:pre-line">${s.address||''}</div>
        ${s.phone?`<div style="font-size:13px;margin-top:4px">${s.phone}</div>`:''}
        ${s.hours?`<div style="font-size:12px;color:#6b7280;margin-top:6px;white-space:pre-line">${s.hours}</div>`:''}
        <div style="margin-top:8px"><a href="https://www.google.com/maps/dir/?api=1&destination=${addrQ}" target="_blank" rel="noopener">Directions</a></div>
      </div>`;
    }

    function focusStore(idx){
      const s = stores[idx]; if (!s) return;
      map.setView([s.lat,s.lng], 16, {animate:true});
      const m = markers[idx]; m && m.openPopup();
      els.list.querySelectorAll('.chsl__card').forEach(n => n.setAttribute('aria-selected','false'));
      const card = els.list.querySelector(`.chsl__card[data-idx="${idx}"]`);
      card && card.setAttribute('aria-selected','true');
    }
    const nextCard = el => el.nextElementSibling || el;
    const prevCard = el => el.previousElementSibling || el;

    // Text search + service filters
    let lastQ = '';
    els.search.addEventListener('input', ()=>{ lastQ = els.search.value.trim().toLowerCase(); render(); });
    els.clear.addEventListener('click', ()=>{ els.search.value=''; lastQ=''; els.search.focus(); render(); });

    function applyFilters(){
      let out = stores.slice();
      if (lastQ){
        out = out.filter(s =>
          (s.title||'').toLowerCase().includes(lastQ) ||
          (s.address||'').toLowerCase().includes(lastQ) ||
          (s.city||'').toLowerCase().includes(lastQ)
        );
      }
      if (activeServices.size){
        out = out.filter(s => (s.services||[]).some(tag => activeServices.has(tag)));
      }
      return out;
    }
    render();

    // Geolocation (client-only)
    els.geo.addEventListener('click', ()=>{
      if (!navigator.geolocation){ els.status.textContent='Geolocation not supported.'; return; }
      els.status.textContent = 'Locating…';
      navigator.geolocation.getCurrentPosition((pos)=>{
        els.status.textContent='';
        const me = {lat:pos.coords.latitude, lng:pos.coords.longitude};
        const you = L.circleMarker([me.lat, me.lng], {radius:6, color:'#1d4ed8'}).addTo(map).bindTooltip('You are here');
        const ranked = applyFilters().map(s => ({...s, _distanceKm: hav(me, {lat:s.lat, lng:s.lng})}))
                                    .sort((a,b)=> (a._distanceKm)-(b._distanceKm));
        render(ranked);
        try { map.fitBounds(L.featureGroup([you, cluster]).getBounds().pad(0.2)); } catch(_){}
      }, ()=>{ els.status.textContent='Could not get your location.'; }, {enableHighAccuracy:true, timeout:10000});
    });

    function hav(a,b){
      const R=6371, dLat=toRad(b.lat-a.lat), dLng=toRad(b.lng-a.lng);
      const p1=toRad(a.lat), p2=toRad(b.lat);
      const h=Math.sin(dLat/2)**2 + Math.cos(p1)*Math.cos(p2)*Math.sin(dLng/2)**2;
      return 2*R*Math.asin(Math.sqrt(h));
    }
    const toRad = d => d*Math.PI/180;
  }
})();
</script>
