    },
    {
      id:'north',
      name:'CameraHaus Plus SM North EDSA',
      address:'5F, Cyberzone Annex',
      city:'Quezon City',
      phones:['(02) 8332-8927','(0998) 969-0655'],
      hours:'Sun–Sat 10:00am–10:00pm',
      schedule: daily('10:00','22:00'),
      coords:{lat:14.657027, lng:121.030479}
    },
    {
      id:'mega',
      name:'CameraHaus Plus Megamall',
      address:'4F, Building B, Cyberzone, SM Megamall',
      city:'Mandaluyong',
      phones:['(02) 8635-6039','(0998) 969-0652'],
      hours:'Monday–Sunday 10:00am–10:00pm',
      schedule: daily('10:00','22:00'),
      coords:{lat:14.585735, lng:121.057037}
    },
    {
      id:'moa',
      name:'CameraHaus Plus SM Mall of Asia',
      address:'2nd Floor, Cyberzone Mall of Asia',
      city:'Pasay',
      phones:['(02) 8889-0795','(0998) 969-0656'],
      hours:'Mon–Fri 11:00am–9:00pm / Sat–Sun 10:00am–10:00pm',
      schedule: mergeSchedules(mon_fri('11:00','21:00'), sat_sun('10:00','22:00')),
      coords:{lat:14.535067, lng:120.982155}
    },
    {
      id:'glorietta2',
      name:'CameraHaus Glorietta 2',
      address:'3F, Ayala Center',
      city:'Makati City',
      phones:['(02) 7625-3756','(0998) 969-0654'],
      hours:'Mon–Thu 10:00am–9:00pm / Sat–Sun 10:00am–10:00pm',
      schedule: mergeSchedules(mw_th('10:00','21:00'), sat_sun('10:00','22:00'), fri('10:00','21:00')),
      coords:{lat:14.5512, lng:121.0260}
    },
    {
      id:'aura',
      name:'CameraHaus Plus SM Aura',
