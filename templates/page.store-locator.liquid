<!-- =============== Store Locator (rev) =============== -->
<section class="locator" id="store-locator" aria-label="Store locator">
  <a class="skip" href="#sl-map">Skip to map</a>
  <a class="skip" href="#sl-list">Skip to store list</a>

  <!-- New top bar + semantic H2 -->
  <div class="catc__top">
    <h2 class="catc__heading">Find a Camerahaus near you</h2>
    <div class="catc__right"></div>
  </div>

  <div class="sl-shell">
    <aside class="rail" aria-label="Store list and controls">
      <!-- Controls -->
      <div class="controls" role="search">
        <div class="control-row">
          <div class="search" role="searchbox">
            <!-- White icon on brand-red chip -->
            <span class="search-icon" aria-hidden="true">
              <svg class="icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                <path d="M10 2a8 8 0 105.3 14.3l4.2 4.2 1.4-1.4-4.2-4.2A8 8 0 0010 2zm0 2a6 6 0 110 12 6 6 0 010-12z"
                      fill="currentColor"/>
              </svg>
            </span>
            <input
              id="sl-search"
              type="search"
              placeholder="Search city, store, or address…"
              autocomplete="off"
            />
            <button id="sl-clear" class="clear" aria-label="Clear search">×</button>
          </div>
        </div>

        <div class="meta">
          <span id="sl-count" class="count">0 results</span>
        </div>
        <p id="sl-a11y-hint" class="assist" role="note">
          Tip: tap a store card to see its pin and details on the map.
        </p>
      </div>

      <!-- Scrollable rail body -->
      <div class="rail-body" aria-describedby="sl-a11y-hint">
        <ul id="sl-list" class="store-list" role="list" aria-label="Store results"></ul>
      </div>

      <!-- Foot removed per request -->
      <!-- <div class="rail-foot"><a class="all" href="/pages/stores">View all stores</a></div> -->
    </aside>

    <div id="sl-map" class="map" role="region" aria-label="Map of store locations"></div>
  </div>
</section>

