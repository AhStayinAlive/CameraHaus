];


  /* ===== Time / Open status helpers ===== */
  const PH_TZ = 'Asia/Manila';
  const daily = (o,c)=>({0:[[o,c]],1:[[o,c]],2:[[o,c]],3:[[o,c]],4:[[o,c]],5:[[o,c]],6:[[o,c]]});
  const mw_th = (o,c)=>({1:[[o,c]],2:[[o,c]],3:[[o,c]],4:[[o,c]]});
  const th_su = (o,c)=>({4:[[o,c]],5:[[o,c]],6:[[o,c]],0:[[o,c]]});
  const mon_wed = (o,c)=>({1:[[o,c]],2:[[o,c]],3:[[o,c]]});
  const fri = (o,c)=>({5:[[o,c]]});
  const sat_sun = (o,c)=>({6:[[o,c]],0:[[o,c]]});
  const mon_fri = (o,c)=>({1:[[o,c]],2:[[o,c]],3:[[o,c]],4:[[o,c]],5:[[o,c]]});
  const mergeSchedules=(...p)=>{const o={0:[],1:[],2:[],3:[],4:[],5:[],6:[]};p.forEach(x=>Object.keys(x).forEach(d=>o[d].push(...x[d])));for(let d=0;d<7;d++){if(!o[d])o[d]=[]}return o;}
  const toMinutes=t=>{const [h,m]=t.split(':').map(Number);return h*60+(m||0);}
  const phNow=()=>{const fmt=new Intl.DateTimeFormat('en-CA',{timeZone:PH_TZ,hour12:false,year:'numeric',month:'2-digit',day:'2-digit',hour:'2-digit',minute:'2-digit',second:'2-digit'});const parts=fmt.formatToParts(new Date());const g=t=>Number(parts.find(p=>p.type===t).value);return new Date(g('year'),g('month')-1,g('day'),g('hour'),g('minute'),g('second'));}
  const isOpenNow=s=>{const n=phNow(),d=n.getDay(),m=n.getHours()*60+n.getMinutes(),r=(s&&s[d])||[];return r.some(([o,c])=>{const O=toMinutes(o),C=toMinutes(c);return m>=O&&m<=C;});}

