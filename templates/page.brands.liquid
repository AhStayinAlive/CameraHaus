    {% assign sorted_rows = brand_rows | sort %}

    <div class="groups" id="brand-groups">
      {% assign current_letter = '' %}
      {% for row in sorted_rows %}
        {% assign parts = row | strip | split: "|" %}
        {% assign nm = parts[0] | strip %}
        {% assign file = parts[1] | strip %}
        {% assign q = parts[2] | strip %}
        {% assign letter = nm | slice: 0, 1 | upcase %}
        {% if letter contains '0' or letter contains '1' or letter contains '2' or letter contains '3' or letter contains '4' or letter contains '5' or letter contains '6' or letter contains '7' or letter contains '8' or letter contains '9' %}
          {% assign letter = '#' %}
        {% endif %}

        {% if letter != current_letter %}
          {% unless forloop.first %}</div></div>{% endunless %}
          <div class="group" data-letter="{{ letter }}">
            <h2 class="group-title" id="group-{{ letter }}">{{ letter }}</h2>
            <div class="ch-grid">
          {% assign current_letter = letter %}
        {% endif %}

{% if LINK_MODE == 'collection' %}
  {% assign href = '/collections/all?filter.p.vendor=' | append: nm | url_param_escape %}
{% else %}
  {%- comment -%} Build vendor:"..." OR vendor:"..." then encode ONLY the q param {%- endcomment -%}
  {% assign vendor_terms = q | split: ' OR ' %}
  {% capture vendor_query %}
    {%- for term in vendor_terms -%}
      {%- assign v = term | strip | remove: 'vendor:' | strip -%}
      {%- if forloop.first == false -%} OR {%- endif -%}vendor:"{{ v }}"
    {%- endfor -%}
  {% endcapture %}
  {% assign encoded_q = vendor_query | strip | url_param_escape %}
  {% assign href = '/search?type=product&q=' | append: encoded_q | append: '&sort_by=best-selling' %}
{% endif %}



        <a class="tile" data-name="{{ nm | downcase }}" data-letter="{{ letter }}" href="{{ href }}">
          {% assign src = file | file_url %}
          {% if src contains 'files' %}
            <img loading="lazy" src="{{ src }}" width="160" height="54" alt="{{ nm | escape }}">
          {% else %}
            <span class="fallback">{{ nm }}</span>
          {% endif %}
        </a>

        {% if forloop.last %}</div></div>{% endif %}
      {% endfor %}
    </div>

    <p class="empty-msg is-hidden" id="brand-empty-{{ section.id }}">No brands match your filters.</p>
  </div><script>
(function(){
  const root = document.getElementById('ch-brands-{{ section.id }}');
  if (!root) return;

  const searchInput = root.querySelector('#brand-search-{{ section.id }}');
  const clearBtn = root.querySelector('.clear-btn');
function updateClearBtn(){
  if (!clearBtn) return;
  const hasValue = !!(searchInput && searchInput.value);
  clearBtn.hidden = !hasValue;
}

  let groups = Array.from(root.querySelectorAll('.group'));
  const tiles  = Array.from(root.querySelectorAll('.tile'));
  const emptyMsg = root.querySelector('#brand-empty-{{ section.id }}');

  /* Merge any duplicate groups that share the same data-letter (fixes split "A") */
  (function dedupeGroups(){
    const map = new Map();
    groups.forEach(g => {
      const L = g.dataset.letter;
      if (map.has(L)) {
        const targetGrid = map.get(L).querySelector('.ch-grid');
        g.querySelectorAll('.tile').forEach(t => targetGrid.appendChild(t));
        g.remove();
      } else {
        map.set(L, g);
      }
    });
    groups = Array.from(root.querySelectorAll('.group'));
  })();

  /* Build the letter availability, but do NOT remove buttons (we hide chips on mobile anyway) */
  const lettersWithBrands = new Set(tiles.map(t => t.dataset.letter));
  Array.from(root.querySelectorAll('.az-btn')).forEach(btn => {
    const L = btn.dataset.letter;
    if (L !== 'All' && !lettersWithBrands.has(L)) {
      btn.classList.add('is-disabled');
      btn.setAttribute('aria-disabled','true');
    }
  });

  let activeLetter = 'All';
  let query = '';

  function applyFilters(){
    const q = (query || '').trim().toLowerCase();
    let anyVisible = false;
    let appearIndex = 0;

    tiles.forEach(t => {
      const name = t.dataset.name;
      const L = t.dataset.letter;
      const matchesSearch = !q || name.includes(q);
      const matchesLetter = (activeLetter === 'All') ? true : (L === activeLetter);
      const show = matchesSearch && matchesLetter;
      const wasHidden = t.classList.contains('is-hidden');

      if (show) {
        if (wasHidden) {
          t.classList.remove('is-hidden');
          t.style.setProperty('--i', appearIndex++);
          t.classList.add('fade-in');
          setTimeout(() => t.classList.remove('fade-in'), 320);
        }
      } else {
        t.classList.add('is-hidden');
      }
    });

    groups.forEach(g => {
      const visibleTiles = g.querySelectorAll('.tile:not(.is-hidden)');
      const show = visibleTiles.length > 0;
      g.classList.toggle('is-hidden', !show);
      if (show) anyVisible = true;
    });

    emptyMsg.classList.toggle('is-hidden', anyVisible);
  }

  function setActiveLetter(letter){
    activeLetter = letter;
    root.querySelectorAll('.az-btn').forEach(b =>
      b.setAttribute('aria-current', b.dataset.letter === letter ? 'true' : 'false')
    );
    applyFilters();
    updateClearBtn();
    /* no auto-scroll */
  }

  if (searchInput) {
    searchInput.addEventListener('input', (e) => {
      query = e.target.value || '';
      applyFilters();
      updateClearBtn();
    });
  }
  if (clearBtn) {
    clearBtn.addEventListener('click', () => {
      if (!searchInput) return;
      searchInput.value = '';
      query = '';
      applyFilters();
      updateClearBtn();
      searchInput.focus();
    });
  }

  root.addEventListener('click', (e) => {
    const btn = e.target.closest('.az-btn');
    if (!btn || btn.classList.contains('is-disabled')) return;
    e.preventDefault();
    setActiveLetter(btn.dataset.letter);
  });

  applyFilters();
})();
</script>
