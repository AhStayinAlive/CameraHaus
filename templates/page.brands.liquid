{% comment %}
  Section: brands-index-tiles-a2z
{% endcomment %}

{% assign LINK_MODE = 'search' %}

<section id="ch-brands-{{ section.id }}" class="ch-brands" data-section-id="{{ section.id }}">
  <style>
    #ch-brands-{{ section.id }}{
      --panel:#fff; --ink:#111; --muted:#6B7280; --line:rgba(17,17,17,.12);
      --radius:14px; --shadow:0 10px 30px rgba(17,17,17,.06); --gap:20px;
      --sticky-top: 80px;
      scroll-behavior:smooth;
    }
    #ch-brands-{{ section.id }} *,#ch-brands-{{ section.id }} *::before,#ch-brands-{{ section.id }} *::after{
      box-sizing:border-box; font-family:var(--font-sans);
    }

    /* Header */
    #ch-brands-{{ section.id }} .ch-header{ margin:34px 0 0; }
    #ch-brands-{{ section.id }} .ch-title{ margin:0 0 10px; line-height:1.12; letter-spacing:-.02em; font-weight:900; }
    /* push description so search won't overlap */
    #ch-brands-{{ section.id }} .ch-sub{
      margin:0 0 1.25rem;
      color:var(--ink);
      opacity:.9;
      position:relative;
      z-index:1;
    }

    /* Search + A–Z controls */
    #ch-brands-{{ section.id }} .ch-controls{
      display:flex; flex-direction:column; gap:14px;
      margin:0 0 24px;
      position:relative;
      z-index:2;
    }

    #ch-brands-{{ section.id }} .brand-search{ position:relative; max-width:560px; }
    #ch-brands-{{ section.id }} .brand-search input{
      width:100%; border:1px solid var(--line); border-radius:12px; padding:12px 40px 12px 40px;
      font-size:14px; line-height:1.3; background:#fff;
    }
    #ch-brands-{{ section.id }} .brand-search svg{ position:absolute; left:12px; top:50%; transform:translateY(-50%); pointer-events:none; }

    #ch-brands-{{ section.id }} .ch-az-wrap{
      position:sticky; top:var(--sticky-top); background:#fff; z-index:10;
      padding:8px 0 12px; border-bottom:1px solid var(--line);
    }
    #ch-brands-{{ section.id }} .ch-az{ display:flex; flex-wrap:wrap; gap:8px; }
    #ch-brands-{{ section.id }} .az-btn{
      border:1px solid var(--line); background:#fff; color:var(--ink);
      border-radius:10px; padding:8px 12px; font-size:14px; line-height:1; cursor:pointer;
      transition:background .15s, transform .15s;
    }
    #ch-brands-{{ section.id }} .az-btn:hover{ transform:translateY(-1px); }
    #ch-brands-{{ section.id }} .az-btn[aria-current="true"]{ background:#F6F7F8; font-weight:700; }
    #ch-brands-{{ section.id }} .az-btn:focus-visible{ outline:0; box-shadow:0 0 0 3px rgba(32,94,214,.35); }

    /* Groups */
    #ch-brands-{{ section.id }} .groups{ display:block; }
    #ch-brands-{{ section.id }} .group{ padding:22px 0 10px; }
    #ch-brands-{{ section.id }} .group + .group{ border-top:1px solid var(--line); }
    #ch-brands-{{ section.id }} .group-title{
      margin:0 0 16px; font-size:18px; font-weight:800; letter-spacing:.08em;
      text-transform:uppercase; color:var(--muted);
      scroll-margin-top: calc(var(--sticky-top) + 14px);
    }

    /* Tiles */
    #ch-brands-{{ section.id }} .ch-grid{ display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:var(--gap); }
    @media (min-width:750px){ #ch-brands-{{ section.id }} .ch-grid{ grid-template-columns:repeat(4,minmax(0,1fr)); } }
    @media (min-width:1100px){ #ch-brands-{{ section.id }} .ch-grid{ grid-template-columns:repeat(6,minmax(0,1fr)); } }

    #ch-brands-{{ section.id }} .tile{
      position:relative;
      display:flex; align-items:center; justify-content:center; text-align:center; min-height:112px;
      background:linear-gradient(180deg, #fff 0%, #fafafa 100%);
      border:1px solid var(--line); border-radius:16px; padding:18px; box-shadow:var(--shadow);
      text-decoration:none; color:var(--ink);
      transition:transform .18s ease, box-shadow .18s ease, border-color .18s ease;
      overflow:hidden;
    }
    #ch-brands-{{ section.id }} .tile:hover{
      transform:translateY(-2px); border-color:rgba(17,17,17,.22);
      box-shadow:0 12px 36px rgba(17,17,17,.10);
    }
    #ch-brands-{{ section.id }} .tile:focus-visible{ outline:0; box-shadow:0 0 0 3px rgba(32,94,214,.35); }
    #ch-brands-{{ section.id }} .tile img{ max-width:100%; max-height:54px; width:auto; height:auto; object-fit:contain; }
    #ch-brands-{{ section.id }} .tile .fallback{ font-weight:700; letter-spacing:.02em; }

    /* hover name */
    #ch-brands-{{ section.id }} .tile::after {
      content: attr(data-name);
      position: absolute;
      left: 10px;
      right: 10px;
      bottom: 10px;
      background: rgba(17,17,17,.85);
      color: #fff;
      font-size: 12px;
      line-height: 1.2;
      text-align: center;
      border-radius: 999px;
      padding: 4px 8px;
      opacity: 0;
      transform: translateY(6px);
      transition: opacity .15s ease, transform .15s ease;
      text-transform: capitalize;
      pointer-events: none;
    }
    #ch-brands-{{ section.id }} .tile:hover::after,
    #ch-brands-{{ section.id }} .tile:focus-visible::after {
      opacity: 1;
      transform: translateY(0);
    }

    /* Utilities */
    #ch-brands-{{ section.id }} .is-hidden{ display:none !important; }
    #ch-brands-{{ section.id }} .empty-msg{ margin:14px 0 0; color:var(--muted); font-size:14px; }

    /* mobile tweaks */
    @media (max-width: 749px) {
      #ch-brands-{{ section.id }} .ch-controls { gap:10px; }
      /* on mobile: no sticky, show all letters (wrap) */
      #ch-brands-{{ section.id }} .ch-az-wrap {
        position: static;
        border-bottom:0;
        padding-bottom:0;
      }
      #ch-brands-{{ section.id }} .ch-az {
        flex-wrap: wrap;
        gap: 8px;
      }
      #ch-brands-{{ section.id }} .az-btn { white-space: nowrap; }
      #ch-brands-{{ section.id }} .ch-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap:14px; }
      #ch-brands-{{ section.id }} .tile { min-height:96px; }
      #ch-brands-{{ section.id }} .ch-header { margin-bottom:.5rem; }
    }

    /* guard for Judge.me rogue close button */
    .jdgm-modal.jdgm-hidden,
    .jdgm-modal[aria-hidden="true"]{ display:none !important; }
    
  </style>
  
<style>
  #ch-brands-{{ section.id }}{
    --panel:#fff; --ink:#111; --muted:#6B7280; --line:rgba(17,17,17,.12);
    --radius:14px; --shadow:0 10px 30px rgba(17,17,17,.06); --gap:20px;
    --sticky-top: 80px;
    --accent:#b5281f;            /* active */
    --accent-hover:#d12f24;      /* hover */
    scroll-behavior:smooth;
  }

  /* A–Z chips */
  #ch-brands-{{ section.id }} .ch-az{ display:flex; flex-wrap:wrap; gap:8px; }
  #ch-brands-{{ section.id }} .az-btn{
    border:1px solid var(--line);
    background:#fff; color:var(--ink);
    border-radius:999px; padding:10px 14px;
    font-size:14px; line-height:1; font-weight:700;
    cursor:pointer; transition:background .15s, color .15s, border-color .15s, transform .1s;
    box-shadow:0 1px 2px rgba(17,17,17,.06);
  }
  #ch-brands-{{ section.id }} .az-btn:hover{
    background:var(--accent-hover); color:#fff; border-color:var(--accent-hover);
  }
  #ch-brands-{{ section.id }} .az-btn[aria-current="true"]{
    background:var(--accent); color:#fff; border-color:var(--accent);
  }
  #ch-brands-{{ section.id }} .az-btn:active{ transform:scale(.98); }
  #ch-brands-{{ section.id }} .az-btn:focus-visible{ outline:0; box-shadow:0 0 0 3px rgba(181,40,31,.35); }

  /* Tiles: subtle press + enable appearance animation */
  #ch-brands-{{ section.id }} .tile{
    position:relative; display:flex; align-items:center; justify-content:center; text-align:center; min-height:112px;
    background:linear-gradient(180deg, #fff 0%, #fafafa 100%);
    border:1px solid var(--line); border-radius:16px; padding:18px; box-shadow:var(--shadow);
    text-decoration:none; color:var(--ink);
    transition:transform .18s ease, box-shadow .18s ease, border-color .18s ease, opacity .18s ease;
    overflow:hidden;
  }
  #ch-brands-{{ section.id }} .tile:active{ transform:translateY(0) scale(.98); }

  /* Fade-up animation for “appearing” tiles (after search/filter) */
  @keyframes chFadeUp {
    from { opacity:0; transform:translateY(8px) }
    to   { opacity:1; transform:translateY(0) }
  }
  #ch-brands-{{ section.id }} .tile.fade-in {
    animation: chFadeUp .26s ease both;
    animation-delay: calc(var(--i, 0) * 12ms); /* gentle stagger */
  }
  @media (prefers-reduced-motion: reduce) {
    #ch-brands-{{ section.id }} .tile.fade-in { animation: none; }
  }

  /* Mobile polish for the A–Z list */
  @media (max-width: 749px) {
    #ch-brands-{{ section.id }} .ch-az-wrap {
      position: static; border-bottom:0; padding-bottom:0;
      overflow-x:auto; -webkit-overflow-scrolling:touch;
      scrollbar-width:none;
    }
    #ch-brands-{{ section.id }} .ch-az-wrap::-webkit-scrollbar{ display:none; }
    #ch-brands-{{ section.id }} .ch-az { flex-wrap:nowrap; gap:10px; }
    #ch-brands-{{ section.id }} .az-btn { flex:0 0 auto; padding:10px 16px; font-size:15px; }
    #ch-brands-{{ section.id }} .ch-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap:14px; }
    #ch-brands-{{ section.id }} .tile { min-height:96px; }
    #ch-brands-{{ section.id }} .ch-header { margin-bottom:.5rem; }
  }
  /* --- MOBILE A–Z STRIP: make it truly scrollable --- */
@media (max-width: 749px) {
  #ch-brands-{{ section.id }} .ch-az-wrap {
    position: static;
    border-bottom: 0;
    padding: 0 8px;
    overflow-x: auto;                    /* enable horizontal scroll */
    -webkit-overflow-scrolling: touch;   /* momentum scroll on iOS */
    touch-action: pan-x;                 /* prefer horizontal pan */
    overscroll-behavior-x: contain;      /* prevent page from hijacking */
  }
  #ch-brands-{{ section.id }} .ch-az {
    display: inline-flex;        /* key: lets container take content width */
    flex-wrap: nowrap;           /* single row */
    gap: 10px;
    min-width: max-content;      /* key: expand to fit all chips */
  }
  /* optional: visible scrollbar on Android; hide on iOS if you like
  #ch-brands-{{ section.id }} .ch-az-wrap::-webkit-scrollbar { display:none; }
  */

  /* keep the rest of your existing mobile tile/grid tweaks */
  #ch-brands-{{ section.id }} .az-btn { flex: 0 0 auto; padding:10px 16px; font-size:15px; }
  #ch-brands-{{ section.id }} .ch-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap:14px; }
  #ch-brands-{{ section.id }} .tile { min-height:96px; }
  #ch-brands-{{ section.id }} .ch-header { margin-bottom:.5rem; }
}

/* Disabled letters (if you choose to disable instead of remove) */
#ch-brands-{{ section.id }} .az-btn.is-disabled {
  opacity:.4; pointer-events:none;
}
/* Accent colors */
#ch-brands-{{ section.id }}{ --accent:#b5281f; --accent-hover:#d12f24; }

/* Search: red icon pill + white glyph */
#ch-brands-{{ section.id }} .brand-search { position:relative; max-width:560px; }
#ch-brands-{{ section.id }} .brand-search input{
  width:100%; border:1px solid var(--line); border-radius:12px;
  padding:12px 40px 12px 56px;  /* more left room for pill */
  font-size:14px; background:#fff;
}
#ch-brands-{{ section.id }} .brand-search svg{
  position:absolute; left:8px; top:50%; transform:translateY(-50%);
  width:34px; height:34px; padding:8px; border-radius:10px;
  background:var(--accent); pointer-events:none;
}
#ch-brands-{{ section.id }} .brand-search svg path{ stroke:#fff !important; }

/* A–Z chips (desktop look unchanged) */
#ch-brands-{{ section.id }} .az-btn{
  border:1px solid var(--line); background:#fff; color:var(--ink);
  border-radius:999px; padding:10px 14px; font-weight:700; line-height:1;
  transition:background .15s, color .15s, border-color .15s, transform .1s;
  box-shadow:0 1px 2px rgba(17,17,17,.06);
}
#ch-brands-{{ section.id }} .az-btn:hover{
  background:var(--accent-hover); color:#fff; border-color:var(--accent-hover);
}
#ch-brands-{{ section.id }} .az-btn[aria-current="true"]{
  background:var(--accent); color:#fff; border-color:var(--accent);
}

/* Hide the A–Z chips on mobile entirely */
@media (max-width: 749px){
  #ch-brands-{{ section.id }} .ch-az-wrap{ display:none; }
}

/* Fade-up animation for appearing tiles (kept) */
@keyframes chFadeUp { from{opacity:0; transform:translateY(8px)} to{opacity:1; transform:translateY(0)} }
#ch-brands-{{ section.id }} .tile.fade-in{
  animation: chFadeUp .26s ease both;
  animation-delay: calc(var(--i, 0) * 12ms);
}
@media (prefers-reduced-motion: reduce){
  #ch-brands-{{ section.id }} .tile.fade-in{ animation:none; }
}
/* === Match Store Locator header === */
#ch-brands-{{ section.id }}{ --ink-strong:#2b2f36; }  /* blackish grey */

#ch-brands-{{ section.id }} .ch-header{
  display:flex;
  align-items:flex-end;
  justify-content:space-between;
  gap:16px;
  padding:8px 0 10px;
  border-bottom:1px solid var(--line);
  margin:0 0 16px;
}

#ch-brands-{{ section.id }} .ch-title{
  font-size:clamp(24px, 2.4vw + 8px, 34px);
  font-weight: var(--font-heading-weight, 600);
  letter-spacing:-0.01em;
  line-height:1.1;
  margin:0;
  color: var(--heading-color, var(--ink-strong, #2b2f36));
}



#ch-brands-{{ section.id }} .ch-sub{
  margin:.35rem 0 0;
  color:var(--muted);
  font-weight:400;
}
#ch-brands-{{ section.id }} .tile::after {
  content: attr(data-name);
  position: absolute;
  left: 10px; right: 10px; bottom: 10px;
  background: var(--accent);         /* #b5281f */
  color: #fff;                       /* white text */
  font-size: 12px; line-height: 1.2; text-align: center;
  border-radius: 999px; padding: 4px 8px;
  opacity: 0; transform: translateY(6px);
  transition: opacity .15s ease, transform .15s ease;
  text-transform: capitalize; pointer-events: none;
  box-shadow: 0 2px 8px rgba(181,40,31,.25);
}
/* kill native search cancel buttons so we can style our own */
#ch-brands-{{ section.id }} .brand-search input::-webkit-search-cancel-button,
#ch-brands-{{ section.id }} .brand-search input::-webkit-search-decoration,
#ch-brands-{{ section.id }} .brand-search input::-webkit-search-results-button,
#ch-brands-{{ section.id }} .brand-search input::-webkit-search-results-decoration { display:none; }
#ch-brands-{{ section.id }} .brand-search input::-ms-clear { display:none; width:0; height:0; }
#ch-brands-{{ section.id }} .brand-search { position:relative; }
#ch-brands-{{ section.id }} .clear-btn{
  position:absolute; right:8px; top:50%; transform:translateY(-50%);
  width:32px; height:32px; border:0; border-radius:8px;
  background:#F3F4F6; /* light gray pill */
  display:grid; place-items:center; cursor:pointer;
}
#ch-brands-{{ section.id }} .clear-btn:hover{ background:#E5E7EB; }
#ch-brands-{{ section.id }} .clear-btn:focus-visible{ outline:0; box-shadow:0 0 0 3px rgba(107,114,128,.35); }
/* SEARCH: tidy focus + extra right padding for the X */
#ch-brands-{{ section.id }} .brand-search input{
  padding-left: 56px;          /* room for red search pill */
  padding-right: 56px;         /* room for clear button */
  border:1px solid var(--line);
  border-radius:12px;
  outline: none;               /* remove default black outline */
  box-shadow:none;
}
#ch-brands-{{ section.id }} .brand-search input:focus,
#ch-brands-{{ section.id }} .brand-search input:focus-visible{
  outline: none;
  border-color: var(--accent);
  box-shadow: 0 0 0 3px rgba(181,40,31,.15); /* subtle, not black */
}

/* Custom gray clear button, positioned further INSIDE the field */
#ch-brands-{{ section.id }} .clear-btn{
  position:absolute; right:10px; top:50%; transform:translateY(-50%);
  width:34px; height:34px; border:0; border-radius:10px;
  display:grid; place-items:center; cursor:pointer;
  box-shadow:none;
}
#ch-brands-{{ section.id }} .clear-btn:hover{ background:#E5E7EB; }
#ch-brands-{{ section.id }} .clear-btn svg path{ stroke:#6B7280; }  /* gray X */
#ch-brands-{{ section.id }} .brand-search svg{
  position:absolute; left:8px; top:50%; transform:translateY(-50%);
  width:34px; height:34px; padding:8px; border-radius:10px;
  background:var(--accent);
}
#ch-brands-{{ section.id }} .brand-search svg path{ stroke:#fff !important; }
#ch-brands-{{ section.id }} .ch-header{ display:block; }
#ch-brands-{{ section.id }} .ch-title{
  display:block;
  margin:34px 0 6px;
  /* no color here so it inherits from the rule above */
}

#ch-brands-{{ section.id }} .ch-sub{
  display:block; clear:both;    /* forces it under the title even if theme uses flex */
  margin:0 0 1.25rem; color:var(--ink); opacity:.9;
}

</style>

  <div class="page-width">
    <header class="ch-header">
      <h1 class="ch-title">{{ section.settings.heading | default: 'Brand list' }}</h1>
      <p class="ch-sub">{{ section.settings.subheading | default: 'Camerahaus official brand partners since 1980.' }}</p>
    </header>

    <div class="ch-controls">
      <!-- Search -->
      <div class="brand-search" role="search">
        <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true"><path d="M21 21l-4.2-4.2M10.5 18a7.5 7.5 0 1 1 0-15 7.5 7.5 0 0 1 0 15z" stroke="#6B7280" stroke-width="2" fill="none" stroke-linecap="round"/></svg>
        <input id="brand-search-{{ section.id }}" type="search" placeholder="Search brands…" aria-label="Search brands">
        <button type="button" class="clear-btn" aria-label="Clear search" hidden>
  <svg width="16" height="16" viewBox="0 0 24 24" aria-hidden="true">
    <path d="M6 6l12 12M18 6L6 18" stroke="#6B7280" stroke-width="2" stroke-linecap="round"/>
  </svg>
</button>

      </div>

      <!-- A–Z filter -->
      <div class="ch-az-wrap">
        <nav class="ch-az" aria-label="Filter by letter">
