  {%- when 'pavilion' -%}
  <svg viewBox="0 0 24 24" width="{{ s }}" height="{{ s }}" fill="none"
       stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M0 0h24v24H0z" fill="none" stroke="none"/>
    <path d="M3 21h7v-3a2 2 0 0 1 4 0v3h7"/>
    <path d="M6 21l0 -9"/><path d="M18 21l0 -9"/>
    <path d="M6 12h12a3 3 0 0 0 3 -3a9 8 0 0 1 -9 -6a9 8 0 0 1 -9 6a3 3 0 0 0 3 3"/>
  </svg>

  {%- when 'ticket' -%}
  <svg viewBox="0 0 24 24" width="{{ s }}" height="{{ s }}" fill="none"
       stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M16.5 6v.75m0 3v.75m0 3v.75m0 3V18m-9-5.25h5.25M7.5 15h3M3.375 5.25c-.621 0-1.125.504-1.125 1.125v3.026a2.999 2.999 0 0 1 0 5.198v3.026c0 .621.504 1.125 1.125 1.125h17.25c.621 0 1.125-.504 1.125-1.125v-3.026a2.999 2.999 0 0 1 0-5.198V6.375c0-.621-.504-1.125-1.125-1.125H3.375Z"/>
  </svg>

  {%- when 'tag' -%}
  <svg viewBox="0 0 24 24" width="{{ s }}" height="{{ s }}" fill="none"
       stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M12.586 2.586A2 2 0 0 0 11.172 2H4a2 2 0 0 0-2 2v7.172a2 2 0 0 0 .586 1.414l8.704 8.704a2.426 2.426 0 0 0 3.42 0l6.58-6.58a2.426 2.426 0 0 0 0-3.42z"/>
    <circle cx="7.5" cy="7.5" r=".5" fill="currentColor"/>
  </svg>

  {%- when 'headset' -%}
  <svg viewBox="0 0 24 24" width="{{ s }}" height="{{ s }}" fill="none"
       stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M0 0h24v24H0z" fill="none" stroke="none"/>
    <path d="M4 14v-3a8 8 0 1 1 16 0v3"/>
    <path d="M18 19c0 1.657 -2.686 3 -6 3"/>
    <path d="M4 14a2 2 0 0 1 2 -2h1a2 2 0 0 1 2 2v3a2 2 0 0 1 -2 2h-1a2 2 0 0 1 -2 -2v-3z"/>
    <path d="M15 14a2 2 0 0 1 2 -2h1a2 2 0 0 1 2 2v3a2 2 0 0 1 -2 2h-1a2 2 0 0 1 -2 -2v-3z"/>
  </svg>

  {%- when 'package-import' -%}
  <svg viewBox="0 0 24 24" width="{{ s }}" height="{{ s }}" fill="none"
       stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M0 0h24v24H0z" fill="none" stroke="none"/>
    <path d="M12 21l-8 -4.5v-9l8 -4.5l8 4.5v4.5"/><path d="M12 12l8 -4.5"/><path d="M12 12v9"/><path d="M12 12l-8 -4.5"/>
    <path d="M22 18h-7"/><path d="M18 15l-3 3l3 3"/>
  </svg>

  {%- else -%}
  <svg viewBox="0 0 24 24" width="{{ s }}" height="{{ s }}" fill="currentColor" aria-hidden="true"><circle cx="12" cy="12" r="10"/></svg>
{%- endcase -%}
