<script>
(() => {
  const $$ = (s,sc=document)=>Array.from(sc.querySelectorAll(s));
  const  $ = (s,sc=document)=>sc.querySelector(s);

  const PANELS = new Map();
  $$('.ch-panel').forEach(p => PANELS.set(p.getAttribute('data-ch-panel'), p));

  let lastFocus = null;

  function focusTrap(panel, enable){
    if(!panel) return;
    const pn = panel.querySelector('.ch-panel__pn');
    const FOCUSABLE = 'a,button,input,select,textarea,[tabindex]:not([tabindex="-1"])';
    function trap(e){
      if(e.key !== 'Tab') return;
      const nodes = $$(FOCUSABLE, pn).filter(x => x.offsetParent !== null);
      if(!nodes.length) return;
      const first = nodes[0], last = nodes[nodes.length-1];
      if(e.shiftKey && document.activeElement === first){ e.preventDefault(); last.focus(); }
      else if(!e.shiftKey && document.activeElement === last){ e.preventDefault(); first.focus(); }
    }
    panel.__trap = trap;
    (enable?document.addEventListener:document.removeEventListener)('keydown', trap, true);
  }

  function setOpen(id, open){
    const panel = PANELS.get(id); if(!panel) return;

    // close others
    PANELS.forEach((p, key)=>{ if(key!==id){ p.classList.remove('is-open'); p.setAttribute('aria-hidden','true'); focusTrap(p,false); } });

    panel.classList.toggle('is-open', !!open);
    panel.setAttribute('aria-hidden', open ? 'false' : 'true');
    document.documentElement.style.overflow = open ? 'hidden' : '';
    if(open){
      lastFocus = document.activeElement;
      setTimeout(()=> {
        const first = panel.querySelector('button, a, input, [tabindex]:not([tabindex="-1"])');
        try{ (first||panel.querySelector('.ch-panel__pn')).focus(); }catch(_){}
      }, 10);
      focusTrap(panel,true);
    }else{
      focusTrap(panel,false);
      if(lastFocus){ try{ lastFocus.focus(); }catch(_){ } }
    }
    document.dispatchEvent(new CustomEvent('ch:panel', { detail:{ name:id, open:!!open } }));
  }

  const open  = id => setOpen(id, true);
  const close = id => setOpen(id, false);

  // Delegated triggers
  document.addEventListener('click', (e)=>{
    const t = e.target.closest('[data-panel-open]');
    if(t){ e.preventDefault(); open(t.getAttribute('data-panel-open')); }

    if(e.target.closest('[data-ch-panel-close]')){
      const shell = e.target.closest('.ch-panel');
      if(shell) close(shell.getAttribute('data-ch-panel'));
    }

    if(e.target.classList.contains('ch-panel__ov')){
      const shell = e.target.closest('.ch-panel');
      if(shell) close(shell.getAttribute('data-ch-panel'));
    }

    // close when clicking a link that navigates
    const link = e.target.closest('.ch-panel a[href]');
    if(link && !link.getAttribute('href').startsWith('#')){
      const shell = link.closest('.ch-panel');
      if(shell) close(shell.getAttribute('data-ch-panel'));
    }
  }, true);

  document.addEventListener('keydown', e => { if(e.key==='Escape'){ PANELS.forEach((_, id)=>close(id)); } }, true);

  // Bridge common theme events to open Cart
  ['cart:open','cart-drawer:open','ajaxcart:open','cart:drawer:open','open-mini-cart']
    .forEach(ev => document.addEventListener(ev, ()=> open('cart'), { passive:true }));

  // Bridge legacy header buttons (no header CSS changes needed)
  document.addEventListener('click', (e)=>{
    if(e.target.closest('[data-open-search]')){ e.preventDefault(); open('search'); }
    if(e.target.closest('[data-cart]')){ e.preventDefault(); open('cart'); }
  }, true);

  // Expose minimal API if needed
  window.CHPanels = { open, close };
})();
</script>
