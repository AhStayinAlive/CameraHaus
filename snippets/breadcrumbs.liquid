{%- comment -%}
Breadcrumbs — HAVIT-style full-bleed gray bar
Usage: {% render 'breadcrumbs', menu: 'main-menu' %}
{%- endcomment -%}

{%- if request.page_type != 'index' -%}
{%- assign menu_handle = menu | default: 'main-menu' -%}
{%- assign nav = linklists[menu_handle] -%}

{%- assign current_collection = nil -%}
{%- if request.page_type == 'product' -%}
  {%- assign current_collection = collection -%}
  {%- if current_collection == nil and product and product.collections.size > 0 -%}
    {%- assign current_collection = product.collections.first -%}
  {%- endif -%}
{%- endif -%}

{%- assign p1_t = '' -%}{%- assign p1_u = '' -%}
{%- assign p2_t = '' -%}{%- assign p2_u = '' -%}
{%- assign p3_t = '' -%}{%- assign p3_u = '' -%}
{%- assign leaf_t = '' -%}{%- assign leaf_u = '' -%}

{%- assign target_url = '' -%}
{%- if request.page_type == 'collection' and collection -%}
  {%- assign target_url = collection.url -%}
{%- elsif request.page_type == 'product' and current_collection -%}
  {%- assign target_url = current_collection.url -%}
{%- endif -%}

{%- if nav and target_url != '' -%}
  {%- assign found = false -%}
  {%- for l1 in nav.links -%}
    {%- if l1.url == target_url -%}
      {%- assign leaf_t = l1.title -%}{%- assign leaf_u = l1.url -%}{%- assign found = true -%}{%- break -%}
    {%- endif -%}
    {%- for l2 in l1.links -%}
      {%- if l2.url == target_url -%}
        {%- assign p1_t = l1.title -%}{%- assign p1_u = l1.url -%}
        {%- assign leaf_t = l2.title -%}{%- assign leaf_u = l2.url -%}{%- assign found = true -%}{%- break -%}
      {%- endif -%}
      {%- for l3 in l2.links -%}
        {%- if l3.url == target_url -%}
          {%- assign p1_t = l1.title -%}{%- assign p1_u = l1.url -%}
          {%- assign p2_t = l2.title -%}{%- assign p2_u = l2.url -%}
          {%- assign leaf_t = l3.title -%}{%- assign leaf_u = l3.url -%}{%- assign found = true -%}{%- break -%}
        {%- endif -%}
        {%- for l4 in l3.links -%}
          {%- if l4.url == target_url -%}
            {%- assign p1_t = l1.title -%}{%- assign p1_u = l1.url -%}
            {%- assign p2_t = l2.title -%}{%- assign p2_u = l2.url -%}
            {%- assign p3_t = l3.title -%}{%- assign p3_u = l3.url -%}
            {%- assign leaf_t = l4.title -%}{%- assign leaf_u = l4.url -%}{%- assign found = true -%}{%- break -%}
          {%- endif -%}
        {%- endfor -%}
        {%- if found -%}{%- break -%}{%- endif -%}
      {%- endfor -%}
      {%- if found -%}{%- break -%}{%- endif -%}
    {%- endfor -%}
    {%- if found -%}{%- break -%}{%- endif -%}
  {%- endfor -%}
{%- endif -%}

<nav class="hv-bc" role="navigation" aria-label="Breadcrumbs">
  <div class="hv-bc__inner">
    <ol class="hv-bc__list">
      <li class="hv-bc__item"><a class="hv-bc__link" href="{{ routes.root_url }}">Home</a></li>

      {%- if request.page_type == 'collection' and collection -%}
        {%- if p1_t != '' -%}<li class="hv-bc__item"><a class="hv-bc__link" href="{{ p1_u }}">{{ p1_t }}</a></li>{%- endif -%}
        {%- if p2_t != '' -%}<li class="hv-bc__item"><a class="hv-bc__link" href="{{ p2_u }}">{{ p2_t }}</a></li>{%- endif -%}
        {%- if p3_t != '' -%}<li class="hv-bc__item"><a class="hv-bc__link" href="{{ p3_u }}">{{ p3_t }}</a></li>{%- endif -%}
        <li class="hv-bc__item" aria-current="page">{{ leaf_t | default: collection.title }}</li>

      {%- elsif request.page_type == 'product' and product -%}
        {%- if current_collection -%}
          {%- if p1_t != '' -%}<li class="hv-bc__item"><a class="hv-bc__link" href="{{ p1_u }}">{{ p1_t }}</a></li>{%- endif -%}
          {%- if p2_t != '' -%}<li class="hv-bc__item"><a class="hv-bc__link" href="{{ p2_u }}">{{ p2_t }}</a></li>{%- endif -%}
          {%- if p3_t != '' -%}<li class="hv-bc__item"><a class="hv-bc__link" href="{{ p3_u }}">{{ p3_t }}</a></li>{%- endif -%}
          <li class="hv-bc__item"><a class="hv-bc__link" href="{{ leaf_u | default: current_collection.url }}">{{ leaf_t | default: current_collection.title }}</a></li>
        {%- else -%}
          <li class="hv-bc__item"><a class="hv-bc__link" href="{{ routes.all_products_collection_url }}">All Products</a></li>
        {%- endif -%}
        <li class="hv-bc__item" aria-current="page">{{ product.title }}</li>

      {%- elsif request.page_type == 'page' and page -%}
        <li class="hv-bc__item" aria-current="page">{{ page.title }}</li>

      {%- elsif request.page_type contains 'blog' -%}
        {%- if article and blog -%}
          <li class="hv-bc__item"><a class="hv-bc__link" href="{{ blog.url }}">{{ blog.title }}</a></li>
          <li class="hv-bc__item" aria-current="page">{{ article.title }}</li>
        {%- elsif blog -%}
          <li class="hv-bc__item" aria-current="page">{{ blog.title }}</li>
        {%- endif -%}
      {%- endif -%}
    </ol>
  </div>
</nav>

<style>
/* HAVIT-style full-bleed bar under header */
.hv-bc{
  --bc-bg:#f5f5f5;      /* gray bar */
  --bc-text:#000;       /* black text */
  --bc-muted:#9e9e9e;   /* chevron color */

  background:var(--bc-bg);
  width:100vw;
  position:relative;
  left:50%;
  right:50%;
  margin-left:-50vw;
  margin-right:-50vw;

  font-family:"Roboto","Helvetica Neue",Arial,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI","Noto Sans","Liberation Sans",sans-serif !important;
  font-weight:400;
  letter-spacing:0;
  border-bottom:1px solid #e5e7eb;
}

.hv-bc__inner{
  /* set this CSS var once in your theme if you want: :root { --page-width: 1200px; } */
  max-width:var(--page-width, 1200px);
  margin-inline:auto;
  padding:12px 16px;
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:16px;
}

.hv-bc__list{
  list-style:none;
  margin:0;
  padding:0;
  display:flex;
  flex-wrap:wrap;
  gap:.5rem;
  color:var(--bc-text);
  font-size:14px;
  line-height:1.4;
}

.hv-bc__item{ display:inline-flex; align-items:center; color:var(--bc-text); }
.hv-bc__item:not(:last-child)::after{
  content:"›";
  margin-left:.5rem;
  color:var(--bc-muted);
}

/* links are black, no color flip */
.hv-bc__link{ color:var(--bc-text) !important; text-decoration:none; }
.hv-bc__link:hover{ text-decoration:underline; color:var(--bc-text) !important; }

/* mobile fix to avoid 1px horizontal scroll when parents have transforms */
@media (max-width: 768px){
  .hv-bc{
    width:100%;
    left:auto; right:auto;
    margin-left:0; margin-right:0;
  }
  .hv-bc__inner{ padding:12px 14px; gap:10px; }
  .hv-bc__list{ font-size:13px; gap:.4rem; }
}
</style>

{%- assign pos = 1 -%}
<script type="application/ld+json">
{
  "@context":"https://schema.org",
  "@type":"BreadcrumbList",
  "itemListElement":[
    { "@type":"ListItem","position": {{ pos }},"name":"Home","item":"{{ shop.url }}{{ routes.root_url }}" }
    {%- assign pos = pos | plus: 1 -%}
    {%- if request.page_type == 'collection' and collection -%}
      {%- if p1_t != '' -%}, { "@type":"ListItem","position": {{ pos }},"name": {{ p1_t | json }},"item":"{{ shop.url }}{{ p1_u }}" }{%- assign pos = pos | plus: 1 -%}{%- endif -%}
      {%- if p2_t != '' -%}, { "@type":"ListItem","position": {{ pos }},"name": {{ p2_t | json }},"item":"{{ shop.url }}{{ p2_u }}" }{%- assign pos = pos | plus: 1 -%}{%- endif -%}
      {%- if p3_t != '' -%}, { "@type":"ListItem","position": {{ pos }},"name": {{ p3_t | json }},"item":"{{ shop.url }}{{ p3_u }}" }{%- assign pos = pos | plus: 1 -%}{%- endif -%}
      , { "@type":"ListItem","position": {{ pos }},"name": {{ leaf_t | default: collection.title | json }},"item":"{{ shop.url }}{{ collection.url }}" }
    {%- elsif request.page_type == 'product' and product -%}
      {%- if current_collection -%}
        {%- if p1_t != '' -%}, { "@type":"ListItem","position": {{ pos }},"name": {{ p1_t | json }},"item":"{{ shop.url }}{{ p1_u }}" }{%- assign pos = pos | plus: 1 -%}{%- endif -%}
        {%- if p2_t != '' -%}, { "@type":"ListItem","position": {{ pos }},"name": {{ p2_t | json }},"item":"{{ shop.url }}{{ p2_u }}" }{%- assign pos = pos | plus: 1 -%}{%- endif -%}
        {%- if p3_t != '' -%}, { "@type":"ListItem","position": {{ pos }},"name": {{ p3_t | json }},"item":"{{ shop.url }}{{ p3_u }}" }{%- assign pos = pos | plus: 1 -%}{%- endif -%}
        , { "@type":"ListItem","position": {{ pos }},"name": {{ leaf_t | default: current_collection.title | json }},"item":"{{ shop.url }}{{ current_collection.url }}" }
        {%- assign pos = pos | plus: 1 -%}
      {%- else -%}
        , { "@type":"ListItem","position": {{ pos }},"name":"All products","item":"{{ shop.url }}{{ routes.all_products_collection_url }}" }
        {%- assign pos = pos | plus: 1 -%}
      {%- endif -%}
      , { "@type":"ListItem","position": {{ pos }},"name": {{ product.title | json }},"item":"{{ shop.url }}{{ product.url }}" }
    {%- elsif request.page_type == 'page' and page -%}
      , { "@type":"ListItem","position": {{ pos }},"name": {{ page.title | json }},"item":"{{ shop.url }}{{ page.url }}" }
    {%- elsif request.page_type contains 'blog' -%}
      {%- if article and blog -%}
        , { "@type":"ListItem","position": {{ pos }},"name": {{ blog.title | json }},"item":"{{ shop.url }}{{ blog.url }}" }
        {%- assign pos = pos | plus: 1 -%}
        , { "@type":"ListItem","position": {{ pos }},"name": {{ article.title | json }},"item":"{{ shop.url }}{{ article.url }}" }
      {%- elsif blog -%}
        , { "@type":"ListItem","position": {{ pos }},"name": {{ blog.title | json }},"item":"{{ shop.url }}{{ blog.url }}" }
      {%- endif -%}
    {%- endif -%}
  ]
}
</script>
{%- endif -%}
