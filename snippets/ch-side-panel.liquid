{% comment %}
SLEEK SIDE PANELS (SEARCH / CART / WISHLIST)
- Drop-in replacement styles + behavior for ch-side-panel + mini cart wiring.
- Focused on a clean Camerahaus feel: crisp typography, soft shadows, rounded corners, glassy overlay.
- Includes robust cart rendering using Shopify Cart AJAX API.

INSTALL
1) Replace your existing 'snippets/ch-side-panel.liquid' content with the <div class="ch-panel ..."> block + <style> below.
2) Keep your panel bodies (search/wishlist) but you can adopt the sleeker structure/classes.
3) Add the <script> block ONCE on the page (after panels). This augments your existing controller; if you already render
   'ch-panels-controller', keep that (this script only handles data + styles and won’t double-open panels).

Notes
- Honors prefers-reduced-motion.
- Accessible: aria-live updates, focus trapping (by your controller), button hit-areas ≥ 44px.
- The cart wiring works out of the box for standard add-to-cart forms. If your theme uses custom endpoints, hook them where noted.
{% endcomment %}

<!-- ===== GENERIC SIDE PANEL WRAPPER (same Liquid API) ===== -->
<div class="ch-panel {{ theme | default: 'light' }}{% if is_open %} is-open{% endif %}"
     id="ch-panel-{{ id }}"
     aria-hidden="{% if is_open %}false{% else %}true{% endif %}"
     data-ch-panel="{{ id }}">
  <div class="ch-panel__ov" data-ch-panel-close></div>
  <aside class="ch-panel__pn" role="dialog" aria-modal="true" aria-label="{{ aria_label | default: title | default: id }}">
    <div class="ch-panel__hd">
      <div class="ch-panel__title">{{ title }}</div>
      <button type="button" class="btn btn-icon" aria-label="Close" data-ch-panel-close>
        <svg class="ico" viewBox="0 0 24 24" aria-hidden="true"><path d="M18.3 5.7 12 12l6.3 6.3-1.4 1.4L10.6 13.4 4.3 19.7 2.9 18.3 9.2 12 2.9 5.7 4.3 4.3l6.3 6.3L16.9 4.3z"/></svg>
      </button>
    </div>
    <div class="ch-panel__body">
      {{ body }}
    </div>
  </aside>
</div>

<style>
/* ===== Camerahaus Sleek Panel Styles (scoped per instance via ID) ===== */
#ch-panel-{{ id }}{
  /* Havit-style token map */
  --bg: #ffffff;
  --bg-soft:#F8FAFC;
  --ink: #111111;
  --muted:#6B7280;
  --line:#E5E7EB;
  --brand:#E0302A;
  --success:#16A34A;
  --danger:#DC2626;
  --radius: 14px;
  --shadow-lg: 0 28px 80px rgba(17,17,17,.18);
  --shadow-md: 0 12px 32px rgba(17,17,17,.12), 0 2px 8px rgba(17,17,17,.06);
  --ease-out: cubic-bezier(.22,1,.36,1);
  --ease-in: cubic-bezier(.5,0,.7,.2);
  position:fixed; inset:0; z-index:1400; pointer-events:none; font-family: var(--font-body, ui-sans-serif);
}
#ch-panel-{{ id }}.is-open{ pointer-events:auto; }
#ch-panel-{{ id }} .ch-panel__ov{
  position:absolute; inset:0; background:rgba(17,17,17,.48);
  -webkit-backdrop-filter:saturate(120%) blur(8px); backdrop-filter:saturate(120%) blur(8px);
  opacity:0; transition:opacity .28s var(--ease-out);
}
#ch-panel-{{ id }}.is-open .ch-panel__ov{ opacity:1; }
#ch-panel-{{ id }} .ch-panel__pn{
  position:absolute; top:0; right:0; height:100%; width:min(560px,96vw);
  background:var(--bg); color:var(--ink);
  transform: translateX(104%) scale(.995);
  transition: transform .42s var(--ease-out), box-shadow .24s ease;
  display:flex; flex-direction:column; border-left:1px solid var(--line);
  box-shadow: var(--shadow-md);
  border-top-left-radius: var(--radius); border-bottom-left-radius: var(--radius);
}
#ch-panel-{{ id }}.is-open .ch-panel__pn{ transform: translateX(0) scale(1); box-shadow: var(--shadow-lg); }
#ch-panel-{{ id }} .ch-panel__pn:focus{ outline:none; }
#ch-panel-{{ id }} .ch-panel__hd{
  display:flex; align-items:center; justify-content:space-between; gap:8px;
  padding:16px 16px; border-bottom:1px solid var(--line); background:linear-gradient(#fff, #fdfdfd);
  position:sticky; top:0; z-index:2; border-top-left-radius: var(--radius);
}
#ch-panel-{{ id }} .ch-panel__title{ font: 800 16px/1.2 var(--font-body, ui-sans-serif); letter-spacing:.2px; }
#ch-panel-{{ id }} .ch-panel__body{ padding:16px 18px 20px; display:grid; gap:12px; overflow:auto; min-height:0; }
#ch-panel-{{ id }} .btn{ background:#111; color:#fff; border:0; height:44px; padding:0 18px; border-radius:999px; font:800 14px/1 var(--font-body, ui-sans-serif); cursor:pointer; transition:background-color .18s ease, box-shadow .18s ease, transform .02s ease; }
#ch-panel-{{ id }} .btn:hover{ background:#0b0b0b; }
#ch-panel-{{ id }} .btn:active{ transform:translateY(1px); }
#ch-panel-{{ id }} .btn:focus-visible{ outline:0; box-shadow:0 0 0 2px #fff, 0 0 0 4px var(--brand); }
#ch-panel-{{ id }} .btn.btn-outline{ background:#fff; color:#111; border:1px solid var(--line); }
#ch-panel-{{ id }} .btn.btn-outline:hover{ background:#F9FAFB; }
#ch-panel-{{ id }} .btn.btn-icon{ background:transparent; color:inherit; height:44px; min-width:44px; padding:0; }
#ch-panel-{{ id }} .ico{ width:20px; height:20px; fill:currentColor; }

/* Dark header variant */
#ch-panel-{{ id }}.dark .ch-panel__pn{ background:linear-gradient(180deg, var(--brand) 0%, #c72b26 100%); color:#fff; }
#ch-panel-{{ id }}.dark .ch-panel__hd{ background:transparent; border-color:rgba(255,255,255,.22); }
#ch-panel-{{ id }}.dark .btn.btn-outline{ background:transparent; color:#fff; border-color:rgba(255,255,255,.35); }

/* ===== Cart (Camerahaus compact) ===== */
#ch-panel-{{ id }} [data-mc-list]{ display:grid; gap:10px; }
#ch-panel-{{ id }} .mci{ display:grid; grid-template-columns:80px 1fr auto; gap:12px; padding:12px; border:1px solid var(--line); border-radius:12px; background:#fff; box-shadow:0 1px 0 rgba(0,0,0,.02); }
#ch-panel-{{ id }} .mci .pic{ width:80px; height:80px; border-radius:10px; object-fit:cover; background:#fff; border:1px solid #F1F5F9; }
#ch-panel-{{ id }} .mci .name{ font:700 13px/1.35 var(--font-body, ui-sans-serif); color:var(--ink); text-decoration:none; }
#ch-panel-{{ id }} .mci .name:hover{ text-decoration:underline; text-underline-offset:2px; }
#ch-panel-{{ id }} .mci .meta{ color:var(--muted); font:600 11px/1.2 var(--font-body, ui-sans-serif); margin-top:4px; }
#ch-panel-{{ id }} .mci .price{ font:800 13px/1 var(--font-body, ui-sans-serif); white-space:nowrap; text-align:right; }
#ch-panel-{{ id }} .mci .qty{ display:inline-flex; align-items:center; gap:6px; border:1px solid var(--line); border-radius:10px; padding:6px; margin-top:8px; background:#fff; }
#ch-panel-{{ id }} .mci .qty button{ width:28px; height:28px; border-radius:8px; border:1px solid var(--line); background:#fff; cursor:pointer; transition:background-color .12s ease, border-color .12s ease; }
#ch-panel-{{ id }} .mci .qty button:hover{ background:#F9FAFB; border-color:#D1D5DB; }
#ch-panel-{{ id }} .mci .qty input{ width:40px; text-align:center; border:0; outline:0; background:transparent; font:700 13px/1 var(--font-body, ui-sans-serif); }
#ch-panel-{{ id }} .mc-ft{ padding:16px 18px 14px; border-top:1px solid var(--line); margin-top:auto; background:inherit; position:sticky; bottom:0; }
#ch-panel-{{ id }} .mc-sub{ display:flex; align-items:center; justify-content:space-between; font-weight:800; margin-bottom:12px; }
#ch-panel-{{ id }} .mc-cta{ display:flex; gap:10px; }
#ch-panel-{{ id }} .mc-cta a{ flex:1 1 0; height:46px; display:inline-flex; align-items:center; justify-content:center; border-radius:999px; text-decoration:none; font:800 14px/1 var(--font-body, ui-sans-serif); transition:background-color .18s ease, box-shadow .18s ease; }
#ch-panel-{{ id }} .mc-cta .btn-view{ background:#fff; border:1px solid var(--line); color:#111; }
#ch-panel-{{ id }} .mc-cta .btn-view:hover{ background:#F9FAFB; }
#ch-panel-{{ id }} .mc-cta .btn-checkout{ background:#111; color:#fff; }
#ch-panel-{{ id }} .mc-cta .btn-checkout:hover{ background:#0b0b0b; }
#ch-panel-{{ id }} .mc-note{ color:var(--muted); font:600 11px/1.2 var(--font-body, ui-sans-serif); margin-top:8px; }

/* Skeleton shimmer */
#ch-panel-{{ id }} .skeleton{ background:linear-gradient(90deg,#eee,#f7f7f7,#eee); animation:ch-sk 1.2s infinite; }
#ch-panel-{{ id }} .s1{ height:14px; border-radius:6px; margin-bottom:6px; }
#ch-panel-{{ id }} .s2{ width:60%; height:12px; border-radius:6px; }
#ch-panel-{{ id }} .s3{ width:72px; height:14px; border-radius:6px; margin-left:auto; }
@keyframes ch-sk{ 0%{background-position:-140px 0} 100%{background-position:140px 0} }

/* Motion reduce */
@media (prefers-reduced-motion: reduce){
  #ch-panel-{{ id }} .ch-panel__ov{ transition:none; }
  #ch-panel-{{ id }} .ch-panel__pn{ transition:none; }
}
/* Typography (scoped to this panel instance) */
#ch-panel-{{ id }}{
  --font-heading: "Space Grotesk", system-ui, -apple-system, "Segoe UI", Roboto, Arial, sans-serif;
  --font-body: "Inter", system-ui, -apple-system, "Segoe UI", Roboto, Arial, sans-serif;
}

#ch-panel-{{ id }} { 
  font-family: var(--font-body);
  -webkit-font-smoothing: antialiased; 
  text-rendering: optimizeLegibility;
}

#ch-panel-{{ id }} .ch-panel__title{
  font-family: var(--font-heading);
  letter-spacing: -0.01em;
  font-weight: 700;          /* Space Grotesk weight */
}

#ch-panel-{{ id }} .ch-panel__body,
#ch-panel-{{ id }} .mci .name,
#ch-panel-{{ id }} .mci .meta,
#ch-panel-{{ id }} .btn{
  font-family: var(--font-body);
  font-weight: 500;
  letter-spacing: 0;         /* Inter is already tight/clean */
}

#ch-panel-{{ id }} .btn{
  font-weight: 800;          /* strong CTAs in Inter look great */
  letter-spacing: .02em;
}

/* Prices & numeric chips – align digits perfectly */
#ch-panel-{{ id }} .price,
#ch-panel-{{ id }} [data-mc-subtotal],
#ch-panel-{{ id }} [data-price]{
  font-variant-numeric: tabular-nums lining-nums;
  font-feature-settings: "tnum" 1, "lnum" 1;
}

/* Optional helper for small, all-caps labels (e.g., “SUBTOTAL”) */
#ch-panel-{{ id }} .label--caps{
  text-transform: uppercase;
  letter-spacing: .08em;
  font-weight: 700;
  opacity: .9;
}

/* ===== Havit visual overrides for Search panel inside side panel ===== */
.ch-panel[data-ch-panel="search"] .sh-inp{
  height:48px; background:#fff; border:1px solid var(--line); border-radius:999px;
  padding:0 14px; box-shadow: inset 0 0 0 1px transparent; transition:border-color .15s ease, box-shadow .15s ease;
}
.ch-panel[data-ch-panel="search"] .sh-inp:focus-within{ border-color:var(--brand); box-shadow: inset 0 0 0 1px var(--brand); }
.ch-panel[data-ch-panel="search"] .sh-inp input{ font:600 16px/1.35 var(--font-body); color:var(--ink); }
.ch-panel[data-ch-panel="search"] .chips{ gap:8px; }
.ch-panel[data-ch-panel="search"] .chip{ height:32px; padding:0 12px; border-radius:999px; border:1px solid var(--line); background:#fff; color:#111; font-weight:700; font-size:12px; }
.ch-panel[data-ch-panel="search"] .chip:hover{ background:#FFF4F3; border-color:var(--brand); }
.ch-panel[data-ch-panel="search"] .srow{ border:1px solid var(--line); border-radius:12px; background:#fff; }
.ch-panel[data-ch-panel="search"] .it{ grid-template-columns:64px 1fr auto; border:1px solid var(--line); border-radius:12px; background:#fff; padding:10px; gap:10px; }
.ch-panel[data-ch-panel="search"] .mthumb{ width:64px; height:64px; border-radius:10px; background:#fff; border:1px solid #F1F5F9; object-fit:contain; }
.ch-panel[data-ch-panel="search"] .mtitle{ font:600 13px/1.35 var(--font-body); color:#111; }
.ch-panel[data-ch-panel="search"] .mprice{ font:800 13px/1 var(--font-body); color:var(--brand); }
.ch-panel[data-ch-panel="search"] .price-was{ color:#6B7280; text-decoration:line-through; margin-left:6px; font-weight:700; }

/* ===== Wishlist panel typography & empty state ===== */
.ch-panel[data-ch-panel="wishlist"] .ch-panel__body{ color:var(--ink); }
.ch-panel[data-ch-panel="wishlist"] .wl-empty, .ch-panel[data-ch-panel="wishlist"] .empty{
  text-align:center; color:var(--muted); padding:24px 8px; font:500 13px/1.5 var(--font-body);
}

</style>

{% comment %}
======== MINI-CART WIRING (DATA + RENDER) ========
- Safe to include once per page. If you use multiple panels, this script detects the cart by data-ch-panel="cart".
{% endcomment %}
<script>
(() => {
  const rootDoc = document;
  const $$ = (s,sc=rootDoc)=>Array.from(sc.querySelectorAll(s));
  const $  = (s,sc=rootDoc)=>sc.querySelector(s);

  /* Early exit if no cart panel on page */
  const cartPanel = $('.ch-panel[data-ch-panel="cart"]');
  if(!cartPanel) return;

  /* ---------- Utilities ---------- */
  const locale = {{ request.locale.iso_code | json }} || 'en-PH';
  const currency = {{ shop.currency | json }} || 'PHP';
  const nf = new Intl.NumberFormat(locale, { style:'currency', currency });
  const money = (cents) => nf.format((Number(cents)||0)/100);

  function announce(msg){ const live = $('[data-mc-live]', cartPanel); if(live){ live.textContent=''; requestAnimationFrame(()=> live.textContent = msg); } }

  function setBadge(count){ const el = $('[data-cart-count]'); if(!el) return; el.textContent = String(count||0); const live = $('[data-cart-live]'); if(live) live.textContent = count>0 ? `${count} item${count>1?'s':''} in cart` : 'Cart is empty'; }

  async function fetchCart(){
    try{ const r = await fetch('/cart.js', { headers:{'Accept':'application/json'}, cache:'no-store' }); return r.ok ? r.json() : null; }
    catch(_){ return null; }
  }

  async function changeLine(line, quantity){
    const fd = new FormData(); fd.append('line', String(line)); fd.append('quantity', String(quantity));
    const r = await fetch('/cart/change.js', { method:'POST', body:fd, headers:{'Accept':'application/json'} });
    return r.ok ? r.json() : null;
  }

  function lineItemTemplate(item, idx){
    const p = document.createElement('div'); p.className='mci';
    const url = item.url || (`/products/${(item.handle||'')}`);
    p.innerHTML = `
      <img class="pic" src="${(item.image||'').replace(/(\.\w+)(?:\?.*)?$/, '_160x$1')}" alt="${(item.product_title||'').replace(/"/g,'&quot;')}">
      <div>
        <a class="name" href="${url}">${item.product_title||''}</a>
        <div class="meta">${[item.variant_title||'', item.sku||''].filter(Boolean).join(' • ')}</div>
        <div class="qty">
          <button type="button" aria-label="Decrease quantity" data-mc-dec="${idx}">−</button>
          <input type="number" min="0" value="${item.quantity}" data-mc-qty="${idx}">
          <button type="button" aria-label="Increase quantity" data-mc-inc="${idx}">+</button>
        </div>
      </div>
      <div class="price">
        <div>${money(item.final_line_price)}</div>
        <button type="button" class="btn btn-outline" style="height:32px;padding:0 10px;margin-top:8px;" data-mc-rem="${idx}">Remove</button>
      </div>`;
    return p;
  }

  function renderCart(cart){
    const list = $('[data-mc-list]', cartPanel); if(!list) return;
    list.innerHTML = '';
    if(!cart || !Array.isArray(cart.items) || cart.items.length===0){
      list.innerHTML = `<div class="mc-empty" style="text-align:center;color:#6b7280;padding:24px 8px;">
        <div style="font-weight:800;margin-bottom:6px;">Your cart is empty</div>
        <div>Find something you love and add it to your cart.</div>
      </div>`;
    }else{
      cart.items.forEach((it, i)=> list.appendChild(lineItemTemplate(it, i+1)));
    }
    const sub = $('[data-mc-subtotal]', cartPanel); if(sub) sub.textContent = money(cart && cart.items_subtotal_price || 0);
    setBadge(cart ? cart.item_count : 0);
  }

  /* ---------- Event bindings ---------- */
  cartPanel.addEventListener('click', async (e)=>{
    const dec = e.target.closest('[data-mc-dec]');
    const inc = e.target.closest('[data-mc-inc]');
    const rem = e.target.closest('[data-mc-rem]');
    if(dec||inc||rem){ e.preventDefault(); }
    try{
      if(dec||inc){
        const idx = Number((dec||inc).getAttribute('data-mc-dec') || (inc && inc.getAttribute('data-mc-inc')));
        const input = cartPanel.querySelector(`[data-mc-qty="${idx}"]`);
        let q = Math.max(0, Number(input.value||0) + (inc?1:-1));
        const newCart = await changeLine(idx, q); if(newCart){ renderCart(newCart); announce('Cart updated'); }
      }else if(rem){
        const idx = Number(rem.getAttribute('data-mc-rem'));
        const newCart = await changeLine(idx, 0); if(newCart){ renderCart(newCart); announce('Item removed'); }
      }
    }catch(_){ announce('Could not update cart'); }
  });

  cartPanel.addEventListener('change', async (e)=>{
    const inp = e.target.closest('[data-mc-qty]'); if(!inp) return;
    const idx = Number(inp.getAttribute('data-mc-qty')); const q = Math.max(0, Number(inp.value||0));
    const newCart = await changeLine(idx, q); if(newCart){ renderCart(newCart); announce('Quantity changed'); }
  });

  /* Open-cart hook from your controller’s broadcast */
  document.addEventListener('ch:panel', (e)=>{
    const { name, open } = (e && e.detail) || {}; if(name==='cart' && open){ fetchCart().then(renderCart); }
  }, { passive:true });

  /* Intercept Add-to-Cart to reflect changes immediately and open drawer */
  document.addEventListener('submit', async (e)=>{
    const form = e.target;
    const isATC = form.matches('form[action*="/cart/add"], form[action="/cart/add"]');
    if(!isATC) return;
    e.preventDefault();
    const fd = new FormData(form);
    try{
      const r = await fetch('/cart/add.js', { method:'POST', body:fd, headers:{'Accept':'application/json'} });
      if(!r.ok) throw 0; await r.json();
      const cart = await fetchCart(); renderCart(cart); setTimeout(()=>{ document.dispatchEvent(new CustomEvent('cart:open')); }, 10);
      announce('Added to cart');
    }catch(_){ announce('Could not add to cart'); form.submit && form.submit(); }
  }, true);

  /* Initial badge sync on page load */
  fetchCart().then(renderCart);
})();
</script>