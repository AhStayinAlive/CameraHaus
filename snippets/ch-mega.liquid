{%- comment -%}
  SNIPPET: ch-mega
  - Modes:
      • 'cats'   → flat category text list (multi-column, no subcategories)
      • 'brands' → logo tiles (from brand_rows mapping)
      • 'stores' → one-column list + CTA
  - Panel mounts under header, overlay behind
{%- endcomment -%}

{%- assign _mode = mode | default: 'cats' -%}

<style>
  .mmg-wrap[data-mega]{ position:relative; }

  /* ===== PANEL (fixed under header) ===== */
  .mmg{
    --brand:#D12F24;               /* CTA / accent red */
    --ink:#111111;                 /* primary text */
    --ink-2:#6B7280;               /* section labels */
    --ink-soft:#4B5563;
    --chev:#9CA3AF;

    position:fixed; left:0; right:0; top:0; z-index:9999;
    background:#fff; color:var(--ink);
    border:0; border-radius:0; box-shadow:0 24px 64px rgba(16,24,40,.18);
    opacity:0; visibility:hidden; pointer-events:none; transform:translateY(8px);
    transition:opacity .18s cubic-bezier(.22,.61,.36,1), transform .18s cubic-bezier(.22,.61,.36,1);
    overflow-y:auto;                  /* single scroll if content overflows */
    max-height:100vh;                 /* JS will shrink further from header height */
  }
  .mmg.is-open{ opacity:1; visibility:visible; pointer-events:auto; transform:none; }

  .mmg-shell{
    padding:24px 40px 28px;
  }
  .mmg-inner{
    margin:0 auto;
    max-width:1220px;                /* centers content, balanced whitespace */
  }

  /* Headings */
  .mmg-head{
    display:flex; align-items:center; justify-content:space-between;
    gap:12px; margin-bottom:18px;
  }
  .mmg-sectiontag{
    background:transparent;
    color:var(--ink-2);
    padding:0;
    font:600 14px/1.2 "Inter",system-ui;
    letter-spacing:.08em;
    text-transform:uppercase;
  }

  /* ===== CATEGORIES: TEXT LIST WITH ARROW (MULTI-COLUMN) ===== */
  .mmg-catlist{
    list-style:none;
    margin:4px 0 0;
    padding:0;

    display:grid;
    grid-template-columns:repeat(2, minmax(0,1fr));
    column-gap:48px;
    row-gap:4px;
  }
  @media (min-width:1024px){
    .mmg-catlist{
      grid-template-columns:repeat(3, minmax(0,1fr));
    }
  }

  .mmg-catlink{
    display:flex;
    align-items:center;
    gap:10px;
    padding:6px 4px;
    border-radius:8px;
    text-decoration:none;
    color:var(--ink);
    font:600 18px/1.35 "Inter",system-ui;
    transition:color .18s ease, background-color .14s ease;
  }
  .mmg-catlink::after{
    content:"";
    margin-left:auto;
    width:6px; height:6px;
    border-right:2px solid var(--chev);
    border-top:2px solid var(--chev);
    transform:rotate(45deg);
    opacity:.9;
  }
  .mmg-catlink:hover,
  .mmg-catlink:focus-visible{
    color:var(--brand);
    background:#F9FAFB;
  }
  .mmg-catlink:focus-visible{
    outline:0;
    box-shadow:0 0 0 2px rgba(32,94,214,.35);
  }

  /* ===== BRAND LOGO GRID (6 PER ROW DESKTOP, SMALLER TILES) ===== */
  .mmg-brandgrid{
    display:grid;
    grid-template-columns:repeat(2,minmax(0,1fr));
    gap:12px;
    margin-top:6px;
  }
  @media (min-width:768px){
    .mmg-brandgrid{
      grid-template-columns:repeat(4,minmax(0,1fr));
    }
  }
  @media (min-width:1200px){
    .mmg-brandgrid{
      grid-template-columns:repeat(6,minmax(0,1fr));
    }
  }

  .mmg-brandtile{
    position:relative;
    display:flex; align-items:center; justify-content:center; text-align:center;
    min-height:72px;
    padding:10px 8px;
    border-radius:14px;
    border:1px solid rgba(17,17,17,.10);
    background:linear-gradient(180deg,#fff 0%,#fafafa 100%);
    box-shadow:0 6px 20px rgba(17,17,17,.05);
    text-decoration:none;
    color:var(--ink);
    transition:
      transform .18s ease,
      box-shadow .18s ease,
      border-color .18s ease,
      background .18s ease;
    overflow:hidden;
  }
  .mmg-brandtile:hover{
    transform:translateY(-2px);
    border-color:rgba(17,17,17,.20);
    box-shadow:0 10px 28px rgba(17,17,17,.10);
  }
  .mmg-brandtile:active{
    transform:translateY(0) scale(.98);
  }
  .mmg-brandtile:focus-visible{
    outline:0;
    box-shadow:0 0 0 3px rgba(32,94,214,.35);
  }
  .mmg-brandtile img{
    max-width:100%;
    max-height:50px;
    width:auto;
    height:auto;
    object-fit:contain;
  }
  .mmg-brandfallback{
    font:600 14px/1.3 "Inter",system-ui;
  }

  /* Red hover pill like site brand */
  .mmg-brandtile::after{
    content:attr(data-name);
    position:absolute;
    left:10px; right:10px; bottom:8px;
    padding:3px 8px;
    border-radius:999px;
    background:var(--brand);
    color:#fff;
    font-size:11px; line-height:1.2;
    text-align:center;
    opacity:0;
    transform:translateY(6px);
    transition:opacity .15s ease, transform .15s ease;
    pointer-events:none;
    text-transform:capitalize;
    box-shadow:0 2px 8px rgba(209,47,36,.25);
  }
  .mmg-brandtile:hover::after,
  .mmg-brandtile:focus-visible::after{
    opacity:1;
    transform:translateY(0);
  }

  /* ===== CTA ===== */
  .mmg-railcta{
    margin-top:18px;
  }
  .mmg .mmg-cta{
    display:inline-flex; align-items:center; justify-content:center;
    height:38px; padding:0 16px;
    border-radius:10px; border:1px solid var(--brand);
    background:var(--brand); color:#fff;
    font:700 13px/1 "Inter",system-ui;
    box-shadow:0 1px 0 rgba(0,0,0,.02);
    transition: filter .12s ease, transform .04s ease;
    text-decoration:none;
    white-space:nowrap;
  }
  .mmg .mmg-cta:hover{ filter:brightness(.95); }
  .mmg .mmg-cta:active{ transform:translateY(1px); }

  /* Brands mode: top-right header CTA */
  .mmg[data-mode="brands"] .mmg-head .mmg-cta{
    height:34px;
    padding:0 14px;
    font-size:12px;
  }
  .mmg-cta-label{
    display:inline-block;
  }
  .mmg-cta-arrow{
    display:inline-block;
    margin-left:6px;
    font-size:13px;
    line-height:1;
    position:relative;
    top:-0.5px;                 /* lift the arrow slightly to center it */
    transition:transform .18s ease;
  }
  /* Arrow animation on hover: subtle slide to the right */
  .mmg-cta:hover .mmg-cta-arrow,
  .mmg-cta:focus-visible .mmg-cta-arrow{
    transform:translateX(4px);
  }

  /* MAKE "VIEW ALL BRANDS" STICKY IN BRANDS MODE ONLY (legacy) */
  .mmg[data-mode="brands"] .mmg-railcta{
    position:sticky;
    bottom:16px;
    padding-top:14px;
    margin-top:12px;
    background:linear-gradient(to bottom, rgba(255,255,255,0), #fff 55%);
    z-index:2;
  }

  /* ===== STORES MODE (simple one-column + CTA) ===== */
  .mmg--stores .mmg-head{ margin-bottom:12px; }
  .mmg-1col{
    padding-right:4px;
  }
  .mmg-1col ul{
    list-style:none; margin:0; padding:0;
    max-width:360px;
    display:grid; gap:8px;
  }
  .mmg-1col a{
    display:block; padding:6px 0;
    font:600 16px/1.35 "Inter",system-ui;
    color:var(--ink); text-decoration:none; border-radius:4px;
    transition:color .18s ease;
  }
  .mmg-1col a:hover,
  .mmg-1col a:focus-visible{
    color:var(--brand); background:transparent;
  }

  /* Overlay */
  .mmg-overlay{
    position:fixed; inset:0;
    background:rgba(0,0,0,.45);
    opacity:0; pointer-events:none;
    transition:opacity .18s;
    z-index:9998;
  }
  .mmg-overlay.is-open{ opacity:1; pointer-events:auto; }

  /* ===== Animations ===== */
  @keyframes mmg-fade-up {
    from{opacity:0; transform:translateY(8px)}
    to{opacity:1; transform:none}
  }
  .mmg.mmg-animate [data-stagger] > *{
    opacity:0; transform:translateY(6px);
    animation:mmg-fade-up .26s ease-out both;
  }

  /* Reduced motion */
  @media (prefers-reduced-motion:reduce){
    .mmg, .mmg-overlay{ transition:none !important; }
    .mmg *{ animation:none !important; transform:none !important; }
  }

  @media (max-width:980px){
    .mmg-shell{ padding:20px 18px 24px; }
  }

  /* ===== BRAND LOGO GRID (6 PER ROW DESKTOP, CLEANER LOOK) ===== */
  .mmg-brandgrid{
    display:grid;
    grid-template-columns:repeat(2,minmax(0,1fr));
    column-gap:18px;
    row-gap:14px;
    margin-top:14px;
  }
  @media (min-width:768px){
    .mmg-brandgrid{
      grid-template-columns:repeat(4,minmax(0,1fr));
    }
  }
  @media (min-width:1200px){
    .mmg-brandgrid{
      grid-template-columns:repeat(6,minmax(0,1fr));
    }
  }

  .mmg-brandtile{
    position:relative;
    display:flex; align-items:center; justify-content:center; text-align:center;
    min-height:64px;
    padding:10px 12px;
    border-radius:12px;
    border:1px solid rgba(15,23,42,.06);
    background:#ffffff;
    box-shadow:0 3px 12px rgba(15,23,42,.04);
    text-decoration:none;
    color:var(--ink);
    transition:
      transform .16s ease,
      box-shadow .16s ease,
      border-color .16s ease,
      background .16s ease;
    overflow:hidden;
  }
  .mmg-brandtile:hover{
    transform:translateY(-1px);
    border-color:rgba(15,23,42,.14);
    box-shadow:0 6px 18px rgba(15,23,42,.10);
  }
  .mmg-brandtile:active{
    transform:translateY(0) scale(.985);
  }
  .mmg-brandtile:focus-visible{
    outline:0;
    box-shadow:0 0 0 3px rgba(32,94,214,.35);
  }

  .mmg-brandtile img{
    max-width:100%;
    max-height:44px;
    width:auto;
    height:auto;
    object-fit:contain;
  }
  .mmg-brandfallback{
    font:600 14px/1.3 "Inter",system-ui;
  }

  .mmg-brandtile::after{
    content:attr(data-name);
    position:absolute;
    left:10px; right:10px; bottom:6px;
    padding:3px 8px;
    border-radius:999px;
    background:var(--brand);
    color:#fff;
    font-size:11px; line-height:1.2;
    text-align:center;
    opacity:0;
    transform:translateY(6px);
    transition:opacity .15s ease, transform .15s ease;
    pointer-events:none;
    text-transform:capitalize;
    box-shadow:0 2px 8px rgba(209,47,36,.25);
  }
  .mmg-brandtile:hover::after,
  .mmg-brandtile:focus-visible::after{
    opacity:1;
    transform:translateY(0);
  }

  .mmg[data-mode="brands"] .mmg-railcta{
    position:sticky;
    bottom:18px;
    margin-top:20px;
    padding:0;
    display:flex;
    justify-content:center;
    align-items:center;
    background:transparent;
    z-index:3;
  }
  .mmg[data-mode="brands"] .mmg-railcta::before{
    content:"";
    position:absolute;
    inset:-4px -10px;
    border-radius:999px;
    background:rgba(255,255,255,.96);
    box-shadow:0 6px 18px rgba(15,23,42,.20);
    z-index:-1;
    pointer-events:none;
  }

</style>

{%- comment -%} Resolve Categories & Stores from the main menu (top level only) {%- endcomment -%}
{%- assign cat_links = nil -%}
{%- if menu_obj and menu_obj.links -%}
  {%- assign p_norm = parent_title | default: 'Category' | strip | downcase -%}
  {%- for l in menu_obj.links -%}
    {%- assign t_norm = l.title | strip | downcase -%}
    {%- if t_norm == p_norm or t_norm contains 'categor' or t_norm contains 'shop' -%}
      {%- assign cat_links = l.links -%}{%- break -%}
    {%- endif -%}
  {%- endfor -%}
  {%- if cat_links == nil or cat_links == empty -%}
    {%- for l in menu_obj.links -%}
      {% if l.links and l.links.size > 0 %}
        {%- assign cat_links = l.links -%}{%- break -%}
      {% endif %}
    {%- endfor -%}
  {%- endif -%}
{%- endif -%}

{%- assign stores_links = nil -%}
{%- if menu_obj and menu_obj.links -%}
  {%- assign s_norm = stores_parent_title | default: 'Stores' | strip | downcase -%}
  {%- for l in menu_obj.links -%}
    {%- assign t_norm = l.title | strip | downcase -%}
    {%- if t_norm == s_norm or t_norm contains 'store' or t_norm contains 'where' -%}
      {%- assign stores_links = l.links -%}{%- break -%}
    {%- endif -%}
  {%- endfor -%}
{%- endif -%}

<div class="mmg {% if _mode == 'stores' %}mmg--stores{% endif %}"
     data-mode="{{ _mode }}" role="dialog" aria-modal="false"
     aria-label="{% if _mode == 'cats' %}All Categories{% elsif _mode == 'brands' %}Brands{% else %}Where to find us{% endif %}">
  <div class="mmg-shell">
    <div class="mmg-inner">

      {% if _mode == 'stores' %}
        <!-- ================= STORES: ONE-COLUMN + CTA ================= -->
        <div class="mmg-head">
          <span class="mmg-sectiontag">Where to find us</span>
        </div>

        <div class="mmg-1col">
          <ul data-stagger="stores">
            {% if stores_links and stores_links.size > 0 %}
              {% for s in stores_links %}
                <li><a href="{{ s.url | default: '/pages/store-locator' }}">{{ s.title | strip }}</a></li>
              {% endfor %}
            {% else %}
              {%- assign fallback_stores =
                "Camerahaus Online|/pages/camerahaus-online
                 Camerahaus Stores|/pages/store-locator
                 Lazada|https://www.lazada.com.ph/shop/camerahaus/
                 Shopee|https://shopee.ph/camerahaus"
                | newline_to_br | split: '<br />' -%}
              {% for row in fallback_stores %}
                {%- assign parts = row | split:'|' -%}
                <li><a href="{{ parts[1] }}">{{ parts[0] }}</a></li>
              {% endfor %}
            {% endif %}
          </ul>

          <div class="mmg-railcta">
            <a class="mmg-cta" href="{{ stores_fallback_url | default: '/pages/store-locator' }}">View all stores</a>
          </div>
        </div>

      {% elsif _mode == 'cats' %}
        <!-- ================= CATEGORIES: TEXT LIST ================= -->
        <div class="mmg-head">
          <span class="mmg-sectiontag">Shop by category</span>
        </div>

        <ul class="mmg-catlist" data-stagger="cats">
          {% assign category_links = cat_links %}
          {% if category_links and category_links.size > 0 %}
            {% for c in category_links %}
              {% assign label = c.title | strip %}
              {% assign url   = c.url | default: '/collections/all' %}
              <li>
                <a class="mmg-catlink" href="{{ url }}">
                  <span class="mmg-catlabel">{{ label }}</span>
                </a>
              </li>
            {% endfor %}
          {% endif %}
        </ul>

        <div class="mmg-railcta">
          <a class="mmg-cta" href="{{ categories_fallback_url | default: '/collections/all' }}">
            View all categories
          </a>
        </div>

      {% else %}
        <!-- ================= BRANDS: LOGO TILES ================= -->

        <div class="mmg-head">
          <span class="mmg-sectiontag">Shop by brand</span>
          <a class="mmg-cta" href="{{ brands_fallback_url | default: '/pages/brands' }}">
            <span class="mmg-cta-label">View all brands</span>
            <span class="mmg-cta-arrow">&gt;</span>
          </a>
        </div>

        {% assign brand_rows = "
AgfaPhoto|agfaphoto-min.png|vendor:AgfaPhoto,
AKASO|akaso-min.png|vendor:AKASO,
Aputure|aputure-min.png|vendor:Aputure,
