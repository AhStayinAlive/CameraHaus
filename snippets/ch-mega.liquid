{%- comment -%}
  SNIPPET: ch-mega
  - Modes:
      • 'cats'   → flat category text list (multi-column, no subcategories)
      • 'brands' → logo tiles (from brand_rows mapping)
      • 'stores' → one-column list + CTA
  - Panel mounts under header, overlay behind
{%- endcomment -%}

{%- assign _mode = mode | default: 'cats' -%}

<style>
  .mmg-wrap[data-mega]{ position:relative; }

  /* ===== PANEL (fixed under header) ===== */
  .mmg{
    --brand:#D12F24;               /* CTA / accent red */
    --ink:#111111;                 /* primary text */
    --ink-2:#6B7280;               /* section labels */
    --ink-soft:#4B5563;
    --chev:#9CA3AF;

    position:fixed; left:0; right:0; top:0; z-index:9999;
    background:#fff; color:var(--ink);
    border:0; border-radius:0; box-shadow:0 24px 64px rgba(16,24,40,.18);
    opacity:0; visibility:hidden; pointer-events:none; transform:translateY(8px);
    transition:opacity .18s cubic-bezier(.22,.61,.36,1), transform .18s cubic-bezier(.22,.61,.36,1);
    overflow-y:auto;                  /* single scroll if content overflows */
    max-height:100vh;                 /* JS will shrink further from header height */
  }
  .mmg.is-open{ opacity:1; visibility:visible; pointer-events:auto; transform:none; }

  .mmg-shell{
    padding:24px 40px 28px;
  }
  .mmg-inner{
    margin:0 auto;
    max-width:1220px;                /* centers content, balanced whitespace */
  }

  /* Headings */
  .mmg-head{
    display:flex; align-items:center; justify-content:space-between;
    gap:12px; margin-bottom:18px;
  }
  .mmg-sectiontag{
    background:transparent;
    color:var(--ink-2);
    padding:0;
    font:600 14px/1.2 "Inter",system-ui;
    letter-spacing:.08em;
    text-transform:uppercase;
  }

  /* ===== CATEGORIES: TEXT LIST WITH ARROW (MULTI-COLUMN) ===== */
  .mmg-catlist{
    list-style:none;
    margin:4px 0 0;
    padding:0;

    display:grid;
    grid-template-columns:repeat(2, minmax(0,1fr));
    column-gap:48px;
    row-gap:4px;
  }
  @media (min-width:1024px){
    .mmg-catlist{
      grid-template-columns:repeat(3, minmax(0,1fr));
    }
  }

  .mmg-catlink{
    display:flex;
    align-items:center;
    gap:10px;
    padding:6px 4px;
    border-radius:8px;
    text-decoration:none;
    color:var(--ink);
    font:600 18px/1.35 "Inter",system-ui;
    transition:color .18s ease, background-color .14s ease;
  }
  .mmg-catlink::after{
    content:"";
    margin-left:auto;
    width:6px; height:6px;
    border-right:2px solid var(--chev);
    border-top:2px solid var(--chev);
    transform:rotate(45deg);
    opacity:.9;
  }
  .mmg-catlink:hover,
  .mmg-catlink:focus-visible{
    color:var(--brand);
    background:#F9FAFB;
  }
  .mmg-catlink:focus-visible{
    outline:0;
    box-shadow:0 0 0 2px rgba(32,94,214,.35);
  }

  /* ===== BRAND LOGO GRID (6 PER ROW DESKTOP, SMALLER TILES) ===== */
  .mmg-brandgrid{
    display:grid;
    grid-template-columns:repeat(2,minmax(0,1fr));
    gap:12px;
    margin-top:6px;
  }
  @media (min-width:768px){
    .mmg-brandgrid{
      grid-template-columns:repeat(4,minmax(0,1fr));
    }
  }
  @media (min-width:1200px){
    .mmg-brandgrid{
      grid-template-columns:repeat(6,minmax(0,1fr));
    }
  }

  .mmg-brandtile{
    position:relative;
    display:flex; align-items:center; justify-content:center; text-align:center;
    min-height:72px;
    padding:10px 8px;
    border-radius:14px;
    border:1px solid rgba(17,17,17,.10);
    background:linear-gradient(180deg,#fff 0%,#fafafa 100%);
    box-shadow:0 6px 20px rgba(17,17,17,.05);
    text-decoration:none;
    color:var(--ink);
    transition:
      transform .18s ease,
      box-shadow .18s ease,
      border-color .18s ease,
      background .18s ease;
    overflow:hidden;
  }
  .mmg-brandtile:hover{
    transform:translateY(-2px);
    border-color:rgba(17,17,17,.20);
    box-shadow:0 10px 28px rgba(17,17,17,.10);
  }
  .mmg-brandtile:active{
    transform:translateY(0) scale(.98);
  }
  .mmg-brandtile:focus-visible{
    outline:0;
    box-shadow:0 0 0 3px rgba(32,94,214,.35);
  }
  .mmg-brandtile img{
    max-width:100%;
    max-height:50px;
    width:auto;
    height:auto;
    object-fit:contain;
  }
  .mmg-brandfallback{
    font:600 14px/1.3 "Inter",system-ui;
  }

  /* Red hover pill like site brand */
  .mmg-brandtile::after{
    content:attr(data-name);
    position:absolute;
    left:10px; right:10px; bottom:8px;
    padding:3px 8px;
    border-radius:999px;
    background:var(--brand);
    color:#fff;
    font-size:11px; line-height:1.2;
    text-align:center;
    opacity:0;
    transform:translateY(6px);
    transition:opacity .15s ease, transform .15s ease;
    pointer-events:none;
    text-transform:capitalize;
    box-shadow:0 2px 8px rgba(209,47,36,.25);
  }
  .mmg-brandtile:hover::after,
  .mmg-brandtile:focus-visible::after{
    opacity:1;
    transform:translateY(0);
  }

  /* ===== CTA ===== */
  .mmg-railcta{
    margin-top:18px;
  }
  .mmg .mmg-cta{
    display:inline-flex; align-items:center; justify-content:center;
    height:36px; padding:0 14px;
    border-radius:8px; border:0;
    background:var(--brand); color:#fff;
    font:700 13px/1 "Inter",system-ui;
    box-shadow:0 6px 16px rgba(0,0,0,.1);
    transition: background .2s ease, box-shadow .2s ease;
    text-decoration:none;
    white-space:nowrap;
    gap: 8px; /* Space between text and icon */
  }
  .mmg .mmg-cta:hover{
    background: color-mix(in srgb, var(--brand) 88%, white 12%);
    color: #fff;
    box-shadow: 0 6px 18px rgba(0,0,0,.18);
  }
  .mmg .mmg-cta svg {
    transition: transform 0.22s ease;
  }
  .mmg .mmg-cta:hover svg {
    transform: translateX(3px);
  }
  .mmg .mmg-cta:active{ transform:translateY(1px); }

  /* Brands mode: top-right header CTA */


  /* MAKE "VIEW ALL BRANDS" STICKY IN BRANDS MODE ONLY (legacy) */
  .mmg[data-mode="brands"] .mmg-railcta{
    position:sticky;
    bottom:16px;
    padding-top:14px;
    margin-top:12px;
    background:linear-gradient(to bottom, rgba(255,255,255,0), #fff 55%);
    z-index:2;
  }

  /* ===== STORES MODE (simple one-column + CTA) ===== */
  .mmg--stores .mmg-head{ margin-bottom:12px; }
  .mmg-1col{
    padding-right:4px;
  }
  .mmg-1col ul{
    list-style:none; margin:0; padding:0;
    max-width:360px;
    display:grid; gap:8px;
  }
  .mmg-1col a{
    display:block; padding:6px 0;
    font:600 16px/1.35 "Inter",system-ui;
    color:var(--ink); text-decoration:none; border-radius:4px;
    transition:color .18s ease;
  }
  .mmg-1col a:hover,
  .mmg-1col a:focus-visible{
    color:var(--brand); background:transparent;
  }

  /* Overlay */
  .mmg-overlay{
    position:fixed; inset:0;
    background:rgba(0,0,0,.45);
    opacity:0; pointer-events:none;
    transition:opacity .18s;
    z-index:9998;
  }
  .mmg-overlay.is-open{ opacity:1; pointer-events:auto; }

  /* ===== Animations ===== */
  @keyframes mmg-fade-up {
    from{opacity:0; transform:translateY(8px)}
    to{opacity:1; transform:none}
  }
  .mmg.mmg-animate [data-stagger] > *{
    opacity:0; transform:translateY(6px);
    animation:mmg-fade-up .26s ease-out both;
  }

  /* Reduced motion */
  @media (prefers-reduced-motion:reduce){
    .mmg, .mmg-overlay{ transition:none !important; }
    .mmg *{ animation:none !important; transform:none !important; }
  }

  @media (max-width:980px){
    .mmg-shell{ padding:20px 18px 24px; }
  }

  /* ===== BRAND LOGO GRID (6 PER ROW DESKTOP, CLEANER LOOK) ===== */
  .mmg-brandgrid{
    display:grid;
    grid-template-columns:repeat(2,minmax(0,1fr));
    column-gap:18px;
    row-gap:14px;
    margin-top:14px;
  }
  @media (min-width:768px){
    .mmg-brandgrid{
      grid-template-columns:repeat(4,minmax(0,1fr));
    }
  }
  @media (min-width:1200px){
    .mmg-brandgrid{
      grid-template-columns:repeat(6,minmax(0,1fr));
    }
  }

  .mmg-brandtile{
    position:relative;
    display:flex; align-items:center; justify-content:center; text-align:center;
    min-height:64px;
    padding:10px 12px;
    border-radius:12px;
    border:1px solid rgba(15,23,42,.06);
    background:#ffffff;
    box-shadow:0 3px 12px rgba(15,23,42,.04);
    text-decoration:none;
    color:var(--ink);
    transition:
      transform .16s ease,
      box-shadow .16s ease,
      border-color .16s ease,
      background .16s ease;
    overflow:hidden;
  }
  .mmg-brandtile:hover{
    transform:translateY(-1px);
    border-color:rgba(15,23,42,.14);
    box-shadow:0 6px 18px rgba(15,23,42,.10);
  }
  .mmg-brandtile:active{
    transform:translateY(0) scale(.985);
  }
  .mmg-brandtile:focus-visible{
    outline:0;
    box-shadow:0 0 0 3px rgba(32,94,214,.35);
  }

  .mmg-brandtile img{
    max-width:100%;
    max-height:44px;
    width:auto;
    height:auto;
    object-fit:contain;
  }
  .mmg-brandfallback{
    font:600 14px/1.3 "Inter",system-ui;
  }

  .mmg-brandtile::after{
    content:attr(data-name);
    position:absolute;
    left:10px; right:10px; bottom:6px;
    padding:3px 8px;
    border-radius:999px;
    background:var(--brand);
    color:#fff;
    font-size:11px; line-height:1.2;
    text-align:center;
    opacity:0;
    transform:translateY(6px);
    transition:opacity .15s ease, transform .15s ease;
    pointer-events:none;
    text-transform:capitalize;
    box-shadow:0 2px 8px rgba(209,47,36,.25);
  }
  .mmg-brandtile:hover::after,
  .mmg-brandtile:focus-visible::after{
    opacity:1;
    transform:translateY(0);
  }

  .mmg[data-mode="brands"] .mmg-railcta{
    position:sticky;
    bottom:18px;
    margin-top:20px;
    padding:0;
    display:flex;
    justify-content:center;
    align-items:center;
    background:transparent;
    z-index:3;
  }
  .mmg[data-mode="brands"] .mmg-railcta::before{
    content:"";
    position:absolute;
    inset:-4px -10px;
    border-radius:999px;
    background:rgba(255,255,255,.96);
    box-shadow:0 6px 18px rgba(15,23,42,.20);
    z-index:-1;
    pointer-events:none;
  }

  /* ===== BRANDS CTA FOOTER ===== */
  .brands-cta-footer {
    margin-top: 24px;
    padding-top: 20px;
    border-top: 2px solid rgba(15, 23, 42, 0.08);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
  }

  .brands-count {
    margin: 0;
    color: #6B7280;
    font-size: 14px;
    font-weight: 500;
  }

  .brands-cta-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 10px 20px;
    background: #D12F24;
    color: white;
    border-radius: 8px;
    font-weight: 600;
    font-size: 14px;
    text-decoration: none;
    transition: all 0.2s ease;
    box-shadow: 0 2px 8px rgba(209, 47, 36, 0.2);
  }

  .brands-cta-btn:hover {
    background: #A02419;
    color: #fff;
    transform: translateY(-1px);
    box-shadow: 0 4px 12px rgba(209, 47, 36, 0.3);
  }

  .brands-cta-btn svg {
    transition: transform 0.2s ease;
  }

  .brands-cta-btn:hover svg {
    transform: translateX(2px);
  }

</style>

{%- comment -%} Resolve Categories & Stores from the main menu (top level only) {%- endcomment -%}
{%- assign cat_links = nil -%}
{%- if menu_obj and menu_obj.links -%}
  {%- assign p_norm = parent_title | default: 'Category' | strip | downcase -%}
  {%- for l in menu_obj.links -%}
    {%- assign t_norm = l.title | strip | downcase -%}
    {%- if t_norm == p_norm or t_norm contains 'categor' or t_norm contains 'shop' -%}
      {%- assign cat_links = l.links -%}{%- break -%}
    {%- endif -%}
  {%- endfor -%}
  {%- if cat_links == nil or cat_links == empty -%}
    {%- for l in menu_obj.links -%}
      {% if l.links and l.links.size > 0 %}
        {%- assign cat_links = l.links -%}{%- break -%}
      {% endif %}
    {%- endfor -%}
  {%- endif -%}
{%- endif -%}

{%- assign stores_links = nil -%}
{%- assign stores_parent_link = nil -%}
{%- if menu_obj and menu_obj.links -%}
  {%- assign s_norm = stores_parent_title | default: 'Stores' | strip | downcase -%}
  {%- for l in menu_obj.links -%}
    {%- assign t_norm = l.title | strip | downcase -%}
    {%- if t_norm == s_norm or t_norm contains 'store' or t_norm contains 'where' -%}
      {%- assign stores_links = l.links -%}
      {%- assign stores_parent_link = l -%}
      {%- break -%}
    {%- endif -%}
  {%- endfor -%}
{%- endif -%}

{%- assign brands_links = nil -%}
{%- if menu_obj and menu_obj.links -%}
  {%- assign b_norm = brands_parent_title | default: 'Brands' | strip | downcase -%}
  {%- for l in menu_obj.links -%}
    {%- assign t_norm = l.title | strip | downcase -%}
    {%- if t_norm == b_norm -%}
      {%- assign brands_links = l.links -%}{%- break -%}
    {%- endif -%}
  {%- endfor -%}
{%- endif -%}

{%- assign stores_title = stores_parent_link.title | default: 'Where to find us' -%}
<div class="mmg {% if _mode == 'stores' %}mmg--stores{% endif %}"
     data-mode="{{ _mode }}" role="dialog" aria-modal="false"
     aria-label="{% if _mode == 'cats' %}All Categories{% elsif _mode == 'brands' %}Brands{% else %}{{ stores_title }}{% endif %}">
  <div class="mmg-shell">
    <div class="mmg-inner">

      {% if _mode == 'stores' %}
        <!-- ================= STORES: ONE-COLUMN + CTA ================= -->
        <div class="mmg-head">
          <span class="mmg-sectiontag">{{ stores_title }}</span>
        </div>

        <div class="mmg-1col">
          <ul data-stagger="stores">
            {% if stores_links and stores_links.size > 0 %}
              {% for s in stores_links %}
                <li><a href="{{ s.url }}">{{ s.title | strip }}</a></li>
              {% endfor %}
            {% endif %}
          </ul>

          {% if stores_links and stores_links.size > 0 and stores_parent_link and stores_parent_link.url %}
          <div class="mmg-railcta">
            <a class="mmg-cta" href="{{ stores_parent_link.url }}">
              View all
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-right-icon lucide-arrow-right"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
            </a>
          </div>
          {% endif %}
        </div>

      {% elsif _mode == 'cats' %}
        <!-- ================= CATEGORIES: TEXT LIST ================= -->
        <div class="mmg-head">
          <span class="mmg-sectiontag">Shop by category</span>
        </div>

        <ul class="mmg-catlist" data-stagger="cats">
          {% assign category_links = cat_links %}
          {% if category_links and category_links.size > 0 %}
            {% for c in category_links %}
              {% assign label = c.title | strip %}
              {% assign url   = c.url | default: '/collections/all' %}
              <li>
                <a class="mmg-catlink" href="{{ url }}">
                  <span class="mmg-catlabel">{{ label }}</span>
                </a>
              </li>
            {% endfor %}
          {% endif %}
        </ul>

        <div class="mmg-railcta">
          <a class="mmg-cta" href="{{ categories_fallback_url | default: '/collections/all' }}">
            View all categories
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-right-icon lucide-arrow-right"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
          </a>
        </div>

      {% elsif _mode == 'brands' %}
        <!-- ================= FEATURED BRANDS ================= -->
        <div class="mmg-head">
          <span class="mmg-sectiontag">Shop our featured brands</span>
        </div>

        <div class="mmg-brandgrid" data-stagger="brands">
          {%- render 'brands-from-header', header_blocks: header_section_blocks -%}
        </div>

        <div class="brands-cta-footer">
          <p class="brands-count">200+ brands available</p>
          <a class="brands-cta-btn" href="{{ brands_fallback_url | default: '/pages/brands' }}">
            View all brands
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M5 12h14"/><path d="m12 5 7 7-7 7"/>
            </svg>
          </a>
        </div>

      {% endif %}

    </div>
  </div>
</div>

<script>
(() => {
  const MODE = {{ _mode | json }};

  function findWrap() {
    return (
      document.querySelector(`[data-mega="${MODE}"]`) ||
      document.querySelector('[data-mega]')
    );
  }

  function initOnce() {
    const wrap  = findWrap();
    if (!wrap) return false;

    const panel = wrap.querySelector('.mmg');
    if (!panel) return false;

    const placeholder = document.createComment('mmg-placeholder');
    const overlay = document.createElement('div'); overlay.className = 'mmg-overlay';

    function headerEl(){
      const h = document.getElementById('ch-header-{{ section.id }}');
      return h || document.querySelector('[data-ch-header], header.site-header, header');
    }
    function calcTopOffset(){
      const header = headerEl();
      const band   = header?.querySelector('.nav-band');
      let top = 0;
      if (band){
        const cs = getComputedStyle(band);
        const r  = band.getBoundingClientRect();
        top = (cs.position === 'fixed' || band.classList.contains('is-fixed'))
              ? Math.round(r.bottom) : Math.round(header.getBoundingClientRect().bottom);
      } else if (header){
        top = Math.round(header.getBoundingClientRect().bottom);
      }
      return Math.max(0, Math.min(top, window.innerHeight * 0.5));
    }

    function setOffsets(){
      const top = calcTopOffset();
      panel.style.top = top + 'px';
      panel.style.maxHeight = `calc(100vh - ${top}px)`;
    }

    function applyStagger(nodes, step=22){
      if(!nodes) return;
      let i=0;
      [...nodes].forEach(el=>{
        el.style.animationDelay = (0.06 + (i*step/1000)) + 's';
        el.style.willChange = 'transform,opacity';
        i++;
      });
    }

    function mount(){
      if (panel.parentNode !== document.body){
        panel.parentNode.insertBefore(placeholder, panel);
        document.body.appendChild(panel);
      }
      if (!overlay.parentNode){
        document.body.appendChild(overlay);
        overlay.addEventListener('click', ()=> wrap.setAttribute('data-open','false'));
      }
      setOffsets();
      panel.classList.add('is-open','mmg-animate');
      requestAnimationFrame(()=> overlay.classList.add('is-open'));

      const cats   = panel.querySelector('[data-stagger="cats"]');
      const brands = panel.querySelector('[data-stagger="brands"]');
      const stores = panel.querySelector('[data-stagger="stores"]');
      if (cats)   applyStagger(cats.children);
      if (brands) applyStagger(brands.children);
      if (stores) applyStagger(stores.children);
    }

    function unmount(){
      overlay.classList.remove('is-open');
      overlay.remove();
      panel.classList.remove('is-open','mmg-animate');
      if (placeholder.parentNode){
        placeholder.parentNode.insertAdjacentElement('beforebegin', panel);
        placeholder.remove();
      }
      panel.style.top = '';
      panel.style.maxHeight = '';
    }

    const mo = new MutationObserver(()=> {
      wrap.getAttribute('data-open')==='true' ? mount() : unmount();
    });
    mo.observe(wrap, { attributes:true, attributeFilter:['data-open'] });

    if (wrap.getAttribute('data-open') === 'true') mount();

    window.addEventListener('scroll', setOffsets,  {passive:true});
    window.addEventListener('resize', setOffsets,  {passive:true});
    panel.addEventListener('mmg:reflow', setOffsets);

    window.CH_Mega = window.CH_Mega || {
      open: (mode=MODE)  => (document.querySelector(`[data-mega="${mode}"]`)||wrap)?.setAttribute('data-open','true'),
      close:(mode=MODE)  => (document.querySelector(`[data-mega="${mode}"]`)||wrap)?.setAttribute('data-open','false')
    };

    return true;
  }

  function boot(){
    if (initOnce()) return;
    let tries = 0, max = 20;
    const iv = setInterval(()=>{
      tries++;
      if (initOnce() || tries>=max) clearInterval(iv);
    }, 100);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', boot, {once:true});
  } else {
    boot();
  }
})();
</script>
