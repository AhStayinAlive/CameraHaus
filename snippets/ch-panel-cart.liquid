{%- comment -%}
Havit-style Cart Drawer — minimal
• Flat item rows with horizontal divider (no cards)
• Floating thumbnail at left
• Compare price (gray, strike) + red price
• Stepper: outline black; + filled black
• Only trash icon below stepper
• Sticky subtotal + terms + CTAs
{%- endcomment -%}

<style>
  /* Typography */
.ch-panel[data-ch-panel="cart"]{
  --font-body: "Inter", system-ui, -apple-system, "Segoe UI", Roboto, "Helvetica Neue",
               Arial, "Noto Sans", sans-serif;
  font-family: var(--font-body);
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
}
.ch-panel[data-ch-panel="cart"] *:not(svg):not(style){
  font-family: var(--font-body);
}

.ch-panel[data-ch-panel="cart"]{
  --ink:#111; --muted:#6B7280; --line:#E5E7EB; --brand:#E0302A;
}
.ch-panel[data-ch-panel="cart"] *{ box-sizing:border-box; }

/* Shell */
.ch-panel[data-ch-panel="cart"] .cart-wrap{ display:grid; grid-template-rows:auto 1fr auto; height:100%; background:#fff; }
.ch-panel[data-ch-panel="cart"] .cart-head{ display:flex; justify-content:space-between; align-items:center; padding:14px 16px; border-bottom:1px solid var(--line); }
.ch-panel[data-ch-panel="cart"] .cart-title{ margin:0; font:800 14px/1 var(--font-body,inherit); text-transform:uppercase; letter-spacing:.02em; }
.ch-panel[data-ch-panel="cart"] .cart-x{ width:32px;height:32px;border:1px solid var(--line);border-radius:999px;background:#fff;display:grid;place-items:center; }

.ch-panel[data-ch-panel="cart"] .cart-body{ min-height:0; overflow:auto; }
.ch-panel[data-ch-panel="cart"] .items{ padding:12px 14px; }

/* Item row: flat with divider */
.ch-panel[data-ch-panel="cart"] .it{ display:grid; grid-template-columns:96px 1fr; gap:14px; padding:16px 0; }
.ch-panel[data-ch-panel="cart"] .it + .it{ border-top:1px solid var(--line); } /* divider between products */

.ch-panel[data-ch-panel="cart"] .it-img{ width:96px; height:96px; object-fit:contain; border-radius:10px; background:transparent; } /* “floating” */
.ch-panel[data-ch-panel="cart"] .it-title{ margin:0; font:800 13px/1.2 var(--font-body); text-transform:uppercase; }
.ch-panel[data-ch-panel="cart"] .it-variant{ margin:.25rem 0 6px; color:var(--muted); font:700 11px/1 var(--font-body); text-transform:uppercase; }
.ch-panel[data-ch-panel="cart"] .it-price{ font:800 14px/1 var(--font-body); color:var(--brand); }
.ch-panel[data-ch-panel="cart"] .it-compare{ color:#9CA3AF; text-decoration:line-through; margin-right:6px; font-weight:800; }

/* Stepper + trash */
.ch-panel[data-ch-panel="cart"] .it-bar{ display:flex; align-items:center; gap:10px; margin-top:10px; }
.ch-panel[data-ch-panel="cart"] .stepper{
  display:grid; grid-template-columns:36px 44px 36px; height:40px; border:1px solid #111; border-radius:12px; overflow:hidden;
}
.ch-panel[data-ch-panel="cart"] .stepper button{ border:0; background:#fff; font:900 16px/1 var(--font-body); color:#111; }
.ch-panel[data-ch-panel="cart"] .stepper button.plus{ background:#111; color:#fff; }
.ch-panel[data-ch-panel="cart"] .stepper input{ border:0; background:transparent; text-align:center; font:800 13px/1 var(--font-body); color:#111; }

.ch-panel[data-ch-panel="cart"] .trash-only{ display:flex; gap:12px; margin-top:8px; }
.ch-panel[data-ch-panel="cart"] .icon-btn{ width:28px;height:28px;border:0;background:transparent; display:grid; place-items:center; color:#6B7280; }
.ch-panel[data-ch-panel="cart"] .icon-btn:hover{ color:#111; }

/* Sticky footer */
.ch-panel[data-ch-panel="cart"] .cart-ft{ position:sticky; bottom:0; background:#fff; border-top:1px solid var(--line); padding:14px 14px 16px; display:grid; gap:12px; }
.ch-panel[data-ch-panel="cart"] .row{ display:flex; justify-content:space-between; align-items:center; }
.ch-panel[data-ch-panel="cart"] .subtotal-lbl{ font:800 14px/1 var(--font-body); }
.ch-panel[data-ch-panel="cart"] .subtotal-val{ font:900 16px/1 var(--font-body); }
.ch-panel[data-ch-panel="cart"] .fine{ color:#6B7280; font:600 12px/1.25 var(--font-body); }
.ch-panel[data-ch-panel="cart"] .terms{ display:flex; gap:8px; align-items:flex-start; font:600 12px/1.35 var(--font-body); }
.ch-panel[data-ch-panel="cart"] .cta{ display:grid; grid-template-columns:1fr 1fr; gap:10px; }
.ch-panel[data-ch-panel="cart"] .btn{ height:44px; border-radius:12px; display:inline-flex; align-items:center; justify-content:center; font:900 13px/1 var(--font-body); text-transform:uppercase; letter-spacing:.06em; text-decoration:none; }
.ch-panel[data-ch-panel="cart"] .btn-outline{ background:#fff; border:1px solid #111; color:#111; }
.ch-panel[data-ch-panel="cart"] .btn-solid{ background:var(--brand); border:1px solid var(--brand); color:#fff; }

/* Nuke leftover theme bits that might overlap */
.ch-panel[data-ch-panel="cart"] .ajaxcart__footer,
.ch-panel[data-ch-panel="cart"] .ajaxcart__product,
.ch-panel[data-ch-panel="cart"] .tools,
.ch-panel[data-ch-panel="cart"] .upsell{ display:none !important; }
/* --- De-bold (cart drawer) --- */
.ch-panel[data-ch-panel="cart"] .cart-title,
.ch-panel[data-ch-panel="cart"] .it-title,
.ch-panel[data-ch-panel="cart"] .it-variant,
.ch-panel[data-ch-panel="cart"] .it-price,
.ch-panel[data-ch-panel="cart"] .it-compare,
.ch-panel[data-ch-panel="cart"] .subtotal-lbl,
.ch-panel[data-ch-panel="cart"] .subtotal-val,
.ch-panel[data-ch-panel="cart"] .fine,
.ch-panel[data-ch-panel="cart"] .terms,
.ch-panel[data-ch-panel="cart"] .btn,
.ch-panel[data-ch-panel="cart"] .stepper button,
.ch-panel[data-ch-panel="cart"] .stepper input {
  font-weight: 400 !important; /* regular */
}

</style>

<div class="cart-wrap" data-cart-root>
  <div class="cart-head">
    <h3 class="cart-title">SHOPPING CART</h3>
    <button class="cart-x" type="button" data-cart-close aria-label="Close">
      <svg width="16" height="16" viewBox="0 0 24 24"><path fill="currentColor" d="m18.3 5.7-1.4-1.4L12 9.2 7.1 4.3 5.7 5.7 10.6 10.6 5.7 15.5l1.4 1.4L12 12l4.9 4.9 1.4-1.4L13.4 10.6z"/></svg>
    </button>
  </div>

  <div class="cart-body">
    <div class="items" data-cart-items></div>
  </div>

  <div class="cart-ft">
    <div class="row">
      <div class="subtotal-lbl">Subtotal:</div>
      <div class="subtotal-val" data-cart-subtotal>—</div>
    </div>
    <div class="fine">Taxes and shipping calculated at checkout</div>
    <label class="terms"><input type="checkbox" id="agree-terms"> <span>I agree with the <a href="/policies/terms-of-service" target="_blank" rel="noopener">terms and conditions</a>.</span></label>
    <div class="cta">
      <a class="btn btn-outline" href="/cart">View cart</a>
      <a class="btn btn-solid" href="/checkout" data-checkout>Check out</a>
    </div>
  </div>
</div>

<script>
(() => {
  const root = document.querySelector('.ch-panel[data-ch-panel="cart"]');
  if (!root) return;

  const itemsEl = root.querySelector('[data-cart-items]');
  const subEl   = root.querySelector('[data-cart-subtotal]');
  const agree   = root.querySelector('#agree-terms');
  const checkoutBtn = root.querySelector('[data-checkout]');
  const closeBtn = root.querySelector('[data-cart-close]');

  const nf = new Intl.NumberFormat({{ request.locale.iso_code | json }} || 'en-PH',
    { style:'currency', currency: {{ shop.currency | json }} || 'PHP' });
  const money = c => nf.format((Number(c)||0)/100);
  const esc = s => (s||'').replace(/[&<>"']/g,m=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[m]));
  const thumb = u => u ? u.replace(/(\.(?:jpe?g|png|webp|gif))(?:\?.*)?$/i,'_224x$1') : '';

  function rowTpl(line, idx){
    const cp = Number(line.compare_at_price || 0);
    return `
      <div class="it" data-line="${idx+1}">
        <img class="it-img" src="${thumb(line.image || (line.featured_image && line.featured_image.url))}" alt="${esc(line.product_title||'')}">
        <div>
          <h4 class="it-title">${esc(line.product_title || line.title || '')}</h4>
          ${line.variant_title && line.variant_title !== 'Default Title' ? `<div class="it-variant">${esc(line.variant_title)}</div>` : ``}
          <div>
            ${cp>line.final_price?`<span class="it-compare">${money(cp)}</span>`:''}
            <span class="it-price">${money(line.final_price)}</span>
          </div>

          <div class="it-bar">
            <div class="stepper">
              <button type="button" data-dec aria-label="Decrease">−</button>
              <input type="text" value="${line.quantity}" inputmode="numeric" data-qty>
              <button type="button" class="plus" data-inc aria-label="Increase">+</button>
            </div>
          </div>
          <div class="trash-only">
            <button class="icon-btn" type="button" title="Remove" data-remove>
              <svg width="18" height="18" viewBox="0 0 24 24"><path fill="currentColor" d="M6 7h12v2H6zm1 3h10l-1 10H8L7 10zm3-5h4l1 2H9l1-2z"/></svg>
            </button>
          </div>
        </div>
      </div>`;
  }

  function bindRow(row){
    const line = Number(row.getAttribute('data-line'));
    const qty  = row.querySelector('[data-qty]');
    const dec  = row.querySelector('[data-dec]');
    const inc  = row.querySelector('[data-inc]');
    const rmv  = row.querySelector('[data-remove]');

    const setQty = q => {
      q = Math.max(0, Number(q)||0);
      fetch('/cart/change.js', {
        method:'POST',
        headers:{'Content-Type':'application/json','Accept':'application/json'},
        body: JSON.stringify({ line, quantity: q })
      }).then(r=>r.json()).then(paint).catch(()=>paint());
    };

    dec && dec.addEventListener('click', ()=> setQty((Number(qty.value)||0)-1));
    inc && inc.addEventListener('click', ()=> setQty((Number(qty.value)||0)+1));
    qty && qty.addEventListener('change', ()=> setQty(qty.value));
    rmv && rmv.addEventListener('click', ()=> setQty(0));
  }

  function paint(cart){
    itemsEl.innerHTML = '';
    if (!cart || !cart.items || !cart.items.length){
      itemsEl.innerHTML = `<div style="padding:24px;color:#6B7280;font:600 14px/1.4 var(--font-body)">Your cart is empty.</div>`;
      subEl.textContent = money(0);
      return;
    }
    cart.items.forEach((l,i)=> itemsEl.insertAdjacentHTML('beforeend', rowTpl(l,i)) );
    itemsEl.querySelectorAll('.it').forEach(bindRow);
    subEl.textContent = money(cart.items_subtotal_price || 0);
  }

  function refresh(){ fetch('/cart.js',{headers:{'Accept':'application/json'},cache:'no-store'}).then(r=>r.json()).then(paint); }

  // block checkout until terms checked (Havit parity)
  checkoutBtn && checkoutBtn.addEventListener('click', (e)=>{ if (agree && !agree.checked){ e.preventDefault(); agree.focus(); } });

  closeBtn && closeBtn.addEventListener('click', ()=> document.dispatchEvent(new CustomEvent('ch:panel', { detail: { name:'cart', open:false } })));

  document.addEventListener('ch:panel', (e)=>{ const d=e && e.detail; if(d && d.name==='cart' && d.open) refresh(); });

  refresh();
})();
</script>
<style>
/* =============== 1) GLOBAL TYPE + TOKENS ================= */
:root{
  --font-body: "Inter", system-ui, -apple-system, "Segoe UI", Roboto, "Helvetica Neue", Arial, "Noto Sans", sans-serif;
  --ink:#111;
  --muted:#6b7280;
  --line:#e5e7eb;
  --brand:#e03a2f;
  --brand-600:#d12f24;
  --panel-width: min(560px, 92vw);
  --panel-pad: 14px;
  --radius-8: 8px;
  --radius-12: 12px;
}

/* your exact request */
*, *::before, *::after{ box-sizing:border-box; font-family: var(--font-body); }

/* Kill stray font overrides (e.g., Montserrat in the menu drawer) */
#ch-menu-drawer, #ch-menu-drawer *{ font-family: var(--font-body) !important; }

/* =============== 2) CTA BUTTON SYSTEM (ALL BUTTONS) ================= */
/* Base CTA: height 32, padding 0 14, radius 8, 13/600, brand background */
.btn, .btn-solid, .btn-outline, 
.ms-island .sh-go,                          /* search island button */
.ch-tabs .ch-tab.cta,                       /* if you use any tab as CTA */
.ch-panel [data-cta],                       /* optional hook */
button.ch-btn--cta{
  height:32px;
  padding:0 14px;
  border-radius:var(--radius-8);
  font-size:13px;
  font-weight:600;
  line-height:1;
  text-transform:none;                      /* “Capital first” by content */
  color:#fff;
  background:var(--brand);
  border:1px solid var(--brand);
  display:inline-flex; align-items:center; justify-content:center;
  cursor:pointer; user-select:none; text-decoration:none;
}

/* Hover for all CTAs */
.btn:hover, .btn-solid:hover, .btn-outline:hover,
.ms-island .sh-go:hover, .ch-panel [data-cta]:hover, button.ch-btn--cta:hover{
  background:var(--brand-600); border-color:var(--brand-600);
}

/* Make cart drawer CTAs conform (they used a taller 44px before) */
.ch-panel[data-ch-panel="cart"] .btn,
.ch-panel[data-ch-panel="cart"] .btn-outline,
.ch-panel[data-ch-panel="cart"] .btn-solid{ height:32px !important; }

/* If you still want a neutral/outline version somewhere, use .btn--ghost */
.btn--ghost{
  background:#fff !important; color:var(--ink) !important; border:1px solid var(--ink) !important;
}

/* =============== 3) CLOSE “X” — one look, one behavior ================= */
.ch-x, .ch-close, .cart-x, .ms-x{
  width:32px; height:32px;
  display:grid; place-items:center;
  border-radius:999px;
  border:1px solid var(--line);
  background:#fff; color:var(--ink);
  transition:transform .12s ease, background-color .15s ease, border-color .15s ease;
}
.ch-x:hover, .ch-close:hover, .cart-x:hover, .ms-x:hover{
  background:#f9fafb; border-color:#dfe3e8; transform:scale(1.02);
}
.ch-x:active, .ch-close:active, .cart-x:active, .ms-x:active{ transform:scale(.96); }
.ch-x svg, .ch-close svg, .cart-x svg, .ms-x svg{
  width:18px; height:18px; stroke:currentColor; stroke-width:2; fill:none; vector-effect:non-scaling-stroke;
}

/* Place the X consistently: right side of sticky headers */
.ch-mdrawer__header, .ch-panel__hd{
  position:sticky; top:0; z-index:2;
  display:flex; align-items:center; justify-content:space-between; gap:8px;
  background:#fff; color:var(--ink);
  padding:var(--panel-pad);
  border-bottom:1px solid var(--line);
}
.ch-mdrawer__title, .ch-panel__title{ font:800 14px/1.2 var(--font-body); }

/* Ensure the X actually closes — add a shared data-close hook */
.ch-close, .cart-x, .ms-x{ cursor:pointer; }
.ch-close, .cart-x, .ms-x{ /* also treat them as data-close targets */ }
.ch-close[data-close], .cart-x[data-close], .ms-x[data-close]{}

/* =============== 4) PANEL CONSISTENCY (width, edges, gaps) ============= */
/* Right-side panels (cart, wishlist, legacy panels) */
.ch-panel__pn{
  width:var(--panel-width) !important;
  border-left:1px solid var(--line);
  background:#fff; color:var(--ink);
}
.ch-panel__ov{ background:rgba(0,0,0,.45); }

/* Left menu drawer: match widths & edges but keep left slide-in */
#ch-menu-drawer .ch-mdrawer__panel{
  width:var(--panel-width) !important;
  max-width:none !important;
  border-right:1px solid var(--line);
}

/* Panel bodies: consistent inner spacing & scroll behavior */
.ch-panel__body, .ch-pane{
  padding:10px var(--panel-pad) 20px !important;
  -webkit-overflow-scrolling:touch; touch-action:pan-y;
}

/* Lists/rows inside drawers: unify text sizes/weights */
.ch-row .tx{ font:600 14px/1.2 var(--font-body); color:var(--ink); }
.ch-row:hover{ background:#fafafa; }

/* Tabs keep look but use Inter + brand token */
.ch-tab{ font:600 13px/1 var(--font-body); color:#374151; }
.ch-tab.is-active{ color:var(--brand); box-shadow: inset 0 -2px 0 var(--brand); }

/* Search island: reuse the same X and button styles */
.ms-portal .ms-island{ border:1px solid var(--line); border-radius:18px; }
.ms-portal .ms-x{ position:absolute; top:10px; right:10px; }
.ms-portal .sh-inp{ border:1px solid var(--line); border-radius:12px; padding-right:118px; }
.ms-portal .sh-go{ border-radius:var(--radius-8); border:1px solid var(--brand); background:var(--brand); color:#fff; }

/* Cart rows — keep your minimalist look but align type/spacing */
.ch-panel[data-ch-panel="cart"] .cart-head{ padding:var(--panel-pad); }
.ch-panel[data-ch-panel="cart"] .cart-body{ padding:0; }
.ch-panel[data-ch-panel="cart"] .items{ padding:12px var(--panel-pad); }
.ch-panel[data-ch-panel="cart"] .cart-ft{ padding:14px var(--panel-pad) 16px; }

/* Wishlist “empty” footer button as CTA */
.wl-body + .mc-ft .btn-view{
  display:inline-flex; align-items:center; justify-content:center;
  height:32px; padding:0 14px; border-radius:var(--radius-8);
  background:var(--brand); border:1px solid var(--brand); color:#fff; font:600 13px/1 var(--font-body);
}
.wl-body + .mc-ft .btn-view:hover{ background:var(--brand-600); border-color:var(--brand-600); }
</style>

<script>
/* =============== 5) ONE CLOSE BEHAVIOR FOR ALL “X”s ====================
   - Works for menu drawer, cart/wishlist panels, and search island.
   - Just add `data-close` on any X button (I added it for you in the notes). */
(function(){
  // Close helpers (reuse your existing public APIs if present)
  const closePanelByEl = (el) => {
    const shell = el.closest('.ch-panel');                 // cart/wishlist/etc.
    if (shell && window.CHPanels){ CHPannels?.close?.(shell.getAttribute('data-ch-panel')); return; }
    const menu = el.closest('#ch-menu-drawer');            // left menu drawer
    if (menu && window.CHMenuDrawer){ CHMenuDrawer.close(); return; }
    const searchPortal = el.closest('.ms-portal');         // search island
    if (searchPortal){ searchPortal.removeAttribute('data-open'); return; }
  };

  document.addEventListener('click', (e) => {
    const x = e.target.closest('[data-close]');
    if (x){ e.preventDefault(); closePanelByEl(x); }
    // Overlay click for generic .ch-panel overlays
    if (e.target.classList && e.target.classList.contains('ch-panel__ov')){
      closePanelByEl(e.target);
    }
  }, true);
})();
</script>
