{%- comment -%}
CART DRAWER — full version with inventory auto-fix on add-to-cart
{%- endcomment -%}



<div class="cart-wrap" data-cart-root>
  <div class="cart-head">
    <h3 class="cart-title">SHOPPING CART</h3>
    <button class="cart-x" type="button" data-cart-close aria-label="Close">
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <path d="M18 6L6 18M6 6l12 12"
          stroke="currentColor" stroke-width="1.9"
          stroke-linecap="round" stroke-linejoin="round" fill="none"/>
      </svg>
    </button>
  </div>

  {% render 'ch-cart-alert' %}

  <div class="cart-body">
    <div class="items" data-cart-items></div>
  </div>

  <div class="cart-ft">
    <div class="row">
      <div class="subtotal-lbl" style="color: var(--heading-color, #4b5563);">
        Subtotal:
      </div>
      <div class="subtotal-val" data-cart-subtotal>—</div>
    </div>

    <div class="fine">Taxes and shipping calculated at checkout</div>

    <div class="cta">
      <a class="btn btn-outline" href="/cart">View cart</a>
      <a class="btn btn-solid" href="/checkout" data-checkout>Check out</a>
    </div>
  </div>
</div>

<script>
  window.chRoutes = {
    cartUrl: {{ routes.cart_url | json }},
    locale: {{ request.locale.iso_code | json }},
    currency: {{ shop.currency | json }}
  };
</script>


<!-- CTA HARDENER -->
<script>
(function(){
  const panel = document.querySelector('.ch-panel[data-ch-panel="cart"]');
  if (!panel) return;

  function ensureCTAs(){
    const ft = panel.querySelector('.cart-ft'); if (!ft) return;

    let cta = ft.querySelector('.cta');
    if (!cta) {
      cta = document.createElement('div');
      cta.className = 'cta';
      ft.appendChild(cta);
    }

    let view = cta.querySelector('a[href="/cart"]');
    if (!view) {
      view = document.createElement('a');
      view.href = '/cart';
      view.className = 'btn btn-outline';
      view.textContent = 'View cart';
      cta.appendChild(view);
    }

    let go = cta.querySelector('[data-checkout], a[href*="/checkout"], [name="checkout"]');
    if (!go) {
      go = document.createElement('a');
      go.href = '/checkout';
      go.setAttribute('data-checkout','');
      go.className = 'btn btn-solid';
      go.textContent = 'Check out';
      cta.appendChild(go);
    }

    cta.removeAttribute('hidden');
    cta.style.display = 'grid';
    [view, go].forEach(el => { el.style.display = 'flex'; el.style.width = '100%'; });
  }

  ensureCTAs();
  document.addEventListener('cart:refreshed', ensureCTAs);

  const ft = panel.querySelector('.cart-ft');
  if (ft) {
    new MutationObserver(()=>ensureCTAs()).observe(ft, { childList:true, subtree:true });
  }
})();
</script>

