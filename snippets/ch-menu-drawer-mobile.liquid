{%- comment -%}
Mobile Menu Drawer — lines to edges, darker active cats, slide animations, inside black X (refined position & styling)
{%- endcomment -%}

{%- assign _is_open = is_open | default: false -%}
{%- assign _main_handle = main_handle | default: 'main-menu-copy' -%}
{%- assign _store_url = store_locator_url | default: '/pages/store-locator' -%}
{%- assign _main_menu = linklists[_main_handle] -%}

<style>
#ch-menu-drawer{
  --brand:#D12F24;
  --line:#e2e2e2;
  --ink:#111; --muted:#6b7280;
  --tab-idle:#ededed; --tab-active:#e0e0e0; /* darker when active */
  --icon-size:18px;
  --ch-topbar-h: 60px;
  position:fixed; inset:0; pointer-events:none; z-index:1300;
  font-family: var(--font-sans, ui-sans-serif, system-ui), sans-serif;
}
#ch-menu-drawer.is-open{ pointer-events:auto; }

/* overlay */
#ch-menu-drawer .ch-mdrawer__overlay{
  position:absolute; inset:0; background:rgba(0,0,0,.45);
  opacity:0; visibility:hidden; pointer-events:none;
  transition:opacity .22s, visibility .22s; z-index:10;
}
#ch-menu-drawer.is-open .ch-mdrawer__overlay{ opacity:1; visibility:visible; pointer-events:auto; }

/* panel */
#ch-menu-drawer .ch-mdrawer__panel{
  --panel-w: min(90vw, 400px);
  position:absolute;
  top:0;
  left:0;
  width:var(--panel-w);
  height:100%;  background:#fff;
  color:var(--ink);
  border-right:1px solid var(--line);
  transform:translateX(-104%);
  /* SMOOTHER: 0.4s with custom ease */
  transition:transform .4s cubic-bezier(0.25, 1, 0.5, 1);
  z-index:11;
  display:flex;
  flex-direction:column;
  padding-top:0 !important; /* prevent inheriting body padding */
  margin-top:0 !important; /* prevent inherited margin */
}

#ch-menu-drawer.is-open .ch-mdrawer__panel{ 
  transform:translateX(0); 
}


/* tabs */
#ch-menu-drawer .ch-topbar{
  position:absolute;
  top:0 !important;
  left:0;
  right:0;
  width:100%; /* force width */
  height:var(--ch-topbar-h);
  margin:0 !important;
  padding-top:0 !important;

  background:#f6f6f6;
  border-bottom:1px solid var(--line);
  padding-right:56px; /* space for the X button */
  z-index:12;
  display: flex;
  align-items: stretch;
}


#ch-menu-drawer .ch-tabs{ display:grid; grid-template-columns:1fr 1fr; flex:1; height:100%; }
#ch-menu-drawer .ch-tab{
  padding:0 16px; height:100%; display:flex; align-items:center; justify-content:center;
  font-weight:700; font-size:14px; color:#2b2b2b;
  background:var(--tab-idle); border:0; border-bottom:2px solid transparent;
  border-radius:0; cursor:pointer; position:relative; text-transform:uppercase; letter-spacing:.02em;
  transition: border-color .2s ease, background .2s ease;
}
#ch-menu-drawer .ch-tab + .ch-tab{ border-left:1px solid var(--line); }
#ch-menu-drawer .ch-tab.is-active{ 
  background:var(--tab-active); 
  border-bottom-color:var(--brand);
}

/* INSIDE black “X” — nicer, top-right placement */

#ch-menu-drawer .ch-close-outer svg{ width:22px; height:22px; display:block; margin:auto; }
#ch-menu-drawer.is-open .ch-close-outer{ display:block; }
#ch-menu-drawer .ch-close-outer:hover{
  background:#f3f3f3; border-color:#cfcfcf; color:#000;
  box-shadow:0 2px 6px rgba(0,0,0,.12); transform:translateZ(0) scale(1.02);
}
#ch-menu-drawer .ch-close-outer:active{ transform:scale(.98); }
#ch-menu-drawer .ch-close-outer:focus-visible{
  outline:2px solid #111; outline-offset:2px;
}

/* panes + tab slide animation */
#ch-menu-drawer .ch-tabpanes{flex:1; overflow:auto; -webkit-overflow-scrolling:touch; padding-top:var(--ch-topbar-h);}
#ch-menu-drawer .ch-pane{padding:0 0 22px;}
#ch-menu-drawer .ch-pane[data-anim="slide-left"]{animation:slideLeft .22s ease both;}
#ch-menu-drawer .ch-pane[data-anim="slide-right"]{animation:slideRight .22s ease both;}
@keyframes slideLeft{from{opacity:0; transform:translateX(14px)}to{opacity:1; transform:translateX(0)}}
@keyframes slideRight{from{opacity:0; transform:translateX(-14px)}to{opacity:1; transform:translateX(0)}}

/* lists — full-bleed lines */
#ch-menu-drawer .ch-list{list-style:none; margin:0; padding:0; background:#fff;}
#ch-menu-drawer .ch-list--lines > li{border-top:1px solid var(--line); margin:0;}
#ch-menu-drawer .ch-list--lines > li:first-child{border-top:0;}
#ch-menu-drawer .ch-row{
  position:relative; display:flex; align-items:center; gap:10px;
  min-height:56px; padding:0 16px; text-decoration:none; color:inherit;
}
#ch-menu-drawer .ch-row:hover{ background:#fafafa; }
#ch-menu-drawer .tx{font-weight:500; font-size:14.5px; flex:1 1 auto;}

/* icons smaller (menu only) */
#ch-menu-drawer .ico{ width:var(--icon-size); height:var(--icon-size); display:inline-flex; align-items:center; justify-content:center; color:#4b5563; }
#ch-menu-drawer .ico svg{ width:100%; height:100%; }

/* CATEGORIES: parent rows darker when open; end-to-end borders  */
#ch-menu-drawer .ch-list--cats > .ch-cat-card{ border-top:1px solid var(--line); }
#ch-menu-drawer .ch-list--cats > .ch-cat-card:last-child{ border-bottom:1px solid var(--line); }
#ch-menu-drawer .ch-list--cats .ch-row{ padding-right:56px; }
#ch-menu-drawer .ch-cat-card.is-open > .ch-row{ background:#e9e9e9; }

/* plus toggle */
#ch-menu-drawer .ch-cat-toggle{
  position:absolute; right:12px; top:50%; transform:translateY(-50%);
  width:28px; height:28px; border:1px solid rgba(209,47,36,.55); border-radius:8px;
  background:#fff; color:var(--brand); display:flex; align-items:center; justify-content:center;
  cursor:pointer; transition:background .16s, border-color .16s, transform .18s ease;
}
#ch-menu-drawer .ch-cat-toggle::before{
  content:""; width:14px; height:14px; background:currentColor;
  -webkit-mask:url('data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><path d="M12 5v14M5 12h14" stroke="black" stroke-width="2" stroke-linecap="round"/></svg>') center/14px 14px no-repeat;
          mask:url('data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><path d="M12 5v14M5 12h14" stroke="black" stroke-width="2" stroke-linecap="round"/></svg>') center/14px 14px no-repeat;
}
#ch-menu-drawer .ch-cat-card.is-open .ch-cat-toggle{
  background:rgba(209,47,36,.08); border-color:rgba(209,47,36,.75); transform:translateY(-50%) rotate(180deg);
}
#ch-menu-drawer .ch-cat-card.is-open .ch-cat-toggle::before{
  -webkit-mask:url('data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><path d="M5 12h14" stroke="black" stroke-width="2" stroke-linecap="round"/></svg>') center/14px 14px no-repeat;
          mask:url('data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><path d="M5 12h14" stroke="black" stroke-width="2" stroke-linecap="round"/></svg>') center/14px 14px no-repeat;
}

/* SUBLIST */
#ch-menu-drawer .ch-sub{
  --indent: 18px;
  list-style:none; margin:0; padding:0 0 8px var(--indent);
  max-height:0; opacity:0; overflow:hidden;
  transition:max-height .28s ease, opacity .22s ease;
}
#ch-menu-drawer .ch-sub.show{ max-height:600px; opacity:1; }
#ch-menu-drawer .ch-sub li{
  border-top:1px solid var(--line);
  margin-left:calc(-1 * var(--indent));
  width:calc(100% + var(--indent));
}
#ch-menu-drawer .ch-sub li:first-child{ border-top:1px solid var(--line); }
#ch-menu-drawer .ch-sub li a{
  display:block; min-height:48px; padding:0 16px 0 calc(var(--indent) + 8px);
  line-height:48px; font-size:13.5px; color:#4b5563; text-decoration:none;
}
#ch-menu-drawer .ch-sub li a:hover{ background:#f7f7f7; }
#ch-menu-drawer .ch-close-outer{
  display:none;
  position:absolute;
  right:12px;
  top:10px;
  z-index:12;
  width:44px;
  height:44px;
  padding:0;
  border:none;
  border-radius:0;
  background:transparent;
  box-shadow:none;
  color:#111;
  cursor:pointer;
  display:flex;
  align-items:center;
  justify-content:center;
  appearance:none;
  -webkit-appearance:none;
  transition:color .12s ease;
}

#ch-menu-drawer.is-open .ch-close-outer{
  display:flex;
}

#ch-menu-drawer .ch-close-outer svg{
  width:22px;
  height:22px;
}

/* make sure hover has NO box / bg */
#ch-menu-drawer .ch-close-outer:hover,
#ch-menu-drawer .ch-close-outer:active{
  background:transparent;
  box-shadow:none;
  border:none;
  color:#D12F24; /* red X on hover/click */
}

#ch-menu-drawer .ch-close-outer:focus-visible{
  outline:2px solid #111;
  outline-offset:2px;
}
#ch-menu-drawer .ch-tab:focus{ outline:none; }

</style>

<div id="ch-menu-drawer"
     class="ch-mdrawer"
     aria-hidden="true">
  <div class="ch-mdrawer__overlay" data-close></div>

  <aside class="ch-mdrawer__panel" role="dialog" aria-modal="true" aria-label="Menu">

    <!-- Tabs -->
    <div class="ch-topbar">
      <div class="ch-tabs" role="tablist" aria-label="Main navigation tabs">
        <button id="ch-tab-menu" class="ch-tab is-active" role="tab"
                aria-selected="true" aria-controls="ch-panel-menu">Menu</button>
        <button id="ch-tab-cats" class="ch-tab" role="tab"
                aria-selected="false" aria-controls="ch-panel-cats">Categories</button>
      </div>
    </div>

    <div class="ch-tabpanes">
      <!-- MENU -->
      <section id="ch-panel-menu" class="ch-pane is-on" role="tabpanel"
               aria-labelledby="ch-tab-menu" aria-hidden="false" style="display:block;">
        <ul class="ch-list ch-list--lines">
          <li>
            <a class="ch-row" href="/pages/brands">
              <span class="ico" aria-hidden="true">
                <!-- brands -->
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M13.997 4a2 2 0 0 1 1.76 1.05l.486.9A2 2 0 0 0 18.003 7H20a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V9a2 2 0 0 1 2-2h1.997a2 2 0 0 0 1.759-1.048l.489-.904A2 2 0 0 1 10.004 4z"/><circle cx="12" cy="13" r="3"/></svg>
              </span>
              <span class="tx">Brands</span>
            </a>
          </li>
          <li>
            <a class="ch-row" href="/pages/store-branches">
              <span class="ico" aria-hidden="true">
                <!-- store locator -->
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 10c0 4.993-5.539 10.193-7.399 11.799a1 1 0 0 1-1.202 0C9.539 20.193 4 14.993 4 10a8 8 0 0 1 16 0"/><circle cx="12" cy="10" r="3"/></svg>
              </span>
              <span class="tx">Store locator</span>
            </a>
          </li>
          <li>
            <a class="ch-row" href="{{ routes.search_url }}" data-panel-open="search">
              <span class="ico" aria-hidden="true">
                <!-- search -->
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m21 21-4.34-4.34"/><circle cx="11" cy="11" r="8"/></svg>
              </span>
              <span class="tx">Search</span>
            </a>
          </li>
          <li>
            <a class="ch-row" href="{{ routes.account_login_url }}">
              <span class="ico" aria-hidden="true">
                <!-- login -->
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="5"/><path d="M20 21a8 8 0 0 0-16 0"/></svg>
              </span>
              <span class="tx">Login / Register</span>
            </a>
          </li>
          <li>
            <a class="ch-row" href="{{ routes.cart_url }}">
              <span class="ico" aria-hidden="true">
                <!-- cart -->
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="8" cy="21" r="1"/><circle cx="19" cy="21" r="1"/><path d="M2.05 2.05h2l2.66 12.42a2 2 0 0 0 2 1.58h9.78a2 2 0 0 0 1.95-1.57l1.65-7.43H5.12"/></svg>
              </span>
              <span class="tx">Cart</span>
            </a>
          </li>
        </ul>
      </section>

      {%- assign _cats_index = -1 -%}
      {%- if _main_menu and _main_menu.links.size > 0 -%}
        {%- for top in _main_menu.links -%}
          {%- assign _t = top.title | strip | downcase -%}
          {%- if _t == 'category' or _t == 'categories' -%}
            {%- assign _cats_index = forloop.index0 -%}{%- break -%}
          {%- endif -%}
        {%- endfor -%}
      {%- endif -%}

      <!-- CATEGORIES -->
      <section id="ch-panel-cats" class="ch-pane" role="tabpanel"
               aria-labelledby="ch-tab-cats" aria-hidden="true" hidden style="display:none;">
        <ul class="ch-list ch-list--lines ch-list--cats">
          {%- if _main_menu and _cats_index > -1 -%}
            {%- assign cats_parent = _main_menu.links[_cats_index] -%}
            {%- for l in cats_parent.links -%}
              {%- assign n = l.title | strip | downcase -%}
              {%- unless n == 'brands' -%}
              <li class="ch-cat-card">
                <a class="ch-row has-toggle" href="{{ l.url }}">
                  <span class="tx">{{ l.title }}</span>
                  {% if l.links.size > 0 %}
                    <button class="ch-cat-toggle" type="button"
                            aria-label="Expand {{ l.title }}" aria-expanded="false"
                            aria-controls="sub-{{ forloop.index }}"></button>
                  {% endif %}
                </a>
                {% if l.links.size > 0 %}
                  <ul id="sub-{{ forloop.index }}" class="ch-sub">
                    {% for s in l.links %}
                      <li><a href="{{ s.url }}">{{ s.title }}</a></li>
                    {% endfor %}
                  </ul>
                {% endif %}
              </li>
              {%- endunless -%}
            {%- endfor -%}
          {%- else -%}
            <li><a class="ch-row" href="/collections/all"><span class="tx">All Categories</span></a></li>
          {%- endif -%}
        </ul>
      </section>
    </div>

    <!-- INSIDE black “X”; only visible when open -->
    <button type="button" class="ch-close-outer" aria-label="Close" data-close>
      <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
        <path d="M18 6 6 18M6 6l12 12" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
      </svg>
    </button>

  </aside>
</div>

<script>
(function(){
  const root = document.getElementById('ch-menu-drawer'); if(!root) return;
  const html = document.documentElement;
  const overlay = root.querySelector('.ch-mdrawer__overlay');

  let opener = null;
  let currentPane = 'menu';

  const setOpen = (open) => {
    root.classList.toggle('is-open', !!open);
    root.setAttribute('aria-hidden', open ? 'false' : 'true');
    html.style.overflow = open ? 'hidden' : '';

    if (open) {
      opener = document.activeElement;
      (root.querySelector('button, a[href]') || root).focus();
    } else {
      opener && opener.focus && opener.focus({ preventScroll: true });
    }
  };


  document.addEventListener('click', (e)=>{
    if(e.target.closest('[data-panel-open="menu"],[data-open-drawer],[data-drawer-open]')){ e.preventDefault(); setOpen(true); }
    if(e.target.closest('#ch-menu-drawer [data-close]') || e.target === overlay){ e.preventDefault(); setOpen(false); }
  }, true);

  document.addEventListener('keydown', (e)=>{
    if(!root.classList.contains('is-open')) return;
    if(e.key === 'Escape'){ e.preventDefault(); setOpen(false); }
  }, true);

  // tabs
  const btnMenu  = root.querySelector('#ch-tab-menu');
  const btnCats  = root.querySelector('#ch-tab-cats');
  const paneMenu = root.querySelector('#ch-panel-menu');
  const paneCats = root.querySelector('#ch-panel-cats');

  function showPane(showCats){
    const next = showCats ? 'cats' : 'menu';
    if(next === currentPane) return;

    const entering = showCats ? paneCats : paneMenu;
    const leaving  = showCats ? paneMenu : paneCats;

    btnMenu.classList.toggle('is-active', !showCats);
    btnMenu.setAttribute('aria-selected', (!showCats).toString());
    btnCats.classList.toggle('is-active', showCats);
    btnCats.setAttribute('aria-selected', showCats.toString());

    leaving.hidden = true; leaving.style.display = 'none';
    entering.hidden = false; entering.style.display = 'block';
    entering.setAttribute('data-anim', next === 'cats' ? 'slide-left' : 'slide-right');
    setTimeout(()=>entering.removeAttribute('data-anim'), 250);

    currentPane = next;
  }
  btnMenu && btnMenu.addEventListener('click', (e)=>{ e.preventDefault(); showPane(false); });
  btnCats && btnCats.addEventListener('click', (e)=>{ e.preventDefault(); showPane(true); });

  // start with all subcats CLOSED
  root.querySelectorAll('.ch-sub').forEach(ul=>ul.classList.remove('show'));
  root.querySelectorAll('.ch-cat-toggle').forEach(btn=>btn.setAttribute('aria-expanded','false'));

  // accordion with slide animation
  root.addEventListener('click', (e)=>{
    const tg = e.target.closest('.ch-cat-toggle'); if(!tg) return;
    e.preventDefault();
    const id = tg.getAttribute('aria-controls');
    const sub = id && root.querySelector('#'+id);
    const open = tg.getAttribute('aria-expanded') === 'true';

    // close others
    root.querySelectorAll('.ch-cat-toggle[aria-expanded="true"]').forEach(btn=>{
      if(btn !== tg){
        btn.setAttribute('aria-expanded','false');
        const sib = root.querySelector('#'+btn.getAttribute('aria-controls'));
        if(sib){ sib.classList.remove('show'); }
        btn.closest('.ch-cat-card')?.classList.remove('is-open');
      }
    });

    tg.setAttribute('aria-expanded', (!open).toString());
    if(sub){ sub.classList.toggle('show', !open); }
    tg.closest('.ch-cat-card')?.classList.toggle('is-open', !open);
  }, true);

  // expose if needed
  window.CHMenuDrawer = {
    open: ()=>setOpen(true),
    close: ()=>setOpen(false),
    showCategories:()=>showPane(true),
    showMenu:()=>showPane(false)
  };
})();
</script>
