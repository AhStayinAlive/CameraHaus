{%- comment -%}
Mobile Menu Drawer (left slide)
Usage: {% render 'ch-menu-drawer-mobile', is_open: false %}
Triggers supported out of the box:
- [data-open-drawer]  (legacy)
- [data-drawer-open]
- [data-panel-open="menu"]
{%- endcomment -%}

<div class="ch-drawer only-m{% if is_open %} is-open{% endif %}"
     id="ch-menu-drawer"
     aria-hidden="{% if is_open %}false{% else %}true{% endif %}"
     data-ch-drawer="menu">
  <div class="ch-drawer__ov" data-close></div>
  <aside class="ch-drawer__pn" role="dialog" aria-modal="true" aria-label="Menu">
    <div class="ch-drawer__hd">
      <div class="title">Menu</div>
      <button type="button" class="btn" aria-label="Close" data-close>
        <svg class="ico" viewBox="0 0 24 24"><path d="M18.3 5.7 12 12l6.3 6.3-1.4 1.4L10.6 13.4 4.3 19.7 2.9 18.3 9.2 12 2.9 5.7 4.3 4.3l6.3 6.3L16.9 4.3z"/></svg>
      </button>
    </div>

    <div class="grid">
      <div class="col">
        <nav aria-label="Primary">
          <ul class="list">
            <li><a href="{{ routes.root_url }}">Home</a></li>
            <li><a href="{{ section.settings.store_locator_url | default: '/pages/store-locator' }}">Find a store near you</a></li>

            {% if section.settings.links_secondary %}
              {% assign links_obj = linklists[section.settings.links_secondary] %}
              {% if links_obj and links_obj.links.size > 0 %}
                {% for l in links_obj.links %}
                  <li><a href="{{ l.url }}">{{ l.title }}</a></li>
                {% endfor %}
              {% endif %}
            {% endif %}

            <li><a href="{{ routes.search_url }}">Search</a></li>
            <li><a href="/pages/wishlist">Wishlist</a></li>

            {% if shop.customer_accounts_enabled %}
              {% if customer %}
                <li><a href="{{ routes.account_url }}">Account</a></li>
              {% else %}
                <li><a href="{{ routes.account_login_url }}">Login / Register</a></li>
              {% endif %}
            {% endif %}
          </ul>
        </nav>
      </div>

      <div class="col">
        <div class="sec">
          <button class="sec__head" type="button" data-acc aria-expanded="true">
            <span>Categories</span>
            <svg class="chev" viewBox="0 0 24 24"><path d="M7 10l5 5 5-5z"/></svg>
          </button>
          <div class="sec__body">
            <ul class="list">
              {% assign main_handle = section.settings.menu_main %}
              {% assign parent_title = section.settings.categories_parent_title | default: 'Category' %}
              {% assign menu_obj = linklists[main_handle] %}
              {% assign categories_parent_index = -1 %}
              {% if menu_obj %}
                {% for l in menu_obj.links %}
                  {% assign t_norm = l.title | strip | downcase %}
                  {% assign p_norm = parent_title | strip | downcase %}
                  {% if t_norm == p_norm %}{% assign categories_parent_index = forloop.index0 %}{% endif %}
                {% endfor %}
              {% endif %}

              {% if menu_obj and categories_parent_index > -1 %}
                {% assign cats_parent = menu_obj.links[categories_parent_index] %}
                {% if cats_parent.links and cats_parent.links.size > 0 %}
                  {% for c in cats_parent.links %}<li><a href="{{ c.url }}">{{ c.title }}</a></li>{% endfor %}
                {% else %}
                  <li><a href="{{ section.settings.categories_fallback_url | default: '/collections/all' }}">All Categories</a></li>
                {% endif %}
              {% else %}
                <li><a href="{{ section.settings.categories_fallback_url | default: '/collections/all' }}">All Categories</a></li>
              {% endif %}
            </ul>
          </div>
        </div>

        <div class="sec">
          <button class="sec__head" type="button" data-acc aria-expanded="false">
            <span>Brands</span>
            <svg class="chev" viewBox="0 0 24 24"><path d="M7 10l5 5 5-5z"/></svg>
          </button>
          <div class="sec__body" hidden>
            <div class="chips">
              {% assign brands = section.settings.brands_list | default: "Canon\nNikon\nSony\nFujifilm\nPanasonic\nSigma" | split: '\n' %}
              {% for b in brands %}
                {% assign v = b | strip %}
                {% if v != '' %}
                  <a class="chip" href="/search?type=product&q={{ 'vendor:"' | append: v | append: '"' | url_encode }}"><span>{{ v }}</span></a>
                {% endif %}
              {% endfor %}
              {% if section.settings.brands_fallback_url %}
                <a class="chip" href="{{ section.settings.brands_fallback_url }}"><span>All brands</span></a>
              {% endif %}
            </div>
          </div>
        </div>
      </div>
    </div>
  </aside>
</div>

<style>
/* ===== Drawer-only styles (scoped) ===== */
#ch-menu-drawer{ position:fixed; inset:0; z-index:1300; pointer-events:none; }
#ch-menu-drawer.is-open{ pointer-events:auto; }
#ch-menu-drawer .ch-drawer__ov{ position:absolute; inset:0; background:rgba(0,0,0,.45); opacity:0; transition:opacity .24s; }
#ch-menu-drawer.is-open .ch-drawer__ov{ opacity:1; }

#ch-menu-drawer .ch-drawer__pn{
  position:absolute; top:0; left:0; width:min(720px,92vw); height:100%;
  background:var(--brand, #E0302A); color:#fff; transform:translateX(-104%);
  transition:transform .36s cubic-bezier(.22,.61,.36,1); padding:14px; overflow:auto;
}
#ch-menu-drawer.is-open .ch-drawer__pn{ transform:translateX(0); }

#ch-menu-drawer .ch-drawer__hd{ display:flex; align-items:center; justify-content:space-between; gap:8px; padding-bottom:10px; border-bottom:1px solid rgba(255,255,255,.18); }
#ch-menu-drawer .title{ font:800 14px/1.2 var(--font-body, ui-sans-serif); }
#ch-menu-drawer .btn{ background:transparent; border:0; min-width:44px; min-height:44px; display:inline-flex; align-items:center; justify-content:center; cursor:pointer; }
#ch-menu-drawer .ico{ width:20px; height:20px; fill:currentColor; }

#ch-menu-drawer .grid{ display:grid; grid-template-columns:1fr; gap:12px; padding-top:12px; }
@media(min-width:480px){ #ch-menu-drawer .grid{ grid-template-columns:1fr 1fr; } }
#ch-menu-drawer .col{ background:#fff; color:#111; border-radius:12px; padding:10px; border:1px solid #e5e7eb; }

#ch-menu-drawer .list{ list-style:none; margin:0; padding:0; display:grid; gap:4px; }
#ch-menu-drawer .list a{ display:block; padding:12px 10px; border-radius:8px; text-decoration:none; color:#111; font-weight:700; min-height:44px; }
#ch-menu-drawer .list a:hover{ background:#f6f6f6; }

#ch-menu-drawer .sec + .sec{ margin-top:10px; }
#ch-menu-drawer .sec__head{ width:100%; display:flex; align-items:center; justify-content:space-between; padding:10px; border-radius:10px; border:1px solid #e5e7eb; background:#fff; cursor:pointer; font-weight:800; }
#ch-menu-drawer .sec__head:focus-visible{ outline:0; box-shadow:0 0 0 1.5px var(--brand, #E0302A); }
#ch-menu-drawer .sec__body{ padding:10px 0 0; }
#ch-menu-drawer .chev{ width:18px; height:18px; transition:transform .18s ease; }
#ch-menu-drawer [aria-expanded="true"] .chev{ transform:rotate(180deg); }

#ch-menu-drawer .chips{ display:flex; flex-wrap:wrap; gap:8px; }
#ch-menu-drawer .chip{
  display:inline-flex; align-items:center; height:32px; padding:0 12px; border-radius:999px;
  border:1px solid #e5e7eb; background:#fff; color:#111; text-decoration:none; font-weight:700; font-size:12px;
}
#ch-menu-drawer .chip:hover{ background:#FFF4F3; border-color:var(--brand, #E0302A); }
</style>

<script>
(() => {
  const drawer  = document.getElementById('ch-menu-drawer');
  if(!drawer) return;

  const setOpen = (open) => {
    drawer.classList.toggle('is-open', !!open);
    drawer.setAttribute('aria-hidden', open ? 'false' : 'true');
    document.documentElement.style.overflow = open ? 'hidden' : '';
    if(open){
      const first = drawer.querySelector('button, a, [href], [tabindex]:not([tabindex="-1"])');
      first && first.focus();
    }
  };

  // open/close triggers (legacy + new)
  document.addEventListener('click', (e)=>{
    if(e.target.closest('[data-open-drawer],[data-drawer-open],[data-panel-open="menu"]')){ e.preventDefault(); setOpen(true); }
    if(e.target.closest('#ch-menu-drawer [data-close], #ch-menu-drawer .ch-drawer__ov')){ e.preventDefault(); setOpen(false); }
    const link = e.target.closest('#ch-menu-drawer a[href]');
    if(link && !link.getAttribute('href').startsWith('#')) setOpen(false);
  }, true);

  document.addEventListener('keydown', (e)=>{ if(e.key==='Escape') setOpen(false); }, true);

  // simple accordion
  drawer.addEventListener('click', (e)=>{
    const head = e.target.closest('#ch-menu-drawer [data-acc]');
    if(!head) return;
    const open = head.getAttribute('aria-expanded') === 'true';
    head.setAttribute('aria-expanded', open ? 'false' : 'true');
    const body = head.parentElement.querySelector('.sec__body');
    if(body) body.hidden = open;
  });
})();
</script>
