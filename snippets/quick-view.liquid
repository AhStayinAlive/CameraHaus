{%- comment -%}
QUICK VIEW — compact & tidy (2025-10-20)
- Works with delegated JS in product-card (CHQV_INIT_V2)
- Arrows show if variants>1 OR images>1 and switch correctly
- "Product gallery" thumbs sit under label, above CTAs
- Qty • Add to cart • Wishlist on one row
- Brand red: #d12f24 ; Buy now gray/black → red on hover
{%- endcomment -%}

{%- liquid
  assign v = product.selected_or_first_available_variant

  assign compare_val = 0
  assign pct_save    = 0
  if v and v.compare_at_price and v.compare_at_price > v.price
    assign compare_val = v.compare_at_price
    assign pct_save    = (compare_val | minus: v.price) | times: 100.0 | divided_by: compare_val | floor
  endif

  assign images = product.images
  assign img    = images.first

  assign has_variant_nav = product.variants.size > 1 and product.has_only_default_variant == false
  assign has_image_nav   = images.size > 1
-%}

<div class="hv-qv" data-qv-root data-product-id="{{ product.id }}" data-hv-has-variant-nav="{{ has_variant_nav }}" data-hv-has-image-nav="{{ has_image_nav }}">
  <button class="hv-qv__close" type="button" aria-label="Close" data-qv-close>
    <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path fill="none" stroke="#fff" stroke-width="2" d="M5 5l14 14M19 5L5 19"/></svg>
  </button>

  <div class="hv-qv__grid">
    <!-- MEDIA -->
    <div class="hv-qv__media">
      <div class="hv-fig">
        {% if has_variant_nav or has_image_nav %}
          <button class="hv-nav hv-nav--prev" type="button" aria-label="Previous" data-hv-prev>
            <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M15 6l-6 6 6 6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </button>
        {% endif %}

        {% if img %}
          <img class="hv-fig__img" src="{{ img | image_url: width: 1200 }}" alt="{{ product.title | escape }}" width="{{ img.width }}" height="{{ img.height }}" loading="lazy" decoding="async" data-hv-img>
        {% else %}
          {{ 'product-1' | placeholder_svg_tag: 'hv-fig__ph' }}
        {% endif %}

        {% if has_variant_nav or has_image_nav %}
          <button class="hv-nav hv-nav--next" type="button" aria-label="Next" data-hv-next>
            <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M9 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </button>
        {% endif %}

        <!-- Badges above image -->
        <div class="hv-qv__badges">
          {%- if compare_val > 0 -%}
            <span class="hv-badge hv-badge--sale">-{{ pct_save }}%</span>
          {%- endif -%}
          {%- unless product.available -%}
            <span class="hv-badge hv-badge--sold">Sold out</span>
          {%- endunless -%}
        </div>
      </div>
    </div>

    <!-- INFO -->
    <div class="hv-qv__info" data-hv-info>
      <h3 class="hv-title">{{ product.title }}</h3>

      <div class="hv-price" data-hv-price>
        {%- if compare_val > 0 -%}
          <span class="hv-price__compare">{{ compare_val | money_without_trailing_zeros }}</span>
        {%- endif -%}
        <span class="hv-price__current">{{ v.price | money_without_trailing_zeros }}</span>
      </div>

      <p class="hv-ship"><a href="/policies/shipping-policy">Shipping</a> calculated at checkout.</p>

      <!-- Product gallery label + thumbs -->
      {% assign VAR_THUMB_LIMIT = 8 %}
      {% assign IMG_THUMB_LIMIT = 8 %}
      {% if product.variants.size > 1 and product.has_only_default_variant == false %}
        <div class="hv-opt"><div class="hv-opt__label">Product gallery</div></div>
        <div class="hv-thumbs-row" data-hv-thumbs-row>
          {%- for var in product.variants limit: VAR_THUMB_LIMIT -%}
            {%- assign vimg = var.featured_image | default: images.first -%}
            <button type="button"
                    class="hv-thumb {% if forloop.first %}is-active{% endif %}"
                    aria-label="{{ var.title | escape }}"
                    data-hv-variant-id="{{ var.id }}"
                    data-hv-thumb="{{ vimg | image_url: width: 1200 }}">
              <img src="{{ vimg | image_url: width: 120 }}" alt="{{ var.title | escape }}">
            </button>
          {%- endfor -%}
        </div>
      {% elsif images.size > 1 %}
        <div class="hv-opt"><div class="hv-opt__label">Product gallery</div></div>
        <div class="hv-thumbs-row" data-hv-thumbs-row>
          {%- for im in images limit: IMG_THUMB_LIMIT -%}
            <button type="button"
                    class="hv-thumb {% if forloop.first %}is-active{% endif %}"
                    aria-label="Image {{ forloop.index }}"
                    data-hv-thumb="{{ im | image_url: width: 1200 }}">
              <img src="{{ im | image_url: width: 120 }}" alt="Image {{ forloop.index }}">
            </button>
          {%- endfor -%}
        </div>
      {% endif %}

      <!-- CONTROLS ROW -->
      <div class="hv-controls">
        <div class="hv-qty">
          <button type="button" class="hv-qty__btn" data-hv-qty-dec aria-label="Decrease quantity">−</button>
          <input class="hv-qty__inp" type="number" min="1" value="1" inputmode="numeric" pattern="[0-9]*" data-hv-qty>
          <button type="button" class="hv-qty__btn" data-hv-qty-inc aria-label="Increase quantity">+</button>
        </div>

        <form method="post" action="/cart/add" class="ch-atc hv-atc">
          <input type="hidden" name="id" value="{{ v.id }}" data-hv-variant>
          <input type="hidden" name="quantity" value="1" data-hv-qty-field>
          <button type="submit" class="hv-btn hv-btn--primary">Add to cart</button>
        </form>

        <button type="button" class="hv-icb hv-icb--wish" aria-label="Wishlist" data-wishlist-add="{{ product.id }}">
          {% render 'icon-wishlist' %}
        </button>
      </div>

      <form method="post" action="/cart/add" class="hv-buyit">
        <input type="hidden" name="id" value="{{ v.id }}" data-hv-variant-buy>
        <input type="hidden" name="quantity" value="1" data-hv-qty-field-buy>
        <button class="hv-btn hv-btn--dim hv-btn--block" type="submit" formaction="/checkout" formmethod="post">Buy it now</button>
      </form>
    </div>
  </div>

  <!-- Data for delegated JS -->
  <script type="application/json" data-hv-variants-detail>
    {{ product.variants | json }}
  </script>
  <script type="application/json" data-hv-images>
    {{ images | map: 'src' | json }}
  </script>
</div>

<style>
.hv-qv, .hv-qv *:not(svg):not(style){
  font-family:"Inter",system-ui,-apple-system,"Segoe UI",Roboto,"Helvetica Neue",Arial,"Noto Sans",sans-serif;
}
.hv-qv{ --accent:#d12f24; --text:#0F172A; --muted:#6B7280; background:#fff; padding:18px 20px; }
.hv-qv__grid{ display:grid; grid-template-columns: 1.15fr .95fr; gap:20px; align-items:start; }
@media (max-width: 860px){ .hv-qv__grid{ grid-template-columns:1fr; gap:14px; } }
.hv-qv__close{ position:absolute; top:10px; right:10px; width:32px; height:32px; background:#111; color:#fff; border:0; border-radius:6px; display:grid; place-items:center; cursor:pointer; }

.hv-qv__badges{ position:absolute; top:10px; left:10px; z-index:6; display:flex; flex-direction:column; gap:6px; }
.hv-badge{ display:inline-block; font-size:11px; font-weight:700; padding:4px 8px; border-radius:6px; line-height:1; }
.hv-badge--sale{ background:#FFE8B3; color:#B22A25; }
.hv-badge--sold{ background:#111827; color:#fff; }

.hv-fig{ position:relative; background:#fff; border-radius:8px; }
.hv-fig__img{ width:100%; height:auto; object-fit:contain; display:block; }
.hv-nav{ position:absolute; top:50%; transform:translateY(-50%); width:34px; height:34px; border-radius:999px; background:#fff; border:1px solid #111; display:grid; place-items:center; cursor:pointer; transition: background-color .15s, border-color .15s, transform .15s; z-index:5;}
.hv-nav--prev{ left:-16px; } .hv-nav--next{ right:-16px; }
.hv-nav:hover{ background:#FACC15; border-color:#F59E0B; transform:translateY(-50%) scale(1.06); }

.hv-title{ margin:0 0 6px; font-size:18px; font-weight:500; color:var(--text); }
.hv-price{ display:flex; align-items:baseline; gap:8px; margin-bottom:6px; }
.hv-price__current{ color:var(--accent); font-weight:600; font-size:18px; }
.hv-price__compare{ color:var(--muted); text-decoration:line-through; font-size:16px; }
.hv-ship{ color:var(--muted); margin:0 0 10px; font-size:13px; }
.hv-ship a{ color:inherit; text-decoration:underline; }

.hv-opt{ margin:2px 0 4px; } .hv-opt__label{ font-weight:500; font-size:13px; color:#111; }
.hv-thumbs-row{ display:flex; gap:8px; margin:6px 0 10px; overflow-x:auto; -webkit-overflow-scrolling:touch; scrollbar-width:none; }
.hv-thumbs-row::-webkit-scrollbar{ display:none; }
.hv-thumb{ width:44px; height:44px; border-radius:8px; border:1px solid #E5E7EB; background:#fff; padding:0; display:grid; place-items:center; transition: transform .16s cubic-bezier(.2,.8,.2,1), border-color .16s, box-shadow .16s; flex:0 0 auto; }
.hv-thumb img{ max-width:100%; max-height:100%; border-radius:7px; display:block; }
.hv-thumb:hover{ transform:scale(1.1); border-color:var(--accent); box-shadow:0 0 0 2px rgba(209,47,36,.25) inset; }
.hv-thumb.is-active{ border-color:var(--accent); box-shadow:0 0 0 2px rgba(209,47,36,.25) inset; }

.hv-controls{ display:grid; grid-template-columns:auto 1fr auto; gap:10px; align-items:center; }
.hv-qty{ display:inline-flex; align-items:center; border:1px solid #D1D5DB; border-radius:999px; overflow:hidden; height:38px; background:#fff; }
.hv-qty__btn{ width:34px; height:38px; background:#fff; border:0; font-size:18px; cursor:pointer; color:#111; }
.hv-qty__inp{ width:42px; height:38px; border:0; text-align:center; font-weight:600; font-size:15px; color:#0F172A; background:#fff; }
.hv-qty__inp::-webkit-outer-spin-button,.hv-qty__inp::-webkit-inner-spin-button{ -webkit-appearance:none; margin:0; }
.hv-qty__inp{ -moz-appearance: textfield; }

.hv-btn{ display:inline-flex; align-items:center; justify-content:center; height:38px; padding:0 16px; border-radius:999px; border:0; font-weight:700; cursor:pointer; transition: background-color .15s, color .15s, transform .08s; }
.hv-btn--primary{ background:#d12f24; color:#fff; width:100%; }
.hv-icb{ width:38px; height:38px; border-radius:999px; border:1px solid #D1D5DB; display:grid; place-items:center; background:#fff; color:#111; transition: transform .15s, border-color .15s; }
.hv-icb:hover{ transform:translateY(-1px) scale(1.06); border-color:#111; }

.hv-buyit{ margin-top:10px; }
.hv-btn--dim{ background:#1f1f1f; color:#fff; }
.hv-btn--dim:hover{ background:#d12f24; color:#fff; }
.hv-btn--block{ width:100%; }

.sr-only{ position:absolute!important;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0; }
</style>
