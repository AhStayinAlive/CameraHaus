{%- comment -%}
  Snippet: Brands Grid for Mega Menu
  Shows brands configured in the brands page theme editor
  
  Since older Shopify themes can't access section blocks from snippets,
  this shows a message directing users to manage brands in theme editor.
  The brands will appear on the brands page itself.
{%- endcomment -%}

<div style="grid-column: 1 / -1; padding: 30px 20px; text-align: center; background: rgba(209, 47, 36, 0.05); border-radius: 12px; border: 2px dashed rgba(209, 47, 36, 0.2);">
  <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="#D12F24" stroke-width="2" style="margin: 0 auto 12px; display: block;">
    <rect x="3" y="3" width="18" height="18" rx="2" ry="2"/><line x1="9" y1="9" x2="15" y2="9"/><line x1="9" y1="15" x2="15" y2="15"/>
  </svg>
  <p style="margin: 0 0 12px; font-size: 16px; font-weight: 600; color: #2b2f36;">Brand logos managed in Theme Editor</p>
  <p style="margin: 0 0 16px; color: #6B7280; font-size: 14px;">Add brand blocks on the Brands page to see them here and on the brands page</p>
  <a href="/pages/brands" style="display: inline-block; padding: 10px 20px; background: #D12F24; color: white; text-decoration: none; border-radius: 8px; font-weight: 600; font-size: 14px;">
    View All Brands →
  </a>
</div>
