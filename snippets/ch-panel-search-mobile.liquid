    } else input.setAttribute('aria-activedescendant','');
  }
  function clearList(){ list.replaceChildren(); setActive(-1); }

  function renderProducts(items){
    const frag=document.createDocumentFragment();
    (items||[]).forEach((p,i)=>{
      const li=document.createElement('li');
      li.className='ms-item'; li.setAttribute('data-kind','product'); li.setAttribute('role','option'); li.id=`ms-opt-${i}`;
      li.dataset.url=p.url||'#';
      const img=p.image||(p.featured_image && (p.featured_image.url||p.featured_image))||'';
      const now=p.price||p.price_min||0; const was=p.compare_at_price||0;
      const vendor=p.vendor||''; const cat=p.product_type||p.type||'';
      li.innerHTML=`
        <a href="${p.url||'#'}" aria-label="${esc(p.title||'')}"></a>
