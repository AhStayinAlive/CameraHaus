{%- comment -%} Floating Search — v15 (spec complete: desktop top anchor, safe-area mobile island, red matches, tab underline, bottom meta, a11y, rAF pinning) {%- endcomment -%}

{%- assign _preview = preview_collection
  | default: section.settings.default_preview_collection
  | default: settings.search_prefill_collection
  | default: collections['all']
  | default: collections.frontpage
-%}
{%- if _preview and _preview != blank and _preview.products_count == nil -%}{%- assign _preview = collections[_preview] -%}{%- endif -%}

{%- assign _limit = section.settings.search_limit_products | default: 6 -%}
{%- assign _min_chars = 2 -%}
{%- assign _locale = request.locale.iso_code | default: 'en' -%}
{%- assign _currency = shop.currency | default: 'USD' -%}
{%- assign _meta_limit = _limit | times: 10 -%}


{%- capture prefill_json -%}
[
  {%- if _preview and _preview.products_count > 0 -%}
    {%- for p in _preview.products limit: _limit -%}
    { "title": {{ p.title | json }}, "url": {{ p.url | json }}, "price": {{ p.price | divided_by: 100.0 | json }}, "compare_at_price": {{ p.compare_at_price | divided_by: 100.0 | json }}, "image": {{ p.featured_image | image_url: width: 480 | json }}, "vendor": {{ p.vendor | json }}, "product_type": {{ p.type | json }} }{%- unless forloop.last -%},{%- endunless -%}
    {%- endfor -%}
  {%- endif -%}
]
{%- endcapture -%}

{%- capture prefill_meta_json -%}
[
  {%- if _preview and _preview.products_count > 0 -%}
    {%- for p in _preview.products limit: _meta_limit -%}
    { "title": {{ p.title | json }}, "url": {{ p.url | json }}, "price": {{ p.price | divided_by: 100.0 | json }}, "compare_at_price": {{ p.compare_at_price | divided_by: 100.0 | json }}, "image": {{ p.featured_image | image_url: width: 480 | json }}, "vendor": {{ p.vendor | json }}, "product_type": {{ p.type | json }} }{%- unless forloop.last -%},{%- endunless -%}
    {%- endfor -%}
  {%- endif -%}
]
{%- endcapture -%}

{%- capture vendors_json -%}{{ shop.vendors | json }}{%- endcapture -%}

<style>
/* Force-hide conflicting theme search UIs */
.ch-panel[data-ch-panel="search"], .search-modal, [data-drawer="search"], .js-predictive-search{ display:none!important; }

/* Tokens */
:root{
  --ink:#1f2937; --muted:#6b7280; --hair:#e5e7eb; --bg:#fff; --hover:#f7f8fa; --hit:#E03A2F;
  --g-gap:12px; /* mobile island gutters */
}

/* Portal overlay */
.ms-portal{ position:fixed; inset:0; z-index:2147483647; pointer-events:none; }
.ms-portal::before{ content:""; position:absolute; inset:0; background:rgba(0,0,0,.35); opacity:0; transition:opacity .22s ease; pointer-events:none; }
.ms-portal[data-open]{ pointer-events:auto; }
.ms-portal[data-open]::before{ opacity:1; pointer-events:auto; }

/* Thin black typography, inherit theme font */
.ms-portal, .ms-portal *:not(svg):not(style){
  font-family: inherit;
  font-weight:300;
  color:#111;
  -webkit-font-smoothing:antialiased;
}

/* Island */
.ms-island{
  position:fixed; left:50%;
  transform:translateX(-50%) translateY(6px) scale(.995);
  width:min(96vw,1200px); max-height:calc(100dvh - 24px);
  background:var(--bg); border:1px solid var(--hair); border-radius:18px;
  box-shadow:0 24px 72px rgba(17,19,21,.18);
  display:flex; flex-direction:column; overflow:hidden;
  opacity:0; transition:opacity .18s ease, transform .18s ease, box-shadow .18s ease;
}
.ms-portal[data-open] .ms-island{ opacity:1; transform:translateX(-50%) translateY(0) scale(1); }

/* Desktop top placement (JS computes precise top) */
@media(min-width:1024px){ .ms-island{ top:80px; } }

/* Mobile island gutters (Moment-style) */
@media(max-width:1023px){
  .ms-island{
    left: calc(env(safe-area-inset-left) + var(--g-gap));
    right: calc(env(safe-area-inset-right) + var(--g-gap));
    top:  calc(env(safe-area-inset-top) + var(--g-gap));
    bottom: calc(env(safe-area-inset-bottom) + var(--g-gap));
    width:auto; max-height:none; border-radius:16px;
  }
}

/* Reduced motion respect */
@media (prefers-reduced-motion: reduce){
  .ms-portal *{ transition:none!important; animation:none!important; }
}

/* Header row */
.ms-row{ padding:14px 16px 0; display:grid; gap:10px; }
@media(min-width:1024px){ .ms-row{ padding:18px 20px 0; } }

.ms-input-wrap{ display:flex; align-items:center; gap:10px; padding:12px 12px 14px; border-bottom:1px solid var(--hair); background:#fff; }
.ms-search-hero{ width:20px; height:20px; color:#a0a7af; }
.ms-input-wrap input{ width:100%; border:0; background:transparent; outline:0; font-size:17px; color:#111; }
.ms-input-wrap input::placeholder{ color:#a0a7af; }
.ms-esc-hint{ margin-left:auto; font-size:12px; color:#a0a7af; display:none; }
@media(min-width:1024px){ .ms-esc-hint{ display:block; } }
[data-ms-close]{ position:absolute; top:10px; right:10px; width:32px; height:32px; display:grid; place-items:center; background:#fff; border:1px solid var(--hair); border-radius:999px; color:#111; }
@media(min-width:1024px){ [data-ms-close]{ display:none; } }

/* Tabs (mobile) */
.ms-tabs{ display:grid; grid-template-columns:repeat(3,1fr); background:#fff; border-bottom:1px solid var(--hair); }
@media(min-width:1024px){ .ms-tabs{ display:none; } }
.ms-tab{
  position:relative; appearance:none; background:#fff; border:0; border-radius:0;
  padding:12px 10px; font-size:13px; cursor:pointer; color:#111;
  transition:color .18s ease, background-color .18s ease;
}
.ms-tab::after{
  content:""; position:absolute; left:0; right:0; bottom:-1px; height:3px;
  background:transparent; transform:scaleX(0); transform-origin:center;
  transition:transform .14s ease, background-color .14s ease; border-radius:2px;
}
.ms-tab[aria-selected="true"]{ background:#f3f4f6; }
.ms-tab[aria-selected="true"]::after{ background:var(--hit); transform:scaleX(1); }
.ms-tab:hover{ color:var(--hit); }

/* Body */
.ms-scroll{ flex:1; overflow:auto; padding:12px 16px 12px; background:#fff; }
@media(min-width:1024px){ .ms-scroll{ padding:16px 20px; } }

.ms-desk-grid{ display:block; }
@media(min-width:1024px){
  .ms-desk-grid{ display:grid; grid-template-columns:360px 1fr; gap:24px; }
  .ms-left{ display:flex; flex-direction:column; gap:16px; border-right:1px solid var(--hair); padding-right:16px; }
  .ms-right{ position:relative; }
  .ms-toplink{ position:absolute; right:0; top:-2px; font-size:13px; color:#1d4ed8; text-decoration:none; }
  .ms-toplink:hover{ color:var(--hit); }
}
@media(max-width:1023px){ .ms-left,.ms-toplink{ display:none; } }

/* Titles */
.ms-sec-title{ margin:6px 2px 10px; font-size:12px; font-weight:600; letter-spacing:0; text-transform:none; color:#111; }

/* Side lists */
.ms-side-list{ list-style:none; margin:0; padding:0; border:1px solid var(--hair); border-radius:12px; background:#fff; }
.ms-side-item a{ display:flex; align-items:center; gap:10px; padding:10px 12px; color:#374151; text-decoration:none; transition:background .15s ease, color .15s ease; }
.ms-side-item + .ms-side-item{ border-top:1px solid var(--hair); }
.ms-side-item a:hover{ background:var(--hover); color:var(--hit); }
.ms-side-icon{ width:18px; height:18px; color:#a7adb3; }
.ms-side-label{ white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }

/* Results list */
.ms-list{ list-style:none; margin:0; padding:6px; background:#fff; border:1px solid var(--hair); border-radius:14px; display:grid; gap:0; }
.ms-item{ position:relative; display:grid; grid-template-columns:60px minmax(0,1fr) auto; gap:12px; align-items:center; padding:12px 14px; border-radius:12px; transition:background-color .14s ease, color .14s ease; }
.ms-item + .ms-item{ border-top:1px solid var(--hair); }
.ms-item:hover, .ms-item.is-active{ background:var(--hover); }
.ms-item>a{ position:absolute; inset:0; border-radius:12px; }

/* Product cell */
.ms-thumb{ width:56px; height:56px; object-fit:contain; border-radius:12px; background:#fff; box-shadow:inset 0 0 0 1px var(--hair); }
.ms-title{ font-size:15px; color:#111; line-height:1.35; display:-webkit-box; -webkit-line-clamp:2; -webkit-box-orient:vertical; overflow:hidden; transition:color .15s ease; }
.ms-item:hover .ms-title{ color:var(--hit); }

/* vendor • category (faint) */
.ms-sub{ font-size:13px; color:#9aa0a6; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
.ms-item:hover .ms-sub{ color:var(--hit); } /* hover turns red as requested */

/* prices */
.ms-price{ display:flex; flex-direction:column; align-items:flex-end; gap:2px; }
.ms-price-old{ font-size:12px; color:#c2c7cf; text-decoration:line-through; font-weight:300; }
.ms-price-now{ font-size:15px; font-weight:300; color:var(--hit); }

/* ensure matched highlight stays red even on hover/focus */
.ms-hilite{ color:var(--hit) !important; }

/* Link rows (mobile brands/categories) */
.ms-link{ position:relative; display:flex; align-items:center; gap:10px; padding:12px 14px; border-radius:12px; transition:background .14s ease, color .14s ease; }
.ms-link + .ms-link{ border-top:1px solid var(--hair); }
.ms-link a{ position:absolute; inset:0; border-radius:12px; }
.ms-link .label{ flex:1 1 auto; min-width:0; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
.ms-link .chev{ color:#9aa0a6; }
.ms-link:hover{ background:var(--hover); }
.ms-link:hover .label{ color:var(--hit); }

/* Bottom meta */
.ms-bottom-meta{ padding:8px 16px 0; }
@media(min-width:1024px){ .ms-bottom-meta{ padding:10px 20px 0; } }
.ms-bottom-meta .ms-sec-title{ margin:0 0 6px; }
.ms-bottom-meta .ms-count{ font-size:14px; }
.ms-bottom-meta .ms-count b{ color:var(--hit); font-weight:600; }

/* Footer + View all */
.ms-footer{ border-top:1px solid var(--hair); background:#fff; padding:12px 16px calc(18px + env(safe-area-inset-bottom)); display:flex; justify-content:center; }
.ms-view-all{
  display:inline-flex; align-items:center; height:36px; padding:0 16px; border-radius:10px;
  background:#fff; color:#111; border:1px solid #111; text-decoration:none; font-size:14px; font-weight:500;
  transition:background .18s ease, color .18s ease, border-color .18s ease;
}
@media(max-width:1023px){ .ms-view-all{ background:var(--hit); border-color:var(--hit); color:#fff; } } /* mobile: always red */
.ms-view-all:hover, .ms-view-all:focus-visible{ background:var(--hit); border-color:var(--hit); color:#fff; } /* desktop: outline → red on hover */
/* 1) Vendor • Category chips under product cards → faint gray (stay gray on hover) */
.ms-item .ms-sub{
  color:#9aa0a6 !important;
  font-weight:300 !important;
}
.ms-item:hover .ms-sub{ color:#9aa0a6 !important; }

/* 2) Original price (compare_at) → faint gray + strikethrough */
.ms-item .ms-price-old{
  color:#c2c7cf !important;
  text-decoration:line-through !important;
  font-weight:300 !important;
}

/* 3) Actual price → red */
.ms-item .ms-price-now{
  color:#E03A2F !important;
  font-weight:300 !important;
}

/* 4) Headers (“Suggested brands”, “Products”, “Suggested categories”) 
      → Title Case + +100 weight (600 → 700) */
.ms-sec-title{
  text-transform:capitalize !important;
  font-weight:700 !important;
}

/* 5) Remove the bottom “suggested categories / N products found” block */
.ms-bottom-meta{ display:none !important; }

/* 6) Make the TOP “products found” count red (adjust selector if yours differs) */
.ms-row .ms-count,
.ms-right .ms-count-top,
.ms-right .ms-sec-count{
  color:#E03A2F !important;
  font-weight:600 !important;
}
.ms-row .ms-count b,
.ms-right .ms-count-top b,
.ms-right .ms-sec-count b{
  color:#E03A2F !important;
}

/* 7) Mobile island must be centered with safe-area gaps (not stuck to the side) */
@media(max-width:1023px){
  .ms-island{
    left: calc(env(safe-area-inset-left) + 12px) !important;
    right: calc(env(safe-area-inset-right) + 12px) !important;
    top: calc(env(safe-area-inset-top) + 12px) !important;
    bottom: calc(env(safe-area-inset-bottom) + 12px) !important;
    width:auto !important;
    max-height:none !important;
    transform:none !important;
  }
}

/* 8) “View all results” CTA: on mobile keep white text (also on hover) */
@media(max-width:1023px){
  .ms-view-all{
    background:#E03A2F !important;
    border-color:#E03A2F !important;
    color:#fff !important;
  }
  .ms-view-all:hover,
  .ms-view-all:focus{
    background:#E03A2F !important;
    border-color:#E03A2F !important;
    color:#fff !important;
  }
}
/* place the count near the Products header on desktop & mobile */
.ms-right{ position:relative; }
.ms-count-top{
  position:absolute; right:0; top:-26px;
  font-size:12px; font-weight:600; color:#E03A2F;
}
.ms-count-top b{ color:#E03A2F; }

/* hide the old bottom meta block since we moved the count */
.ms-bottom-meta{ display:none !important; }

/* also make sure the top-link is gone even if markup lingers */
.ms-toplink{ display:none !important; }
/* subtle highlight: keep text color, add soft blue background */
.ms-item .ms-title .ms-hilite,
.ms-side-label .ms-hilite,
.ms-link .label .ms-hilite{
  color:inherit !important;
  background:rgba(29, 78, 216, .14) !important; /* soft blue */
  border-radius:3px; padding:0 .08em;
}
/* on hover, leave highlight color alone (titles/labels may turn red overall) */
.ms-item:hover .ms-title .ms-hilite,
.ms-side-item a:hover .ms-side-label .ms-hilite,
.ms-link:hover .label .ms-hilite{
  color:inherit !important;
}
/* Substring highlight → light red pill (keeps text color neutral) */
.ms-item .ms-title .ms-hilite,
.ms-side-label .ms-hilite,
.ms-link .label .ms-hilite,
.ms-hilite{
  color:inherit !important;
  background:rgba(224, 58, 47, .12) !important; /* #E03A2F @ 12% */
  border-radius:4px;
  padding:0 .12em;
  box-shadow:inset 0 0 0 1px rgba(224, 58, 47, .18);
}

/* Don’t change on hover/active */
.ms-item:hover .ms-title .ms-hilite,
.ms-side-item a:hover .ms-side-label .ms-hilite,
.ms-link:hover .label .ms-hilite{
  color:inherit !important;
  background:rgba(224, 58, 47, .12) !important;
  box-shadow:inset 0 0 0 1px rgba(224, 58, 47, .18);
}
/* Kill the live hint (“Type more to search”) completely */
[data-ms-live], .sr-only{ 
  position:absolute !important; 
  width:1px; height:1px; 
  overflow:hidden; clip:rect(0 0 0 0);
  white-space:nowrap; border:0; margin:-1px; 
}

/* Remove any counts wherever they might appear */
.ms-count-top,
[data-ms-count],
.ms-bottom-meta{ display:none !important; }
/* slightly darker hairlines + subtle hovers */
:root{
  --hair:#d1d5db !important;          /* was #e5e7eb */
  --hover:#f2f4f7 !important;         /* a touch darker than before */
}

/* ensure all borders pick up the darker tone */
.ms-input-wrap{ border-bottom-color:var(--hair) !important; }
.ms-side-list, .ms-list{ border-color:var(--hair) !important; }
.ms-item + .ms-item{ border-top-color:var(--hair) !important; }
.ms-side-item + .ms-side-item{ border-top-color:var(--hair) !important; }
.ms-thumb{ box-shadow:inset 0 0 0 1px var(--hair) !important; }
.ms-footer{ border-top-color:var(--hair) !important; }

/* faint text a bit darker */
.ms-sub{ color:#7e8792 !important; }                  /* was #9aa0a6 */
.ms-side-icon{ color:#8a919a !important; }
.ms-input-wrap input::placeholder{ color:#8a919a !important; }

/* old-price a hair darker too */
.ms-price-old{ color:#b8c0c8 !important; }

/* light-red highlight pill stays, unchanged */
/* === Compact, clean search layout (desktop + mobile) === */

/* 3.1 Left side: simple text lists, no boxes */
.ms-left {
  border-right: 1px solid var(--hair);  /* keeps the single vertical divider like pic #6 */
  padding-right: 20px;
  gap: 20px;
}

.ms-left .ms-sec-title {
  margin: 0 0 6px;
  font-size: 11px;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: var(--muted);
}

/* remove “card” boxes around brands & categories */
.ms-side-list {
  border: 0 !important;
  background: transparent !important;
  border-radius: 0 !important;
  padding: 0;
}

.ms-side-item + .ms-side-item {
  border-top: 0 !important;
}

.ms-side-item a {
  padding: 4px 0;
  border-radius: 0;
  background: transparent;
}

.ms-side-item a:hover {
  background: transparent;
  color: var(--hit);
}

/* 3.2 Product list: havit-style rows (no outer box, no inner lines) */
.ms-list {
  border: 0 !important;
  background: transparent !important;
  padding: 0;
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.ms-item {
  position: relative;
  display: grid;
  grid-template-columns: 72px minmax(0, 1fr) auto;
  gap: 14px;
  align-items: center;
  padding: 10px 16px;
  border-radius: 0;              /* flat rows like havit */
  border: 0 !important;
  box-shadow: none;              /* no card shadow */
  background: #fff;
}

.ms-item + .ms-item {
  border-top: 0 !important;      /* remove dividers between rows */
}

/* product image: no border/line, just the pic */
.ms-thumb {
  width: 64px;
  height: 64px;
  object-fit: contain;
  background: transparent !important;
  box-shadow: none !important;   /* removes the inner line around the image */
  border-radius: 8px;
}

/* 3.3 Text hierarchy: Name + gray old price + red new price */
.ms-title {
  font-size: 14px;
  font-weight: 400;
  margin-bottom: 4px;
  color: #111;
}

/* hide vendor/category line if you want pure name + prices like havit */
.ms-sub {
  display: none;
}

/* old price: faint gray + strikethrough */
.ms-price-old {
  font-size: 12px;
  color: #c2c7cf !important;
  text-decoration: line-through !important;
  font-weight: 300 !important;
}

/* new price: red */
.ms-price-now {
  font-size: 15px;
  font-weight: 400;
  color: #E03A2F !important;
}

/* keep hover only as a soft background tint, no lines */
.ms-item:hover,
.ms-item.is-active {
  background: var(--hover);
}

/* 3.4 Narrower layout on desktop */
@media (min-width: 1024px) {
  .ms-island {
    max-width: 1040px; /* matches DESKTOP_MIN_WIDTH above */
  }

  .ms-desk-grid {
    grid-template-columns: 280px minmax(0, 1fr);
    gap: 24px;
  }
}
/* === Product row layout: name, vendor/category, then prices below === */

.ms-item {
  /* 2-column grid: image + text, 2 rows so price sits below text */
  grid-template-columns: 72px minmax(0, 1fr);
  grid-template-rows: auto auto;
  grid-template-areas:
    "thumb info"
    "thumb price";
  align-items: flex-start;
}

/* map children into those areas */
.ms-thumb { grid-area: thumb; }

.ms-info {
  grid-area: info;
}

.ms-price {
  grid-area: price;
  display: flex;
  gap: 6px;
  align-items: flex-end;
  justify-content: flex-start;  /* prices under the text, left-aligned */
  text-align: left;
  margin-top: 2px;
}

/* title on top */
.ms-title {
  font-size: 14px;
  font-weight: 400;
  margin-bottom: 2px;
}

/* show vendor + category again, above price */
.ms-sub {
  display: block !important;
  font-size: 12px;
  color: #7e8792 !important;
  margin-bottom: 2px;
}

/* keep old/new price styling */
.ms-price-old {
  font-size: 12px;
  color: #c2c7cf !important;
  text-decoration: line-through !important;
  font-weight: 300 !important;
}

.ms-price-now {
  font-size: 15px;
  font-weight: 400;
  color: #E03A2F !important;
}
@media (min-width: 1024px) {
  .ms-island {
    max-width: 960px;  /* match DESKTOP_MIN_WIDTH above */
  }
}
/* === Left column: clean Apple-like list, red on hover === */

.ms-left {
  border-right: 1px solid var(--hair);
  padding: 20px 24px 20px 0;
  gap: 24px;
}

/* subtle section labels */
.ms-left .ms-sec-title {
  margin: 0 0 8px;
  font-size: 11px;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: var(--muted);
}

/* no box around the whole list */
.ms-side-list {
  border: 0 !important;
  background: transparent !important;
  border-radius: 0 !important;
  padding: 0;
}

/* each row = soft pill */
.ms-side-item a {
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 6px 10px;
  border-radius: 999px;
  background: transparent;
  transition:
    background 0.16s ease,
    color 0.16s ease,
    transform 0.12s ease;
}

/* icon */
.ms-side-icon {
  width: 16px;
  height: 16px;
  color: #9aa0a6;
}

/* label text */
.ms-side-label {
  font-size: 13px;
  color: #374151;
}

/* hover: soft red tint + red text/icon, slight slide */
.ms-side-item a:hover {
  background: rgba(224, 58, 47, 0.06);
  color: #E03A2F;
  transform: translateX(2px);
}

.ms-side-item a:hover .ms-side-icon {
  color: #E03A2F;
}

.ms-side-item a:hover .ms-side-label {
  color: #E03A2F;
}

/* no dividers between items */
.ms-side-item + .ms-side-item {
  border-top: 0 !important;
}
/* === FORCE layout: image left, name + vendor/category, then price BELOW === */

.ms-item {
  /* 2 columns only: image + text */
  display: grid;
  grid-template-columns: 72px minmax(0, 1fr) !important;
  grid-auto-rows: auto;
  column-gap: 14px;
  align-items: flex-start;
}

/* image stays in first column, spans both rows */
.ms-thumb {
  grid-column: 1;
  grid-row: 1 / span 2;
}

/* name + vendor/category on first row, second column */
.ms-info {
  grid-column: 2;
  grid-row: 1;
}

