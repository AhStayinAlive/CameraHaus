    if (!bottomTitle) return;
    bottomTitle.textContent = tab === 'brands' ? 'suggested brands' : 'suggested categories';
  }

  /* =========================
   * Prefill & Fetch
   * ========================= */
  function showPrefill(){
    lastRegex=null; updateViewAll('');
    const shown = Math.min((prefill||[]).length, PREFILL_LIMIT);
    setBottomCount(shown);
