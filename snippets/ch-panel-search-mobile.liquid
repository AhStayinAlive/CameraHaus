<script>
(() => {
  "use strict";
  if (window.__msSearchInstalled) return;

  /* =========================
   * CONFIG (tweak freely)
   * ========================= */
  const DESKTOP_MIN_WIDTH = 900;          // width = min(1200px, 96vw)
  const DESKTOP_OFFSET    = -32;           // negative = higher; positive = lower
  const DESKTOP_BP        = 1024;          // desktop breakpoint (px)

  /* =========================
   * Portal mounting
   * ========================= */
  let portal = document.querySelector('.ms-portal');
  if (!portal) {
    portal = document.createElement('div');
    portal.className = 'ms-portal';
    document.body.appendChild(portal);
  }
  const island = document.querySelector('[data-ms-island]');
  if (!island) return;
  portal.replaceChildren(island);

  /* =========================
   * Refs
   * ========================= */
  const input        = island.querySelector('[data-ms-input]');
  const list         = island.querySelector('[data-ms-list]');
  const live         = island.querySelector('[data-ms-live]');
  const viewAll      = island.querySelector('[data-ms-viewall]');
  const sectionTitle = island.querySelector('[data-ms-section-title]');
  const deskBrands   = island.querySelector('[data-desk-brands]');
  const deskCats     = island.querySelector('[data-desk-cats]');
  const tabs         = Array.from(island.querySelectorAll('.ms-tab'));
  const countEl      = island.querySelector('[data-ms-count]');
  const bottomTitle  = island.querySelector('[data-ms-bottom-title]');

  // Remove any lingering top link if present (design choice)
  const topLink = island.querySelector('.ms-toplink'); if (topLink) topLink.remove();

  /* =========================
   * Liquid data (still used)
   * ========================= */
  const prefill     = {{ prefill_json | strip | replace: "\n", "" }};
  const prefillMeta = {{ prefill_meta_json | strip | replace: "\n", "" }};
  const vendorPool  = {{ vendors_json | strip | default: '[]' }};
  const defaultCollectionUrl = {{ _preview.url | default: '/search?q=&sort_by=best-selling' | json }};
  const localeCode  = {{ _locale | json }};
  const shopCurrency= {{ _currency | json }};
  const MIN_CHARS   = {{ _min_chars | json }};
  const PREFILL_LIMIT = {{ _limit | json }};
  const LIST_CAP = 8;
  const DESK_SIDE_MAX = 7;

  /* =========================
   * Helpers & State
   * ========================= */
  const isDesktop  = () => matchMedia(`(min-width:${DESKTOP_BP}px)`).matches;
  let activeTab = 'products';
  let debounce = null, ctl = null;
  let activeIndex = -1;
  let lastRegex = null;

  const nf = new Intl.NumberFormat(localeCode || 'en', { style:'currency', currency:shopCurrency || 'USD' });
  const money = c => nf.format(Number(c) || 0);
  const esc = s => (s||'').replace(/[&<>"']/g, m=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[m]));
  const uniq = arr => Array.from(new Set((arr||[]).map(s => (s||'').trim()).filter(Boolean)));
  const byFreq = arr => { const m=new Map(); (arr||[]).forEach(v=>{ if(!v)return; const k=v.trim(); m.set(k,(m.get(k)||0)+1); }); return Array.from(m.entries()).sort((a,b)=>b[1]-a[1]).map(x=>x[0]); };
  const sized = (u,w)=>{ if(!u) return ''; if(u.indexOf('{width}')>-1) return u.replace('{width}', String(w)); return u.replace(/(\.(?:jpe?g|png|webp|gif))(?:\?.*)?$/i,`_${w}x$1`) };
  const qFilter = (field, value) => `${encodeURIComponent(field)}%3A%22${encodeURIComponent(value)}%22`;
  const shuffle = a => { const x=a.slice(); for(let i=x.length-1;i>0;i--){ const j=(Math.random()*(i+1))|0; [x[i],x[j]]=[x[j],x[i]]; } return x; };

  const deriveBrands = (prods) => uniq((prods||[]).map(p => (p.vendor||'').trim()));
  const deriveTypes  = (prods) => uniq((prods||[]).map(p => (p.product_type||p.type||'').trim()));
  const baseTypes    = byFreq(deriveTypes(prefillMeta.length ? prefillMeta : prefill));
  const baseBrands   = byFreq(uniq(vendorPool.length ? vendorPool : deriveBrands(prefillMeta.length ? prefillMeta : prefill)));

    // --- Aperture helpers: make f1.8, f/1.8, f 1.8 all behave the same ---
// Build extra query variants for things like "f1.8", "f/1.8", etc.
function apertureVariants(q) {
  const variants = [q]; // always include original

  // 1. Tag Bypass: Check for explicit "f/1.8" or "f1.8" patterns
  // If we see "f/1.8", we also search for "tag:f1.8" and "tag:f/1.8"
  // This allows the user to manually tag products as "f1.8" to force a match.
  const tagRe = /\bf\s*\/?\s*([0-9]+(?:\.[0-9]+)?)/gi;
  let tagM;
  while ((tagM = tagRe.exec(q)) !== null) {
      const num = tagM[1];
      variants.push(`tag:f${num}`); // e.g. tag:f1.8
      variants.push(`tag:${num}`);  // e.g. tag:1.8
  }

  // 2. Text Variants
  const re = /\bf\s*\/?\s*([0-9]+(?:\.[0-9]+)?)/gi;
  let m;

  while ((m = re.exec(q)) !== null) {
    const full = m[0];   // e.g. "f/1.8"
    const num  = m[1];   // e.g. "1.8"

    const candidates = [
        `f${num}`,       // f1.8
        `F${num}`,       // F1.8
        `f/${num}`,      // f/1.8
        `F/${num}`,      // F/1.8
        num,             // 1.8 (strict)
        `${num}*`,       // 1.8* (wildcard for 1.8mm, 1.8x, etc - broad but catches things)
        `${num}g`,       // 1.8g
        `${num}G`,       // 1.8G
        `${num} g`,      // 1.8 g (space)
        `${num} G`       // 1.8 G (space)
    ];

    candidates.forEach(rep => {
      // Create a new variant string by replacing the aperture part
      // e.g. "nikkor f/1.8" -> "nikkor 1.8G"
      const v = q.replace(full, rep);
      if (!variants.includes(v)) variants.push(v);
    });
  }

  return variants;
}

  // Normalize query for Shopify: "f/1.8", "f1.8", "f 1.8" => "1.8"
  // and keep the rest of the search words intact.
  function normalizeApertureQuery(raw) {
    if (!raw) return '';
    // replace any "f something" aperture token with just the numeric part
    // e.g. "sigma 35mm f1.8 lens" -> "sigma 35mm 1.8 lens"
    return raw.replace(/\bf\s*\/?\s*(\d+(\.\d+)?)/gi, '$1');
  }

  // Build a regex that matches both "f/1.8" style and plain "1.8"
  // so we can highlight nicely in result titles.
  function buildHighlightRegex(raw) {
    if (!raw) return null;

    const tokens = raw
      .split(/\s+/)
      .filter(Boolean)
      .map(tok => {
        const m = tok.match(/^f\/?(\d+(\.\d+)?)/i);
        if (m) {
          const num = m[1].replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
          // matches: f1.8, f/1.8, f 1.8, 1.8
          return `f\\s*\\/?\\s*${num}|${num}`;
        }
        // normal word: escape for regex
        return tok.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
      });

    return tokens.length ? new RegExp(tokens.join('|'), 'ig') : null;
  }

  const highlight = (label) => {
    if(!lastRegex) return esc(label);
    const s=String(label); let out=[], last=0;
    s.replace(lastRegex,(m,idx)=>{ out.push(esc(s.slice(last,idx)),'<span class="ms-hilite">',esc(m),'</span>'); last=idx+m.length; return m; });
    out.push(esc(s.slice(last))); return out.join('');
  };

  /* =========================
   * Renderers
   * ========================= */
  function setActive(idx){
    const items = list.querySelectorAll('.ms-item[role="option"], .ms-link');
    items.forEach(el => el.classList.remove('is-active'));
    activeIndex = Math.max(-1, Math.min(idx, items.length-1));
    if (activeIndex >= 0){
      const el = items[activeIndex]; el.classList.add('is-active');
      const c = list, eb = el.getBoundingClientRect(), cb = c.getBoundingClientRect();
      if (eb.bottom > cb.bottom) c.scrollTop += (eb.bottom - cb.bottom);
      if (eb.top < cb.top)       c.scrollTop -= (cb.top - eb.top);
