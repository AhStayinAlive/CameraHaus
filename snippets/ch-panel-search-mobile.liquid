          <span class="ms-price-now">${money(now||was)}</span>
        </div>`;
      frag.appendChild(li);
    });
    list.replaceChildren(frag);
  }

  function renderSide(listEl, items, type){
    if (!listEl) return;
    const frag=document.createDocumentFragment();
    (items||[]).forEach(title=>{
      const href = type==='brand'
        ? `/search?type=product&q=${qFilter('vendor', title)}&sort_by=best-selling`
        : `/search?type=product&q=${qFilter('product_type', title)}&sort_by=best-selling`;
      const li=document.createElement('li'); li.className='ms-side-item';
      li.innerHTML = `<a href="${href}">
        <span class="ms-side-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="18" height="18"><circle cx="11" cy="11" r="7" stroke="currentColor" stroke-width="1.6" fill="none"/><path d="M20 20l-4-4" stroke="currentColor" stroke-width="1.6" fill="none" stroke-linecap="round"></path></svg>
        </span>
        <span class="ms-side-label">${highlight(title)}</span>
