    });
    list.replaceChildren(frag);
  }

  function updateViewAll(q){
    const val=(q||'').trim();
    const href = val ? `/search?q=${encodeURIComponent(val)}&sort_by=best-selling` : (defaultCollectionUrl || '/search?q=&sort_by=best-selling');
    if (viewAll) viewAll.href = href, viewAll.textContent = val ? `View all results for “${val}”` : 'View all results';
  }

  function setBottomCount(n){
    if(!countEl) return;
    if (typeof n === 'number') countEl.innerHTML = `<b>${n}</b> products found`;
