    if (isDesktop()){
      renderProducts((prefill||[]).slice(0, PREFILL_LIMIT));
      renderSide(deskBrands, (shuffle(baseBrands)).slice(0, DESK_SIDE_MAX), 'brand');
      renderSide(deskCats,   (shuffle(baseTypes)).slice(0, DESK_SIDE_MAX),  'cat');
      if (live) live.textContent = `${shown} products`;
    } else {
      if (activeTab==='products'){
        renderProducts((prefill||[]).slice(0, PREFILL_LIMIT));
        if (live) live.textContent = `${shown} products`;
      } else if (activeTab==='brands'){
        const rows = (shuffle(baseBrands)).slice(0, LIST_CAP)
          .map(t => ({label:t, href:`/search?type=product&q=${qFilter('vendor', t)}&sort_by=best-selling`}));
        renderLinksMobile(rows);
      } else {
        const rows = (shuffle(baseTypes)).slice(0, LIST_CAP)
          .map(t => ({label:t, href:`/search?type=product&q=${qFilter('product_type', t)}&sort_by=best-selling`}));
        renderLinksMobile(rows);
      }
    }
  }

  // =========================
  // Prefill & Fetch
  // =========================
function fetchSuggest(q){
  if (ctl) ctl.abort();
  ctl = new AbortController();

  const raw = q.trim();
  const variants = apertureVariants(raw);
  
  // 1) Predictive suggest (keep as-is for speed/suggestions)
  // We use the raw query here (or the simplest variant)
  const urlSuggest = `/search/suggest.json?q=${encodeURIComponent(raw)}` +
    `&resources[type]=product` +
    `&resources[limit]=${PREFILL_LIMIT}` +
    `&resources[options][fields]=title,product_type,vendor,tag`;

  // 2) Full Search with OR-joined variants
  // e.g. "nikkor f/1.8" -> "nikkor f/1.8 OR nikkor 1.8G OR tag:f1.8"
  // Increased limit to 20 to ensure relevant items aren't pushed out by "1.8m" tripods
  const combined = variants.join(' OR ');
  const urlSearch = `/search.json?q=${encodeURIComponent(combined)}&type=product&options[prefix]=last`; // removed limit, let it be default (usually 10) or set explicitly. 
  // Actually default 10 might be too low. Let's explicitly ask for more.
  // We can't easily change page size in standard search.json via `limit` param (it ignores it often), 
  // but `view` param can be used if we had a template. Standard JSON API usually page_size is fixed or 10.
  // Wait, standard global search limit is 10. 
  // We can't easily boost it without a custom view.
  // BUT we can try `&type=product` which we have.
  // Let's rely on the more specific variants (like 1.8G) to float to the top.
  // And the TAG search is very specific, so it should rank #1.


  const fetchJson = (url) =>
    fetch(url, {
      headers: { 'Accept':'application/json' },
      signal: ctl.signal,
      cache: 'no-store'
    }).then(r => r.ok ? r.json() : null)
      .catch(() => null);

  return Promise.all([
    fetchJson(urlSuggest),
    fetchJson(urlSearch)
  ]).then(([jsSuggest, jsSearch]) => {
    const seen   = new Set();
    const merged = [];

    const add = (p) => {
      if (!p) return;
      // Normalization for ID ensuring dedupe across endpoints
      const key = p.id || (p.url ? p.url.split('?')[0] : p.handle);
      if (!key || seen.has(key)) return;
      seen.add(key);
      merged.push(p);
    };

    // 1. Suggest results first (usually most relevant textually)
    if (jsSuggest &&
        jsSuggest.resources &&
        jsSuggest.resources.results &&
        Array.isArray(jsSuggest.resources.results.products)) {
      jsSuggest.resources.results.products.forEach(add);
    }

    // 2. Search results second (catches the aperture cases)
    if (jsSearch) {
      const rawProducts = Array.isArray(jsSearch.products)
        ? jsSearch.products
        : Array.isArray(jsSearch.results)
          ? jsSearch.results
          : [];

      rawProducts.forEach(p => {
        // Normalize search.json shape to match suggest.json shape
        const normalized = {
          id: p.id,
          handle: p.handle,
          title: p.title,
          url: p.url || (p.handle ? `/products/${p.handle}` : '#'),
          price: p.price || p.price_min || 0,
          compare_at_price: p.compare_at_price || p.compare_at_price_max || 0,
          image: (p.featured_image && (p.featured_image.url || p.featured_image.src)) ||
                 (p.image && (p.image.url || p.image.src || p.image)) || '',
          vendor: p.vendor || '',
          product_type: p.product_type || p.type || '',
        };
        add(normalized);
      });
    }

    return {
      resources: {
        results: {
          products: merged
        }
      }
    };
  });
}


  /* =========================
   * Input + debounce
   * ========================= */
  function handleInput() {
    const raw = input.value.trim();           // what the user typed
    // pass RAW query to fetchSuggest, let it handle variants/OR-logic
    const q   = raw;

    // CTA text ("View all results for …") should show the raw query
    updateViewAll(raw);

    // build highlight regex from the raw query (so f/1.8 still highlights)
    if (q && q.length >= MIN_CHARS) {
      lastRegex = buildHighlightRegex(raw);
    } else {
      lastRegex = null;
    }

    clearTimeout(debounce);
    debounce = setTimeout(() => {
      if (!q) {          // if normalized query is empty, show prefill
        showPrefill();
        return;
      }

      // PRODUCTS tab (desktop OR mobile)
      if (isDesktop() || activeTab === 'products') {
        if (q.length < MIN_CHARS) {
          clearList();
          setBottomCount(null);
          if (live) live.textContent = 'Type more to search';
          return;
        }

        // skeleton loader (unchanged)
        const frag = document.createDocumentFragment();
        for (let i = 0; i < PREFILL_LIMIT; i++) {
          const li = document.createElement('li');
          li.className = 'ms-item';
          li.innerHTML = `
            <div class="ms-thumb" style="background:#eef1f4"></div>
            <div class="ms-info">
              <div style="height:14px;width:70%;background:#eef1f4;border-radius:6px;margin-bottom:6px;"></div>
              <div style="height:12px;width:50%;background:#eef1f4;border-radius:6px;"></div>
            </div>
            <div class="ms-price">
              <div style="height:12px;width:80px;background:#eef1f4;border-radius:6px;margin-left:auto;"></div>
            </div>`;
          frag.appendChild(li);
        }
        list.replaceChildren(frag);
        if (live) live.textContent = 'Loading…';

        // IMPORTANT: we now call fetchSuggest with the *normalized* query
        fetchSuggest(q).then(js => {
          const prods = js && js.resources && Array.isArray(js.resources.results.products)
            ? js.resources.results.products
            : [];

          renderProducts(prods);
          setBottomCount(prods.length);

          if (isDesktop()) {
            const qLower = raw.toLowerCase();
            const b = baseBrands.filter(v => v.toLowerCase().includes(qLower)).slice(0, DESK_SIDE_MAX);
            const c = baseTypes.filter(t => t.toLowerCase().includes(qLower)).slice(0, DESK_SIDE_MAX);
            renderSide(deskBrands, (b.length ? b : baseBrands).slice(0, DESK_SIDE_MAX), 'brand');
            renderSide(deskCats,   (c.length ? c : baseTypes).slice(0, DESK_SIDE_MAX),  'cat');
          }

          if (live) {
            live.textContent = prods.length ? `${prods.length} products` : 'No products';
          }
          setActive(-1);
        });

      // BRANDS tab (mobile)
      } else if (activeTab === 'brands') {
        const qLower = raw.toLowerCase();
        const filtered = baseBrands.filter(v => v.toLowerCase().includes(qLower));
        const rows = (filtered.length ? filtered : baseBrands).slice(0, LIST_CAP)
          .map(t => ({
            label: t,
            href: `/search?type=product&q=${qFilter('vendor', t)}&sort_by=best-selling`
          }));
        renderLinksMobile(rows);

      // CATEGORIES tab (mobile)
      } else {
        const qLower = raw.toLowerCase();
        const filtered = baseTypes.filter(v => v.toLowerCase().includes(qLower));
        const rows = (filtered.length ? filtered : baseTypes).slice(0, LIST_CAP)
          .map(t => ({
            label: t,
            href: `/search?type=product&q=${qFilter('product_type', t)}&sort_by=best-selling`
          }));
        renderLinksMobile(rows);
      }
    }, 150);
  }


  /* =========================
   * Tabs (mobile)
   * ========================= */
  function setTab(tab){
    activeTab = tab;
    tabs.forEach(btn => btn.setAttribute('aria-selected', btn.dataset.tab === tab ? 'true' : 'false'));
    sectionTitle.textContent = tab==='products' ? 'products' : (tab==='brands' ? 'suggested brands' : 'suggested categories');
    setBottomTitleForTab(tab);
    handleInput();
  }
  tabs.forEach(btn => btn.addEventListener('click', ()=>setTab(btn.dataset.tab)));

  /* =========================
   * DESKTOP POSITION — anchor to header TOP (covers search)
   * ========================= */
  const headerEl = () =>
    document.querySelector('[data-ch-header]') ||
    document.getElementById('ch-header-{{ section.id }}') ||
    document.querySelector('#shopify-section-header') ||
    document.querySelector('header[role="banner"], header.site-header, .site-header, header');

  function positionDesktop(){
    const h = headerEl();
    // Fallback to viewport top if header is missing
    const topBase = (() => {
      if (!h) return window.scrollY + 8;
      const r = h.getBoundingClientRect();
      return window.scrollY + Math.round(r.top) + 8; // anchor near header TOP
    })();
    return Math.max(8, topBase + DESKTOP_OFFSET);
  }

  let posReq=null;
  function schedulePos(){
    if(!portal.hasAttribute('data-open') || !isDesktop()) return;
    if(posReq) return;
    posReq=requestAnimationFrame(()=>{ island.style.top = positionDesktop() + 'px'; posReq=null; });
  }

  /* =========================
   * Open / Close
   * ========================= */
  function openIsland(val = ''){
    portal.setAttribute('data-open','true');
    island.setAttribute('aria-hidden','false');
    document.documentElement.style.overflow='hidden';
    input.value = val || '';

    if (isDesktop()){
      const maxW = Math.min(DESKTOP_MIN_WIDTH, Math.floor(window.innerWidth * 0.96));
      island.style.width = maxW + 'px';
      island.style.left = '50%';
      island.style.transform = 'translateX(-50%)';
      island.style.top = positionDesktop() + 'px'; // always compute from header TOP (ignore trigger rect)
    } else {
      island.style.left = island.style.right = island.style.top = island.style.bottom = island.style.width = island.style.transform = '';
    }

    const hasQ = input.value.trim().length > 0;
    setTimeout(()=>{ try{ input.focus(); }catch(e){} hasQ ? handleInput() : showPrefill(); }, 24);
  }

  function closeIsland(){
    portal.removeAttribute('data-open');
    island.setAttribute('aria-hidden','true');
    document.documentElement.style.overflow='';
    setActive(-1);
  }

  /* =========================
   * Events
   * ========================= */
  // Click backdrop to close
  portal.addEventListener('click', (ev)=>{ if(!portal.hasAttribute('data-open')) return; if(ev.target.closest('[data-ms-island]')) return; closeIsland(); });
  island.addEventListener('click', (ev)=>{ if(ev.target.closest('[data-ms-close]')) closeIsland(); });

  // Input + keyboard
  input.addEventListener('input', handleInput);
  island.addEventListener('keydown', (e)=>{
    const items = list.querySelectorAll('.ms-item[role="option"], .ms-link');
    if (e.key==='Escape'){ e.preventDefault(); closeIsland(); return; }
    if (e.key==='ArrowDown'){ e.preventDefault(); if(!items.length) return; setActive(activeIndex+1); return; }
    if (e.key==='ArrowUp'){ e.preventDefault(); if(!items.length) return; setActive(activeIndex-1); return; }
    if (e.key==='Enter'){
      const q = input.value.trim();
      if (activeIndex>=0 && items[activeIndex]){ const url = items[activeIndex].dataset.url || '#'; window.location.href = url; }
      else { window.location.href = q ? `/search?q=${encodeURIComponent(q)}&sort_by=best-selling` : (defaultCollectionUrl || '/search?q=&sort_by=best-selling'); }
    }
  });

  // Openers (capture + prevent default)
  document.addEventListener('click', (ev)=>{
    const t = ev.target.closest('[data-ms-open="search"], [data-panel-open="search"], .site-header__search-toggle, .search__button, a[href="#search"], input[type="search"][name="q"], input[name="q"][type="search"]');
    if(!t) return;
    ev.preventDefault(); ev.stopPropagation(); ev.stopImmediatePropagation();
    const val  = t.tagName==='INPUT' ? (t.value||'') : ((t.closest('form')?.querySelector('input[type="search"], input[name="q"]')?.value) || '');
    openIsland(val); // NOTE: we ignore rect to always cover the header search
  }, true);

  // Keep pinned on scroll/resize
  window.addEventListener('scroll', schedulePos, { passive:true });
  window.addEventListener('resize', schedulePos, { passive:true });

  /* =========================
   * Export a small API
   * ========================= */
  window.__msSearchInstalled = true;
  window.openIsland = openIsland;
  window.closeIsland = closeIsland;
  window.handleInput = handleInput;
  window.fetchSuggest = fetchSuggest;
  window.setTab = setTab;
  window.positionDesktop = positionDesktop;
  window.schedulePos = schedulePos;

  /* =========================
   * Init
   * ========================= */
  showPrefill();
})();
</script>
