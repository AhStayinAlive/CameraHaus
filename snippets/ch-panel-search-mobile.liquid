      frag.appendChild(li);
    });
    listEl.replaceChildren(frag);
  }

  function renderLinksMobile(rows){
    const frag=document.createDocumentFragment();
    rows.slice(0, LIST_CAP).forEach((r,i)=>{
      const div=document.createElement('div');
      div.className='ms-link'; div.id=`ms-opt-${i}`; div.setAttribute('role','option'); div.dataset.url=r.href;
      div.innerHTML=`<a href="${r.href}" aria-label="${esc(r.label)}"></a>
        <span class="ms-side-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="18" height="18"><circle cx="11" cy="11" r="7" stroke="currentColor" stroke-width="1.6" fill="none"/><path d="M20 20l-4-4" stroke="currentColor" stroke-width="1.6" fill="none" stroke-linecap="round"></path></svg>
        </span>
