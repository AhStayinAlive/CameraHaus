{%- liquid
  assign media         = product.featured_media | default: product.featured_image
  assign second_media  = product.media[1] | default: product.images[1]
  assign available     = product.available
  assign v             = product.selected_or_first_available_variant
  assign only_default  = product.has_only_default_variant

  assign price_min     = product.price_min
  assign price_max     = product.price_max
  assign price_varies  = product.price_varies
  assign is_range      = false
  if price_varies and price_max > price_min
    assign is_range = true
  endif

  assign compare_val = 0
  assign pct_save    = 0
  assign save_amt    = 0
  if v and v.compare_at_price and v.compare_at_price > v.price
    assign compare_val = v.compare_at_price
    assign save_amt    = compare_val | minus: v.price
    assign pct_save    = save_amt | times: 100.0 | divided_by: compare_val | floor
  endif

  assign current_price_text = price_min | money_without_trailing_zeros

  assign compare_text_long = ''
  if compare_val > 0
    assign compare_text_long = compare_val | money_without_trailing_zeros
  endif

  # ---- Compact compare like ₱16.2k / ₱1.3M for tight spaces ----
  assign compare_text_compact = ''
  if compare_val > 0
    assign cmp_units = compare_val | divided_by: 100.0
    if cmp_units >= 1000000
      assign m = cmp_units | divided_by: 1000000.0 | round: 1
      assign m_str = m | replace: '.0',''
      assign compare_text_compact = '₱' | append: m_str | append: 'M'
    elsif cmp_units >= 1000
      assign k = cmp_units | divided_by: 1000.0 | round: 1
      assign k_str = k | replace: '.0',''
      assign compare_text_compact = '₱' | append: k_str | append: 'k'
    else
      assign compare_text_compact = compare_val | money_without_trailing_zeros
    endif
  endif

  # ---- badges (kept separate) ----
  assign badge_forced = product.metafields.camerahaus.badge | default: ''
  assign tag_str      = product.tags | join: ',' | downcase
  assign has_bundle   = false
  assign has_new      = false
  assign has_best     = false
  if tag_str contains 'bundle' or tag_str contains 'bundle:'
    assign has_bundle = true
  endif
  if tag_str contains 'new'
    assign has_new = true
  endif
  if tag_str contains 'bestseller' or tag_str contains 'featured'
    assign has_best = true
  endif

  assign discount_badge = ''
  if badge_forced != ''
    assign discount_badge = badge_forced
  elsif compare_val > 0
    assign discount_badge = '-' | append: pct_save | append: '%'
  elsif has_bundle
    assign discount_badge = 'Bundle'
  elsif has_new
    assign discount_badge = 'New'
  elsif has_best
    assign discount_badge = 'Bestseller'
  endif

  assign inv_tracked = false
  assign inv_qty     = 0
  if v and v.inventory_management and v.inventory_management != ''
    assign inv_tracked = true
    assign inv_qty     = v.inventory_quantity | default: 0
  endif

  assign stock_badge = ''
  if available and inv_tracked and inv_qty > 0 and inv_qty <= 5
    assign stock_badge = inv_qty | append: ' stocks left'
  endif

  # ---- reviews ----
  assign rating_val = 0
  assign rating_count = 0
  if product.metafields.reviews.rating.value
    assign rating_val = product.metafields.reviews.rating.value | round: 1
  elsif product.metafields.reviews.rating
    assign rating_val = product.metafields.reviews.rating | round: 1
  endif
  if product.metafields.reviews.rating_count
    assign rating_count = product.metafields.reviews.rating_count | plus: 0
  endif
  assign rating_full = rating_val | floor
-%}

<article class="ch-card ch-card--elev" data-product-id="{{ product.id }}">
  <a class="ch-card__overlay" href="{{ product.url }}" aria-label="View {{ product.title | escape }}"></a>

  <!-- MEDIA -->
  <div class="ch-card__mediawrap">
    <a class="ch-card__media" href="{{ product.url }}" aria-label="{{ product.title | escape }}" data-media-link>
      {% if media %}
        <img class="ch-card__img"
             src="{{ media | image_url: width: 900 }}"
             srcset="{{ media | image_url: width: 540 }} 540w, {{ media | image_url: width: 720 }} 720w, {{ media | image_url: width: 900 }} 900w, {{ media | image_url: width: 1200 }} 1200w"
             sizes="(min-width:1100px) 22vw, (min-width:768px) 30vw, 46vw"
             alt="{{ product.title | escape }}"
             loading="lazy" decoding="async"
             width="{{ media.width }}" height="{{ media.height }}"
             data-img-main
             onload="this.closest('.ch-card__media')?.setAttribute('data-loaded','true')"
             onerror="this.closest('.ch-card__media')?.setAttribute('data-loaded','true')">

        {% if discount_badge != '' %}
          <span class="ch-badge ch-badge--ribbon" aria-hidden="true">{{ discount_badge }}</span>
        {% endif %}
        {% if stock_badge != '' %}
          <span class="ch-badge ch-badge--stock" aria-hidden="true">{{ stock_badge }}</span>
        {% endif %}
      {% else %}
        {{ 'image' | placeholder_svg_tag: 'ch-card__ph' }}
      {% endif %}
    </a>

    <!-- Quick View FAB (URL-based QV with template fallback) -->
    <a class="ch-qv-fab"
       href="{{ product.url }}?view=quick-view"
       data-qv-url="{{ product.url }}?view=quick-view"
       data-qv-target="{{ 'qv-template-' | append: product.id }}"
       aria-label="Quick view {{ product.title | escape }}">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5c5.5 0 9.7 3.7 11 7-1.3 3.3-5.5 7-11 7S2.3 15.3 1 12c1.3-3.3 5.5-7 11-7Zm0 2C8 7 4.9 9.3 3.3 12 4.9 14.7 8 17 12 17s7.1-2.3 8.7-5C19.1 9.3 16 7 12 7Zm0 2.5a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5Z"/></svg>
    </a>

    <!-- Mini gallery (images only) — always visible; capped via CSS (5 desktop / 3 mobile) -->
    {% assign image_medias = product.media | where: "media_type", "image" %}
    {% if image_medias.size > 1 %}
      <div class="ch-mini" data-mini aria-label="More product images">
        <div class="ch-mini__track" role="listbox">
          {% for m in image_medias %}
            <button
              type="button"
              class="ch-mini__thumb {% if forloop.first %}is-active{% endif %}"
              role="option"
              aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
              data-src="{{ m | image_url: width: 900 }}"
              data-srcset="{{ m | image_url: width: 540 }} 540w, {{ m | image_url: width: 720 }} 720w, {{ m | image_url: width: 900 }} 900w, {{ m | image_url: width: 1200 }} 1200w">
              <img
                src="{{ m | image_url: width: 120 }}"
                alt="Thumbnail {{ forloop.index }} of {{ product.title | escape }}"
                loading="lazy" decoding="async" width="60" height="60">
            </button>
          {% endfor %}
        </div>
      </div>
    {% endif %}
  </div>

  <!-- BODY -->
  <div class="ch-card__body">
    <div class="ch-card__vendor" aria-label="Brand">{{ product.vendor }}</div>

    <h3 class="ch-card__title" title="{{ product.title | escape }}">
      <a class="ch-card__titlelink" href="{{ product.url }}" data-title-link>{{ product.title }}</a>
    </h3>

    <!-- PRICE (row: current + compare; save below) -->
    <div class="ch-price" itemprop="offers" itemscope itemtype="https://schema.org/Offer" aria-label="Price" data-range="{% if is_range %}true{% else %}false{% endif %}">
      <meta itemprop="priceCurrency" content="{{ cart.currency.iso_code }}">
      <meta itemprop="availability" content="https://schema.org/{% if available %}InStock{% else %}OutOfStock{% endif %}">
      <div class="ch-price__row">
        <span class="ch-price__cur" itemprop="price">{{ current_price_text }}</span>
        {% if compare_val > 0 %}
          <span class="ch-price__compare ch-price__compare--long">{{ compare_text_long }}</span>
          <span class="ch-price__compare ch-price__compare--compact">{{ compare_text_compact }}</span>
        {% endif %}
      </div>
      {% if compare_val > 0 %}
        <div class="ch-price__save">Save {{ save_amt | money_without_trailing_zeros }}<span class="ch-save__pct"> ({{ pct_save }}%)</span></div>
      {% endif %}
    </div>

    <!-- Rating (Okendo-first) -->
    <div class="ch-rating" data-rating>
      <div class="ch-rating__oke" data-oke-star-rating data-oke-reviews-product-id="{{ product.id }}"></div>
      {%- if rating_count > 0 -%}
      <div class="ch-rating__fallback" aria-hidden="true">
        <div class="ch-stars" aria-hidden="true">
          {% assign filled = rating_full %}
          {% for i in (1..5) %}
            <svg class="ch-star {% if i <= filled %}is-full{% else %}is-empty{% endif %}" viewBox="0 0 24 24" width="16" height="16">
              <path d="m12 17.3-5.46 3.28 1.45-6.23L3 9.76l6.36-.54L12 3.5l2.64 5.72 6.36.54-5 4.59 1.45 6.23z"/>
            </svg>
          {% endfor %}
        </div>
        <span class="ch-rating__count">({{ rating_count }})</span>
      </div>
      {%- endif -%}
    </div>

    <!-- CTAs -->
    <div class="ch-cta">
      {% if available %}
        {% if only_default and v %}
          <form method="post" action="/cart/add" class="ch-atc" aria-label="Add {{ product.title | escape }} to cart">
            <input type="hidden" name="id" value="{{ v.id }}">
            <button type="submit" class="sbtn ch-atcbtn" aria-label="Add to cart"><span class="ch-atcbtn__txt">Add to cart</span></button>
          </form>
        {% else %}
          <a class="sbtn ch-atcbtn" href="{{ product.url }}" aria-label="Add to cart"><span class="ch-atcbtn__txt">Add to cart</span></a>
        {% endif %}
      {% else %}
        <span class="sbtn ch-atcbtn ch-atcbtn--disabled" aria-disabled="true">Sold out</span>
      {% endif %}

      <button class="ch-wishbtn" type="button" aria-label="Add to wishlist" data-wishlist-add="{{ product.id }}">
        <svg class="ch-icon ch-icon--heart" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M21 8.25c0-2.485-2.03-4.5-4.536-4.5-1.642 0-3.09.879-3.964 2.19-.874-1.311-2.321-2.19-3.964-2.19C6.03 3.75 4 5.765 4 8.25c0 7.22 8 11 8 11s9-4 9-11Z"/>
        </svg>
      </button>
    </div>

    <script type="application/json" class="ch-desc">{{ product.description | json }}</script>
  </div>

  <template id="{{ 'qv-template-' | append: product.id }}">
    {% render 'quick-view', product: product %}
  </template>
</article>

<style>
  .ch-card, .ch-card *:not(svg):not(style){ font-family:var(--font-sans); }
  .ch-card{
    --brand:#e03a2f; --brand-600:#d12f24; --ch-text:#0F172A; --ch-muted:#6B7280; --ch-star:#8B1C1C;
    position:relative; background:#fff; border:1px solid #E5E7EB; border-radius:12px;
    box-shadow:0 1px 2px rgba(16,24,40,.04);
    transition:box-shadow .18s,border-color .18s,transform .18s;
    display:flex; flex-direction:column; height:100%;
  }
  @media (hover:hover){ .ch-card:hover{ border-color:#D1D5DB; box-shadow:0 6px 18px rgba(16,24,40,.08); transform:translateY(-1px); } }
  .ch-card__overlay{ position:absolute; inset:0; z-index:1; }
  .ch-card a, .ch-card button{ cursor:pointer; }

  /* Media + loader */
  .ch-card__mediawrap{ position:relative; z-index:2; flex:0 0 auto; }
  .ch-card__media{ margin:0!important; border-radius:12px 12px 0 0!important; background:#fff; aspect-ratio:1/1; position:relative; display:block; overflow:hidden; }
  .ch-card__img{ width:100%; height:100%; object-fit:contain; object-position:center; display:block; }
  .ch-card__media::before{
    content:""; position:absolute; inset:0; display:grid; place-items:center;
    background:#fff url({{ 'chicon.png' | asset_url }}) center/56px 56px no-repeat;
    opacity:0; transition:opacity .18s ease;
  }
  .ch-card__media:not([data-loaded="true"])::before{ opacity:.5; }

  /* Badges (smaller) */
  .ch-badge--ribbon{
    position:absolute; top:8px; left:8px; z-index:5; background:#FFEFCF; color:#B42318;
    font-weight:700; font-size:10px; line-height:1; padding:5px 8px; border-radius:4px 2px 2px 4px;
    clip-path:polygon(0 0,calc(100% - 8px) 0,100% 50%,calc(100% - 8px) 100%,0 100%);
    white-space:nowrap; max-width:75%; overflow:hidden; text-overflow:ellipsis;
  }
  .ch-badge--stock{
    position:absolute; top:8px; right:8px; z-index:5; background:#FFF7ED; color:#B45309;
    border:1px solid #FED7AA; border-radius:999px; padding:3px 6px; font-size:10px; font-weight:700; line-height:1; white-space:nowrap;
  }
  @media (max-width:480px){
    .ch-badge--ribbon{ font-size:9px; padding:4px 6px; }
    .ch-badge--stock { font-size:9px; padding:2px 6px; }
  }

  /* Quick View FAB */
  .ch-qv-fab{
    position:absolute; right:10px; bottom:10px; z-index:6; width:36px; height:36px; border-radius:999px;
    display:flex; align-items:center; justify-content:center;
    background:rgba(255,255,255,.85); border:1px solid rgba(0,0,0,.06); color:#6B7280;
    opacity:0; pointer-events:none; transition:opacity .15s,color .15s,transform .15s,background .15s,border-color .15s;
  }
  .ch-qv-fab svg{ width:20px; height:20px; fill:currentColor; }
  @media (min-width:768px){
    .ch-card:hover .ch-qv-fab{ opacity:1; pointer-events:auto; }
    .ch-qv-fab:hover{ color:#fff; background:var(--brand); border-color:var(--brand); transform:translateY(-1px); }
  }

  /* Body */
  .ch-card__body{ position:relative; z-index:2; padding:10px 12px 12px!important; display:flex; flex-direction:column; gap:8px; flex:1; }
  .ch-card__vendor{ font-size:12px; line-height:1; color:#9CA3AF; }
  .ch-card__title{ margin:2px 0 0; line-height:1.28; font-size:14px; font-weight:700; }
  .ch-card__titlelink{
    position:relative; color:#111; text-decoration:none;
    display:-webkit-box; -webkit-box-orient:vertical; -webkit-line-clamp:2; overflow:hidden; white-space:normal;
    transition: color .18s ease;
    outline-offset:3px;
    --title-glow: rgba(224,58,47,.28);
  }
  /* disable card-wide hover color */
  .ch-card:hover .ch-card__titlelink,
  .ch-card:focus-within .ch-card__titlelink{ color:#111; }
  .ch-card__titlelink::after{
    content:""; position:absolute; left:0; right:0; bottom:-2px; height:2px;
    background:linear-gradient(90deg,var(--brand),var(--brand));
    box-shadow:0 0 10px var(--title-glow);
    transform:scaleX(0); transform-origin:left;
    transition: transform .22s ease;
    pointer-events:none;
  }
  .ch-card__titlelink:hover,
  .ch-card__titlelink:focus-visible{ color:var(--brand); }
  .ch-card__titlelink:hover::after,
  .ch-card__titlelink:focus-visible::after{ transform:scaleX(1); }
  @media (max-width:480px){
    .ch-card__titlelink::after{ height:1.5px; box-shadow:0 0 8px var(--title-glow); }
  }

  /* Price */
  .ch-price{ display:block; }
  .ch-price__row{ display:flex; align-items:baseline; gap:6px; flex-wrap:wrap; min-width:0; }
  .ch-price__cur{ color:var(--brand); font-weight:800; font-size:16px; white-space:nowrap; }
  .ch-price__compare{ color:#6B7280; text-decoration:line-through; font-size:12px; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
  .ch-price__compare--compact{ display:inline; }
  .ch-price__compare--long{ display:none; }
  @media (min-width:900px){
    .ch-price__compare--compact{ display:none; }
    .ch-price__compare--long{ display:inline; }
  }
  .ch-price__save{ display:block; margin-top:2px; color:#B42318; font-size:11px; font-weight:700; white-space:nowrap; }
  @media (min-width:481px){
    .ch-price[data-range="true"] .ch-price__cur::before{ content:'From '; font-weight:600; }
  }

  /* Rating */
  .ch-rating{ display:flex; align-items:center; gap:6px; }
  .ch-stars{ display:flex; gap:2px; }
  .ch-star path{ stroke:var(--ch-star); stroke-width:1.2; }
  .ch-star.is-full path{ fill:var(--ch-star); }
  .ch-star.is-empty path{ fill:transparent; }
  .ch-rating__count{ color:var(--ch-muted); font-size:11px; }
  .ch-rating__oke{ display:flex; align-items:center; }

  /* CTAs pinned bottom */
  .ch-cta{ display:flex; align-items:center; gap:8px; margin-top:auto; }
  .ch-atc{ display:contents !important; }

  /* ATC: Desktop quiet → hover/focus red; Mobile/touch red always */
  .sbtn.ch-atcbtn{
    height:32px; padding:0 14px; border-radius:8px;
    font-size:13px; font-weight:600;
    background:#fff; color:var(--brand);
    border:1px solid var(--brand);
    text-decoration:none; display:inline-flex; align-items:center; justify-content:center;
    white-space:nowrap; line-height:32px; flex:1 0 auto; min-width:120px;
    transition:background .15s,border-color .15s,color .15s, box-shadow .15s;
  }
  .sbtn.ch-atcbtn:hover,
  .sbtn.ch-atcbtn:focus-visible{
    background:var(--brand); border-color:var(--brand); color:#fff;
    outline:2px solid transparent; box-shadow:0 0 0 3px rgba(224,58,47,.15);
  }
  .sbtn.ch-atcbtn[disabled]{ cursor:not-allowed; }
  .sbtn.ch-atcbtn.is-adding{ cursor:progress; }
  .ch-atcbtn--disabled{ background:#F3F4F6; border-color:#E5E7EB; color:#9CA3AF; pointer-events:none; }
  .ch-atcbtn.is-adding::after{
    content:""; width:14px; height:14px; margin-left:8px; border-radius:999px;
    border:2px solid rgba(255,255,255,.6); border-top-color:#fff; display:inline-block; animation:chspin .8s linear infinite;
  }
  .ch-atcbtn.is-added::after{
    content:""; width:18px; height:18px; margin-left:8px;
    mask:url('data:image/svg+xml;utf8,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 24 24%22><path d=%22M20 6 9 17l-5-5%22 stroke=%22%23fff%22 stroke-width=%222.5%22 stroke-linecap=%22round%22 stroke-linejoin=%22round%22 fill=%22none%22/></svg>') center/contain no-repeat;
    background:#fff;
  }
  @keyframes chspin { to{ transform:rotate(360deg); } }

  /* Wishlist */
  .ch-wishbtn{
    width:36px; height:32px; display:inline-flex; align-items:center; justify-content:center;
    background:transparent; border:0; color:#9CA3AF; padding:0; transition: color .15s, transform .15s;
    flex:0 0 36px;
  }
  .ch-wishbtn:hover{ color:var(--brand); transform:translateY(-1px); }
  .ch-icon--heart{ width:22px; height:22px; stroke:currentColor; stroke-width:2.2; fill:none; }
  .ch-wishbtn.is-active .ch-icon--heart path{ fill:currentColor; stroke:currentColor; }

  /* Mobile/touch: keep ATC red always */
  @media (hover:none), (max-width:767px){
    .sbtn.ch-atcbtn{ background:var(--brand); color:#fff; border-color:var(--brand); }
    .sbtn.ch-atcbtn:hover{ background:var(--brand-600); border-color:var(--brand-600); }
  }
  @media (max-width:480px){
    .ch-card__media{ aspect-ratio:4/3 !important; }
    .ch-card__body{ padding:8px 10px 10px !important; gap:6px; }
    .ch-card__vendor{ font-size:11px; }
    .ch-card__title{ font-size:13.5px; }
    .ch-price__cur{ font-size:15px; }
    .ch-cta{ gap:6px; }
    .sbtn.ch-atcbtn{ height:32px; font-size:13px; min-width:0; flex:1 1 auto; }
  }

  /* ---------------------------
     MINI GALLERY (overlay, no blur, no rail)
     --------------------------- */
  .ch-mini{
    position:absolute; left:8px; right:48px; bottom:8px; z-index:5;
    padding:0; background:transparent;        /* no translucent panel */
    border-radius:8px;
    display:flex; align-items:center; opacity:1; transform:none; /* always visible */
  }
  .ch-mini__track{
    display:flex; gap:6px; padding:4px 6px;
    overflow:hidden;                           /* no scroll, no rail */
    scrollbar-width:none;                      /* Firefox */
  }
  .ch-mini__track::-webkit-scrollbar{ display:none; } /* WebKit */

  .ch-mini__thumb{
    flex:0 0 auto; width:40px; height:40px; padding:0;
    border:1px solid #E5E7EB; background:#fff; border-radius:6px;
    display:grid; place-items:center; cursor:pointer;
    transition:border-color .15s, box-shadow .15s, transform .15s;
  }
  .ch-mini__thumb img{ width:100%; height:100%; object-fit:cover; border-radius:5px; }
  .ch-mini__thumb:hover{ transform:translateY(-1px); }
  .ch-mini__thumb.is-active{ border-color:var(--brand); box-shadow:0 0 0 2px rgba(224,58,47,.15); }
  .ch-mini__thumb:focus-visible{ outline:2px solid transparent; box-shadow:0 0 0 3px rgba(224,58,47,.20); }

  /* Cap: 5 desktop, 3 mobile */
  @media (min-width:768px){
    .ch-mini__track .ch-mini__thumb:nth-child(n+6){ display:none !important; }
  }
  @media (max-width:767px), (hover:none){
    .ch-mini{ left:6px; right:44px; bottom:6px; }
    .ch-mini__track{ padding:3px 4px; gap:4px; }
    .ch-mini__thumb{ width:30px; height:30px; }
    .ch-mini__track .ch-mini__thumb:nth-child(n+4){ display:none !important; }
  }

  /* ---------------------------
     QUICK VIEW MODAL SHELL
     --------------------------- */
  .ch-qv{ position:fixed; inset:0; display:none; z-index:9999; }
  .ch-qv[data-open="true"]{ display:block; }
  .ch-qv__ov{ position:absolute; inset:0; background:rgba(0,0,0,.45); }
  .ch-qv__pn{
    position:absolute; top:0; right:0; height:100%;
    width:min(720px,92%); background:#fff; overflow:auto;
    box-shadow:-12px 0 24px rgba(0,0,0,.2);
  }
</style>

<script>
/* Image loader clear */
(function(){
  if(window.CHCARD_LOCAL_INIT_V3) return; window.CHCARD_LOCAL_INIT_V3=true;
  function init(scope){
    (scope||document).querySelectorAll('.ch-card').forEach(card=>{
      const img=card.querySelector('[data-img-main]'); const wrap=card.querySelector('.ch-card__media');
      if(img && wrap){ if(img.complete) wrap.setAttribute('data-loaded','true'); }
    });
  }
  document.addEventListener('DOMContentLoaded', ()=>init());
  document.addEventListener('shopify:section:load', e=>init(e.target));
})();

/* ATC (AJAX), QV shell, Wishlist, Okendo fallback-hide, Mini-gallery, QV URL loader */
(function(){
  if(window.CH_BIND_CARD_V11) return; window.CH_BIND_CARD_V11=true;

  /* ATC */
  document.addEventListener('submit', async function(e){
    const form=e.target.closest('.ch-atc'); if(!form) return;
    e.preventDefault();
    const btn=form.querySelector('.ch-atcbtn');
    if(btn){
      btn.classList.add('is-adding');
      btn.setAttribute('aria-busy','true');
      if('disabled' in btn) btn.disabled = true;
    }
    const fd=new FormData(form); const payload={ id: fd.get('id'), quantity: Number(fd.get('quantity')||1) };
    try{
      const r=await fetch('/cart/add.js',{ method:'POST', headers:{'Content-Type':'application/json','Accept':'application/json'}, body:JSON.stringify(payload), credentials:'same-origin', cache:'no-store' });
      if(!r.ok) throw 0;
      try{
        const cart=await (await fetch('/cart.js',{headers:{'Accept':'application/json'},cache:'no-store'})).json();
        const bubble=document.querySelector('[data-cart-count]'); if(bubble) bubble.textContent=String(cart.item_count||0);
        const live=document.querySelector('[data-cart-live]');  if(live)   live.textContent=(cart.item_count||0)+' items in cart';
      }catch(_){}
      document.dispatchEvent(new Event('open-mini-cart'));
      if(btn){
        btn.classList.remove('is-adding');
        btn.classList.add('is-added');
        btn.removeAttribute('aria-busy');
        if('disabled' in btn) btn.disabled = false;
        setTimeout(()=>{ btn.classList.remove('is-added'); }, 800);
      }
    }catch(_){
      if(btn){
        btn.classList.remove('is-adding');
        btn.removeAttribute('aria-busy');
        if('disabled' in btn) btn.disabled = false;
      }
      location.href='/cart';
    }
  }, false);

  /* Quick View shell */
  if(!window.CHQV){
    window.CHQV=(function(){
      const el=document.createElement('div'); el.className='ch-qv';
      el.innerHTML='<div class="ch-qv__ov" data-qv-close></div><aside class="ch-qv__pn" role="dialog" aria-modal="true" aria-label="Quick view"><div data-qv-body></div></aside>';
      document.body.appendChild(el);
      const body=el.querySelector('[data-qv-body]');
      function openFromTemplate(id){ const tpl=document.getElementById(id); if(!tpl){ console.warn('[QV] Missing template', id); return; } body.innerHTML=tpl.innerHTML; el.setAttribute('data-open','true'); document.documentElement.style.overflow='hidden'; }
      function close(){ el.removeAttribute('data-open'); document.documentElement.style.overflow=''; body.innerHTML=''; }
      el.addEventListener('click',e=>{ if(e.target.closest('[data-qv-close]') || e.target.classList.contains('ch-qv__ov')) close(); });
      document.addEventListener('keydown',e=>{ if(e.key==='Escape' && el.getAttribute('data-open')==='true') close(); });
      return { openFromTemplate, close };
    })();
  }

  /* QV: support URL-based quick view (?view=quick-view) with graceful fallback */
  (function(){
    const root=document.querySelector('.ch-qv'); if(!root) return;
    const body=root.querySelector('[data-qv-body]');
    window.CHQV.openFromURL = async function(url, fallbackTemplateId){
      if(!body) { location.href=url; return; }
      try{
        const r = await fetch(url, { headers:{ 'Accept':'text/html' }, credentials:'same-origin' });
        if(!r.ok) throw 0;
        const html = await r.text();
        body.innerHTML = html;
        root.setAttribute('data-open','true');
        document.documentElement.style.overflow='hidden';
      }catch(_){
        if (fallbackTemplateId && window.CHQV && typeof window.CHQV.openFromTemplate==='function'){
          window.CHQV.openFromTemplate(fallbackTemplateId);
        }else{
          location.href = url;
        }
      }
    };
  })();

  /* Delegate to open QV from inline template (legacy fallback) */
  document.addEventListener('click', function(e){
    const t=e.target.closest('[data-qv-target]'); if(!t) return;
    e.preventDefault(); window.CHQV.openFromTemplate(t.getAttribute('data-qv-target'));
  }, false);

  /* Delegate to open QV from URL anchor */
  document.addEventListener('click', function(e){
    const a=e.target.closest('.ch-qv-fab[href][data-qv-url]'); if(!a) return;
    e.preventDefault();
    if(window.CHQV && typeof window.CHQV.openFromURL==='function'){
      window.CHQV.openFromURL(a.getAttribute('data-qv-url'), a.getAttribute('data-qv-target'));
    }else{
      location.href = a.getAttribute('href');
    }
  }, false);

  /* Wishlist toggle (emit event for integration) */
  document.addEventListener('click', function(e){
    const b=e.target.closest('[data-wishlist-add]'); if(!b) return;
    e.preventDefault();
    const on=b.classList.toggle('is-active'); b.setAttribute('aria-pressed', on ? 'true' : 'false');
    try{ document.dispatchEvent(new CustomEvent('wishlist:add', {detail:{productId:b.getAttribute('data-wishlist-add'), active:on}})); }catch(_){}
  }, false);

  /* Hide fallback stars once Okendo paints */
  document.addEventListener('DOMContentLoaded', function(){
    document.querySelectorAll('.ch-rating').forEach(function(r){
      const oke=r.querySelector('.ch-rating__oke'); const fb=r.querySelector('.ch-rating__fallback'); if(!oke || !fb) return;
      const check=()=>{ if(oke.innerHTML && oke.innerHTML.trim().length>0){ fb.style.display='none'; } };
      new MutationObserver(check).observe(oke,{childList:true,subtree:true}); setTimeout(check,600);
    });
  });

  /* Mini gallery: swap main image on thumb click/hover */
  document.addEventListener('click', function(e){
    const t = e.target.closest('.ch-mini__thumb'); if(!t) return;
    const card = t.closest('.ch-card');
    const main = card?.querySelector('[data-img-main]'); if(!main) return;

    const src    = t.getAttribute('data-src');
    const srcset = t.getAttribute('data-srcset');
    if(srcset) main.setAttribute('srcset', srcset);
    if(src)    main.setAttribute('src', src);

    const group = t.closest('[data-mini]');
    group?.querySelectorAll('.ch-mini__thumb').forEach(b=>{
      const on = b === t;
      b.classList.toggle('is-active', on);
      b.setAttribute('aria-selected', on ? 'true' : 'false');
    });
  }, false);

  document.addEventListener('mouseover', function(e){
    const t = e.target.closest('.ch-mini__thumb'); if(!t) return;
    if(window.matchMedia('(hover:hover)').matches){ t.click(); }
  }, false);
})();
</script>
