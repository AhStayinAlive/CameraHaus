{% comment %}
SNIPPET: ch-payments.liquid
Encapsulates the payment chips row with a "+N" popover.

Accepts:
- section_id: string (required, used for unique IDs)
- all: comma-separated list of all payment keys (e.g. "visa,mastercard,amex")
- pinned: comma-separated list of keys to show always (the rest go into popover)
- ext: file extension for icons (default: "svg")

Assumes icon assets are uploaded to Files as <key>-pg.<ext> (e.g., visa-pg.svg)
Markup/classnames match original CSS/JS on the PDP.
{% endcomment %}

{% comment %} ========================== {% endcomment %}
{% comment %} File: snippets/ch-payments.liquid {% endcomment %}
{% comment %} ========================== {% endcomment %}

{%- assign chp_ext = ext | default: 'svg' -%}

{%- assign chp_all_raw = all | split: ',' -%}
{%- assign chp_all = '' | split: ',' -%}
{%- for k in chp_all_raw -%}
  {%- assign k_trim = k | strip -%}
  {%- assign chp_all = chp_all | push: k_trim -%}
{%- endfor -%}

{%- assign chp_pin_raw = pinned | split: ',' -%}
{%- assign chp_pin = '' | split: ',' -%}
{%- for k in chp_pin_raw -%}
  {%- assign k_trim = k | strip -%}
  {%- assign chp_pin = chp_pin | push: k_trim -%}
{%- endfor -%}

{%- assign chp_rest = '' | split: ',' -%}
{%- for k in chp_all -%}
  {%- unless chp_pin contains k -%}
    {%- assign chp_rest = chp_rest | push: k -%}
  {%- endunless -%}
{%- endfor -%}
{%- assign chp_count = chp_rest | size -%}

<div id="ChPayments-{{ section_id }}" class="ch-payments" aria-label="Payment methods" data-count="{{ chp_count }}">
  <div class="ch-payments__row">
    {%- for kk in chp_pin -%}
      {%- assign f = kk | append: '-pg.' | append: chp_ext -%}
      <span class="ch-chip">
        <img class="ch-chip__img" src="{{ f | file_url }}" alt="{{ kk | upcase }}" width="44" height="28" loading="lazy">
      </span>
    {%- endfor -%}

    {%- if chp_count > 0 -%}
      <button
        class="ch-payments__morebtn ch-chip"
        type="button"
        aria-haspopup="dialog"
        aria-expanded="false"
        aria-controls="ChPaymentsMore-{{ section_id }}"
      >+{{ chp_count }}</button>
    {%- endif -%}
  </div>

  {%- if chp_count > 0 -%}
    <div
      id="ChPaymentsMore-{{ section_id }}"
      class="ch-payments__popover"
      role="dialog"
      aria-label="More payment methods"
      aria-modal="false"
      hidden
    >
      <div class="ch-payments__grid">
        {%- for kk in chp_rest -%}
          {%- assign f = kk | append: '-pg.' | append: chp_ext -%}
          <div class="ch-payments__tile">
            <img src="{{ f | file_url }}" alt="{{ kk | upcase }}" width="44" height="28" loading="lazy">
          </div>
        {%- endfor -%}
      </div>
    </div>
  {%- endif -%}
</div>

{%- comment -%} Inline behavior to support +N hover/tap and a11y {%- endcomment -%}
<script>
  (function(){
    var root = document.getElementById('ChPayments-{{ section_id }}');
    if(!root) return;
    var btn = root.querySelector('.ch-payments__morebtn');
    var pop = root.querySelector('.ch-payments__popover');
    if(!btn || !pop) return;

    var mqHover = window.matchMedia('(hover:hover) and (pointer:fine)');

    function open(){
      root.classList.add('is-open');
      btn.setAttribute('aria-expanded','true');
      pop.removeAttribute('hidden');
    }
    function close(){
      root.classList.remove('is-open');
      btn.setAttribute('aria-expanded','false');
      pop.setAttribute('hidden','');
    }
    function toggle(){ root.classList.contains('is-open') ? close() : open(); }

    // Tap/click toggle (mobile & desktop)
    btn.addEventListener('click', function(e){ e.stopPropagation(); toggle(); });

    // Hover open/close for desktop pointers
    if (mqHover.matches){
      btn.addEventListener('mouseenter', open);
      root.addEventListener('mouseleave', close);
    }

    // Close on outside click
    document.addEventListener('click', function(e){ if(!root.contains(e.target)) close(); });

    // Keyboard support
    btn.addEventListener('keydown', function(e){
      if(e.key === 'Escape') close();
      if((e.key === 'Enter' || e.key === ' ') && !mqHover.matches){ e.preventDefault(); toggle(); }
    });
    pop.addEventListener('keydown', function(e){ if(e.key === 'Escape') close(); });
  })();
</script>
