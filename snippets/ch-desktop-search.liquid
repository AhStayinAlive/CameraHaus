{%- comment -%}
SNIPPET: ch-desktop-search.liquid (hardened)
- Guaranteed open (inline display + attribute)
- Unclips parent wrappers that might hide the panel
- Predictive via /search/suggest.json, prefill via default collection
{%- endcomment -%}

<div id="chds-{{ section.id }}" class="chds desk-search-wrap only-d"
     data-ps-wrap
     data-prefill-url="{{ section.settings.default_preview_collection.url | default: '' }}"
     data-prefill-handle="{{ section.settings.default_preview_collection.handle | default: '' }}"
     data-limit="{{ section.settings.search_limit_products | default: 6 }}"
     data-locale="{{ request.locale.iso_code | default: 'en-PH' }}"
     data-currency="{{ shop.currency | default: 'PHP' }}">

  <style>
    /* ===== SCOPED to #chds-{{ section.id }} ===== */
    #chds-{{ section.id }}{ position:relative; width:100%; max-width:760px; justify-self:center; z-index: 200000; }
    #chds-{{ section.id }} .desk-search{
      display:flex; align-items:center; gap:8px;
      background:#fff; border:1px solid #d12f24; border-radius:10px; padding:0 10px 0 14px; height:40px;
      box-shadow:0 1px 2px rgba(0,0,0,.03);
    }
    #chds-{{ section.id }} .desk-search:focus-within{ border-color:#fff; box-shadow:0 0 0 2px rgba(255,255,255,.15); }
    #chds-{{ section.id }} .desk-search input[type="search"]{ width:100%; border:0; outline:0; background:transparent; color:#161616; font-weight:500; font-size:15px; }
    #chds-{{ section.id }} .desk-search .sbtn{
      display:inline-flex; align-items:center; justify-content:center;
      height:32px; padding:0 14px; border-radius:8px; border:1px solid #e03a2f;
      background:#e03a2f; color:#fff; font-weight:600; font-size:13px; line-height:1; cursor:pointer; text-transform:lowercase;
    }
    #chds-{{ section.id }} .desk-search .sbtn:hover{ background:#d12f24; border-color:#d12f24; }

    /* Predictive panel */
    #chds-{{ section.id }} .ps-panel{
      position:absolute; left:50%; top:calc(100% + 12px); transform:translateX(-50%);
      background:#fff; border:1px solid #e8e8e8; border-radius:16px; box-shadow:0 12px 34px rgba(17,17,17,.12);
      width:clamp(820px, 62vw, 1040px); max-width:calc(100vw - 24px);
      display:none; z-index: 999999; overflow: hidden;
    }
    #chds-{{ section.id }} .ps-panel[data-open="true"]{ display:block; }

    #chds-{{ section.id }} .ps-inner{ display:grid; grid-template-columns:1.6fr 1fr; }
    #chds-{{ section.id }} .ps-col{ padding:12px; }
    #chds-{{ section.id }} .ps-col + .ps-col{ border-left:1px solid #e8e8e8; }
    #chds-{{ section.id }} .ps-title{ margin:4px 0 10px; font:700 12px/1 var(--font-sans, ui-sans-serif, system-ui); color:#6b7280; letter-spacing:.02em; text-transform:uppercase; }
    #chds-{{ section.id }} .lst{ list-style:none; margin:0; padding:0 8px 12px; display:grid; gap:8px; }

    #chds-{{ section.id }} .ch-mini{ position:relative; display:grid; grid-template-columns:56px 1fr; gap:10px; padding:8px; border-radius:10px; border:1px solid #EEF2F6; }
    #chds-{{ section.id }} .ch-mini .overlay{ position:absolute; inset:0; border-radius:10px; }
    #chds-{{ section.id }} .ch-mini .thumb{ width:56px; height:56px; border-radius:10px; background:#fff; border:1px solid #F1F5F9; object-fit:contain; }
    #chds-{{ section.id }} .ch-mini .mtitle{ font-weight:600; font-size:13px; line-height:1.35; color:#111; }
    #chds-{{ section.id }} .ch-mini .price{ font-weight:800; font-size:12px; color:#e03a2f; }
    #chds-{{ section.id }} .price-was{ color:#6B7280; text-decoration:line-through; margin-left:6px; font-weight:700; }

    /* Text chips */
    #chds-{{ section.id }} [data-ps-chips],
    #chds-{{ section.id }} [data-ps-brands]{ display:block; background:transparent!important; padding:0!important; border:0!important; }
    #chds-{{ section.id }} .ps-txtlink{ display:inline!important; background:transparent!important; border:0!important; margin:0!important; padding:0!important; color:#111!important; text-decoration:none!important; font-weight:600; font-size:13px; line-height:1.6; }
    #chds-{{ section.id }} .ps-bullet{ display:inline-block; padding:0 6px; opacity:.38; user-select:none; }
    #chds-{{ section.id }} .ps-txtlink:hover, #chds-{{ section.id }} .ps-txtlink:focus{ color:#d12f24!important; }

    /* Suggestions */
    #chds-{{ section.id }} .sugg .srow{ display:flex; align-items:center; gap:8px; padding:6px 8px; border-radius:10px; cursor:pointer; }
    #chds-{{ section.id }} .sugg .srow:hover{ background:#F8FAFC; }
    #chds-{{ section.id }} .sugg .ico{ width:16px; height:16px; color:#6b7280; }
    #chds-{{ section.id }} .sugg .srow div{ color:#d12f24; font-weight:600; }
    #chds-{{ section.id }} .sugg mark{ background:transparent; color:#d12f24; font-weight:800; }

    /* Footer CTA */
    #chds-{{ section.id }} .ps-foot{ display:flex; justify-content:center; padding:10px 12px 12px; border-top:1px solid #e8e8e8; background:#fff; }
    #chds-{{ section.id }} .cta-all{ border:1px solid #e03a2f; background:#e03a2f; color:#fff; border-radius:8px; height:40px; padding:0 14px; font-weight:600; display:inline-flex; align-items:center; gap:8px; }
    #chds-{{ section.id }} .cta-all:hover{ background:#d12f24; border-color:#d12f24; }
  </style>

  <!-- Search field -->
  <form action="{{ routes.search_url }}" method="get" class="desk-search" role="search" aria-label="Search site" novalidate>
    <input type="search" name="q" placeholder="" aria-label="Search products"
           autocomplete="off" data-ps-input aria-controls="ps-panel-{{ section.id }}" aria-expanded="false">
    <button class="sbtn" type="submit">search</button>
  </form>

  <!-- Predictive panel -->
  <div id="ps-panel-{{ section.id }}" class="ps-panel" role="dialog" aria-modal="false" aria-label="Search suggestions" data-ps-panel>
    <div class="ps-inner">
      <div class="ps-col">
        <p class="ps-title" data-ps-heading>Find inspiration</p>
        <ul class="lst" role="listbox" aria-label="Product results" data-ps-prods>
          {% for i in (1..6) %}
            <li class="ch-mini" aria-hidden="true">
              <div class="thumb" style="background:linear-gradient(90deg,#eee,#f7f7f7,#eee);border-radius:8px;"></div>
              <div>
                <div style="height:14px;border-radius:6px;background:linear-gradient(90deg,#eee,#f7f7f7,#eee);margin-bottom:6px;"></div>
                <div style="width:64px;height:12px;border-radius:6px;background:linear-gradient(90deg,#eee,#f7f7f7,#eee);"></div>
              </div>
            </li>
          {% endfor %}
        </ul>
      </div>
      <div class="ps-col">
        <p class="ps-title">QUICK SEARCH</p>
        <div class="chips-inline" data-ps-chips></div>

        <p class="ps-title" style="margin-top:10px;">BRANDS</p>
        <div class="chips" data-ps-brands></div>

        <p class="ps-title" style="margin-top:10px;">SUGGESTIONS</p>
        <div class="sugg" data-ps-sugs></div>
      </div>
    </div>
    <div class="ps-foot">
      <a class="cta-all" href="/search?q=" data-ps-viewall>View all results</a>
    </div>
    <span class="sr-only" aria-live="polite" data-ps-live></span>
  </div>

  <!-- Data blocks (kept by ID so header autotype can read) -->
  <script id="ps-prompts-{{ section.id }}" type="application/json">
    {{ section.settings.search_prompts
      | default: "Search Canon products\nSearch Nikon products\nSearch Sony E-mount lenses\nSearch gimbals\nSearch 128GB SD cards"
      | newline_to_br | split: '<br />' | map: 'strip' | json }}
  </script>
  <script id="ps-quick-{{ section.id }}" type="application/json">
    {{ section.settings.trending_list | default: "Instant\nMirrorless\nFilm\nAction\nLens\nDrones\n360\nGimbals" | split: "\n" | json }}
  </script>
  <script id="ps-brands-{{ section.id }}" type="application/json">
    {{ section.settings.brands_list | default: "Canon\nDJI\nNikon\nRicoh\nSony\nFujifilm\nPanasonic\nSigma\nGoPro\nTamron\nTokina\nZeiss" | split: "\n" | json }}
  </script>

  <!-- Predictive logic -->
  <script>
  (() => {
    const root   = document.getElementById('chds-{{ section.id }}'); if (!root) return;
    const wrap   = root.querySelector('[data-ps-wrap]');
    const input  = root.querySelector('[data-ps-input]');
    const panel  = root.querySelector('[data-ps-panel]');
    const prods  = root.querySelector('[data-ps-prods]');
    const chipsC = root.querySelector('[data-ps-chips]');
    const brandsC= root.querySelector('[data-ps-brands]');
    const suggC  = root.querySelector('[data-ps-sugs]');
    const viewAll= root.querySelector('[data-ps-viewall]');
    if (!wrap || !input || !panel || !prods) return;

    /* --- Unclip likely ancestors so panel is visible --- */
    (function unclip(){
      const suspects = [
        document.getElementById('shopify-section-header'),
        document.querySelector('.shopify-section-header-sticky'),
        document.querySelector('.header-wrapper'),
        root.closest('.bar'),
        root.closest('.row'),
        root.closest('.wrap')
      ].filter(Boolean);
      suspects.forEach(el => {
        el.style.setProperty('overflow', 'visible', 'important');
        el.style.setProperty('z-index', '200000', 'important');
        el.style.setProperty('transform', 'none');
        el.style.setProperty('will-change', 'auto');
      });
    })();

    const limit = parseInt(wrap.dataset.limit || '6', 10);
    const locale = wrap.dataset.locale || 'en-PH';
    const currency = wrap.dataset.currency || '{{ shop.currency | default: "PHP" }}';
    const prefillHandle = (wrap.dataset.prefillHandle || '').trim();
    const minChars = Number('{{ section.settings.search_min_chars | default: 2 }}') || 2;

    const fmtMoney = (maybeCents) => {
      if (maybeCents == null || maybeCents === '') return '';
      const n = typeof maybeCents === 'number'
        ? (maybeCents >= 1000 ? maybeCents/100 : maybeCents)   // tolerate raw or cents
        : parseFloat(maybeCents);
      if (Number.isNaN(n)) return '';
      try{ return new Intl.NumberFormat(locale, { style:'currency', currency }).format(n); }
      catch{ return `${currency} ${n.toFixed(2)}`; }
    };

    const clearProds = () => { prods.innerHTML = ''; };
    const skeleton = () => {
      clearProds();
      for (let i=0;i<limit;i++){
        const li = document.createElement('li');
        li.className='ch-mini'; li.setAttribute('aria-hidden','true');
        li.innerHTML = `
          <div class="thumb" style="background:linear-gradient(90deg,#eee,#f7f7f7,#eee);border-radius:8px;"></div>
          <div>
            <div style="height:14px;border-radius:6px;background:linear-gradient(90deg,#eee,#f7f7f7,#eee);margin-bottom:6px;"></div>
            <div style="width:64px;height:12px;border-radius:6px;background:linear-gradient(90deg,#eee,#f7f7f7,#eee);"></div>
          </div>`;
        prods.appendChild(li);
      }
    };

    const renderProducts = (items=[]) => {
      clearProds();
      if (!items.length){ skeleton(); return; }
      const frag = document.createDocumentFragment();
      items.forEach(p => {
        const url = p.url || (p.handle ? `/products/${p.handle}` : '#');
        const img = (p.featured_image && (p.featured_image.url || p.featured_image)) ||
                    p.image || (p.images && p.images[0] && (p.images[0].url || p.images[0].src)) || '';
        const title = (p.title || '').toString();
        const priceRaw = p.price_min ?? p.min_price ?? p.price ?? (p.variants && p.variants[0] && (p.variants[0].price || p.variants[0].price_min));
        const price = fmtMoney(priceRaw);
        const li = document.createElement('li');
        li.className = 'ch-mini';
        li.innerHTML = `
          <a class="overlay" href="${url}" aria-label="${title.replace(/"/g,'&quot;')}"></a>
          <img class="thumb" loading="lazy" src="${img || ''}" alt="${title.replace(/"/g,'&quot;')}">
          <div>
            <div class="mtitle">${title}</div>
            <div class="price">${price || ''}</div>
          </div>`;
        frag.appendChild(li);
      });
      prods.appendChild(frag);
    };

    const setCTA = (q) => {
      const t = (q && q.trim().length >= minChars) ? `View "${q}"` : 'View all results';
      viewAll.textContent = t;
      viewAll.href = `/search?q=${encodeURIComponent(q || '')}`;
    };

    const setSuggestions = (q, suggestions=[]) => {
      if (!suggC) return;
      suggC.innerHTML = '';
      const addRow = (label, href) => {
        const row = document.createElement('div');
        row.className='srow';
        row.innerHTML = `<svg class="ico" viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7"/><line x1="20" y1="20" x2="16.65" y2="16.65"/></svg><div>${label}</div>`;
        row.addEventListener('click', ()=>{ window.location.href = href; });
        suggC.appendChild(row);
      };

      if (q && q.trim().length >= minChars){
        addRow(`View <mark>"${q}"</mark>`, `/search?q=${encodeURIComponent(q)}`);
        (suggestions || []).slice(0, 6).forEach(s => {
          const text = (typeof s === 'string') ? s : (s?.text || '');
          if (text && text.toLowerCase() !== q.toLowerCase()){
            addRow(text, `/search?q=${encodeURIComponent(text)}`);
          }
        });
      } else {
        ['New arrivals','Best sellers','On sale'].forEach(s => addRow(s, `/search?q=${encodeURIComponent(s)}`));
      }
    };

    const fromJSON = (id, fallback=[]) => {
      try{ return JSON.parse(document.getElementById(id)?.textContent||'[]') || fallback; }catch{ return fallback; }
    };
    const renderInlineChips = (container, items=[]) => {
      if (!container) return;
      container.innerHTML = '';
      const frag = document.createDocumentFragment();
      items.filter(Boolean).forEach((txt, i) => {
        const a = document.createElement('a');
        a.href = `/search?q=${encodeURIComponent(txt)}`;
        a.className = 'ps-txtlink';
        a.textContent = txt;
        a.addEventListener('click', (e)=>{ e.preventDefault(); input.value = txt; openPanel(true); firePredictive(); input.focus(); });
        frag.appendChild(a);
        if (i < items.length - 1){ const dot = document.createElement('span'); dot.className = 'ps-bullet'; dot.textContent = '•'; frag.appendChild(dot); }
      });
      container.appendChild(frag);
    };

    /* Quick chips & brands */
    renderInlineChips(chipsC,  fromJSON('ps-quick-{{ section.id }}', []));
    renderInlineChips(brandsC, fromJSON('ps-brands-{{ section.id }}', []));

    let inflight = 0;
    const fetchPredictive = async (q) => {
      const ticket = ++inflight;
      const url = `/search/suggest.json?q=${encodeURIComponent(q)}&resources[type]=product&resources[limit]=${encodeURIComponent(limit)}`;
      try{
        const res = await fetch(url, {credentials:'same-origin'});
        if (!res.ok) throw new Error('suggest failed');
        const json = await res.json();
        if (ticket !== inflight) return; // stale

        const items =
          (json && json.resources && json.resources.results && json.resources.results.products) ||
          (json && json.resources && json.resources.products) || [];
        renderProducts(items);

        const suggs = Array.isArray(json?.suggestions)
          ? json.suggestions.map(s => s?.text || s).filter(Boolean)
          : [];
        setSuggestions(q, suggs);
      }catch(e){
        renderProducts([]); setSuggestions(q, []);
      }
    };

    const fetchPrefill = async () => {
      setCTA('');
      setSuggestions('', []);
      if (!prefillHandle){ skeleton(); return; }
      try{
        const res = await fetch(`/collections/${encodeURIComponent(prefillHandle)}/products.json?limit=${encodeURIComponent(limit)}`, {credentials:'same-origin'});
        const json = await res.json();
        const items = Array.isArray(json?.products) ? json.products : [];
        renderProducts(items);
      }catch(e){ skeleton(); }
    };

    const reallyShow = () => {
      // Attribute AND inline style with !important to beat rogue CSS
      panel.setAttribute('data-open','true');
      input.setAttribute('aria-expanded','true');
      try{ panel.style.setProperty('display','block','important'); }catch(_){}
    };
    const openPanel = (force) => { if (force || document.activeElement === input) reallyShow(); };
    const closePanel = () => {
      panel.removeAttribute('data-open');
      input.setAttribute('aria-expanded','false');
      panel.style.removeProperty('display');
    };

    const firePredictive = () => {
      const q = input.value || '';
      setCTA(q);
      if (q.trim().length >= minChars){ fetchPredictive(q); } else { fetchPrefill(); }
    };

    // Events
    input.addEventListener('focus', () => { openPanel(true); firePredictive(); });
    input.addEventListener('input', () => { openPanel(true); firePredictive(); });
    document.addEventListener('click', (e) => { if (!root.contains(e.target)) closePanel(); });
    panel.addEventListener('mousedown', (e) => e.stopPropagation());
    input.addEventListener('keydown', (e)=>{ if (e.key==='Escape') closePanel(); });

    // On load: prep skeleton so first open never looks empty
    skeleton();
  })();
  </script>
</div>
