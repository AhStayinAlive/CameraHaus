{%- assign _uid = uid | default: 'x' -%}
{%- assign _render_desktop = render_desktop -%}{%- if _render_desktop == nil -%}{%- assign _render_desktop = true -%}{%- endif -%}
{%- assign _render_mobile  = render_mobile  -%}{%- if _render_mobile  == nil -%}{%- assign _render_mobile  = true -%}{%- endif -%}
{%- assign _min = search_min_chars | default: 2 -%}
{%- assign _lim = search_limit | default: 6 -%}
{%- assign _show_recent = show_recent -%}
{%- assign _show_trending = show_trending -%}
{%- assign _trending = trending_list | default: "Canon\nNikon\nSony E-mount lens\nGimbal\n128GB SD" -%}

<style>
#ch-search-{{ _uid }}{ --line:#e8e8e8; --ink:#161616; --brand:#E0302A; --shadow:0 10px 30px rgba(17,17,17,.12); }
@media (min-width:992px){ #ch-search-{{ _uid }} .sheet{ display:none !important; } }
#ch-search-{{ _uid }} .desk-search-wrap{ position:relative; max-width:820px; width:100%; }
@media (max-width:991px){ #ch-search-{{ _uid }} .desk-search-wrap{ display:none; } }
@media (min-width:992px){ #ch-search-{{ _uid }} .desk-search-wrap{ display:block; } }
#ch-search-{{ _uid }} .desk-search{ display:grid; grid-template-columns:1fr auto; gap:8px; background:#fff; border:1px solid var(--line); border-radius:14px; padding:0 8px 0 12px; align-items:center; height:46px; }
#ch-search-{{ _uid }} .desk-search input[type="search"]{ width:100%; border:0; outline:0; background:transparent; color:var(--ink); font:600 16px/1.25 var(--font-body,inherit); }
#ch-search-{{ _uid }} .desk-search .sbtn{ height:38px; padding:0 16px; border-radius:10px; border:0; background:#111; color:#fff; font:800 14px/1 var(--font-body,inherit); cursor:pointer; }
#ch-search-{{ _uid }} .ps-panel{ position:absolute; left:0; right:0; top:calc(100% + 10px); background:#fff; color:var(--ink); border:1px solid var(--line); border-radius:14px; box-shadow:var(--shadow); display:none; z-index:1400; }
#ch-search-{{ _uid }} .ps-panel[data-open="true"]{ display:block; }
#ch-search-{{ _uid }} .ps-inner{ display:grid; grid-template-columns:1fr 1fr; gap:12px; padding:12px; }
#ch-search-{{ _uid }} .ps-title{ margin:0 0 8px; font:800 12px/1; color:#666; letter-spacing:.02em; }
#ch-search-{{ _uid }} .lst{ list-style:none; margin:0; padding:0; display:grid; gap:8px; }
#ch-search-{{ _uid }} .chips{ display:flex; gap:8px; flex-wrap:nowrap; overflow:hidden; }
#ch-search-{{ _uid }} .chip{ display:inline-flex; align-items:center; height:30px; padding:0 10px; border-radius:999px; border:1px solid var(--line); background:#fff; color:#ink; text-decoration:none; font-weight:700; font-size:12px; cursor:pointer; }
#ch-search-{{ _uid }} .pcard{ position:relative; border:1px solid var(--line); border-radius:12px; background:#fff; display:grid; grid-template-columns:56px 1fr auto; gap:10px; align-items:center; padding:10px; text-decoration:none; color:inherit; overflow:hidden; }
#ch-search-{{ _uid }} .pcard .thumb{ width:56px; height:56px; border-radius:10px; object-fit:cover; background:#f4f4f4; }
#ch-search-{{ _uid }} .pcard .mtitle{ font:700 13px/1.25 var(--font-body,inherit); color:#111; }
#ch-search-{{ _uid }} .price{ display:flex; align-items:center; gap:8px; white-space:nowrap; }
#ch-search-{{ _uid }} .price-now{ font:900 13px/1 var(--font-body,inherit); color:var(--brand); }
#ch-search-{{ _uid }} .price-was{ font:700 12px/1 var(--font-body,inherit); color:#999; text-decoration:line-through; }

#ch-search-{{ _uid }} .sheet{ position:fixed; inset:0; z-index:10000; pointer-events:none; }
#ch-search-{{ _uid }} .sheet__ov{ position:absolute; inset:0; background:rgba(0,0,0,.45); opacity:0; transition:opacity .24s ease; z-index:1; }
#ch-search-{{ _uid }} .sheet__pn{ position:absolute; top:0; right:0; width:min(560px,92vw); height:100%; background:#fff; transform:translateX(104%); transition:transform .36s cubic-bezier(.22,.61,.36,1); display:flex; flex-direction:column; z-index:2; will-change:transform; }
#ch-search-{{ _uid }} .sheet.is-open{ pointer-events:auto; }
#ch-search-{{ _uid }} .sheet.is-open .sheet__ov{ opacity:1; }
#ch-search-{{ _uid }} .sheet.is-open .sheet__pn{ transform:translateX(0); }

#ch-search-{{ _uid }} .sh-hd{ display:flex; align-items:center; justify-content:space-between; gap:8px; padding:14px; border-bottom:1px solid var(--line); }
#ch-search-{{ _uid }} .sh-title{ font:800 14px/1.2 var(--font-body,inherit); color:#111; }
#ch-search-{{ _uid }} .sh-row{ padding:10px 14px; display:grid; gap:10px; }
#ch-search-{{ _uid }} .sh-inp{ height:46px; background:#fff; border:1px solid var(--line); border-radius:12px; display:flex; align-items:center; gap:8px; padding:0 12px; }
#ch-search-{{ _uid }} .sh-inp input{ width:100%; border:0; outline:0; background:transparent; color:#111; font:600 16px/1.25 var(--font-body,inherit); }
#ch-search-{{ _uid }} .sh-live{ position:absolute; left:-9999px; top:auto; width:1px; height:1px; overflow:hidden; }
#ch-search-{{ _uid }} .sh-sec{ padding:8px 14px; }
#ch-search-{{ _uid }} .sh-sec__title{ margin:0 0 8px; font:800 12px/1; color:#666; letter-spacing:.02em; }
#ch-search-{{ _uid }} .it{ display:grid; grid-template-columns:56px 1fr auto; gap:10px; align-items:center; padding:8px; border-radius:12px; border:1px solid var(--line); background:#fff; }
#ch-search-{{ _uid }} .mthumb{ width:56px; height:56px; object-fit:contain; border-radius:8px; background:#f4f4f4; }
#ch-search-{{ _uid }} .mtitle{ font:700 13px/1.3 var(--font-body,inherit); color:#111; }
#ch-search-{{ _uid }} .mprice{ font:800 13px/1 var(--font-body,inherit); color:#111; white-space:nowrap; }
#ch-search-{{ _uid }} .sh-ft{ padding:10px 14px 18px; }
#ch-search-{{ _uid }} .cta-all{ display:inline-flex; align-items:center; gap:8px; height:40px; padding:0 14px; border-radius:999px; background:#000; color:#fff; text-decoration:none; font-weight:800; }
</style>

<div id="ch-search-{{ _uid }}" data-ch-search data-uid="{{ _uid }}">
  {% if _render_desktop %}
  <div class="desk-search-wrap" data-ps-wrap>
    <form action="{{ routes.search_url }}" method="get" class="desk-search" role="search" aria-label="Search site">
      <input type="search" name="q" placeholder="Search products & brands" aria-label="Search products" autocomplete="off" data-ps-input aria-controls="ps-panel-{{ _uid }}" aria-expanded="false">
      <button class="sbtn" type="submit">search</button>
    </form>
    <div id="ps-panel-{{ _uid }}" class="ps-panel" role="dialog" aria-modal="false" aria-label="Search suggestions" data-ps-panel>
      <div class="ps-inner">
        <div>
          <p class="ps-title">Products</p>
          <ul class="lst" role="listbox" aria-label="Product results" data-ps-prods>
            {% for i in (1.._lim) %}
            <li class="pcard" aria-hidden="true">
              <div class="thumb skeleton"></div>
              <div class="skeleton" style="height:14px;border-radius:6px;"></div>
              <div class="skeleton" style="width:64px;height:14px;border-radius:6px;"></div>
            </li>
            {% endfor %}
          </ul>
        </div>
        <div>
          <p class="ps-title">Suggestions</p>
          <ul class="lst" role="listbox" aria-label="Query suggestions" data-ps-sugs></ul>
          <div data-ps-brands-block style="margin-top:10px;">
            <p class="ps-title">Brands</p>
            <div class="chips" data-ps-brands></div>
          </div>
          <div data-ps-chips-block style="margin-top:10px;">
            <p class="ps-title">Quick search</p>
            <div class="chips" data-ps-chips></div>
          </div>
        </div>
      </div>
      <span class="sr-only" aria-live="polite" data-ps-live></span>
    </div>
  </div>
  {% endif %}

  {% if _render_mobile %}
  <div class="sheet" aria-hidden="true" data-sheet>
    <div class="sheet__ov" data-close-search></div>
    <aside class="sheet__pn" role="dialog" aria-modal="true" aria-label="Search our site" data-sheet-panel>
      <div class="sh-hd">
        <div class="sh-title">SEARCH OUR SITE</div>
        <button class="btn" type="button" aria-label="Close search" data-close-search>
          <svg width="22" height="22" viewBox="0 0 24 24" aria-hidden="true"><path d="M18.3 5.7 12 12l6.3 6.3-1.4 1.4L10.6 13.4 4.3 19.7 2.9 18.3 9.2 12 2.9 5.7 4.3 4.3l6.3 6.3L16.9 4.3z"/></svg>
        </button>
      </div>
      <div class="sh-row">
        <div class="sh-inp">
          <input type="search" placeholder="Search products & brands" autocomplete="off" aria-controls="m-list-{{ _uid }}" aria-expanded="false" data-ms-input>
          <button class="btn" type="button" aria-label="Clear" data-ms-clear>
            <svg width="22" height="22" viewBox="0 0 24 24" aria-hidden="true"><path d="M18.3 5.7 12 12l6.3 6.3-1.4 1.4L10.6 13.4 4.3 19.7 2.9 18.3 9.2 12 2.9 5.7 4.3 4.3l6.3 6.3L16.9 4.3z"/></svg>
          </button>
          <svg width="22" height="22" viewBox="0 0 24 24" aria-hidden="true"><path d="M15.5 14h-.8l-.3-.3A6.5 6.5 0 1 0 14 15.5l.3.3v.8L20 21.5 21.5 20l-6-6zM9.5 14A4.5 4.5 0 1 1 14 9.5 4.5 4.5 0 0 1 9.5 14z"/></svg>
        </div>
        <span class="sh-live" aria-live="polite" data-ms-live></span>
      </div>
      <div class="sh-sec">
        <p class="sh-sec__title">Quick search</p>
        <div class="chips" data-ms-chips></div>
      </div>
      <div class="sh-sec">
        <p class="sh-sec__title">Suggestions</p>
        <ul id="m-list-{{ _uid }}" class="lst" role="listbox" aria-label="Search results" data-ms-list></ul>
      </div>
      <div class="sh-ft">
        <a class="cta-all" href="/search?q=" data-ms-viewall>View All</a>
      </div>
    </aside>
  </div>
  {% endif %}
</div>

<script>
(() => {
  const root = document.getElementById('ch-search-{{ _uid }}'); if(!root) return;
  const nf = new Intl.NumberFormat({{ request.locale.iso_code | json }} || 'en-PH', { style:'currency', currency: {{ shop.currency | json }} || 'PHP' });
  const money=(c)=> nf.format((Number(c)||0)/100);
  const esc=(s)=> (s||'').replace(/[&<>"']/g,m=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;','\'':'&#39;'}[m]));
  const widthSwap=(u,w)=> u&&u.indexOf('{width}')>-1 ? u.replace('{width}', String(w)) : (u||'').replace(/(\.(?:jpe?g|png|webp|gif))(?:\?.*)?$/i, '_' + w + 'x$1');
  const srcset=(u)=> widthSwap(u,80) + ' 80w, ' + widthSwap(u,160) + ' 160w, ' + widthSwap(u,320) + ' 320w';

  {% if _render_desktop %}
  (function desk(){
    const wrap=root.querySelector('[data-ps-wrap]'); if(!wrap) return;
    const input=wrap.querySelector('[data-ps-input]'), panel=wrap.querySelector('[data-ps-panel]'), live=wrap.querySelector('[data-ps-live]');
    const listP=wrap.querySelector('[data-ps-prods]'), listS=wrap.querySelector('[data-ps-sugs]');
    const chipsR=wrap.querySelector('[data-ps-chips]'), chipsB=wrap.querySelector('[data-ps-brands]');
    const brandsBlock=wrap.querySelector('[data-ps-brands-block]'), chipsBlock=wrap.querySelector('[data-ps-chips-block]');
    const RKEY='ch_recent_queries'; let db=null, ctl=null; const mem=new Map();

    function chips(){
      if(chipsR) chipsR.innerHTML='';
      {% if _show_recent %}try{
        (JSON.parse(localStorage.getItem(RKEY)||'[]')||[]).forEach(function(t){
          const a=document.createElement('a'); a.href='/search?q='+encodeURIComponent(t); a.textContent=t; a.className='chip'; chipsR.appendChild(a);
        });
      }catch(_){}{% endif %}
      {% if _show_trending %}({{ _trending | json }}||'').split('\n').map(s=>s.trim()).filter(Boolean).slice(0,6).forEach(function(t){
        const a=document.createElement('a'); a.href='/search?q='+encodeURIComponent(t); a.textContent=t; a.className='chip'; chipsR.appendChild(a);
      });{% endif %}
      if(chipsBlock) chipsBlock.style.display = (chipsR && chipsR.children.length) ? '' : 'none';
    }
    chips();

    const open=()=>{ panel.setAttribute('data-open','true'); input.setAttribute('aria-expanded','true'); document.addEventListener('click', onDoc); document.addEventListener('keydown', onEsc); };
    const close=()=>{ panel.setAttribute('data-open','false'); input.setAttribute('aria-expanded','false'); document.removeEventListener('click', onDoc); document.removeEventListener('keydown', onEsc); };
    const onDoc=(e)=>{ if(!panel.contains(e.target) && !wrap.contains(e.target)) close(); };
    const onEsc=(e)=>{ if(e.key==='Escape') close(); };

    function skel(){
      listP.innerHTML=''; listS.innerHTML='';
      for(let i=0;i<{{ _lim }}; i++){
        const li=document.createElement('li'); li.className='pcard';
        li.innerHTML='<div class="thumb skeleton"></div><div class="skeleton" style="height:14px;border-radius:6px;"></div><div class="skeleton" style="width:64px;height:14px;border-radius:6px;"></div>';
        listP.appendChild(li);
      }
      live.textContent='Loading results';
    }

    function fetchSuggest(q){
      if(ctl) ctl.abort(); ctl=new AbortController();
      return fetch('/search/suggest.json?q='+encodeURIComponent(q)+'&resources[type]=product,query&resources[limit]={{ _lim }}', {signal:ctl.signal, headers:{'Accept':'application/json'}, cache:'no-store'})
        .then(r=>r.ok?r.json():null).catch(()=>null);
    }

    function render(js){
      const res=js&&js.resources&&js.resources.results?js.resources.results:{}; const prods=Array.isArray(res.products)?res.products:[]; const sugs=Array.isArray(res.queries)?res.queries:[];
      listP.innerHTML='';
      prods.forEach(function(p){
        const u=(p&&((p.image&&(p.image.url||p.image))||(p.featured_image&&p.featured_image.url)))||'';
        const now=(p.price||p.price_min||0), was=(p.compare_at_price||0);
        const li=document.createElement('li'); li.className='pcard';
        li.innerHTML='<img class="thumb" src="'+widthSwap(u,160)+'" srcset="'+srcset(u)+'" sizes="56px" alt="'+esc(p.title||'')+'" width="56" height="56" loading="lazy" decoding="async" fetchpriority="low"><div><div class="mtitle">'+esc(p.title||'')+'</div><div class="price"><span class="price-now">'+money(now)+'</span>'+(was>now?'<span class="price-was">'+money(was)+'</span>':'')+'</div></div><div></div>';
        listP.appendChild(li);
      });

      listS.innerHTML='';
      sugs.slice(0,{{ _lim }}).forEach(function(s){
        const li=document.createElement('li'); li.className='pcard';
        li.innerHTML = '<div class="thumb" style="background:#f4f4f4;"></div><div><div class="mtitle">'+esc(s.title||s.text||'')+'</div></div><div></div>';
        li.addEventListener('click', function(){ window.location.href = '/search?q=' + encodeURIComponent(s.title || s.text || ''); });
        listS.appendChild(li);
      });

      const seen=new Set();
      if(chipsB){
        chipsB.innerHTML='';
        prods.forEach(function(p){
          const v=(p.vendor||'').trim();
          if(v && !seen.has(v)){
            seen.add(v);
            const a=document.createElement('a'); a.className='chip'; a.href='/search?q='+encodeURIComponent('vendor:"'+v+'"')+'&type=product'; a.textContent=v; chipsB.appendChild(a);
          }
        });
      }
      if(brandsBlock) brandsBlock.style.display = (chipsB && chipsB.children.length) ? '' : 'none';

      live.textContent = (prods.length + Math.min(sugs.length,{{ _lim }})) + ' results';
    }

    input && input.addEventListener('focus', open);
    input && input.addEventListener('input', function(){
      const q=input.value.trim(); clearTimeout(db);
      db=setTimeout(function(){
        if(!q || q.length < {{ _min }}){ listP.innerHTML=''; listS.innerHTML=''; live.textContent='Type to search'; return; }
        if(mem.has(q)){ render(mem.get(q)); return; }
        skel(); fetchSuggest(q).then(function(js){ mem.set(q, js||{}); render(js||{}, q); });
      }, 200);
    });
  })();
  {% endif %}

  {% if _render_mobile %}
  (function mobile(){
    const host = root; if(host.parentNode !== document.body){ document.body.appendChild(host); }
    const sheet  = host.querySelector('[data-sheet]'); if(!sheet) return;
    const panel  = host.querySelector('[data-sheet-panel]');
    const overlay= host.querySelector('.sheet__ov');
    const closers= [overlay, ...Array.from(host.querySelectorAll('[data-close-search]'))].filter(Boolean);
    const input  = host.querySelector('[data-ms-input]');
    const clear  = host.querySelector('[data-ms-clear]');
    const list   = host.querySelector('[data-ms-list]');
    const chips  = host.querySelector('[data-ms-chips]');
    const live   = host.querySelector('[data-ms-live]');
    const viewAll= host.querySelector('[data-ms-viewall]');
    const RKEY   = 'ch_recent_queries';
    let lastFocus=null, ctl=null; const cache=new Map();

    function set(open){
      sheet.classList.toggle('is-open', !!open);
      sheet.setAttribute('aria-hidden', open ? 'false' : 'true');
      if(panel) panel.style.transform = open ? 'translateX(0)' : 'translateX(104%)';
      const lock=open?'hidden':''; document.documentElement.style.overflow=lock; document.body.style.overflow=lock;
      if(open){ lastFocus=document.activeElement; setTimeout(()=>{ input && input.focus(); },10); } else if(lastFocus){ lastFocus.focus(); }
    }
    function openSheet(){ set(true); }
    function closeSheet(){ set(false); }

    // Register this instance
    window.CH_SEARCH_REGISTRY = window.CH_SEARCH_REGISTRY || {};
    window.CH_SEARCH_REGISTRY[host.id] = { open: openSheet, close: closeSheet };

    // Bind buttons that explicitly target this instance via aria-controls
    function bindDirectButtons(){
      const id = host.id;
      const directBtns = Array.from(document.querySelectorAll(`[data-open-search][aria-controls="${id}"]`));
      directBtns.forEach(btn=>{
        if(btn.__ch_search_bound__) return;
        btn.__ch_search_bound__=true;
        const handler=(e)=>{
          if(!window.matchMedia('(max-width: 991px)').matches) return;
          e.preventDefault(); e.stopPropagation();
          openSheet();
        };
        ['click','pointerup','touchend'].forEach(ev=> btn.addEventListener(ev, handler, {passive:false}));
      });
    }
    bindDirectButtons();
    document.addEventListener('shopify:section:load', bindDirectButtons);

    // Close handlers
    closers.forEach(c=>{ c && c.addEventListener('click', ()=> closeSheet()); });
    document.addEventListener('keydown', e=>{ if(e.key==='Escape') closeSheet(); });

    function renderChips(){
      chips.innerHTML='';
      {% if _show_recent %}try{
        (JSON.parse(localStorage.getItem(RKEY)||'[]')||[]).forEach(function(t){
          const a=document.createElement('a'); a.href='/search?q='+encodeURIComponent(t); a.textContent=t; a.className='chip'; chips.appendChild(a);
        });
      }catch(_){}
      {% endif %}
      {% if _show_trending %}({{ _trending | json }} || '').split('\n').map(s=>s.trim()).filter(Boolean).slice(0,6).forEach(function(t){
        const a=document.createElement('a'); a.href='/search?q='+encodeURIComponent(t); a.textContent=t; a.className='chip'; chips.appendChild(a);
      });{% endif %}
    }
    renderChips();

    const escStr=s=> (s||'').replace(/[&<>"']/g,m=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;','\'':'&#39;'}[m]));
    const mark=(t,q)=>{ if(!q) return escStr(t); try{ const re=new RegExp('('+q.replace(/[.*+?^${}()|[\\]\\\\]/g,'\\$&')+')','ig'); return escStr(t).replace(re,'<mark>$1</mark>'); }catch(_){ return escStr(t); } };
    const pickImageUrl=p=>{ let u=(p&&((p.image&&(p.image.url||p.image))||(p.featured_image&&p.featured_image.url)))||''; if(!u) return ''; if(u.indexOf('{width}')>-1) return u.replace('{width}','160'); return u.replace(/(\.(?:jpe?g|png|webp|gif))(?:\?.*)?$/i,'_160x$1'); };
    const announce=t=>{ live && (live.textContent=t); };

    function fetchSuggest(q){
      if(ctl) ctl.abort(); ctl=new AbortController();
      return fetch('/search/suggest.json?q='+encodeURIComponent(q)+'&resources[type]=product,query&resources[limit]={{ _lim }}', {signal:ctl.signal, headers:{'Accept':'application/json'}, cache:'no-store'})
        .then(r=>r.ok?r.json():null).catch(()=>null);
    }

    function render(js){
      list.innerHTML='';
      const res=js&&js.resources&&js.resources.results?js.resources.results:{}; const prods=Array.isArray(res.products)?res.products:[]; const queries=Array.isArray(res.queries)?res.queries:[];
      let count=0;

      prods.slice(0, {{ _lim }}).forEach(function(p){
        const li=document.createElement('li'); li.className='it'; li.setAttribute('role','option');
        li.innerHTML = '<img class="mthumb" src="'+pickImageUrl(p)+'" alt="'+escStr(p.title||'')+'"><div><div class="mtitle">'+mark(p.title||'', input.value.trim())+'</div></div><div class="mprice">'+money((p.price||p.price_min)||0)+'</div>';
        li.addEventListener('click', function(){ window.location.href=p.url||'#'; });
        list.appendChild(li); count++;
      });

      queries.slice(0,5).forEach(function(qy){
        const li=document.createElement('li'); li.className='it'; li.setAttribute('role','option');
        li.innerHTML = '<div class="mthumb" style="display:grid;place-items:center;"><svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path fill="currentColor" d="M3 6h18v2H3zm0 5h12v2H3zm0 5h18v2H3z"/></svg></div><div><div class="mtitle">'+mark(qy.title||qy.text||'', input.value.trim())+'</div></div><div></div>';
        li.addEventListener('click', function(){ window.location.href = '/search?q=' + encodeURIComponent(qy.title || qy.text || ''); });
        list.appendChild(li); count++;
      });

      announce(String(count) + ' result' + (count === 1 ? '' : 's'));
      input && input.setAttribute('aria-expanded', count>0 ? 'true':'false');
      if(count===0){
        const li=document.createElement('li'); li.className='it';
        li.innerHTML='<div></div><div class="mtitle">No results. Try another term.</div><div></div>';
        list.appendChild(li);
      }
    }

    function run(q){
      if(viewAll) viewAll.href = '/search?q=' + encodeURIComponent(q);
      if(!q || q.trim().length < {{ _min }}){ list.innerHTML=''; announce('Showing quick search'); return; }
      if(cache.has(q)){ render(cache.get(q)); return; }
      announce('Loading results'); fetchSuggest(q).then(function(js){ cache.set(q, js||{}); render(js||{}); });
    }

    input && input.addEventListener('input', function(){
      const q=input.value.trim();
      if(clear) clear.style.display = q.length ? 'inline-flex':'none';
      run(q);
    });

    clear && clear.addEventListener('click', function(){
      input.value=''; input.focus(); clear.style.display='none'; list.innerHTML=''; announce('Cleared');
    });
  })();
  {% endif %}
})();
</script>
