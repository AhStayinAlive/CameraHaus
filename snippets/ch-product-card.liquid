{%- liquid
  assign media         = product.featured_media | default: product.featured_image
  assign second_media  = product.media[1] | default: product.images[1]
  assign available     = product.available
  assign v             = product.selected_or_first_available_variant
  assign only_default  = product.has_only_default_variant

  assign price_min     = product.price_min
  assign price_max     = product.price_max
  assign price_varies  = product.price_varies
  assign is_range      = false
  if price_varies and price_max > price_min
    assign is_range = true
  endif

  assign compare_val = 0
  assign pct_save    = 0
  assign save_amt    = 0
  if v and v.compare_at_price and v.compare_at_price > v.price
    assign compare_val = v.compare_at_price
    assign save_amt    = compare_val | minus: v.price
    assign pct_save    = save_amt | times: 100.0 | divided_by: compare_val | floor
  endif

  assign vendor_clean = product.vendor | strip
  assign title_clean  = product.title  | strip
  if vendor_clean != blank
    assign vendor_space = vendor_clean | append: ' '
    assign vendor_dash  = vendor_clean | append: ' - '
    assign vendor_mdash = vendor_clean | append: ' — '
    assign vendor_colon = vendor_clean | append: ': '
    assign vendor_pipe  = vendor_clean | append: ' | '
    assign title_clean = title_clean | replace_first: vendor_space, '' | replace_first: vendor_dash, '' | replace_first: vendor_mdash, '' | replace_first: vendor_colon, '' | replace_first: vendor_pipe, '' | strip
  endif

  assign current_price_text = price_min | money_without_trailing_zeros
  assign compare_text_long  = ''
  if compare_val > 0
    assign compare_text_long = compare_val | money_without_trailing_zeros
  endif

  # ---- misc flags from tags / metafields ----
  assign badge_forced = product.metafields.camerahaus.badge | default: ''
  assign tag_str      = product.tags | join: ',' | downcase
  assign has_bundle   = false
  assign has_new      = false
  assign has_best     = false
  if tag_str contains 'bundle' or tag_str contains 'bundle:'
    assign has_bundle = true
  endif
  if tag_str contains 'new'
    assign has_new = true
  endif
  if tag_str contains 'bestseller' or tag_str contains 'featured'
    assign has_best = true
  endif

  # ---- inventory info ----
  assign inv_tracked = false
  assign inv_qty     = 0
  if v and v.inventory_management and v.inventory_management != ''
    assign inv_tracked = true
    assign inv_qty     = v.inventory_quantity | default: 0
  endif

  # ===========================================================
  # BADGE DECISION: choose the most attractive pill to show
  # - sale pill when discount is attractive enough
  # - stock pill when low quantity is more persuasive
  # ===========================================================
  assign MIN_SALE_PCT = 8     
  assign THRESH_3LEFT = 15 
  assign THRESH_2LEFT = 25   
  assign THRESH_1LEFT = 40    

  assign badge_kind = ''       
  assign badge_text = ''
  assign stock_state = ''   

  if available == false
    assign badge_kind = 'stock'
    assign badge_text = 'Out of stock'
    assign stock_state = 'is-out'
  else
    if inv_tracked and inv_qty > 0 and inv_qty <= 3
      assign stock_threshold = THRESH_3LEFT
      if inv_qty == 2
        assign stock_threshold = THRESH_2LEFT
      endif
      if inv_qty == 1
        assign stock_threshold = THRESH_1LEFT
      endif

      if pct_save >= stock_threshold
        assign badge_kind = 'sale'
        assign badge_text = '−' | append: pct_save | append: '%'
      else
        assign badge_kind = 'stock'
        assign badge_text = inv_qty | append: ' left'
        assign stock_state = 'is-crit'
      endif
    else
      if pct_save >= MIN_SALE_PCT
        assign badge_kind = 'sale'
        assign badge_text = '−' | append: pct_save | append: '%'
      endif
    endif
  endif

  # ---- (compat) legacy variables so existing markup won't break ----
  assign show_stock_badge = false
  assign stock_badge = ''
  if badge_kind == 'stock'
    assign show_stock_badge = true
    assign stock_badge = badge_text
  endif

  assign product_url = product.url

-%}




<article class="ch-card ch-card--elev"
  data-product-id="{{ product.id }}"
  data-product-url="{{ product_url }}"
  data-product-title="{{ title_clean | escape }}">

  
  <a
    class="ch-card__overlay"
    href="{{ product_url }}"
    data-product-url="{{ product_url }}"
    aria-label="View {{ product.title | escape }}">
  </a>

  <!-- MEDIA -->
  <div class="ch-card__mediawrap">
    <a
      class="ch-card__media{% if second_media %} has-alt{% endif %}"
      href="{{ product_url }}"
      data-product-url="{{ product_url }}"
      aria-label="{{ product.title | escape }}"
      data-media-link>
      
      {% if media %}
        <!-- Primary -->
        <img class="ch-card__img"
             src="{{ media | image_url: width: 900 }}"
             srcset="{{ media | image_url: width: 540 }} 540w, {{ media | image_url: width: 720 }} 720w, {{ media | image_url: width: 900 }} 900w, {{ media | image_url: width: 1200 }} 1200w"
             sizes="(min-width:1100px) 22vw, (min-width:768px) 30vw, 46vw"
             alt="{{ product.title | escape }}"
             loading="lazy" decoding="async"
             width="{{ media.width }}" height="{{ media.height }}"
             data-img-main
             onload="this.closest('.ch-card__media')?.setAttribute('data-loaded','true')"
             onerror="this.closest('.ch-card__media')?.setAttribute('data-loaded','true')">

        {% if second_media %}
          <!-- Secondary: shows on hover (desktop only) -->
          <img class="ch-card__img ch-card__img--alt"
               src="{{ second_media | image_url: width: 900 }}"
               srcset="{{ second_media | image_url: width: 540 }} 540w, {{ second_media | image_url: width: 720 }} 720w, {{ second_media | image_url: width: 900 }} 900w, {{ second_media | image_url: width: 1200 }} 1200w"
               sizes="(min-width:1100px) 22vw, (min-width:768px) 30vw, 46vw"
               alt="{{ product.title | escape }} — alternate view"
               loading="lazy" decoding="async" aria-hidden="true">
        {% endif %}
      {% else %}
        {{ 'image' | placeholder_svg_tag: 'ch-card__ph' }}
      {% endif %}
    </a>


<!-- BADGES (top-left) – unified -->
<div class="ch-badgestack-left">
  {% if badge_kind != '' %}
    <span class="ch-badge ch-badge--pill {% if badge_kind == 'stock' %}is-stock{% else %}is-sale{% endif %} {{ stock_state }}">
      {{ badge_text }}
    </span>
  {% endif %}
</div>


    <!-- ACTIONS (fixed top-right:quick view) -->
    <div class="ch-actions-tr">
      <button
        type="button"
        class="ch-iconbtn ch-iconbtn--qv"
        data-standalone-qv
        data-product-handle="{{ product.handle }}"
        data-product-url="{{ product_url }}"
        aria-label="Quick view {{ product.title | escape }}"
        aria-describedby="tt-qv-{{ product.id }}">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18"
             viewBox="0 0 24 24" fill="none" stroke="currentColor"
             stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M1 12s4-7 11-7 11 7 11 7-4 7-11 7-11-7-11-7z"/>
          <circle cx="12" cy="12" r="3"/>
        </svg>
        <span id="tt-qv-{{ product.id }}" class="ch-pop" role="tooltip">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none"
               stroke="#ef4444" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M1 12s4-7 11-7 11 7 11 7-4 7-11 7-11-7-11-7z"/>
            <circle cx="12" cy="12" r="3"/>
          </svg>
          <span>Quick view</span>
        </span>
      </button>
    </div>
  </div> <!-- /mediawrap -->

  <!-- BODY -->
  <div class="ch-card__body">
    <div class="ch-card__vendor" aria-label="Brand">{{ product.vendor }}</div>

    <h3 class="ch-card__title" title="{{ title_clean | escape }}">
      <a class="ch-card__titlelink"
         href="{{ product_url }}"
         data-title-link>
        {{ title_clean }}
      </a> 
    </h3>


    <!-- PRICE -->
    <div class="ch-price" itemprop="offers" itemscope itemtype="https://schema.org/Offer" aria-label="Price" data-range="{% if is_range %}true{% else %}false{% endif %}">
      <meta itemprop="priceCurrency" content="{{ cart.currency.iso_code }}">
      <meta itemprop="availability" content="https://schema.org/{% if available %}InStock{% else %}OutOfStock{% endif %}">
      <div class="ch-price__row">
        <span class="ch-price__cur" itemprop="price">{{ current_price_text }}</span>
       {% if compare_val > 0 %}
  <span class="ch-price__compare" data-compare-cents="{{ compare_val }}">{{ compare_text_long }}</span>
{% endif %}

      </div>
    </div>

    <!-- Rating -->
    <div class="ch-rating" data-rating>
      <div class="ch-rating__oke" data-oke-star-rating data-oke-reviews-product-id="{{ product.id }}"></div>
    </div>

  <div class="ch-cta">
    {% if available %}
{% if only_default and v %}
  <form method="post" action="/cart/add" class="ch-atc" aria-label="Add {{ product.title | escape }} to cart">
    <input type="hidden" name="id" value="{{ v.id }}">
    <button
      type="submit"
      class="sbtn ch-atcbtn"
      data-variant-id="{{ v.id }}"
      {% if inv_tracked %}data-max-qty="{{ inv_qty }}"{% endif %}
    >
      <span class="ch-atcbtn__txt">Add to cart</span>
    </button>
  </form>
{% else %}
  <button
    type="button"
    class="sbtn ch-atcbtn"
    data-standalone-qv
    data-product-handle="{{ product.handle }}"
    data-product-url="{{ product_url }}">
    <span class="ch-atcbtn__txt">Select options</span>
  </button>
{% endif %}

    {% else %}
<a class="sbtn ch-atcbtn ch-atcbtn--oos"
   href="{{ product_url }}">
  <span class="ch-atcbtn__txt">Out of stock</span>
</a>    {% endif %}
  </div>



  </div>
</article>
{{ 'ch-card.css' | asset_url | stylesheet_tag }}


<!-- ✅ CARD INIT -->
<script>
(function(){
  if(window.CHCARD_LOCAL_INIT_V3) return; window.CHCARD_LOCAL_INIT_V3=true;
  function init(scope){
    (scope||document).querySelectorAll('.ch-card').forEach(card=>{
      const img=card.querySelector('[data-img-main]'); const wrap=card.querySelector('.ch-card__media');
      if(img && wrap){ if(img.complete) wrap.setAttribute('data-loaded','true'); }
    });
  }
  document.addEventListener('DOMContentLoaded', ()=>init());
  document.addEventListener('shopify:section:load', e=>init(e.target));
})();


<!-- Quick View Data Logic -->


(function(){
  if(window.CH_BIND_CARD_V11) return; window.CH_BIND_CARD_V11=true;

  function chApplyMaxStateFromCart(cart) {
    if (!cart || !cart.items) return;

    // Build map: variantId -> qty in cart
    const qtyMap = {};
    cart.items.forEach(item => {
      const id = String(item.id);
      qtyMap[id] = (qtyMap[id] || 0) + Number(item.quantity || 0);
    });

    document.querySelectorAll('.ch-atc .ch-atcbtn').forEach(btn => {
      const form = btn.closest('.ch-atc');
      if (!form) return;

      const idInput = form.querySelector('input[name="id"]');
      if (!idInput) return;

      const variantId = String(idInput.value || '');
      const maxQty = parseInt(btn.dataset.maxQty || '0', 10);

      // Store original label once
      const labelEl = btn.querySelector('.ch-atcbtn__txt');
      if (labelEl && !labelEl.dataset.originalLabel) {
        labelEl.dataset.originalLabel = labelEl.textContent.trim();
      }

      // If no max qty (inventory not tracked), always keep clickable
      if (!maxQty || maxQty <= 0) {
        btn.disabled = false;
        btn.removeAttribute('aria-disabled');
        btn.dataset.maxed = 'false';
        if (labelEl && labelEl.dataset.originalLabel) {
          labelEl.textContent = labelEl.dataset.originalLabel;
        }
        return;
      }

      const inCart = qtyMap[variantId] || 0;

      if (inCart >= maxQty) {
        // 🔒 Maxed: lock button
        btn.disabled = true;
        btn.setAttribute('aria-disabled', 'true');
        btn.dataset.maxed = 'true';
        if (labelEl) labelEl.textContent = 'Max in cart';
      } else {
        // Still allow adding
        btn.disabled = false;
        btn.removeAttribute('aria-disabled');
        btn.dataset.maxed = 'false';
        if (labelEl && labelEl.dataset.originalLabel) {
          labelEl.textContent = labelEl.dataset.originalLabel;
        }
      }
    });
  }

  async function chFetchCartAndApplyMax() {
    try {
      const res = await fetch('/cart.js', {
        headers: { 'Accept': 'application/json' },
        cache: 'no-store',
        credentials: 'same-origin'
      });
      if (!res.ok) return;
      const cart = await res.json();
      chApplyMaxStateFromCart(cart);
    } catch (e) {
      // fail silently; no hard break
    }
  }

  /* ATC */
document.addEventListener('click', async function(e){
  const btn = e.target.closest('.ch-atcbtn');
  if (!btn) return;

  const form = btn.closest('.ch-atc');
  if (!form) return; // skips "Select options" buttons

  // 🔒 If this card ATC is maxed, do nothing
  if (btn.dataset.maxed === 'true' || btn.disabled) {
    return;
  }

  e.preventDefault();

  btn.classList.add('is-adding');
  btn.setAttribute('aria-busy','true');
  if ('disabled' in btn) btn.disabled = true;

  const fd      = new FormData(form);
  const payload = {
    id: fd.get('id'),
    quantity: Number(fd.get('quantity') || 1)
  };

  try{
    const r = await fetch('/cart/add.js',{
      method:'POST',
      headers:{'Content-Type':'application/json','Accept':'application/json'},
      body:JSON.stringify(payload),
      credentials:'same-origin',
      cache:'no-store'
    });
    if(!r.ok) throw 0;

    try{
      const cartRes = await fetch('/cart.js', {
        headers:{'Accept':'application/json'},
        cache:'no-store'
      });
      const cart = await cartRes.json();

      const bubble = document.querySelector('[data-cart-count]');
      if (bubble) bubble.textContent = String(cart.item_count || 0);
      const live = document.querySelector('[data-cart-live]');
      if (live) live.textContent = (cart.item_count || 0) + ' items in cart';

      // 🔒 Re-apply max logic after this add
      chApplyMaxStateFromCart(cart);
    }catch(_){}


    document.dispatchEvent(new Event('open-mini-cart'));

    btn.classList.remove('is-adding');
    btn.classList.add('is-added');
    btn.removeAttribute('aria-busy');
    if ('disabled' in btn) btn.disabled = false;
    setTimeout(()=>{ btn.classList.remove('is-added'); }, 800);
  }catch(_){
    btn.classList.remove('is-adding');
    btn.removeAttribute('aria-busy');
    if ('disabled' in btn) btn.disabled = false;
    location.href='/cart';
  }
}, false);


  /* Hide fallback stars once Okendo paints */
  document.addEventListener('DOMContentLoaded', function(){
    document.querySelectorAll('.ch-rating').forEach(function(r){
      const oke=r.querySelector('.ch-rating__oke'); const fb=r.querySelector('.ch-rating__fallback'); if(!oke || !fb) return;
      const check=()=>{ if(oke.innerHTML && oke.innerHTML.trim().length>0){ fb.style.display='none'; } };
      new MutationObserver(check).observe(oke,{childList:true,subtree:true}); setTimeout(check,600);
    });
    chFetchCartAndApplyMax();
  });

  /* Mini gallery */
  /* Mini gallery */
    document.addEventListener('click', function(e){
      const t = e.target.closest('.ch-mini__thumb'); if(!t) return;
      const card = t.closest('.ch-card');
      const main = card?.querySelector('[data-img-main]'); if(!main) return;

      const src    = t.getAttribute('data-src');
      const srcset = t.getAttribute('data-srcset');
      if(srcset) main.setAttribute('srcset', srcset);
      if(src)    main.setAttribute('src', src);

      const group = t.closest('[data-mini]');
      const all   = group?.querySelectorAll('.ch-mini__thumb') || [];
      all.forEach(b=>{
        const on = b === t;
        b.classList.toggle('is-active', on);
        b.setAttribute('aria-selected', on ? 'true' : 'false');
      });

      // NEW: reflect active state on dots (mobile)
      updateDots(card, Array.from(all).indexOf(t));
    }, false);

    document.addEventListener('mouseover', function(e){
      const t = e.target.closest('.ch-mini__thumb'); if(!t) return;
      if(window.matchMedia('(hover:hover)').matches){ t.click(); }
    }, false);

    // NEW: helper to update dots
    function updateDots(card, idx){
      const dotsWrap = card?.querySelector('[data-dots]'); if(!dotsWrap) return;
      const dots = dotsWrap.querySelectorAll('.ch-dot');
      dots.forEach((d,i)=> d.classList.toggle('is-active', i === idx));
    }

})();
</script>
<script>
document.addEventListener('open-mini-cart', () => {
  // Dawn / cart-drawer custom element
  const drawer = document.querySelector('cart-drawer');
  if (drawer && typeof drawer.open === 'function') { drawer.open(); return; }

  // Generic drawer toggle (adapt selectors to your theme)
  const mini = document.querySelector('[data-mini-cart], .mini-cart, #mini-cart');
  if (mini) mini.classList.add('is-open');
});
</script>



