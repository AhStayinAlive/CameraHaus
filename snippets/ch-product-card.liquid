<!-- ✅ STANDALONE QV SCRIPT – FIXED -->
<script>
  (function() {
    if (window.StandaloneShopifyQVPDP) return;
    
    // --- Helper to execute scripts from fetched HTML ---
    function runScripts(container) {
      const scripts = container.querySelectorAll('script');
      scripts.forEach(oldScript => {
        const newScript = document.createElement('script');
        Array.from(oldScript.attributes).forEach(attr => newScript.setAttribute(attr.name, attr.value));
        newScript.appendChild(document.createTextNode(oldScript.innerHTML));
        oldScript.parentNode.replaceChild(newScript, oldScript);
      });
    }

    // --- Main Open Function ---
    function openQV(handle) {
      if (!handle) return;
      
      // Close any existing
      const existing = document.querySelector('.ch-qv');
      if (existing) existing.remove();
      
      return fetch('/products/' + encodeURIComponent(handle) + '?view=quick-view')
        .then(r => {
          if (!r.ok) throw new Error('Product not found');
          return r.text();
        })
        .then(html => {
          // 1. Parse HTML
          const parser = new DOMParser();
          const doc = parser.parseFromString(html, 'text/html');
          
          // 2. Extract the critical parts: 
          // The snippet renders:
          //   [template id="qv-template-ID"] ... [/template]
          //   [style] ... [/style]
          //   [script] ... [/script]
          
          // We append styles and scripts to body, then we find the template and instantiate it.
          const styles = doc.querySelectorAll('style');
          const scripts = doc.querySelectorAll('script');
          const templates = doc.querySelectorAll('script[type="text/template"][id^="qv-template-"]');
          
          if (!templates.length) {
            console.error('QV Template not found in response');
            return;
          }
          
          // Append styles
          styles.forEach(style => document.head.appendChild(style));
          
          // Execute scripts (bind logic)
          scripts.forEach(s => {
            if (s.type === 'text/template') return; // skip the template itself
            const scriptEl = document.createElement('script');
            scriptEl.textContent = s.textContent;
            document.body.appendChild(scriptEl);
          });
          
          // 3. Render the specific product modal
          // The template ID is usually "qv-template-{product_id}"
          // We can just take the first template found since we fetched a specific handle
          const tmpl = templates[0];
          const tmplId = tmpl.id; // "qv-template-12345"
          const qvId = tmplId.replace('qv-template-', 'qv-'); // "qv-12345"
          
          // Convert template content to node
          const div = document.createElement('div');
          div.innerHTML = tmpl.innerHTML;
          const root = div.firstElementChild; // The .ch-qv element
          
          if (!root) return;
          document.body.appendChild(root);
          
          // 4. Init logic using the window.CHQV_SNIPPETS registry
          if (window.CHQV_SNIPPETS && typeof window.CHQV_SNIPPETS[qvId] === 'function') {
            window.CHQV_SNIPPETS[qvId](root);
          }
          
          // 5. Bind close event (the snippet does some, but we ensure global close handling)
          const closeBtns = root.querySelectorAll('[data-ch-qv-close]');
          closeBtns.forEach(b => b.addEventListener('click', () => root.remove()));
          
          return root;
        })
        .catch(err => {
          console.error(err);
          alert('Sorry, could not load quick view.');
        });
    }

    // --- Global Click Listener ---
    document.addEventListener('click', function(e) {
      const btn = e.target.closest('[data-standalone-qv]');
      if (!btn) return;

      const isMobile = window.matchMedia('(hover:none)').matches || window.innerWidth < 768;
      const card = btn.closest('.ch-card');
      const handle = btn.getAttribute('data-product-handle');
      
      // Mobile/Touch: Redirect to PDP
      if (isMobile) {
         const url = card?.dataset.productUrl || (handle ? '/products/' + handle : '#');
         window.location.href = url;
         return;
      }
      
      e.preventDefault();
      
      // Loading State
      if (card) card.classList.add('is-loading');
      btn.classList.add('is-loading');
      btn.setAttribute('aria-busy', 'true');
      
      openQV(handle)
        .finally(() => {
           if (card) card.classList.remove('is-loading');
           btn.classList.remove('is-loading');
           btn.removeAttribute('aria-busy');
        });
    }, false);

    // Expose API
    window.StandaloneShopifyQVPDP = { open: openQV };
  })();
  </script>
