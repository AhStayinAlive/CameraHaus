<!-- ✅ CARD INIT -->
<script>
(function(){
  if(window.CHCARD_LOCAL_INIT_V3) return; window.CHCARD_LOCAL_INIT_V3=true;
  function init(scope){
    (scope||document).querySelectorAll('.ch-card').forEach(card=>{
      const img=card.querySelector('[data-img-main]'); const wrap=card.querySelector('.ch-card__media');
      if(img && wrap){ if(img.complete) wrap.setAttribute('data-loaded','true'); }
    });
  }
  document.addEventListener('DOMContentLoaded', ()=>init());
  document.addEventListener('shopify:section:load', e=>init(e.target));
})();


<!-- Quick View Data Logic -->


(function(){
  if(window.CH_BIND_CARD_V11) return; window.CH_BIND_CARD_V11=true;

  function chApplyMaxStateFromCart(cart) {
    if (!cart || !cart.items) return;

    // Build map: variantId -> qty in cart
    const qtyMap = {};
    cart.items.forEach(item => {
      const id = String(item.id);
      qtyMap[id] = (qtyMap[id] || 0) + Number(item.quantity || 0);
    });

    document.querySelectorAll('.ch-atc .ch-atcbtn').forEach(btn => {
      const form = btn.closest('.ch-atc');
      if (!form) return;

      const idInput = form.querySelector('input[name="id"]');
      if (!idInput) return;

      const variantId = String(idInput.value || '');
      const maxQty = parseInt(btn.dataset.maxQty || '0', 10);

      // Store original label once
      const labelEl = btn.querySelector('.ch-atcbtn__txt');
      if (labelEl && !labelEl.dataset.originalLabel) {
        labelEl.dataset.originalLabel = labelEl.textContent.trim();
      }

      // If no max qty (inventory not tracked), always keep clickable
      if (!maxQty || maxQty <= 0) {
        btn.disabled = false;
        btn.removeAttribute('aria-disabled');
        btn.dataset.maxed = 'false';
        if (labelEl && labelEl.dataset.originalLabel) {
          labelEl.textContent = labelEl.dataset.originalLabel;
        }
        return;
      }

      const inCart = qtyMap[variantId] || 0;

      if (inCart >= maxQty) {
        // 🔒 Maxed: lock button
        btn.disabled = true;
        btn.setAttribute('aria-disabled', 'true');
        btn.dataset.maxed = 'true';
        if (labelEl) labelEl.textContent = 'Max in cart';
      } else {
        // Still allow adding
        btn.disabled = false;
        btn.removeAttribute('aria-disabled');
        btn.dataset.maxed = 'false';
        if (labelEl && labelEl.dataset.originalLabel) {
          labelEl.textContent = labelEl.dataset.originalLabel;
        }
      }
    });
  }

  async function chFetchCartAndApplyMax() {
    try {
      const res = await fetch('/cart.js', {
        headers: { 'Accept': 'application/json' },
        cache: 'no-store',
        credentials: 'same-origin'
      });
      if (!res.ok) return;
      const cart = await res.json();
      chApplyMaxStateFromCart(cart);
    } catch (e) {
      // fail silently; no hard break
    }
  }

  /* ATC */
document.addEventListener('click', async function(e){
  const btn = e.target.closest('.ch-atcbtn');
  if (!btn) return;

  const form = btn.closest('.ch-atc');
  if (!form) return; // skips "Select options" buttons

  // 🔒 If this card ATC is maxed, do nothing
  if (btn.dataset.maxed === 'true' || btn.disabled) {
    return;
  }

  e.preventDefault();

  btn.classList.add('is-adding');
  btn.setAttribute('aria-busy','true');
  if ('disabled' in btn) btn.disabled = true;

  const fd      = new FormData(form);
  const payload = {
    id: fd.get('id'),
    quantity: Number(fd.get('quantity') || 1)
  };

  try{
    const r = await fetch('/cart/add.js',{
      method:'POST',
      headers:{'Content-Type':'application/json','Accept':'application/json'},
      body:JSON.stringify(payload),
      credentials:'same-origin',
      cache:'no-store'
    });
    if(!r.ok) throw 0;

    try{
      const cartRes = await fetch('/cart.js', {
        headers:{'Accept':'application/json'},
        cache:'no-store'
      });
      const cart = await cartRes.json();

      const bubble = document.querySelector('[data-cart-count]');
      if (bubble) bubble.textContent = String(cart.item_count || 0);
      const live = document.querySelector('[data-cart-live]');
      if (live) live.textContent = (cart.item_count || 0) + ' items in cart';

      // 🔒 Re-apply max logic after this add
      chApplyMaxStateFromCart(cart);
    }catch(_){}


    document.dispatchEvent(new Event('open-mini-cart'));

    btn.classList.remove('is-adding');
    btn.classList.add('is-added');
    btn.removeAttribute('aria-busy');
    if ('disabled' in btn) btn.disabled = false;
    setTimeout(()=>{ btn.classList.remove('is-added'); }, 800);
  }catch(_){
    btn.classList.remove('is-adding');
    btn.removeAttribute('aria-busy');
    if ('disabled' in btn) btn.disabled = false;
    location.href='/cart';
  }
}, false);


  /* Hide fallback stars once Okendo paints */
  document.addEventListener('DOMContentLoaded', function(){
    document.querySelectorAll('.ch-rating').forEach(function(r){
      const oke=r.querySelector('.ch-rating__oke'); const fb=r.querySelector('.ch-rating__fallback'); if(!oke || !fb) return;
      const check=()=>{ if(oke.innerHTML && oke.innerHTML.trim().length>0){ fb.style.display='none'; } };
      new MutationObserver(check).observe(oke,{childList:true,subtree:true}); setTimeout(check,600);
    });
    chFetchCartAndApplyMax();
  });

  /* Mini gallery */
  /* Mini gallery */
    document.addEventListener('click', function(e){
      const t = e.target.closest('.ch-mini__thumb'); if(!t) return;
      const card = t.closest('.ch-card');
      const main = card?.querySelector('[data-img-main]'); if(!main) return;

      const src    = t.getAttribute('data-src');
      const srcset = t.getAttribute('data-srcset');
      if(srcset) main.setAttribute('srcset', srcset);
      if(src)    main.setAttribute('src', src);

      const group = t.closest('[data-mini]');
      const all   = group?.querySelectorAll('.ch-mini__thumb') || [];
      all.forEach(b=>{
        const on = b === t;
        b.classList.toggle('is-active', on);
        b.setAttribute('aria-selected', on ? 'true' : 'false');
      });

      // NEW: reflect active state on dots (mobile)
      updateDots(card, Array.from(all).indexOf(t));
    }, false);

    document.addEventListener('mouseover', function(e){
      const t = e.target.closest('.ch-mini__thumb'); if(!t) return;
      if(window.matchMedia('(hover:hover)').matches){ t.click(); }
    }, false);

    // NEW: helper to update dots
    function updateDots(card, idx){
      const dotsWrap = card?.querySelector('[data-dots]'); if(!dotsWrap) return;
      const dots = dotsWrap.querySelectorAll('.ch-dot');
      dots.forEach((d,i)=> d.classList.toggle('is-active', i === idx));
    }

})();
</script>
<script>
document.addEventListener('open-mini-cart', () => {
  // Dawn / cart-drawer custom element
  const drawer = document.querySelector('cart-drawer');
  if (drawer && typeof drawer.open === 'function') { drawer.open(); return; }

  // Generic drawer toggle (adapt selectors to your theme)
  const mini = document.querySelector('[data-mini-cart], .mini-cart, #mini-cart');
  if (mini) mini.classList.add('is-open');
});
</script>

<!-- ✅ STANDALONE QV STYLES – updated -->
<style id="standalone-qv-styles">
  .stand-qv {
    position: fixed;
    inset: 0;
    z-index: 9999;
    display: flex;
    align-items: center;
    justify-content: center;
    pointer-events: auto;
    background: rgba(0,0,0,.12);
  }
  .stand-qv__overlay {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.55);
    backdrop-filter: blur(1px);
  }
  .stand-qv__panel {
    position: relative;
    background: #fff;
    border-radius: 20px;
    max-width: 1080px;
    width: min(1080px, 96vw);
    max-height: 92vh;
    display: flex;
    overflow: hidden;
    box-shadow: 0 20px 50px rgba(15, 23, 42, 0.22);
    z-index: 1;
    transform-origin: center;
    animation: qvIn .16s ease;
  }
  .stand-qv__panel.is-closing {
    animation: qvOut .13s ease forwards;
  }
  @keyframes qvIn {
    from { transform: translateY(8px) scale(.97); opacity:0; }
    to { transform: translateY(0) scale(1); opacity:1; }
  }
  @keyframes qvOut {
    from { transform: translateY(0) scale(1); opacity:1; }
    to { transform: translateY(8px) scale(.97); opacity:0; }
  }

  .stand-qv__close {
    position: absolute;
    top: 10px;
    right: 10px;
    width: 34px;
    height: 34px;
    border: 0;
    background: rgba(248, 250, 252, 0.65);
    border-radius: 999px;
    font-size: 20px;
    line-height: 1;
    cursor: pointer;
    display: grid;
    place-items: center;
    color: #0f172a;
    transition: transform .12s ease;
    z-index: 20;
  }
  .stand-qv__close:hover { transform: scale(1.04); }

  .ch-qv-panel { flex-direction: row; }

  .ch-qv-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.12fr) minmax(0, 0.88fr);
    gap: 1.8rem;
    align-items: flex-start;
    width: 100%;
    padding: 1.6rem 1.6rem 1.2rem;
  }
  .ch-qv-media-col, .ch-qv-info-col { min-width: 0; }

  .ch-qv-media { display: flex; flex-direction: column; gap: 1rem; }
  .ch-qv-media-main {
    position: relative;
    background: #fff;
    border-radius: 14px;
    overflow: hidden;
    min-height: 420px;
  }
  .ch-qv-media-main__item {
    position: absolute;
    inset: 0;
    opacity: 0;
    visibility: hidden;
    transition: opacity .22s ease;
  }
  .ch-qv-media-main__item.is-shown {
    opacity: 1;
    visibility: visible;
    z-index: 2;
  }
  .ch-qv-img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
  }
  .ch-qv-media-nav {
    position: absolute; top: 50%; transform: translateY(-50%); width: 34px; height: 34px;
    border-radius: 999px; border: 1px solid rgba(0,0,0,.05); background: rgba(255,255,255,.75);
    display: grid; place-items: center; cursor: pointer; z-index: 5;
  }
  .ch-qv-media-nav--prev { left: 10px; }
  .ch-qv-media-nav--next { right: 10px; }

  .ch-qv-thumbs { display:flex; gap:10px; flex-wrap:wrap; }
  .ch-qv-thumb {
    background: #fff;
    border: 1px solid #eef2f7;
    border-radius: 6px;
    padding: 3px;
    cursor: pointer;
  }
  .ch-qv-thumb.is-active { border-color: #d12f24; }
  .ch-qv-thumb img { width: 74px; height: auto; display: block; }

  .ch-qv-info-col {
    display: flex;
    flex-direction: column;
    gap: .75rem;
    max-height: calc(92vh - 3.6rem);
    overflow-y: auto;
    padding-right: .4rem;
  }
  /* thinner rail */
  .ch-qv-info-col::-webkit-scrollbar{ width:5px; }
  .ch-qv-info-col::-webkit-scrollbar-track{ background:transparent; }
  .ch-qv-info-col::-webkit-scrollbar-thumb{ background:rgba(148,163,184,.4); border-radius:20px; }

  .ch-qv-vendor { font-size: .8rem; color: #9CA3AF; text-transform: capitalize; }
  .ch-qv-title { font-size: 1.65rem; font-weight: 600; margin: 0; color: #111; }

  .ch-qv-price-block { display:flex; flex-direction:column; gap:.2rem; }
  .ch-qv-price-line { display:flex; align-items:baseline; gap:.6rem; }
  .ch-qv-price { color:#d12f24; font-weight:700; font-size:1.45rem; }
  .ch-qv-price-compare { color:#9ca3af; text-decoration:line-through; }
  .ch-qv-save { color:#b42318; font-size:.78rem; }

  .ch-qv-topdesc { font-size: .85rem; color:#6b7280; line-height:1.4; max-width:38rem; }

  .ch-qv-rating-row { display:flex; align-items:center; gap:.5rem; color:#6b7280; font-size:.72rem; }

  /* smaller option bar */
  .ch-optionbar {
    position: relative;
    margin-top: .2rem;
    margin-bottom: .2rem;
    z-index: 40;
  }
  .ch-optionbar__btn {
    width: 100%;
    background: #fff;
    border: 1px solid rgba(17,17,17,.08);
    border-radius: 12px;
    min-height: 34px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    padding: 4px 10px 4px 12px;
    cursor: pointer;
    transition: box-shadow .12s ease, border .12s ease;
  }
  .ch-optionbar__btn:hover { border: 1px solid rgba(17,17,17,.15); box-shadow: 0 4px 16px rgba(17,17,17,.02); }
  .ch-optionbar__label { font-size: .78rem; color: #4b5563; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .ch-optionbar__ico { width: 22px; height: 22px; display: grid; place-items: center; color: #9ca3af; transition: transform .16s ease; position: relative; }
  .ch-optionbar.is-open .ch-optionbar__ico { transform: rotate(180deg); }

  .ch-optionbar__pop {
    position: absolute;
    left: 0;
    top: calc(100% + 6px);
    min-width: 100%;
    background: #fff;
    border: 1px solid rgba(17,17,17,.04);
    border-radius: 14px;
    box-shadow: 0 16px 34px rgba(17,17,17,.12);
