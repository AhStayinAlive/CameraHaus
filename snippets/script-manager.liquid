{%- comment -%}
  Script Manager: Intercepts content_for_header to defer non-critical apps on Homepage.
  Usage: In theme.liquid, capture content_for_header and pass as 'cfh'.
{%- endcomment -%}

{%- comment -%} cfh is passed as argument {%- endcomment -%}

{%- if request.page_type == 'index' or request.page_type == 'collection' -%}
  {%- comment -%} Define patterns to defer {%- endcomment -%}
  {%- assign defer_patterns = "myminicart.pro,w3apps,replay" | split: ',' -%}
  
  {%- for pattern in defer_patterns -%}
    {%- assign target_src = 'src="' | append: pattern -%}
    {%- assign replacement_src = 'data-src-defer="' | append: pattern | append: '" data-src="' | append: pattern -%}
    {%- assign cfh = cfh | replace: pattern, 'data-defer-target' -%} 
    {%- comment -%} 
      Note: Simple replace above is risky. We will use a JS approach for robustness 
      because manipulating raw Liquid string of cfh can break signed URLs or checksums.
      Actually, best practice for "Safety" is to NOT break the signature but to defer execution.
      However, manipulating src is the only way to stop download.
    {%- endcomment -%}
  {%- endfor -%}

  {%- comment -%} 
     Safe Regex-like Replace Pattern for specific known offenders 
     We match the common "src=" part to invalidate it.
  {%- endcomment -%}
  
  {%- assign cfh = cfh | replace: 'src="https://myminicart.pro', 'data-src="https://myminicart.pro' -%}
  {%- assign cfh = cfh | replace: 'src="https://w3apps', 'data-src="https://w3apps' -%}
  {%- assign cfh = cfh | replace: 'src="https://replay', 'data-src="https://replay' -%}

  {%- comment -%} Okendo Deferral (Homepage Only) {%- endcomment -%}
  {%- assign cfh = cfh | replace: 'src="https://okendo', 'data-src="https://okendo' -%}
  {%- assign cfh = cfh | replace: 'src="https://d3hw6dc1ow8pp2.cloudfront.net/reviews/v5/js/okendo-reviews.js', 'data-src="https://d3hw6dc1ow8pp2.cloudfront.net/reviews/v5/js/okendo-reviews.js' -%}

{%- endif -%}

<!-- Output Modified Header -->
{{ cfh }}

{%- if request.page_type == 'index' or request.page_type == 'collection' -%}
<script>
  /* Delayed Loader for Script Manager */
  (function() {
    function loadScripts() {
      console.log('Script Manager: Loading deferred scripts...');
      var scripts = document.querySelectorAll('script[data-src]');
      scripts.forEach(function(s) {
        if (s.dataset.src) {
           var src = s.dataset.src;
           
           // Conditional Logic
           if(src.indexOf('okendo') !== -1) {
             // Only load Okendo if we see a widget placeholder or user scrolled far
             // For now, load on interaction to be safe
           }

           // Create replacement script
           var n = document.createElement('script');
           n.src = s.dataset.src.replace('data-src="', ''); // cleanup if replace was messy
           // Copy attributes
           Array.from(s.attributes).forEach(function(attr){
             if(attr.name !== 'src' && attr.name !== 'data-src') {
               n.setAttribute(attr.name, attr.value);
             }
           });
           n.async = true;
           s.parentNode.replaceChild(n, s);
        }
      });
    }

    // Load on user interaction
    var loaded = false;
    function onInteract() {
      if (loaded) return;
      loaded = true;
      requestAnimationFrame(function(){
         setTimeout(loadScripts, 100); // Slight delay to prioritize UI response
      });
      window.removeEventListener('scroll', onInteract);
      window.removeEventListener('mousemove', onInteract);
      window.removeEventListener('touchstart', onInteract);
    }

    window.addEventListener('scroll', onInteract, {passive:true});
    window.addEventListener('mousemove', onInteract, {passive:true});
    window.addEventListener('touchstart', onInteract, {passive:true});
    
    // Failsafe: Load after 6 seconds anyway
    setTimeout(onInteract, 6000);
  })();
</script>
{%- endif -%}
