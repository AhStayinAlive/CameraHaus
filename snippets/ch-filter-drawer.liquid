<script id="cart-hotfix-js">
(function(){
  const CURRENCY = {{ shop.currency | json }} || "PHP";
  const LOCALE   = {{ request.locale.iso_code | json }} || "en-PH";
  const money = (c) => new Intl.NumberFormat(LOCALE,{style:'currency',currency:CURRENCY}).format((+c||0)/100);

  function $panel(){
    return document.querySelector('.ch-panel[data-ch-panel="cart"]') ||
           document.querySelector('#CartDrawer') ||
           document.querySelector('.cart-drawer');
  }

  function refresh(){
    fetch('/cart.js',{headers:{'Accept':'application/json'},cache:'no-store'})
      .then(r=>r.json())
      .then(cart=>{
        const p = $panel(); if (!p) return;
        const sub = p.querySelector('[data-cart-subtotal]') || p.querySelector('[data-cart-subtotal-price]');
        if (sub) sub.textContent = money(cart.items_subtotal_price||0);
        document.dispatchEvent(new CustomEvent('cart:refreshed',{detail:cart}));
      }).catch(()=>{});
  }

  document.addEventListener('click', function(e){
    const btn = e.target.closest('.stepper [data-inc], .stepper [data-dec], [data-remove], .quantity__button');
    if (!btn) return;

    if (btn.closest('.ch-panel[data-ch-panel="cart"]')) return;

    const row = btn.closest('[data-key]') || btn.closest('[data-line]') || btn.closest('[data-cart-item]');
    const qtyInput = row && (row.querySelector('[data-qty]') || row.querySelector('.quantity__input'));
    if (!row || !qtyInput) return;

    e.preventDefault(); e.stopPropagation();

    let q = parseInt(qtyInput.value, 10) || 0;
    if (btn.matches('[data-inc], .quantity__button:last-child')) q++;
    else if (btn.matches('[data-dec], .quantity__button:first-child')) q = Math.max(0, q - 1);
    else if (btn.hasAttribute('data-remove')) q = 0;

    const key  = row.getAttribute('data-key');
    const line = parseInt(row.getAttribute('data-line') || '1', 10);

    const payload = key ? { id: key, quantity: q } : { line, quantity: q };

    fetch('/cart/change.js', {
      method:'POST',
      headers:{'Content-Type':'application/json','Accept':'application/json'},
      body: JSON.stringify(payload)
    })
    .then((r) => {
      const status = r.status;
      return r.json().catch(() => null).then((data) => ({ status, data }));
    })
    .then(({ status, data }) => {
      if (status === 422 && data && data.status === 422) {
        const rawMsg = String(data.description || data.message || '');
        const panelEl = $panel();
        let title = '';

        if (row) {
          const titleEl =
            row.querySelector('[data-cart-item-title]') ||
            row.querySelector('.cart-item__name') ||
            row.querySelector('.product__description__name') ||
            row.querySelector('.cart__meta h2') ||
            row.querySelector('.cart__product-title');
          if (titleEl) title = titleEl.textContent.trim();
        }

        const m = rawMsg.match(/only\s+(\d+)\s+items?/i);
        const left = m && m[1] ? m[1] : null;

        let msg;
        if (left && title) {
          msg = `Unfortunately we only have ${left} of "${title}" available right now.`;
        } else if (title) {
          msg = `Unfortunately we don't have enough "${title}" in stock for that quantity.`;
        } else {
          msg = rawMsg || 'Unfortunately we don\u2019t have enough stock for that quantity.';
        }

        try {
          document.dispatchEvent(new CustomEvent('cart:inventory-warning', { detail: { message: msg } }));
        } catch (_){}

        if (!panelEl || !panelEl.querySelector('[data-cart-alert]')) {
          window.alert(msg);
        }

        refresh();
        return;
      }

      refresh();
    })
    .catch(() => refresh());
  }, true);



  document.addEventListener('ch:panel', (e)=>{ const d=e.detail||{}; if(d.name==='cart' && d.open) refresh(); });
})();
</script>
<script>
(function(){
  const cartPanel = document.querySelector('.ch-panel[data-ch-panel="cart"]');
  if (!cartPanel) return;

  function fullyUnlockScroll() {
    // Clear inline locks
    document.documentElement.style.overflow = '';
    document.documentElement.style.position = '';
    document.body.style.overflow = '';
    document.body.style.position = '';

    // Remove common lock classes used by themes / drawers
    const classes = [
      'no-scroll',
      'overflow-hidden',
      'drawer-open',
      'js-drawer-open',
      'modal-open',
      'scroll-locked',
      'ch-panel-open'
    ];
    classes.forEach(c => document.body.classList.remove(c));
  }

  function syncScrollLock() {
    // If no panel is open at all, scrolling should be free
    const anyOpen = document.querySelector('.ch-panel[data-open]');
    if (!anyOpen) fullyUnlockScroll();
  }

  // Watch the cart panel's open/close state
  new MutationObserver(muts => {
    for (const m of muts) {
      if (m.attributeName === 'data-open') {
        syncScrollLock();
      }
    }
  }).observe(cartPanel, { attributes: true });

  // Also react to global ch:panel events
  document.addEventListener('ch:panel', (e) => {
    const d = e && e.detail;
    if (!d) return;
    if (d.name === 'cart' && !d.open) {
      syncScrollLock();
    }
  });

  // Safety: on load, if nothing is open, ensure scroll is unlocked
  syncScrollLock();
})();
</script>
