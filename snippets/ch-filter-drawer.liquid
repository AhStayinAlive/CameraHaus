
{% comment %}
  snippets/ch-filter-drawer.liquid
  Mobile FILTER drawer (left) — CH version
{% endcomment %}

<style>
  @media(max-width:989px){
    .ch-portal .ch-drawer{
      position:fixed;top:0;bottom:0;left:0;width:var(--drawer-w);height:100vh;background:var(--surface);
      box-shadow:0 24px 64px rgba(17,17,17,.24);transform:translate3d(-100%,0,0);transition:transform .24s ease;
      z-index:var(--z-drawer);display:flex;flex-direction:column;border-radius:0 14px 14px 0
    }
    .ch-portal .ch-drawer.is-open{transform:translate3d(0,0,0)}

    .ch-portal .ch-drawer__hd{
      position:sticky;top:0;display:flex;align-items:center;justify-content:space-between;gap:8px;
      padding:12px 14px;border-bottom:1px solid var(--line);background:var(--surface)
    }
    .ch-portal .ch-drawer__hd h2{
      margin:0;font-size:13px;letter-spacing:.02em;text-transform:uppercase;color:var(--ink)
    }
    .ch-portal .ch-drawer__close{
      width:28px;height:28px;border:0;background:transparent;color:#262626;display:grid;place-items:center;padding:0;cursor:pointer;line-height:1
    }
    .ch-portal .ch-drawer__close:hover{ color:var(--brand); }

    .ch-portal .ch-drawer__bd{flex:1 1 auto;overflow:auto;padding:6px 12px}
    .ch-portal .ch-drawer__ft{display:none}

    /* compact form */
    .ch-portal .ch-drawer .ch-grid{grid-template-columns:1fr!important;gap:10px}
    .ch-portal .ch-drawer .ch-group{padding:10px!important}
    .ch-portal .ch-drawer .ch-group h3{font-size:14px;margin:0 0 6px;padding-bottom:4px}
    .ch-portal .ch-drawer [data-type="list"] .ch-list{display:grid;grid-template-columns:1fr;gap:6px;max-height:none}
    .ch-portal .ch-drawer .ch-check{grid-template-columns:auto 1fr;gap:8px;font-size:13px}
    .ch-portal .ch-drawer .ch-check .cnt{display:none}
    .ch-portal .ch-drawer .ch-price{gap:6px}
    .ch-portal .ch-drawer .ch-price__row{gap:6px}
    .ch-portal .ch-drawer .ch-price-note{font-size:13px}
  }

  @media(min-width:990px){
    .ch-portal #ChDrawerFilter-{{ section.id }}{display:none!important}
  }
</style>

<aside id="ChDrawerFilter-{{ section.id }}" class="ch-drawer" role="dialog" aria-modal="true" aria-hidden="true" aria-labelledby="ChDrawerFilterLabel-{{ section.id }}">
  <div class="ch-drawer__hd">
    <h2 id="ChDrawerFilterLabel-{{ section.id }}">Filter</h2>
    <button type="button" class="ch-drawer__close" data-ch-close aria-label="Close">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M18 6L6 18M6 6l12 12" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" fill="none"/></svg>
    </button>
  </div>
  <div class="ch-drawer__bd" data-form-slot></div>
  <div class="ch-drawer__ft" aria-hidden="true"></div>
</aside>

