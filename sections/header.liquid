{% comment %}
CH Header — HAVIT-style (red top bar + centered search button + dark-red nav band)
- Desktop: predictive search panel + mega menus
- Mobile: desktop-style search bar (white + red button) that opens existing right-side search panel
- Mobile top row icons trimmed: remove Search & Wishlist, keep Cart
- Bottom tab bar (mobile) wired to existing panels
- Shy header (mobile): shrinks on scroll down, expands on scroll up

NOTE: This file already includes the full desktop predictive search panel
with working Suggestions and a dynamic “View "<query>” CTA.
{% endcomment %}

<section id="ch-header-{{ section.id }}" class="ch-header" role="banner">
  {%- assign main_handle = section.settings.menu_main -%}
  {%- assign parent_title = section.settings.categories_parent_title | default: 'Category' -%}
  {%- assign menu_obj = linklists[main_handle] -%}

  {%- assign categories_parent_index = -1 -%}
  {% if menu_obj and menu_obj.links %}
    {%- assign p_norm = parent_title | strip | downcase -%}
    {% for l in menu_obj.links %}
      {%- assign t_norm = l.title | strip | downcase -%}
      {% if t_norm == p_norm %}{%- assign categories_parent_index = forloop.index0 -%}{% break %}{% endif %}
    {% endfor %}
    {% if categories_parent_index == -1 %}
      {% for l in menu_obj.links %}
        {%- assign t_norm = l.title | strip | downcase -%}
        {% if t_norm contains 'categor' %}{%- assign categories_parent_index = forloop.index0 -%}{% break %}{% endif %}
      {% endfor %}
    {% endif %}
    {% if categories_parent_index == -1 %}
      {% for l in menu_obj.links %}
        {% if l.links and l.links.size > 0 %}{%- assign categories_parent_index = forloop.index0 -%}{% break %}{% endif %}
      {% endfor %}
    {% endif %}
  {% endif %}

  {%- assign icon_override_lines = section.settings.icon_overrides | default: '' | newline_to_br | split: '<br />' -%}
  {%- assign search_prompts = section.settings.search_prompts | default: "Search Canon products\nSearch Nikon products\nSearch Sony E-mount lenses\nSearch gimbals\nSearch 128GB SD cards" | newline_to_br | split: '<br />' -%}

  <style>
/* ===== Root tokens ===== */
#ch-header-{{ section.id }}{
  --brand:#e03a2f; --brand-600:#d12f24; --ink:#161616; --muted:#6f6f6f; --line:#e8e8e8; --bg:#fff;
  --shadow:0 10px 30px rgba(17,17,17,.08); --h-m:64px; --h-d:72px;
  --safe-top: env(safe-area-inset-top); --safe-bottom: env(safe-area-inset-bottom);
}
#ch-header-{{ section.id }} *{ box-sizing:border-box; font-family:var(--font-sans); }

/* Shared container width */
#ch-header-{{ section.id }} .wrap{ max-width:1180px; width:100%; margin:0 auto; padding:0 12px; }
#ch-header-{{ section.id }} .only-m{ display:none!important; }
@media (max-width:991px){
  #ch-header-{{ section.id }} .only-d{ display:none!important; }
  #ch-header-{{ section.id }} .only-m{ display:block!important; }
}

/* ===== TOP BAR ===== */
#ch-header-{{ section.id }} .bar{
  position:relative; z-index:1; background:var(--brand-600); color:#fff; padding-top:var(--safe-top);
  transition:transform .22s ease, box-shadow .22s ease;
}
#ch-header-{{ section.id }} .row{
  display:grid; grid-template-columns:auto 1fr auto; align-items:center; gap:8px; padding:10px 0;
}
@media (max-width:991px){
  #ch-header-{{ section.id }} .row{ grid-template-columns:1fr auto 1fr; padding:8px 0; }
  #ch-header-{{ section.id }} .logo{ justify-self:center; }
  #ch-header-{{ section.id }} .right{ justify-self:end; }
  #ch-header-{{ section.id }} .logo__img{ max-height:30px; }
}

/* Shy header (mobile) */
@media (max-width:991px){
  #ch-header-{{ section.id }}.is-shy .row{ padding:6px 0; }
  #ch-header-{{ section.id }}.is-shy .m-search{
    max-height:0; margin:0 12px; padding:0; border-width:0; opacity:0; pointer-events:none; overflow:hidden;
  }
  #ch-header-{{ section.id }}.is-shy .bar{ box-shadow:0 1px 8px rgba(0,0,0,.14); }
}

/* Logo */
#ch-header-{{ section.id }} .logo{ display:inline-flex; align-items:center; text-decoration:none; color:#fff; }
#ch-header-{{ section.id }} .logo__img{ max-height:38px; width:auto; display:block; }

/* Icon buttons */
#ch-header-{{ section.id }} .btn{
  appearance:none; background:transparent; border:0; color:#fff;
  min-width:44px; min-height:44px; display:inline-flex; align-items:center; justify-content:center;
  border-radius:10px; cursor:pointer; padding:0 6px;
}
#ch-header-{{ section.id }} .right{ display:flex; align-items:center; gap:6px; padding-right:max(8px, env(safe-area-inset-right)); }

/* Icons */
#ch-header-{{ section.id }} .ico{ width:20px; height:20px; display:block; color:#fff; }
#ch-header-{{ section.id }} .ico path,
#ch-header-{{ section.id }} .ico circle,
#ch-header-{{ section.id }} .ico rect,
#ch-header-{{ section.id }} .ico line,
#ch-header-{{ section.id }} .ico polyline{
  fill:none; stroke:currentColor; stroke-width:1.9; stroke-linecap:round; stroke-linejoin:round;
}
#ch-header-{{ section.id }} .ico-heart path{ stroke-width:2.25; }
#ch-header-{{ section.id }} .btn:hover .ico{ opacity:.9; }

/* ===== COUNT BUBBLES ===== */
#ch-header-{{ section.id }} [data-cart], #ch-header-{{ section.id }} [data-wishlist]{ position:relative; font-size:0; }
#ch-header-{{ section.id }} .bubble{
  background:#fff !important; color:var(--brand-600) !important; font-weight:800 !important;
  font-size:11px !important; min-width:18px; height:18px; line-height:18px; padding:0 6px; border-radius:999px; border:0 !important;
  box-shadow:0 0 0 1px rgba(0,0,0,.06), 0 2px 6px rgba(0,0,0,.18) !important;
  position:absolute; top:-6px; right:-6px; transform-origin:center; transition:transform .18s ease;
}
#ch-header-{{ section.id }} .bubble.pop{ transform:scale(1.15); }

/* ===== DESKTOP SEARCH ===== */
#ch-header-{{ section.id }} .desk-search-wrap{ position:relative; width:100%; max-width:760px; justify-self:center; display:none; }
@media (min-width:992px){ #ch-header-{{ section.id }} .desk-search-wrap{ display:block; } }
#ch-header-{{ section.id }} .desk-search{
  display:flex; align-items:center; gap:8px;
  background:#fff; border:1px solid var(--brand-600); border-radius:10px; padding:0 10px 0 14px; height:40px;
  box-shadow:0 1px 2px rgba(0,0,0,.03);
}
#ch-header-{{ section.id }} .desk-search:focus-within{
  border-color:#fff; box-shadow:0 0 0 2px rgba(255,255,255,.15);
}
#ch-header-{{ section.id }} .desk-search input[type="search"]{
  width:100%; border:0; outline:0; background:transparent; color:var(--ink); font-weight:500; font-size:15px;
}
#ch-header-{{ section.id }} .desk-search .sbtn{
  display:inline-flex; align-items:center; justify-content:center;
  height:32px; padding:0 14px; border-radius:8px; border:1px solid var(--brand);
  background:var(--brand); color:#fff; font-weight:600; font-size:13px; line-height:1; cursor:pointer; text-transform:lowercase;
  align-self:center;
}
#ch-header-{{ section.id }} .desk-search .sbtn:hover{ background:#d12f24; border-color:#d12f24; }

/* Predictive panel */
#ch-header-{{ section.id }} .ps-panel{
  position:absolute; left:50%; top:calc(100% + 12px); transform:translateX(-50%);
  background:#fff; border:1px solid var(--line); border-radius:16px; box-shadow:0 12px 34px rgba(17,17,17,.12);
  width:clamp(820px, 62vw, 1040px); max-width:calc(100vw - 24px); display:none; z-index:1200; overflow:hidden;
}
#ch-header-{{ section.id }} .ps-panel[data-open="true"]{ display:block; }

/* ===== LOWER NAV BAND ===== */
#ch-header-{{ section.id }} .nav-band{ background:var(--brand-600); color:#fff; position:relative; }
#ch-header-{{ section.id }} .nav-band.is-fixed{
  position:fixed; top:0; left:0; right:0; z-index:2000; box-shadow:0 2px 12px rgba(0,0,0,.10);
  border-radius:0; transform:translateZ(0);
}
#ch-header-{{ section.id }} .nav-spacer{ display:none; }
#ch-header-{{ section.id }} .nav-spacer.show{ display:block; height:var(--navH, 44px); }

#ch-header-{{ section.id }} .nav{
  display:grid; grid-template-columns:auto 1fr auto; align-items:center; gap:16px; padding:0 16px; min-height:44px;
  max-width:1180px; margin:0 auto;
}
#ch-header-{{ section.id }} .nav .nav-left{ display:flex; gap:22px; align-items:center; flex-wrap:nowrap; }
#ch-header-{{ section.id }} .nav > * > a{
  position:relative; color:#fff; text-decoration:none; font-weight:500; font-size:14px; padding:10px 2px;
  display:inline-flex; align-items:center; gap:8px;
}
#ch-header-{{ section.id }} .nav > * > a::after{
  content:""; position:absolute; left:0; right:0; bottom:0; height:2px; transform:scaleX(0); transform-origin:left;
  transition:transform .18s ease; background:#fff;
}
#ch-header-{{ section.id }} .nav a:hover::after,
#ch-header-{{ section.id }} [data-open="true"]>a::after{ transform:scaleX(1); }

/* Dark text inside dropdowns */
#ch-header-{{ section.id }} .nav [data-mega] .mega,
#ch-header-{{ section.id }} .nav [data-mega] .mega a,
#ch-header-{{ section.id }} .nav [data-mini] .mega a,
#ch-header-{{ section.id }} .nav [data-mega] .mega .cats a,
#ch-header-{{ section.id }} .nav [data-mega] .mega .brand,
#ch-header-{{ section.id }} .nav [data-mega] .mega .chip{ color:#0F172A !important; }

/* === CHEVRONS (fixed + click-only rotate) === */
#ch-header-{{ section.id }}{ --chev-size:18px; }
#ch-header-{{ section.id }} .chev{
  width:var(--chev-size); height:var(--chev-size);
  flex:0 0 var(--chev-size); min-width:var(--chev-size);   /* lock layout width */
  display:inline-block; vertical-align:middle; margin-left:4px;
  background:currentColor; background-color:currentColor;  /* inherit link color */
  -webkit-mask:url('data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><path d="M7 10l5 5 5-5"/></svg>') center/contain no-repeat;
          mask:url('data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><path d="M7 10l5 5 5-5"/></svg>') center/contain no-repeat;
  transform-origin:50% 50%; backface-visibility:hidden; will-change:transform; transition:transform .18s ease;
}
/* rotate ONLY when parent is open (click toggled) */
#ch-header-{{ section.id }} .mmg-wrap[data-open="true"] > a .chev,
#ch-header-{{ section.id }} [data-mini][data-open="true"] > a .chev{ transform:rotate(180deg); }

/* Mini dropdowns */
#ch-header-{{ section.id }} .mega.mini{
  position:absolute; top:100%; left:0; z-index:1250; background:#fff; border:1px solid var(--line);
  border-radius:12px; padding:10px; min-width:260px; box-shadow:var(--shadow);
  opacity:0; transform:translateY(8px) scale(.98); pointer-events:none;
  transition:opacity .16s ease, transform .18s ease;
}
#ch-header-{{ section.id }} [data-open="true"] > .mega.mini{ opacity:1; transform:translateY(0) scale(1); pointer-events:auto; }

/* Right-side email positioning */
#ch-header-{{ section.id }} .nav-band .nav{ display:grid; grid-template-columns:1fr auto; }
#ch-header-{{ section.id }} .nav-band .nav > .nav-left{ justify-self:start; }
#ch-header-{{ section.id }} .nav-band .nav > div:last-child{ justify-self:end; }
#ch-header-{{ section.id }} .nav-band .nav .nav-left > * > a,
#ch-header-{{ section.id }} .nav-band .nav .nav-left > * > a *{ color:#fff !important; -webkit-text-fill-color:#fff; }
#ch-header-{{ section.id }} .nav-band .nav .nav-left > * > a::after{ background:#fff !important; }
#ch-header-{{ section.id }} .nav-band .nav .nav-left > * > a .chev{ background:#fff !important; }

/* Center desktop search column & box */
@media (min-width:992px){
  #ch-header-{{ section.id }} .row{ grid-template-columns:auto minmax(520px, 56vw) auto !important; }
  #ch-header-{{ section.id }} .desk-search-wrap{ width:auto !important; justify-self:center !important; }
  #ch-header-{{ section.id }} .desk-search{ width:clamp(520px, 56vw, 760px) !important; margin-inline:auto !important; }
}

/* --- Keep header on top --- */
#shopify-section-header, .shopify-section-header-sticky, .header-wrapper { position: relative; z-index: 9999; }
#shopify-section-header .header-bottom, #shopify-section-header .header__row--bottom, .header-bottom {
  position: sticky; top: 0; z-index: 10000; background: #D4372C; isolation: isolate; transform: translateZ(0);
}
#MainContent, .shopify-section:not(#shopify-section-header), .chpc, .ch-brands { position: relative; z-index: 0; }
.chpc__arrows, .ch-badge, .chb-logo-wrap, .ch-card, .chb-viewport, .chb-track { position: relative; z-index: 1; }
#MainContent, .page-width, .content-for-layout { transform: none !important; filter: none !important; perspective: none !important; }

/* ---- Predictive search visuals (scoped) ---- */
#ch-header-{{ section.id }} .ps-inner{ display:grid; grid-template-columns:1.6fr 1fr; }
#ch-header-{{ section.id }} .ps-col{ padding:12px; }
#ch-header-{{ section.id }} .ps-col + .ps-col{ border-left:1px solid var(--line); }
#ch-header-{{ section.id }} .ps-title{ margin:4px 0 10px; font:700 12px/1 var(--font-sans); color:#6b7280; letter-spacing:.02em; text-transform:uppercase; }
#ch-header-{{ section.id }} .lst{ list-style:none; margin:0; padding:0 8px 12px; display:grid; gap:8px; }
#ch-header-{{ section.id }} .ch-mini{ position:relative; display:grid; grid-template-columns:56px 1fr; gap:10px; padding:8px; border-radius:10px; border:1px solid #EEF2F6; }
#ch-header-{{ section.id }} .ch-mini .overlay{ position:absolute; inset:0; border-radius:10px; }
#ch-header-{{ section.id }} .ch-mini .thumb{ width:56px; height:56px; border-radius:10px; background:#fff; border:1px solid #F1F5F9; object-fit:contain; }
#ch-header-{{ section.id }} .ch-mini .mtitle{ font-weight:600; font-size:13px; line-height:1.35; color:#111; }
#ch-header-{{ section.id }} .ch-mini .price{ font-weight:800; font-size:12px; color:var(--brand); }
#ch-header-{{ section.id }} .price-was{ color:#6B7280; text-decoration:line-through; margin-left:6px; font-weight:700; }

/* Text list styles for Quick & Brands (plain text links) */
#ch-header-{{ section.id }} [data-ps-chips],
#ch-header-{{ section.id }} [data-ps-brands]{ display:block; background:transparent!important; padding:0!important; border:0!important; }
#ch-header-{{ section.id }} .ps-txtlink{
  display:inline!important; background:transparent!important; border:0!important; margin:0!important; padding:0!important;
  color:#111!important; text-decoration:none!important; font-weight:600; font-size:13px; line-height:1.6;
}
#ch-header-{{ section.id }} .ps-bullet{ display:inline-block; padding:0 6px; opacity:.38; user-select:none; }
#ch-header-{{ section.id }} .ps-txtlink:hover, #ch-header-{{ section.id }} .ps-txtlink:focus{ color:var(--brand-600)!important; }
#ch-header-{{ section.id }} .ps-txtlink:hover + .ps-bullet{ color:var(--brand-600); opacity:.6; }

/* Suggestions (right column) */
#ch-header-{{ section.id }} .sugg .srow{
  display:flex; align-items:center; gap:8px; padding:6px 8px; border-radius:10px; cursor:pointer;
}
#ch-header-{{ section.id }} .sugg .srow:hover{ background:#F8FAFC; }
#ch-header-{{ section.id }} .sugg .ico{ width:16px; height:16px; color:#6b7280; }
#ch-header-{{ section.id }} .sugg .srow div{ color:var(--brand-600); font-weight:600; }
#ch-header-{{ section.id }} .sugg mark{ background:transparent; color:var(--brand-600); font-weight:800; }

/* Footer CTA */
#ch-header-{{ section.id }} .ps-foot{ display:flex; justify-content:center; padding:10px 12px 12px; border-top:1px solid var(--line); background:#fff; }
#ch-header-{{ section.id }} .cta-all{
  border:1px solid var(--brand); background:var(--brand); color:#fff;
  border-radius:8px; height:40px; padding:0 14px; font-weight:600; display:inline-flex; align-items:center; gap:8px;
}
#ch-header-{{ section.id }} .cta-all:hover{ background:#d12f24; border-color:#d12f24; }

/* ===== Mobile search pill ===== */
@media (max-width:991px){
  #ch-header-{{ section.id }} .bar{ padding-left:0; padding-right:0; }
  #ch-header-{{ section.id }} .wrap.only-m{ padding-left:max(12px, env(safe-area-inset-left)); padding-right:max(12px, env(safe-area-inset-right)); }
  #ch-header-{{ section.id }} .m-search{
    width:100%; margin:8px 0 0; border:0 !important; background:#fff; box-shadow:0 1px 3px rgba(0,0,0,.08);
    height:40px; padding:0 10px 0 12px; display:flex; align-items:center; gap:6px; flex-wrap:nowrap; border-radius:12px;
  }
  #ch-header-{{ section.id }} .m-search:focus-within{ box-shadow:0 1px 3px rgba(0,0,0,.12); }
  #ch-header-{{ section.id }} .m-search input{
    flex:1 1 auto; min-width:0; border:0; outline:0; background:transparent; color:var(--ink); font-weight:500; font-size:15px;
  }
  #ch-header-{{ section.id }} .m-search .sbtn{
    height:32px; padding:0 14px; border-radius:10px; border:1px solid var(--brand); background:var(--brand); color:#fff; font-weight:700; font-size:12px;
    display:inline-flex; align-items:center; justify-content:center; align-self:center;
  }
}

/* ===== NEW: Bottom tab bar (mobile) ===== */
@media (max-width:991px){
  #ch-header-{{ section.id }} .bottom-tabs{
    position:fixed; bottom:0; left:0; right:0; z-index:10050; background:#fff; border-top:1px solid #eee;
    display:grid; grid-template-columns:repeat(5,1fr); height:56px; padding-bottom:var(--safe-bottom);
  }
  #ch-header-{{ section.id }} .bottom-tabs a,
  #ch-header-{{ section.id }} .bottom-tabs button{
    -webkit-tap-highlight-color:transparent; background:none; border:0;
    display:flex; flex-direction:column; align-items:center; justify-content:center; gap:2px;
    font-size:11px; color:#111; text-decoration:none; min-height:56px;
  }
  #ch-header-{{ section.id }} .bottom-tabs .ico{ width:20px; height:20px; color:#111; }
  body.has-bottom-tabs{ padding-bottom:calc(56px + var(--safe-bottom)); }
}

/* === Compact mobile header + search pill (scoped to small screens) === */
@media (max-width: 749px){
  :root{ --chm-bar:56px; --chm-logo:24px; --chm-ico:22px; }
  .site-header__upper{ height:var(--chm-bar); padding:0 12px; display:flex; align-items:center; }
  .site-header__upper .grid{ width:100%; display:flex; align-items:center; }
  .site-header__upper .grid__item.small--one-quarter{ flex:0 0 44px; }
  .site-header__upper .grid__item.small--one-half{ flex:1 1 auto; text-align:center; }
  .site-header__upper .grid__item.small--one-quarter.text-right{ flex:0 0 44px; }
  .site-header__logo img{ max-height:var(--chm-logo); width:auto; max-width:none; }
  .site-header__link, .site-header__cart{ height:var(--chm-bar); display:flex; align-items:center; justify-content:center; }
  .site-header__link svg, .site-header__cart svg{ width:var(--chm-ico); height:var(--chm-ico); }
  .ch-msearch-wrap{ display:block; padding:8px 12px 0; }
  .ch-msearch{
    display:flex; align-items:center; gap:8px; height:40px; border-radius:12px;
    background:#fff; border:1px solid #d12f24; padding:0 10px 0 12px; box-shadow:0 1px 3px rgba(0,0,0,.08);
  }
  .ch-msearch input{
    flex:1 1 auto; min-width:0; border:0; outline:0; background:transparent; color:#161616; font-weight:500; font-size:15px;
  }
  .ch-msearch .sbtn{
    height:32px; padding:0 14px; border-radius:10px; border:1px solid #e03a2f; background:#e03a2f;
    color:#fff; font-weight:700; font-size:12px; display:inline-flex; align-items:center; justify-content:center;
  }
}
/* hide the pill on desktop */
@media (min-width: 750px){ .ch-msearch-wrap{ display:none; } }

/* MOBILE: Camerahaus logo bigger */
@media (max-width: 991px){
  #ch-header-{{ section.id }} .logo__img{ max-height:38px !important; width:auto; }
  #ch-header-{{ section.id }} .bar{ padding-bottom:12px; }
  #ch-header-{{ section.id }}.is-shy .bar{ padding-bottom:0; }
}

/* ===== Desktop header tweaks ===== */
@media (min-width: 992px){
  #ch-header-{{ section.id }} .right .btn[aria-label="Search"]{ display:none !important; }
  #ch-header-{{ section.id }} .row{ gap:16px; }
  #ch-header-{{ section.id }} .desk-search{ margin:0 12px; }
  #ch-header-{{ section.id }} .right{ gap:4px; }
  #ch-header-{{ section.id }} .right .btn{ min-width:38px; padding:0 4px; }
  #ch-header-{{ section.id }} .right .ico{ width:22px; height:22px; }
}

/* === Shy top + sticky lower nav (non-destructive overrides) === */
#ch-header-{{ section.id }} .bar{ transition: transform .24s ease, box-shadow .24s ease; will-change: transform; }

/* Desktop: hide the whole .bar when shy */
@media (min-width: 992px){
  #ch-header-{{ section.id }}.is-shy .bar{
    transform: translateY(-100%); box-shadow: 0 1px 8px rgba(0,0,0,.14);
  }
}

/* Mobile: hide only the .row when shy (keep search pill) */
@media (max-width: 991px){
  #ch-header-{{ section.id }} .bar .row{ transition: transform .24s ease, opacity .18s ease; will-change: transform, opacity; }
  #ch-header-{{ section.id }}.is-shy .bar .row{ transform: translateY(-100%); opacity:0; pointer-events:none; }
  #ch-header-{{ section.id }}.is-shy .m-search{
    max-height:40px !important; opacity:1 !important; pointer-events:auto !important; margin:8px 0 0 !important;
    padding:0 10px 0 12px !important; border-width:1px !important;
  }
}

/* Spacer rules */
#ch-header-{{ section.id }} .nav-spacer{ display:none; height:var(--navH, 44px); }
#ch-header-{{ section.id }} .nav-spacer.show{ display:block; }

/* MOBILE: never show the desktop nav band */
@media (max-width: 991px){ #ch-header-{{ section.id }} nav.nav-band.only-d{ display:none !important; } }

/* Avoid fixed-position bugs caused by transformed ancestors */
html, body{ transform:none !important; }

/* Floating mode: let the red bar float above sticky nav */
#ch-header-{{ section.id }}.bar-floating .bar{ position:fixed; top:0; left:0; right:0; z-index:3001; }

/* Desktop: reset sticky unless floating */
@media (min-width:992px){ #ch-header-{{ section.id }} .bar{ position:relative; top:auto; } }

/* MOBILE polish while shy */
@media (max-width: 991px){
  #ch-header-{{ section.id }} .bar .row{
    transition: transform .24s ease, opacity .18s ease, max-height .24s ease, padding .24s ease, margin .24s ease;
  }
  #ch-header-{{ section.id }}.is-shy .bar .row{
    transform: translateY(-100%); opacity:0; pointer-events:none; max-height:0; padding:0; margin:0; overflow:hidden;
  }
  #ch-header-{{ section.id }} .m-search{ position:relative; }
  #ch-header-{{ section.id }}.is-shy .bar{ box-shadow:0 1px 8px rgba(0,0,0,.14); }
}

/* Never render the nav spacer on mobile */
@media (max-width: 991px){
  #ch-header-{{ section.id }} .nav-spacer{ display:none !important; height:0 !important; }
}

/* DESKTOP: dynamic top offset for fixed lower nav */
@media (min-width: 992px){
  #ch-header-{{ section.id }} .nav-band.is-fixed{ top: var(--navTop, 0px); }
}

/* MOBILE: small red spacer under the search pill; thin when shy */
@media (max-width: 991px){
  #ch-header-{{ section.id }} .bar{ padding-bottom:10px !important; }
  #ch-header-{{ section.id }}.is-shy .bar{ padding-bottom:8px !important; }
  #ch-header-{{ section.id }} .nav-spacer{ display:none !important; height:0 !important; }
}

/* z-index patch so predictive panel stays above fixed lower nav */
#ch-header-{{ section.id }}.bar-floating .ps-panel{ z-index:3002; }

/* Mega menu positioning (trigger is the positioning context) */
#ch-header-{{ section.id }} .mmg-wrap[data-mega]{ position:relative; }
#ch-header-{{ section.id }} .mmg{
  position:absolute !important; left:0 !important; top:calc(100% + 8px) !important;
  z-index:12000 !important; opacity:0; visibility:hidden; pointer-events:none; transform:translateY(6px);
  transition:opacity .18s cubic-bezier(.22,.61,.36,1), transform .18s cubic-bezier(.22,.61,.36,1);
}
/* OPEN STATE — click only */
#ch-header-{{ section.id }} .mmg-wrap[data-open="true"] > .mmg{
  opacity:1; visibility:visible; pointer-events:auto; transform:translateY(0);
}

/* Optional safety: neutralize any transforms on fixed band */
#ch-header-{{ section.id }} .nav-band.is-fixed{ transform:none !important; }

/* put drawers above header & floating bar */
#ch-menu-drawer{ z-index:30000 !important; }
#ch-menu-drawer .ch-mdrawer__overlay{ z-index:30001 !important; }
#ch-menu-drawer .ch-mdrawer__panel{ z-index:30002 !important; }
/* cart drawer */
.ch-panel[data-ch-panel="cart"] .ch-panel__ov{ z-index:30010 !important; }
.ch-panel[data-ch-panel="cart"] .ch-panel__pn{ z-index:30011 !important; }

/* —— Desktop spacing polish —— */
@media (min-width: 992px){
  #ch-header-{{ section.id }} .right .btn[aria-label="Search"]{ display:none !important; }
  #ch-header-{{ section.id }} .row{ gap:16px; }
}

