<script>
(() => {
  const root = document.getElementById('ch-header-{{ section.id }}'); if (!root) return;
  const qs = (s, sc = root) => sc.querySelector(s);

  const bar   = qs('.bar');
  const nav   = qs('.nav-band');
  const spacer= qs('.nav-spacer');
  const mq    = window.matchMedia('(min-width: 992px)');

  let lastY = window.pageYOffset || 0;
  let ticking = false;

  const isDesktop = () => mq.matches;

  function setVars(){
    // keep a fresh bar height for offsets
    const barH = bar ? bar.getBoundingClientRect().height : 0;
    root.style.setProperty('--barH', `${barH}px`);
  }

function positionNav(){
  if (!nav) return;
  if (!isDesktop()){
    nav.style.top = '';
    return;
  }
  const navIsFixed   = nav.classList.contains('is-fixed');
  const barIsVisible = !root.classList.contains('is-shy');
  const offsetPx = barIsVisible ? Math.round((bar?.getBoundingClientRect().bottom || 0)) : 0;

  // When fixed, sit the nav exactly under the red bar; otherwise clear inline style
  nav.style.top = navIsFixed ? `${offsetPx}px` : '';
}

function measure(){
  if (!nav || !spacer) return;

  // keep a fresh bar height for consistency
  const barH = bar ? bar.getBoundingClientRect().height : 0;
  root.style.setProperty('--barH', `${barH}px`);

  if (!isDesktop()){
    // mobile never uses the desktop spacer
    spacer.classList.remove('show');
    return;
  }

  // compute spacer usage
  const navH = nav.getBoundingClientRect().height || 44;
  root.style.setProperty('--navH', `${navH}px`);

  const navIsFixed   = nav.classList.contains('is-fixed');
  const barIsVisible = !root.classList.contains('is-shy');

  // Show spacer ONLY when nav is fixed AND the bar is hidden (shy).
  // This prevents the red gap between the bar and the fixed nav.
  if (navIsFixed && !barIsVisible){
    spacer.classList.add('show');
  } else {
    spacer.classList.remove('show');
  }
}


  function applySticky(){
    if (!bar || !nav || !spacer) return;

    if (!isDesktop()){
      // mobile: float the red bar so the search pill stays sticky
      const y = window.pageYOffset || 0;
      const barH = bar?.offsetHeight || 0;
      const shouldFloat = (y > barH / 2) || root.classList.contains('is-shy');

      if (shouldFloat){
        root.classList.add('bar-floating');
      } else {
        root.classList.remove('bar-floating');
      }

      // desktop nav isn’t used on mobile
      nav.classList.remove('is-fixed');
      spacer.classList.remove('show');
      positionNav();
      return;
    }


    const y = window.pageYOffset || 0;
    const barH = bar.offsetHeight || 0;

    // fix the lower nav whenever the bar is shy OR we've scrolled past the bar height
    const shouldFix = (y > barH) || root.classList.contains('is-shy');

    if (shouldFix){
      if (!nav.classList.contains('is-fixed')){
        nav.classList.add('is-fixed');
        spacer.classList.add('show');
      }
      root.classList.add('bar-floating');
    } else {
      if (nav.classList.contains('is-fixed')){
        nav.classList.remove('is-fixed');
        spacer.classList.remove('show');
      }
      root.classList.remove('bar-floating');
    }

    positionNav();  // keep it under (or at top without) the red bar
  }

  function onScroll(){
    const y = window.pageYOffset || 0;

    // shy behavior: scroll down hides, scroll up shows
    if (Math.abs(y - lastY) > 6){
      const goingDown = y > lastY;
      if (goingDown && y > 60){
        root.classList.add('is-shy');
      } else {
        root.classList.remove('is-shy');
      }
      lastY = y;
    }

    applySticky();
    measure();
    ticking = false;
  }

  window.addEventListener('scroll', () => {
    if (!ticking){
      window.requestAnimationFrame(onScroll);
      ticking = true;
    }
  }, { passive: true });

  window.addEventListener('resize', () => {
    setVars();
    applySticky();
    measure();
  }, { passive: true });

  // initial pass
  setVars();
  applySticky();
  measure();
})();
</script>


<script>
  /* — unified typewriter: shows ONE phrase at a time, pauses while typing — */
  (function(){
    function getPrompts(){
      try {
        const raw = document.getElementById('ps-prompts-{{ section.id }}')?.textContent || '[]';
        const parsed = JSON.parse(raw);
        if (Array.isArray(parsed)) {
          const clean = parsed.map(s => String(s||'').trim()).filter(Boolean);
          if (clean.length >= 2) return clean;
        } else if (typeof parsed === 'string') {
          const clean = parsed.split(/\r?\n|<br\s*\/?>|[|]/i).map(s => s.trim()).filter(Boolean);
          if (clean.length >= 2) return clean;
        }
      } catch(e){}
      return [
        "Search Canon products",
        "Search Nikon products",
        "Search Sony E-mount lenses",
        "Search gimbals",
        "Search 128GB SD cards"
      ];
    }

    function attachTypewriter(input, phrases){
      if (!input || input.dataset.tw === '1') return;
      input.dataset.tw = '1';
      let i = 0, j = 0, del = false, hold = 0;

      function tick(){
        // pause while the user is actually typing in the field
        if (document.activeElement === input && input.value){
          input.setAttribute('placeholder','');
          return setTimeout(tick, 600);
        }
        const phrase = phrases[i] || '';
        input.setAttribute('placeholder', phrase.slice(0, j));

        if (!del){
          if (j < phrase.length) { j++; return setTimeout(tick, 55); }
          if (hold < 12) { hold++; return setTimeout(tick, 80); }
          hold = 0; del = true; return setTimeout(tick, 250);
        } else {
          if (j > 0) { j--; return setTimeout(tick, 28); }
          del = false; i = (i + 1) % phrases.length; return setTimeout(tick, 300);
        }
      }
      tick();
    }

    const phrases = getPrompts();
    // desktop input inside predictive search form
    attachTypewriter(document.querySelector('#ch-header-{{ section.id }} [data-ps-input]'), phrases);
    // mobile pill input
    attachTypewriter(document.querySelector('#ch-header-{{ section.id }} .m-search input'), phrases);
  })();
</script>
<script>
  (function(){
    function readJSON(id, fallback){
      try { return JSON.parse(document.getElementById(id)?.textContent || JSON.stringify(fallback)); }
      catch { return fallback; }
    }

    const phrases = readJSON('ps-prompts-{{ section.id }}', [
      "Search Canon products",
      "Search Nikon products",
      "Search Sony E-mount lenses",
      "Search gimbals",
      "Search 128GB SD cards"
    ]);

    function startTypewriter(input){
      if (!input || input.dataset.tw === '1' || !phrases.length) return;
      input.dataset.tw = '1';
      let i=0, j=0, del=false, hold=0;

      (function tick(){
        if (document.activeElement === input && input.value){
          input.placeholder = '';
          return setTimeout(tick, 600);
        }
        const p = phrases[i] || '';
        input.placeholder = p.slice(0, j);

        if (!del){
          if (j < p.length){ j++; return setTimeout(tick, 55); }
          if (hold < 12){ hold++; return setTimeout(tick, 80); }
          hold = 0; del = true; return setTimeout(tick, 250);
        } else {
          if (j > 0){ j--; return setTimeout(tick, 28); }
          del = false; i = (i + 1) % phrases.length; return setTimeout(tick, 300);
        }
      })();
    }

    // run after DOM for this section exists
    requestAnimationFrame(function(){
      startTypewriter(document.querySelector('#ch-header-{{ section.id }} [data-ps-input]'));   // desktop
      startTypewriter(document.querySelector('#ch-header-{{ section.id }} .m-search input'));   // mobile
    });
  })();
</script>

<!-- NEW: predictive panel controller (open/close + dynamic CTA) -->
<script>
(() => {
  const root  = document.getElementById('ch-header-{{ section.id }}'); if (!root) return;
  const wrap  = root.querySelector('[data-ps-wrap]');
  const input = wrap?.querySelector('[data-ps-input]');
  const panel = wrap?.querySelector('[data-ps-panel]');
  const viewAll = wrap?.querySelector('[data-ps-viewall]');
  const live  = wrap?.querySelector('[data-ps-live]');
  const mq    = window.matchMedia('(min-width: 992px)');
  const minChars = {{ section.settings.search_min_chars | default: 2 }};

  const openPanel = () => {
    if (!panel) return;
    panel.dataset.open = 'true';
    input?.setAttribute('aria-expanded','true');
  };
  const closePanel = () => {
    if (!panel) return;
    panel.dataset.open = 'false';
    input?.setAttribute('aria-expanded','false');
  };
  const updateCTA = (q) => {
    if (!viewAll) return;
    const qTrim = (q || '').trim();
    viewAll.href = `/search?q=${encodeURIComponent(qTrim)}`;
    viewAll.textContent = qTrim ? `View “${qTrim}”` : 'View all results';
    if (live) live.textContent = qTrim ? `Showing suggestions for ${qTrim}` : '';
  };

  // Open on focus on desktop; keep closed until min chars typed if you prefer
  input?.addEventListener('focus', () => {
    if (mq.matches) openPanel();
  });

  // Show/hide as user types; also update the “View <q>” link
  input?.addEventListener('input', (e) => {
    const q = e.target.value || '';
    if (q.trim().length >= minChars) openPanel(); else closePanel();
    updateCTA(q);
  });

  // Close on Esc
  input?.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') { closePanel(); input.blur(); }
  });

  // Close on click outside
  document.addEventListener('click', (e) => {
    if (!wrap?.contains(e.target)) closePanel();
  }, { passive: true });

  // If we swap to mobile layout, ensure it’s closed
  mq.addEventListener('change', () => { if (!mq.matches) closePanel(); });

  // Initial CTA state
  updateCTA('');
})();
</script>

<script>
(() => {
  const root = document.getElementById('ch-header-{{ section.id }}'); if (!root) return;
  const nav = root.querySelector('.nav-band'); if (!nav) return;

  const originalParent = nav.parentNode, originalNext = nav.nextSibling;
  const mq = window.matchMedia('(min-width: 992px)');

  function moveOut(){ if(nav.parentNode!==root) root.appendChild(nav); }
  function moveBack(){ if(nav.parentNode!==originalParent) originalParent.insertBefore(nav, originalNext); }

  function sync(){
    if (mq.matches && nav.classList.contains('is-fixed')) moveOut();
    else moveBack();
  }

  const mo = new MutationObserver(sync);
  mo.observe(nav, { attributes:true, attributeFilter:['class'] });

  mq.addEventListener('change', sync);
  sync();
})();
</script>
<script>
(function(){
  const root = document.getElementById('ch-header-{{ section.id }}');
  if(!root) return;

  // Targets: mega triggers (All Categories, Brands) and mini items with children
  const triggerSelectors = [
    '.mmg-wrap > a',            // mega menu triggers
    '[data-mini] > a[data-mini-link]' // mini dropdown triggers
  ].join(',');

  const triggers = root.querySelectorAll(triggerSelectors);

  function closeAll(except){
    root.querySelectorAll('.mmg-wrap[data-open="true"], [data-mini][data-open="true"]').forEach(el=>{
      if(el !== except){
        el.removeAttribute('data-open');
        const link = el.querySelector('a');
        if(link) link.setAttribute('aria-expanded','false');
      }
    });
  }

  function toggle(parent){
    const isOpen = parent.getAttribute('data-open') === 'true';
    if(isOpen){
      parent.setAttribute('data-open','false');
    }else{
      closeAll(parent);
      parent.setAttribute('data-open','true');
    }
    const link = parent.querySelector('a');
    if(link) link.setAttribute('aria-expanded', String(!isOpen));
  }

  // Click + keyboard activation
  triggers.forEach(a=>{
    const parent = a.closest('.mmg-wrap, [data-mini]');
    if(!parent) return;

    a.addEventListener('click', (e)=>{
      // If this item has a submenu, use click to toggle instead of navigate
      const hasMenu = parent.querySelector('.mmg, .mega');
      if(hasMenu){
        e.preventDefault();
        toggle(parent);
      }
    });

    a.addEventListener('keydown', (e)=>{
      if(e.key === 'Enter' || e.key === ' '){
        e.preventDefault();
        a.click();
      }
    });
  });

  // Close when clicking outside
  document.addEventListener('click', (e)=>{
    if(!root.contains(e.target)) closeAll(null);
  }, { passive: true });

  // Close on Esc
  document.addEventListener('keydown', (e)=>{
    if(e.key === 'Escape') closeAll(null);
  });

})();
</script>

