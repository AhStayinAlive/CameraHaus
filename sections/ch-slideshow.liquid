                     --cap-off-y: {{ block.settings.offset_y | default: 0 }}%;

                     /* mobile offsets (used only at ≤768px) */
                     --cap-off-x-m: {{ block.settings.offset_x_m | default: block.settings.offset_x | default: 0 }}%;
                     --cap-off-y-m: {{ block.settings.offset_y_m | default: block.settings.offset_y | default: 0 }}%;

                     /* free-mode desktop + mobile */
                     --cap-free-x: {{ block.settings.free_x | default: '4%' }};
                     --cap-free-y: {{ block.settings.free_y | default: '50%' }};
                     --cap-free-x-m: {{ block.settings.free_x_m | default: block.settings.free_x | default: '4%' }};
                     --cap-free-y-m: {{ block.settings.free_y_m | default: block.settings.free_y | default: '50%' }};

                     /* alignment desktop + mobile */
                     --title-align: {{ block.settings.title_align | default: 'left' }};
                     --title-align-m: {{ block.settings.title_align_m | default: block.settings.title_align | default: 'left' }};
                     --subtitle-align: {{ block.settings.subtitle_align | default: 'left' }};
                     --subtitle-align-m: {{ block.settings.subtitle_align_m | default: block.settings.subtitle_align | default: 'left' }};
                     --btn-align: {% case block.settings.button_align %}{% when 'center' %}center{% when 'right' %}flex-end{% else %}flex-start{% endcase %};
                     --btn-align-m: {% case block.settings.button_align_m %}{% when 'center' %}center{% when 'right' %}flex-end{% else %}flex-start{% endcase %};

                     /* sizes */
                     --title-size: {{ block.settings.title_size_d | default: 72 }}px;
                     --title-size-m: {{ block.settings.title_size_m | default: 14 }}px;
                     --subtitle-size: {{ block.settings.subtitle_size_d | default: 20 }}px;
                     --subtitle-size-m: {{ block.settings.subtitle_size_m | default: 12 }}px;
                     --btn-size: {{ block.settings.btn_font_size_d | default: 15 }}px;
                     --btn-size-m: {{ block.settings.btn_font_size_m | default: 12 }}px;
                     --btn-min-h-m: {{ block.settings.btn_min_h_m | default: 28 }}px;
                     --btn-radius-m: {{ block.settings.btn_radius_m | default: 10 }}px;

                     /* colors */
                     --title-ink: {{ block.settings.title_color | default: block.settings.text_color | default: '#ffffff' }};
                     --subtitle-ink: {{ block.settings.subtitle_color | default: block.settings.text_color | default: '#ffffff' }};

                     {% if block.settings.position_mode == 'free' %} top: var(--cap-free-y); left: var(--cap-free-x); transform: translateY(-50%); {% endif %}

                     /* outline colors for outline button style (defaults now white) */
                     --btn-outline-border: {{ block.settings.button_outline_border | default: '#FFFFFF' }};
                     --btn-outline-text:   {{ block.settings.button_outline_text   | default: '#FFFFFF' }};
                     --btn-outline-border-h: {{ block.settings.button_outline_border_h | default: section.settings.brand | default: '#E0302A' }};
                     --btn-outline-text-h:   {{ block.settings.button_outline_text_h   | default: '#FFFFFF' }};
                     --btn-outline-bg-h:     {{ block.settings.button_outline_bg_h     | default: section.settings.brand | default: '#E0302A' }};
                   ">

                <div class="hero__cap-inner">
                  {%- unless block.settings.title == blank -%}
                    <h2 class="hero__title">{{ block.settings.title | escape }}</h2>
                  {%- endunless -%}
                  {%- unless block.settings.subtitle == blank -%}
                    <div class="hero__subtitle">{{ block.settings.subtitle }}</div>
                  {%- endunless -%}
                </div>

                {%- if block.settings.button_label != blank and block.settings.button_link != blank -%}
                  <a href="{{ block.settings.button_link }}"
                     class="hero__btn {% if block.settings.button_style == 'outline' %}hero__btn--outline{% endif %}">
                    {{ block.settings.button_label | escape }}
                  </a>
                {%- endif -%}
              </div>
            {%- endunless -%}

            {%- if block.settings.block_logo != blank -%}
              {%- assign logo_w_m = block.settings.block_logo_w_m | default: 120 -%}
              {%- assign logo_w_d = block.settings.block_logo_w_d | default: 160 -%}
              {%- capture slide_logo_sizes -%}(max-width: 768px) {{ logo_w_m }}px, {{ logo_w_d }}px{%- endcapture -%}
              <span class="hero__block-logo"
                    style="--logo-w: {{ block.settings.block_logo_w_d | default: 160 }}px; --logo-x: {{ block.settings.block_logo_x_d | default: 'auto' }}; --logo-y: {{ block.settings.block_logo_y_d | default: 'auto' }};">
                {{ block.settings.block_logo
