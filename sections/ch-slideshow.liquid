{%- comment -%}
  -style slideshow (mobile tuned)
  - Edge-to-edge hero on mobile; arrows hidden on mobile
  - Mobile caption X/Y overrides (header, subtitle, CTA move together)
  - Separate alignment controls for title/subtitle/CTA (desktop vs mobile)
  - Optional per-slide mobile image
  - Mobile: fixed height 53vh with 570px min
  - Starts directly under header (no negative margins)
  - UPDATE: Overlay/opacity is now set per slide (image layer), not on text. Removed text opacity and global ::after overlay. Added per-slide overlay settings.
{%- endcomment -%}

{%- if section.settings.hero_home_height == 'adapt' -%}
  {%- assign first_block = section.blocks[0] -%}
  {%- if first_block.settings.image.aspect_ratio == blank -%}
    {%- assign min_aspect_ratio = 2.0 -%}
  {%- else -%}
    {%- assign min_aspect_ratio = first_block.settings.image.aspect_ratio -%}
  {%- endif -%}
  {% assign wrapper_height = 100 | divided_by: min_aspect_ratio %}
{%- endif -%}

{% if section.blocks.size > 0 %}
  <div
    class="hero-wrapper hero-wrapper--{{ section.settings.hero_home_height }} {% if section.settings.layout == 'bleed' %}is-bleed{% else %}is-contained{% endif %}{% if section.settings.mobile_square_all_corners %} is-mobile-square{% endif %}"
    role="region"
    aria-label="slideshow"
    aria-describedby="a11y-slideshow-info"
    style="
      background-color: {{ section.settings.bg | default: '#ffffff' }};
      /* Card look (desktop) */
      --overlay: {% if section.settings.overlay_enable %}{{ section.settings.overlay_opacity | default: 0.3 }}{% else %}0{% endif %};
      --overlay-color: {{ section.settings.overlay_color | default: '#000000' }};

      --card-outline-w: {{ section.settings.card_outline_w | default: 12 }}px;
      --card-outline-color: {{ section.settings.card_outline_color | default: '#ffffff' }};
      --card-radius: {{ section.settings.card_radius | default: 20 }}px;
      --card-shadow-opacity: {{ section.settings.card_shadow_opacity | default: 0.1 }};
      /* Width & spacing — desktop */
      --hero-max-w: {{ section.settings.hero_max_w | default: 1680 }}px;
      --hero-gutter: {{ section.settings.hero_side_gutter | default: 24 }}px;
      --hero-top-gap: {{ section.settings.hero_margin_top | default: 0 }}px;
      --hero-bottom-gap: {{ section.settings.hero_margin_bottom | default: 8 }}px;
      --hero-pad-top: {{ section.settings.hero_pad_top | default: 0 }}px;
      --hero-pad-bottom: {{ section.settings.hero_pad_bottom | default: 0 }}px;
      /* Width & spacing — mobile */
      --hero-max-w-m: {{ section.settings.hero_max_w_mobile | default: 560 }}px;
      --hero-gutter-m: {{ section.settings.hero_side_gutter_mobile | default: 16 }}px;
      --hero-top-gap-m: {{ section.settings.hero_margin_top_m | default: 0 }}px;
      --hero-bottom-gap-m: {{ section.settings.hero_margin_bottom_m | default: 8 }}px;
      --hero-pad-top-m: {{ section.settings.hero_pad_top_m | default: 0 }}px;
      --hero-pad-bottom-m: {{ section.settings.hero_pad_bottom_m | default: 0 }}px;
    "
  >

    <style>
      :root{
        --tap-target: 44px;
        --title-font: Inter, system-ui, -apple-system, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
        --subtitle-font: Inter, system-ui, -apple-system, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
        --btn-font: Inter, system-ui, -apple-system, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
      }

      /* Scope to this section only (+ stop ancestors from clipping the rounded card) */
      #shopify-section-{{ section.id }}{ overflow:visible !important; }
      #shopify-section-{{ section.id }} .shopify-section--slideshow{ overflow: visible; margin:0 !important; padding-top:0 !important; }
      #shopify-section-{{ section.id }} .section,
      #shopify-section-{{ section.id }} .section__padding,
      #shopify-section-{{ section.id }} .page-width{ overflow:visible !important; }

      /* Full-bleed container (desktop) */
      #shopify-section-{{ section.id }} .is-bleed{
        position: relative; display:block;
        width:100vw; max-width:100vw; min-width:100vw;
        left:50%; transform:translateX(-50%);
        margin: var(--hero-top-gap, 0px) 0 var(--hero-bottom-gap, 8px);
        padding: var(--hero-pad-top, 0px) 0 var(--hero-pad-bottom, 0px);
        overflow:hidden; box-sizing:border-box;
      }

      /* Contained (desktop) */
      #shopify-section-{{ section.id }} .is-contained{
        position:relative; display:block;
        width:min(var(--hero-max-w, 1680px), calc(100vw - (2 * var(--hero-gutter, 24px))));
        margin: var(--hero-top-gap, 0px) auto var(--hero-bottom-gap, 8px);
        border-radius:var(--card-radius, 20px);
        overflow:hidden;
        box-shadow:
          0 0 0 var(--card-outline-w, 12px) var(--card-outline-color, #fff),
          0 18px 48px rgba(0,0,0,var(--card-shadow-opacity, .14));
        background-clip:padding-box;
        padding: var(--hero-pad-top, 0px) 0 var(--hero-pad-bottom, 0px);
      }

      /* Ensure content respects rounding on desktop */
      #shopify-section-{{ section.id }} .hero-wrapper.is-contained{ border-radius:var(--card-radius, 20px) !important; overflow:hidden !important; }
      #shopify-section-{{ section.id }} #Slideshow-{{ section.id }}{ border-radius:inherit !important; }
      #shopify-section-{{ section.id }} #Slideshow-{{ section.id }} .hero__slide,
      #shopify-section-{{ section.id }} #Slideshow-{{ section.id }} .hero__image,
      #shopify-section-{{ section.id }} #Slideshow-{{ section.id }} .hero__image-bg{ border-radius:inherit !important; }
      @supports (clip-path: inset(0 round 10px)){
        #shopify-section-{{ section.id }} .hero-wrapper.is-contained{ clip-path: inset(0 round var(--card-radius, 20px)); }
      }

      /* Slideshow root */
      #Slideshow-{{ section.id }}{ position:relative; overflow:hidden; width:100%; }

      /* Fade-in once first slide is ready */
      #Slideshow-{{ section.id }}.is-loading{
        opacity:0;
      }
      #Slideshow-{{ section.id }}.is-ready{
        opacity:1;
        transition: opacity .45s ease-out;
      }

      #Slideshow-{{ section.id }} .hero__track{ display:flex; width:100%; height:100%; transition:transform .5s ease; will-change: transform; }
      #Slideshow-{{ section.id }} .hero__slide{ position:relative; flex:0 0 100%; width:100%; height:100%; }

      /* Height modes (desktop) */
      #shopify-section-{{ section.id }} .hero--small{ height:45vh; min-height:360px; }
      #shopify-section-{{ section.id }} .hero--large{ height:60vh; min-height:420px; }
      #shopify-section-{{ section.id }} .hero--fit{   height: calc(100svh - var(--header-offset, 0px) - var(--fit-margin, 36px)); min-height:420px; }
      #shopify-section-{{ section.id }} .hero--full{  height:clamp(70vh, 86vh, 92vh); }
      #shopify-section-{{ section.id }} .hero--adapt-height{ height:auto; }
      #shopify-section-{{ section.id }} .hero--custom{ height:var(--hero-h, 86vh); min-height:var(--hero-min, 420px); }

      /* Image layers */
      #Slideshow-{{ section.id }} picture,
      #Slideshow-{{ section.id }} .hero__image,
      #Slideshow-{{ section.id }} .hero__image-bg{
        position:absolute; inset:0; width:100%; height:100%;
        object-fit:cover; display:block; z-index:0; opacity:1 !important;
      }
      #Slideshow-{{ section.id }} .hero__image-bg{ background-size:cover; background-position:center; background-repeat:no-repeat; }

      /* NEW: Per-slide flat overlay on the IMAGE layer (under scrim, above image) */
      #Slideshow-{{ section.id }} .hero__slide::before{
        content:""; position:absolute; inset:0; z-index:2; pointer-events:none;
        background: var(--ov-color, var(--overlay-color, #000));
        opacity: var(--ov, var(--overlay, 0));
        transition: opacity .2s ease;
      }

      /* Caption */
      #Slideshow-{{ section.id }} .hero__caption{
        position:absolute; max-width:var(--cap-w, 720px);
        color:var(--cap-ink, #fff); z-index:5;
        padding:clamp(10px, 1.8vw, 18px) clamp(10px, 2vw, 20px);
        display:flex; flex-direction:column; gap:10px;
        text-align:var(--cap-align, left);
        background:transparent; border:none; box-shadow:none; border-radius:0; backdrop-filter:none;
      }
      #Slideshow-{{ section.id }} .hero__title{
        font: 900 clamp(var(--title-size-m, 14px), 7.5vw, var(--title-size, 72px))/1 var(--title-font);
        text-transform: uppercase; letter-spacing:.02em; margin:0;
        color: var(--title-ink, var(--cap-ink)); text-align: var(--title-align, inherit);
      }
      #Slideshow-{{ section.id }} .hero__subtitle{
        font: 500 clamp(var(--subtitle-size-m, 12px), 3vw, var(--subtitle-size, 20px))/1.35 var(--subtitle-font);
        margin:2px 0 0;
        color: var(--subtitle-ink, var(--cap-ink)); text-align: var(--subtitle-align, inherit);
      }

      /* Float-in on first show */
      @keyframes floatUp { from { opacity:0; transform:translateY(16px); } to { opacity:1; transform:translateY(0); } }
      #Slideshow-{{ section.id }} .hero__slide.is-active .hero__title{ animation: floatUp .6s cubic-bezier(.2,.8,.2,1) .05s both; }
      #Slideshow-{{ section.id }} .hero__slide.is-active .hero__subtitle{ animation: floatUp .6s cubic-bezier(.2,.8,.2,1) .15s both; }
      #Slideshow-{{ section.id }} .hero__slide.is-active .hero__btn{ animation: floatUp .6s cubic-bezier(.2,.8,.2,1) .25s both; }
      #Slideshow-{{ section.id }} .hero__slide.is-active .hero__block-logo{ animation: floatUp .6s cubic-bezier(.2,.8,.2,1) .35s both; }
      @media (prefers-reduced-motion: reduce){
        #Slideshow-{{ section.id }} .hero__title,
        #Slideshow-{{ section.id }} .hero__subtitle,
        #Slideshow-{{ section.id }} .hero__btn,
        #Slideshow-{{ section.id }} .hero__block-logo{ animation:none !important; opacity:1; transform:none; }
      }

      /* Placement presets — use mobile vars first */
      #shopify-section-{{ section.id }} .pos-top-left    { top:calc(4% + var(--cap-off-y-m, var(--cap-off-y, 0%))); left:calc(4% + var(--cap-off-x-m, var(--cap-off-x, 0%))); }
      #shopify-section-{{ section.id }} .pos-top-center  { top:calc(4% + var(--cap-off-y-m, var(--cap-off-y, 0%))); left:50%; transform:translateX(-50%); text-align:center; --cap-align:center; }
      #shopify-section-{{ section.id }} .pos-top-right   { top:calc(4% + var(--cap-off-y-m, var(--cap-off-y, 0%))); right:calc(4% - var(--cap-off-x-m, var(--cap-off-x, 0%))); text-align:right; --cap-align:right; }
      #shopify-section-{{ section.id }} .pos-middle-left { top:50%; left:calc(4% + var(--cap-off-x-m, var(--cap-off-x, 0%))); transform:translateY(-50%); }
      #shopify-section-{{ section.id }} .pos-middle-center{ top:50%; left:50%; transform:translate(-50%, -50%); text-align:center; --cap-align:center; }
      #shopify-section-{{ section.id }} .pos-middle-right{ top:50%; right:calc(4% - var(--cap-off-x-m, var(--cap-off-x, 0%))); transform:translateY(-50%); text-align:right; --cap-align:right; }
      #shopify-section-{{ section.id }} .pos-bottom-left { bottom:calc(4% - var(--cap-off-y-m, var(--cap-off-y, 0%))); left:calc(4% + var(--cap-off-x-m, var(--cap-off-x, 0%))); }
      #shopify-section-{{ section.id }} .pos-bottom-center{ bottom:calc(4% - var(--cap-off-y-m, var(--cap-off-y, 0%))); left:50%; transform:translateX(-50%); text-align:center; --cap-align:center; }
      #shopify-section-{{ section.id }} .pos-bottom-right{ bottom:calc(4% - var(--cap-off-y-m, var(--cap-off-y, 0%))); right:calc(4% - var(--cap-off-x-m, var(--cap-off-x, 0%))); text-align:right; --cap-align:right; }

      /* Scrim */
      #Slideshow-{{ section.id }} .hero__scrim{ position:absolute; inset:0; pointer-events:none; z-index:3; }
      #shopify-section-{{ section.id }} .scrim-bottom{ background:linear-gradient(to top, rgba(0,0,0,var(--scrim, .35)) 0%, rgba(0,0,0,0) 60%); }
      #shopify-section-{{ section.id }} .scrim-top{    background:linear-gradient(to bottom, rgba(0,0,0,var(--scrim, .35)) 0%, rgba(0,0,0,0) 60%); }
      #shopify-section-{{ section.id }} .scrim-radial{ background:radial-gradient(60% 60% at 50% 60%, rgba(0,0,0,var(--scrim, .35)) 0%, rgba(0,0,0,0) 70%); }

      /* CTA */
      #Slideshow-{{ section.id }} .hero__btn{
        display:inline-flex; align-items:center; justify-content:center; gap:.5rem;
        min-height:44px; padding:.6rem 1.1rem; border-radius:12px; border:2px solid transparent;
        font-weight:800; text-decoration:none; width:max-content; letter-spacing:.3px;
        background:var(--btn-bg,#161616); color:var(--btn-ink,#fff);
        box-shadow: 0 8px 24px rgba(0,0,0,.24);
        transition: background .22s ease, color .22s ease, border-color .22s ease, box-shadow .22s ease;
        font-family: var(--btn-font);
        font-size: clamp(var(--btn-size-m, 12px), 2vw, var(--btn-size, 15px));
        align-self: var(--btn-align, flex-start);
      }

      /* OUTLINE button reverted to white outline + white text */
      #Slideshow-{{ section.id }} .hero__btn--outline{
        background:transparent;
        color:#ffffff;
        border-color:#ffffff;
      }
      #Slideshow-{{ section.id }} .hero__btn--outline:hover,
      #Slideshow-{{ section.id }} .hero__btn--outline:focus-visible{
        color:#ffffff;
        border-color:{{ section.settings.brand | default: '#E0302A' }};
        background:{{ section.settings.brand | default: '#E0302A' }};
      }

      /* Per-slide logo */
      #Slideshow-{{ section.id }} .hero__block-logo{ position:absolute; z-index:6; display:block; filter: drop-shadow(0 4px 14px rgba(0,0,0,.25)); left: var(--logo-x, auto); top: var(--logo-y, auto); }
      #Slideshow-{{ section.id }} .hero__block-logo img{ width:var(--logo-w, 160px); height:auto; opacity:var(--logo-opacity, 1); }


      /* Dots reverted: grey squares; active = red rectangle */
      #Slideshow-{{ section.id }} .hero__dots{ position:absolute; left:50%; bottom: var(--dots-offset, 12px); transform:translateX(-50%); display:flex; gap:8px; z-index:6; }
      #Slideshow-{{ section.id }} .hero__dot{ width:10px; height:10px; border-radius:2px; background:#d1d5db; border:none; cursor:pointer; }
      #Slideshow-{{ section.id }} .hero__dot[aria-current="true"]{ width:22px; height:10px; border-radius:2px; background:{{ section.settings.brand | default: '#E0302A' }}; }

      @media (prefers-reduced-motion: reduce){ #Slideshow-{{ section.id }} .hero__track{ transition:none } }

      /* ----------------- MOBILE (≤768px) ----------------- */
      @media (max-width: 768px){

        /* Absolutely no top gap/padding for this hero */
        #MainContent > #shopify-section-{{ section.id }}{
          margin-top:0 !important; padding-top:0 !important;
        }
        #shopify-section-{{ section.id }},
        #shopify-section-{{ section.id }} .shopify-section--slideshow,
        #shopify-section-{{ section.id }} .section,
        #shopify-section-{{ section.id }} .section__padding,
        #shopify-section-{{ section.id }} .page-width,
        #shopify-section-{{ section.id }} .hero-wrapper,
        #shopify-section-{{ section.id }} .is-bleed,
        #shopify-section-{{ section.id }} .hero-wrapper.is-contained{
          margin-top:0 !important; padding-top:0 !important; border-top:0 !important;
          padding-left:0 !important; padding-right:0 !important;
        }

        /* Edge-to-edge. No rounding/shadow on mobile */
        #shopify-section-{{ section.id }} .hero-wrapper.is-contained{
          width:100vw !important; max-width:100vw !important; min-width:100vw !important;
          position:relative; left:50%; transform:translateX(-50%);
          margin: var(--hero-top-gap-m, 0px) auto var(--hero-bottom-gap-m, 8px) !important;
          padding: var(--hero-pad-top-m, 0px) 0 var(--hero-pad-bottom-m, 0px) !important;
          border-radius:0 !important; --card-outline-w:0; box-shadow:none !important; clip-path:none !important;
        }

        /* Square ALL inner layers too */
        #shopify-section-{{ section.id }} #Slideshow-{{ section.id }},
        #shopify-section-{{ section.id }} #Slideshow-{{ section.id }} .hero__slide,
        #shopify-section-{{ section.id }} #Slideshow-{{ section.id }} .hero__image,
        #shopify-section-{{ section.id }} #Slideshow-{{ section.id }} .hero__image-bg{
          border-radius:0 !important; clip-path:none !important;
        }

        /* Mobile height: EXACTLY 53vh; min 570px */
        #Slideshow-{{ section.id }}{
          height: var(--hero-h-m, 53vh) !important;
          min-height: var(--hero-min-m, 570px) !important;
        }
        #Slideshow-{{ section.id }} .hero__track,
        #Slideshow-{{ section.id }} .hero__slide{ height: 100% !important; }

        /* Fit modes: keep height, switch object-fit only */
        #Slideshow-{{ section.id }} .hero__image,
        #Slideshow-{{ section.id }} .hero__image-bg{
          height:100% !important;
          object-fit: cover !important;
        }
        #Slideshow-{{ section.id }}[data-mobile-fit="contain"] .hero__image,
        #Slideshow-{{ section.id }}[data-mobile-fit="contain"] .hero__image-bg{
          object-fit: contain !important;
        }
        #Slideshow-{{ section.id }}[data-mobile-fit="contain"] .hero__slide{
          aspect-ratio: auto !important;
          height:100% !important;
        }

        /* Hide arrows only on mobile */
        #Slideshow-{{ section.id }} .hero__arrow{ display:none !important; }

        /* Caption MOBILE X/Y overrides */
        #Slideshow-{{ section.id }} .hero__caption{
          --cap-off-x: var(--cap-off-x-m, var(--cap-off-x, 0%));
          --cap-off-y: var(--cap-off-y-m, var(--cap-off-y, 0%));
        }
        #Slideshow-{{ section.id }} .hero__caption.pos-free{
          top:  var(--cap-free-y-m, var(--cap-free-y, 50%)) !important;
          left: var(--cap-free-x-m, var(--cap-free-x, 4%)) !important;
          transform: translateY(-50%);
        }

        /* Type sizes & alignments (mobile-specific) */
        #Slideshow-{{ section.id }} .hero__title{
          font-size: clamp(8px, var(--title-size-m, 14px), 28px) !important;
          line-height: 1.1;
          text-align: var(--title-align-m, var(--title-align, inherit));
        }
        #Slideshow-{{ section.id }} .hero__subtitle{
          font-size: clamp(8px, var(--subtitle-size-m, 12px), 22px) !important;
          line-height: 1.35;
          text-align: var(--subtitle-align-m, var(--subtitle-align, inherit));
        }
        #Slideshow-{{ section.id }} .hero__btn{
          min-height: var(--btn-min-h-m, 28px);
          border-radius: var(--btn-radius-m, 10px);
          font-size: var(--btn-size-m, 12px) !important;
          align-self: var(--btn-align-m, var(--btn-align, flex-start));
        }
      }
      /* ================== FIX: NO TOP GAP ON MOBILE ================== */
@media (max-width:768px){
  /* Kill theme header spacers */
  .header__spacer,
  .site-header-spacer,
  .header-spacer{ display:none !important; height:0 !important; }

  /* Remove any global top spacing around content */
  #MainContent,
  .content-for-index,
  .content-for-layout,
  .main-content,
  .page-container{
    padding-top:0 !important;
    margin-top:0 !important;
  }

  /* Ensure THIS section and its wrappers have zero top spacing */
  #shopify-section-{{ section.id }},
  #shopify-section-{{ section.id }} .shopify-section--slideshow,
  #shopify-section-{{ section.id }} .section,
  #shopify-section-{{ section.id }} .section__padding,
  #shopify-section-{{ section.id }} .page-width,
  #shopify-section-{{ section.id }} .hero-wrapper,
  #shopify-section-{{ section.id }} .is-bleed,
  #shopify-section-{{ section.id }} .hero-wrapper.is-contained,
  #Slideshow-{{ section.id }}{
    margin-top:0 !important;
    padding-top:0 !important;
    border-top:0 !important;
  }
}

/* ================== FIX: SHOW + RESTYLE DOTS ================== */
#Slideshow-{{ section.id }} .hero__dots{
  position:absolute;
  left:50%;
  transform:translateX(-50%);
  bottom: var(--dots-offset, 12px) !important; /* same control as before */
  display:flex !important;
  gap:6px;
  z-index:7;
  opacity:1 !important;          /* force visible if theme fades them */
  pointer-events:auto;
}
#Slideshow-{{ section.id }} .hero__dot{
  width:8px; height:8px;
  border-radius:2px;               /* small square */
  background:#d1d5db;              /* grey */
  border:none;
}
#Slideshow-{{ section.id }} .hero__dot[aria-current="true"]{
  width:18px; height:8px;          /* short rectangle */
  border-radius:2px;
  background: {{ section.settings.brand | default: '#E0302A' }}; /* red */
}
/* Pagination dots: circles + rounded pill for active */
#Slideshow-{{ section.id }} .hero__dots{
  gap:8px; bottom: var(--dots-offset, 12px) !important;
}

#Slideshow-{{ section.id }} .hero__dot{
  width:10px; height:10px;
  border-radius:9999px !important;     /* perfect circle */
  background:#d1d5db;
  border:0; appearance:none;
  transition:width .25s ease;
}

#Slideshow-{{ section.id }} .hero__dot[aria-current="true"]{
  width:22px; height:10px;
  border-radius:9999px !important;     /* pill */
  background: {{ section.settings.brand | default: '#E0302A' }};
}

/* REMOVED GLOBAL OVERLAY ::after — we now overlay per slide */
/* #Slideshow-{{ section.id }}::after{ ... } */

/* === DESKTOP: remove any spacer/padding above this hero === */
.header__spacer,
.site-header-spacer,
.header-spacer{
  display:none !important;
  height:0 !important;
}

#MainContent,
.content-for-index,
.content-for-layout,
.main-content,
.page-container{
  padding-top:0 !important;
  margin-top:0 !important;
}

/* Kill top margin/padding on this slideshow section + its wrappers */
#shopify-section-{{ section.id }},
#shopify-section-{{ section.id }} .shopify-section--slideshow,
#shopify-section-{{ section.id }} .section,
#shopify-section-{{ section.id }} .section__padding,
#shopify-section-{{ section.id }} .page-width,
#shopify-section-{{ section.id }} .hero-wrapper,
#shopify-section-{{ section.id }} .is-bleed,
#shopify-section-{{ section.id }} .hero-wrapper.is-contained{
  margin-top:0 !important;
  padding-top:0 !important;
  border-top:0 !important;
}
/* === Slideshow arrows – standard Camerahaus style === */
#Slideshow-{{ section.id }}{
  --arrow-size: 38px;        /* same as product carousel */
  --arrow-inset: 24px;       /* distance from edge; tweak if you want */
  --arrow-icon-scale: 0.5;   /* SVG size inside the circle */
}

#Slideshow-{{ section.id }} .hero__arrow{
  position:absolute;
  top:50%;
  transform:translateY(-50%);
  z-index:6;

  width:var(--arrow-size);
  height:var(--arrow-size);
  min-width:var(--arrow-size);
  min-height:var(--arrow-size);

  display:grid;
  place-items:center;

  border-radius:9999px;
  background:transparent;
  color:{{ section.settings.brand | default: '#E0302A' }};
  border:1.5px solid {{ section.settings.brand | default: '#E0302A' }};
  box-shadow:none !important;

  cursor:pointer;
  transition:
    background .15s ease,
    color .15s ease,
    transform .08s ease,
    border-color .15s ease,
    opacity .15s ease;
}

/* left/right positioning – like product carousel, just inset instead of negative */
#shopify-section-{{ section.id }} .hero__arrow--prev{
  left:var(--arrow-inset);
}
#shopify-section-{{ section.id }} .hero__arrow--next{
  right:var(--arrow-inset);
}

/* hover / active / disabled – same behavior as product carousel */
#Slideshow-{{ section.id }} .hero__arrow:hover,
#Slideshow-{{ section.id }} .hero__arrow:focus-visible{
  background:{{ section.settings.brand | default: '#E0302A' }};
  color:#fff;
}
#Slideshow-{{ section.id }} .hero__arrow:active{
  transform:translateY(-50%) scale(.96);
}
#Slideshow-{{ section.id }} .hero__arrow[disabled]{
  opacity:.35;
  filter:grayscale(1);
  pointer-events:none;
}

/* make sure the SVG icon follows the color + scales nicely */
#Slideshow-{{ section.id }} .hero__arrow svg{
  width:calc(var(--arrow-size) * var(--arrow-icon-scale));
  height:calc(var(--arrow-size) * var(--arrow-icon-scale));
}
#Slideshow-{{ section.id }} .hero__arrow svg [stroke]{
  stroke:currentColor !important;
}
#Slideshow-{{ section.id }} .hero__arrow svg [fill]:not([fill="none"]){
  fill:currentColor !important;
}

/* still hidden on mobile */
@media (max-width: 768px){
  #Slideshow-{{ section.id }} .hero__arrow{
    display:none !important;
  }
}

/* remove any legacy pseudo-element bars / background images */
#Slideshow-{{ section.id }} .hero__arrow::before,
#Slideshow-{{ section.id }} .hero__arrow::after{
  content:none !important;
  display:none !important;
}
#Slideshow-{{ section.id }} .hero__arrow{
  background-image:none !important;
}


/* inset from edges */
#shopify-section-{{ section.id }} .hero__arrow--prev{ left: var(--arrow-inset); }
#shopify-section-{{ section.id }} .hero__arrow--next{ right: var(--arrow-inset); }

/* hover/active states (same as product carousel) */
#Slideshow-{{ section.id }} .hero__arrow:hover,
#Slideshow-{{ section.id }} .hero__arrow:focus-visible{
  background: {{ section.settings.brand | default: '#E0302A' }};
  color: #fff;
}
#Slideshow-{{ section.id }} .hero__arrow:active{
  transform: translateY(-50%) scale(.96);
}
#Slideshow-{{ section.id }} .hero__arrow[disabled]{
  opacity: .35; filter: grayscale(1); pointer-events: none;
}

/* ensure the arrow icon scales with the button */
#Slideshow-{{ section.id }} .hero__arrow svg{
  width: calc(var(--arrow-size) * var(--arrow-icon-scale));
  height: calc(var(--arrow-size) * var(--arrow-icon-scale));
}
#Slideshow-{{ section.id }} .hero__arrow svg [stroke]{ stroke: currentColor !important; }
#Slideshow-{{ section.id }} .hero__arrow svg [fill]:not([fill="none"]){ fill: currentColor !important; }

/* optional: give even more breathing room on very wide screens */
@media (min-width: 1440px){
  #Slideshow-{{ section.id }}{ --arrow-inset: 28px; }
}

/* still hidden on mobile as before */
@media (max-width: 768px){
  #Slideshow-{{ section.id }} .hero__arrow{ display:none !important; }
}
/* Remove legacy pseudo-element bars on slideshow arrows */
#Slideshow-{{ section.id }} .hero__arrow::before,
#Slideshow-{{ section.id }} .hero__arrow::after{
  content: none !important;
  display: none !important;
}

/* Also ensure no sprite/background leaks through */
#Slideshow-{{ section.id }} .hero__arrow{
  background-image: none !important;
}

