          {%- endif -%}

          <div class="hero__slide hero__slide--{{ block.id }}" data-index="{{ forloop.index0 }}" style="--slide-ar: {{ mobile_ar }}; --ov: {% assign ov_raw = block.settings.overlay_opacity_b_select | default: block.settings.overlay_opacity_b %}{% if block.settings.overlay_enable_b %}{{ ov_raw | default: section.settings.overlay_opacity | default: 0.3 }}{% else %}{% if section.settings.overlay_enable %}{{ section.settings.overlay_opacity | default: 0.3 }}{% else %}0{% endif %}{% endif %}; --ov-color: {{ block.settings.overlay_color_b | default: section.settings.overlay_color | default: '#000000' }};" {{ block.shopify_attributes }}>

