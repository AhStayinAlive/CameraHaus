    <script>
      /* Slideshow controls with image-first fade-in */
      (function(){
        const root = document.getElementById('Slideshow-{{ section.id }}');
        if (!root) return;

        const track   = root.querySelector('[data-track]');
        const slides  = track ? Array.from(track.children) : [];
        const prevBtn = root.querySelector('[data-prev]');
        const nextBtn = root.querySelector('[data-next]');
        const dots    = Array.from(root.querySelectorAll('[data-dot]'));

        let index = 0;
        const auto  = root.dataset.autoplay === 'true';
        const speed = parseInt(root.dataset.speed || 5000, 10) || 5000;
        let timer;

        function go(i){
          if (!slides.length || !track) return;

          index = (i + slides.length) % slides.length;

          track.style.transform = 'translateX(-' + (index * 100) + '%)';

          dots.forEach(function(d, di){
            d.setAttribute('aria-current', di === index ? 'true' : 'false');
          });

          slides.forEach(function(s, si){
            s.classList.toggle('is-active', si === index);
          });
        }

        function nextSlide(){ go(index + 1); }
        function prevSlide(){ go(index - 1); }

        function start(){
          if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
          if (!auto || slides.length < 2) return;
          stop();
          timer = setInterval(nextSlide, speed);
        }

        function stop(){
          if (timer) clearInterval(timer);
          timer = null;
        }

        // Called once the first image is ready
        function markReady(){
          if (root.classList.contains('is-ready')) return;

          root.classList.remove('is-loading');
          root.classList.add('is-ready');

          if (slides.length){
            go(0);   // activate first slide so text animation runs
          }

          start();
        }

        // Wire up controls
        nextBtn && nextBtn.addEventListener('click', nextSlide);
        prevBtn && prevBtn.addEventListener('click', prevSlide);
        dots.forEach(function(d){
          d.addEventListener('click', function(e){
            var idx = parseInt(e.currentTarget.getAttribute('data-dot') || '0', 10);
            go(idx);
          });
        });

        root.addEventListener('mouseenter', stop);
        root.addEventListener('mouseleave', start);
        root.addEventListener('focusin', stop);
        root.addEventListener('focusout', start);
        document.addEventListener('visibilitychange', function(){
          document.hidden ? stop() : start();
        });

        // Touch/swipe
        var sx = 0, sy = 0, dx = 0, dy = 0, swiping = false;
        var THRESH = 40;

        root.addEventListener('touchstart', function(e){
          if (e.touches.length !== 1) return;
          sx = e.touches[0].clientX;
          sy = e.touches[0].clientY;
          dx = dy = 0;
          swiping = true;
          stop();
        }, { passive: true });

        root.addEventListener('touchmove', function(e){
          if (!swiping) return;
          dx = e.touches[0].clientX - sx;
          dy = e.touches[0].clientY - sy;
        }, { passive: true });

        root.addEventListener('touchend', function(){
          if (!swiping) return;
          if (Math.abs(dx) > Math.abs(dy) && Math.abs(dx) > THRESH){
            dx < 0 ? nextSlide() : prevSlide();
          }
          swiping = false;
          start();
        }, { passive: true });

        // Wait for the first slide image before revealing hero
        if (!slides.length){
          markReady();
          return;
        }

        var firstImg = slides[0].querySelector('img.hero__image');

        if (firstImg){
          if (firstImg.complete && firstImg.naturalWidth){
            requestAnimationFrame(markReady);
          } else {
            firstImg.addEventListener('load',  markReady, { once: true });
            firstImg.addEventListener('error', markReady, { once: true });
          }
        } else {
          // No image found (edge case)
          markReady();
        }
      })();
    </script>
