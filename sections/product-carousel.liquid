{% comment %}
productcarousel — Havit-like tabs, persistent; red circular carousel arrows.
Mobile tabs show chevrons only when overflowing.
{% endcomment %}

{% liquid
  assign pad_top    = section.settings.padding_top | default: 12
  assign pad_bottom = section.settings.padding_bottom | default: 16

  assign per_d = section.settings.items_per_view_desktop | default: 5
  assign per_t = section.settings.items_per_view_tablet  | default: 3
  assign per_m = section.settings.items_per_view_mobile  | default: 4

  assign card_ratio = section.settings.card_ratio | default: 'square'
  assign fit        = section.settings.image_fit  | default: 'contain'

  assign mobile_bleed_px   = section.settings.mobile_bleed_px | default: 0
  assign mobile_full_bleed = section.settings.mobile_full_bleed
  assign mobile_gutter     = section.settings.mobile_side_gutter | default: 16
  assign show_outline      = section.settings.show_card_outline

  assign autoplay   = section.settings.enable_autoplay
  assign autoplayMs = section.settings.autoplay_ms | default: 5000
  assign loop_pages = section.settings.enable_loop

  assign show_arrows = section.settings.show_arrows
  assign show_dots   = section.settings.show_dots

  assign heading    = section.settings.heading    | default: 'Featured Products'
  assign sub        = section.settings.subheading | default: blank
  assign brand_red  = '#E0302A'
%}

<section id="chpc-{{ section.id }}"
  class="chpc chpc--compact{% if mobile_full_bleed %} chpc--bleed-mobile{% endif %}{% if show_outline %} chpc--outlined{% endif %}"
  style="--pad-top:{{ pad_top }}px;--pad-bottom:{{ pad_bottom }}px;--mobile-bleed:{{ mobile_bleed_px }}px;--mobile-gutter:{{ mobile_gutter }}px;--brand:{{ brand_red }};"
  data-per-desktop="{{ per_d }}" data-per-tablet="{{ per_t }}" data-per-mobile="{{ per_m }}"
  data-card-ratio="{{ card_ratio }}" data-fit="{{ fit }}"
  data-loop="{{ loop_pages }}" data-autoplay="{{ autoplay }}" data-autoplay-ms="{{ autoplayMs }}"
  data-show-arrows="{{ show_arrows }}" data-show-dots="{{ show_dots }}">

  <div class="page-width">
    <!-- Heading + tabs -->
    <header class="chpc__header chpc__header--havit">
      <div class="chpc__titles">
        <h2 class="pcar__heading">{{ section.settings.heading | default: 'Best Sellers' }}</h2>
        {%- if sub != blank -%}<p class="chpc__sub">{{ sub | escape }}</p>{%- endif -%}
      </div>

      {%- if section.blocks.size > 0 -%}
      <nav class="chpc__tabs" data-tabs aria-label="{{ heading | escape }}">
        <button class="chpc__tabs-nudge chpc__tabs-nudge--prev" type="button" data-tab-prev aria-label="Scroll tabs left">‹</button>

        <ul class="chpc__tablist" role="tablist" data-tablist>
          {%- for block in section.blocks -%}
            {%- assign bs = block.settings -%}
            {%- assign handle = bs.collection.handle | default: bs.collection -%}
            {%- assign cobj = blank -%}
            {%- if handle != blank -%}{%- assign cobj = collections[handle] -%}{%- endif -%}
            {%- assign lbl = bs.tab_label -%}
            {%- if lbl == blank and cobj != blank -%}{%- assign lbl = cobj.title -%}{%- endif -%}
            {%- if lbl == blank -%}{%- assign lbl = 'Tab ' | append: forloop.index -%}{%- endif -%}
            <li role="presentation">
              <button class="chpc__tab{% if forloop.first %} is-active{% endif %}"
                      type="button" role="tab"
                      aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
                      data-tab="{{ block.id }}">{{ lbl | escape }}</button>
            </li>
          {%- endfor -%}
        </ul>

        <button class="chpc__tabs-nudge chpc__tabs-nudge--next" type="button" data-tab-next aria-label="Scroll tabs right">›</button>
      </nav>
      {%- endif -%}
    </header>

    <!-- Viewport -->
    <div class="chpc__viewport" data-viewport>
      <div class="chpc__track" id="chpc-track-{{ section.id }}" tabindex="0" aria-label="Product slides" data-track>
        {%- comment -%} initial slides from first tab (no all_products, use limit) {%- endcomment -%}
        {%- if section.blocks.size > 0 -%}
          {%- assign ibs = section.blocks.first.settings -%}
          {%- assign icol_handle = ibs.collection.handle | default: ibs.collection -%}
          {%- if icol_handle != blank -%}
            {%- assign icol = collections[icol_handle] -%}
            {%- if icol != blank -%}
              {%- assign list = icol.products -%}
              {%- case ibs.collection_sort -%}
                {%- when 'price-asc'  -%}{%- assign list = list | sort: 'price' -%}
                {%- when 'price-desc' -%}{%- assign list = list | sort: 'price' | reverse -%}
                {%- when 'title-asc'  -%}{%- assign list = list | sort: 'title' -%}
                {%- when 'title-desc' -%}{%- assign list = list | sort: 'title' | reverse -%}
                {%- when 'date-desc'  -%}{%- assign list = list | sort: 'published_at' | reverse -%}
                {%- when 'date-asc'   -%}{%- assign list = list | sort: 'published_at' -%}
              {%- endcase -%}
              {%- for product in list limit: section.settings.max_items -%}
                {%- if product == blank -%}{% continue %}{%- endif -%}
                <article class="chpc__slide" data-slide="{{ forloop.index }}" data-position="{{ forloop.index0 }}" data-product-id="{{ product.id }}">
                  <div class="chpc__card chpc--proxy">{% render 'product-card', product: product %}</div>
                </article>
              {%- endfor -%}
            {%- endif -%}
          {%- elsif ibs.products != blank -%}
            {%- for product in ibs.products limit: section.settings.max_items -%}
              {%- if product == blank -%}{% continue %}{%- endif -%}
              <article class="chpc__slide" data-slide="{{ forloop.index }}" data-position="{{ forloop.index0 }}" data-product-id="{{ product.id }}">
                <div class="chpc__card chpc--proxy">{% render 'product-card', product: product %}</div>
              </article>
            {%- endfor -%}
          {%- endif -%}
        {%- endif -%}
      </div>

      {% render 'chpc-controls',
        id: section.id,
        show_dots: show_dots,
        show_arrows: show_arrows,
        mobile_hide_arrows: true %}
    </div>

    <div class="chpc__toast" role="status" aria-live="polite" aria-atomic="true" data-toast></div>
  </div>

  {%- comment -%} templates per tab (no all_products, use limit) {%- endcomment -%}
  {%- for block in section.blocks -%}
    {%- assign bs = block.settings -%}
    {%- assign handle2 = bs.collection.handle | default: bs.collection -%}
    <template id="tpl-{{ block.id }}">
      {%- if handle2 != blank -%}
        {%- assign cc = collections[handle2] -%}
        {%- if cc != blank -%}
          {%- assign list2 = cc.products -%}
          {%- case bs.collection_sort -%}
            {%- when 'price-asc'  -%}{%- assign list2 = list2 | sort: 'price' -%}
            {%- when 'price-desc' -%}{%- assign list2 = list2 | sort: 'price' | reverse -%}
            {%- when 'title-asc'  -%}{%- assign list2 = list2 | sort: 'title' -%}
            {%- when 'title-desc' -%}{%- assign list2 = list2 | sort: 'title' | reverse -%}
            {%- when 'date-desc'  -%}{%- assign list2 = list2 | sort: 'published_at' | reverse -%}
            {%- when 'date-asc'   -%}{%- assign list2 = list2 | sort: 'published_at' -%}
          {%- endcase -%}
          {%- for product in list2 limit: section.settings.max_items -%}
            {%- if product == blank -%}{% continue %}{%- endif -%}
            <article class="chpc__slide" data-slide="{{ forloop.index }}" data-position="{{ forloop.index0 }}" data-product-id="{{ product.id }}">
              <div class="chpc__card chpc--proxy">{% render 'product-card', product: product %}</div>
            </article>
          {%- endfor -%}
        {%- endif -%}
      {%- elsif bs.products != blank -%}
        {%- for product in bs.products limit: section.settings.max_items -%}
          {%- if product == blank -%}{% continue %}{%- endif -%}
          <article class="chpc__slide" data-slide="{{ forloop.index }}" data-position="{{ forloop.index0 }}" data-product-id="{{ product.id }}">
            <div class="chpc__card chpc--proxy">{% render 'product-card', product: product %}</div>
          </article>
        {%- endfor -%}
      {%- endif -%}
    </template>
  {%- endfor -%}

<style>
  #chpc-{{ section.id }}{ --tab-fade: 18px; padding-top:var(--pad-top); padding-bottom:var(--pad-bottom); }
  #chpc-{{ section.id }} .page-width{ max-width:1440px; margin:0 auto; padding:0 28px; position:relative; }
  #chpc-{{ section.id }} .chpc__heading{ font-family:var(--font-sans); font-weight:600; letter-spacing:-0.01em; line-height:1.15; margin:0 0 2px; font-size:clamp(22px,3.2vw + 4px,28px); color:#111; }
  #chpc-{{ section.id }} .chpc__sub{ margin:0; color:#6B7280; font-size:.95rem; }
  #chpc-{{ section.id }} .chpc__header--havit{ display:flex; align-items:flex-end; justify-content:space-between; gap:10px; margin:0 0 10px; flex-wrap:wrap; }
  #chpc-{{ section.id }} .chpc__tabs{ display:grid; grid-template-columns:auto 1fr auto; align-items:center; column-gap:6px; position:relative; margin-left:auto; max-width:100%; }
  #chpc-{{ section.id }} .chpc__tablist{ display:flex; gap:clamp(24px, 5vw, 44px); overflow:auto; -webkit-overflow-scrolling:touch; scrollbar-width:none; padding:0 2px; list-style:none; margin:0; scroll-snap-type:x proximity; scroll-behavior:smooth; overscroll-behavior-inline:contain; }
  #chpc-{{ section.id }} .chpc__tablist::-webkit-scrollbar{ display:none; }
  #chpc-{{ section.id }} .chpc__tablist > li{ list-style:none; scroll-snap-align:start; }
  #chpc-{{ section.id }} .chpc__tab{ background:transparent; border:0; padding:6px 0 8px; cursor:pointer; font-family:var(--font-sans); font-weight:500; color:#6B7280; white-space:nowrap; transition:color .18s ease; }
  #chpc-{{ section.id }} .chpc__tab.is-active{ color:var(--brand); }
  #chpc-{{ section.id }} .chpc__tabs-nudge{ border:0; background:none; padding:0 6px; font:700 18px/1 Inter, ui-sans-serif, system-ui, -apple-system, "Segoe UI", Roboto, "Helvetica Neue", Arial; color:#6B7280; cursor:pointer; opacity:0; transform:translateY(2px); transition:opacity .22s ease, transform .22s ease, color .18s ease; pointer-events:none; user-select:none; min-width:28px; }
  #chpc-{{ section.id }} .chpc__tabs[data-overflow="true"] .chpc__tabs-nudge{ opacity:.95; transform:translateY(0); pointer-events:auto; }
  #chpc-{{ section.id }} .chpc__tabs-nudge.is-disabled{ opacity:.25; pointer-events:none; }
  @media (min-width:740px){ #chpc-{{ section.id }} .chpc__tabs-nudge{ display:none !important; } }
  @media (max-width:739.98px){
    #chpc-{{ section.id }} .chpc__tablist{
      padding-left: var(--tab-fade); padding-right: var(--tab-fade); scroll-padding-inline: var(--tab-fade);
      -webkit-mask-image: linear-gradient(to right, transparent 0, black var(--tab-fade), black calc(100% - var(--tab-fade)), transparent 100%);
              mask-image: linear-gradient(to right, transparent 0, black var(--tab-fade), black calc(100% - var(--tab-fade)), transparent 100%);
    }
  }
  #chpc-{{ section.id }} .chpc__viewport{ position:relative; overflow:visible; padding-bottom:28px; }
  #chpc-{{ section.id }} .chpc__track{ position:relative; display:flex; gap:14px; overflow-x:auto; -webkit-overflow-scrolling:touch; padding:6px 6px 8px 6px; align-items:stretch; scroll-snap-type:x mandatory; scrollbar-width:none; }
  #chpc-{{ section.id }} .chpc__track::-webkit-scrollbar{ display:none; }
  #chpc-{{ section.id }} .chpc__slide{ min-width:0; flex:0 0 calc((100% - (14px * (var(--chpc-items) - 1))) / var(--chpc-items)); scroll-snap-align:start; display:flex; }
  @media (min-width:1100px){ #chpc-{{ section.id }}{ --chpc-items: {{ per_d }}; } }
  @media (min-width:740px) and (max-width:1099.98px){ #chpc-{{ section.id }}{ --chpc-items: {{ per_t }}; } }
  @media (max-width:739.98px){
    #chpc-{{ section.id }} .page-width{ padding-left:16px; padding-right:16px; }
    #chpc-{{ section.id }}{ --chpc-items: {{ per_m }}; }
    #chpc-{{ section.id }} .chpc__track{ display:grid; grid-auto-flow:column;
      grid-auto-columns: calc(100vw - (max(var(--mobile-gutter), env(safe-area-inset-left)) + max(var(--mobile-gutter), env(safe-area-inset-right)) ));
      column-gap:12px; padding:6px max(var(--mobile-gutter), env(safe-area-inset-right)) 8px max(var(--mobile-gutter), env(safe-area-inset-left));
    }
    #chpc-{{ section.id }} .chpc__page{ width:100%; display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:12px; scroll-snap-align:start; align-items:stretch; }
  }
  #chpc-{{ section.id }} .chpc__arrows{ position:absolute; inset:0; pointer-events:none; }
  #chpc-{{ section.id }} .chpc__arrow{ position:absolute; top:50%; transform:translateY(-50%); pointer-events:auto; width:38px; height:38px; min-width:38px; min-height:38px; display:grid; place-items:center; background:transparent; color:var(--brand); border:1.5px solid var(--brand); border-radius:9999px; box-shadow:none; transition: background .15s ease, color .15s ease, transform .08s ease; cursor:pointer; }
  #chpc-{{ section.id }} .chpc__arrow:hover{ background:var(--brand); color:#fff; }
  #chpc-{{ section.id }} .chpc__arrow:active{ transform:translateY(-50%) scale(.96); }
  #chpc-{{ section.id }} .chpc__arrow[disabled]{ opacity:.35; filter:grayscale(1); pointer-events:none; }
  #chpc-{{ section.id }} .chpc__arrow--prev{ left: -24px; }
  #chpc-{{ section.id }} .chpc__arrow--next{ right: -24px; }
  @media (max-width:739.98px){ #chpc-{{ section.id }} .chpc__arrows[data-hide-mobile="true"]{ display:none !important; } }
  #chpc-{{ section.id }}.chpc--outlined .chpc--proxy .ch-card,
  #chpc-{{ section.id }}.chpc--outlined .chpc--proxy .chcard{ background:#fff; border-radius:12px; box-shadow:0 6px 20px rgba(17,17,17,.06); outline:1px solid rgba(17,17,17,.06); }

  /* === FINAL, SINGLE SOURCE OF TRUTH ===
     Product carousel heading must match "Shop by Category" */
  #chpc-{{ section.id }} h2.pcar__heading{
    /* neutralize any theme h2 defaults that might leak in */
    all: unset;
    display: block;

    /* desired heading recipe */
    font-family: var(--font-heading-family, var(--font-sans)) !important;
    font-weight: 700 !important;
    letter-spacing: -0.01em !important;
    line-height: 1.15 !important;
    font-size: clamp(24px, 3vw + 8px, 32px) !important;
    color: var(--heading-color, #111827) !important;
    margin: 0 0 8px !important;

    /* Inter variable font hygiene */
    font-optical-sizing: auto !important;
    font-synthesis-weight: none !important;
    font-variation-settings: "wght" 700 !important;
    text-transform: none !important;
  }
</style>

<script>
(function(){
  var root = document.getElementById("chpc-{{ section.id }}");
  if(!root){ return; }

  var track   = root.querySelector("[data-track]");
  var tabs    = root.querySelector("[data-tabs]");
  var tablist = root.querySelector("[data-tablist]");
  var btnPrev = root.querySelector("[data-tab-prev]");
  var btnNext = root.querySelector("[data-tab-next]");

  function setActiveTab(btn){
    tablist.querySelectorAll(".chpc__tab").forEach(function(b){
      var active = (b === btn);
      b.classList.toggle("is-active", active);
      b.setAttribute("aria-selected", active ? "true" : "false");
    });
  }

  function loadTab(blockId){
    var tpl = document.getElementById("tpl-" + blockId);
    if(!tpl){ console.warn("[chpc] Missing template for", blockId); return; }
    track.innerHTML = tpl.innerHTML;
    rebuildPager();
  }

  function hasOverflow(el){ return el && el.scrollWidth > el.clientWidth + 1; }

  function updateTabOverflow(){
    if(!tabs || !tablist) return;
    var overflow = hasOverflow(tablist);
    tabs.setAttribute("data-overflow", overflow ? "true" : "false");
    var max = Math.max(0, tablist.scrollWidth - tablist.clientWidth);
    var L = Math.max(0, Math.min(tablist.scrollLeft, max));
    if(btnPrev){ btnPrev.classList.toggle("is-disabled", L <= 1); }
    if(btnNext){ btnNext.classList.toggle("is-disabled", L >= max - 1); }
  }

  function smoothScrollBy(el, delta){
    try{ el.scrollBy({ left: delta, behavior: "smooth" }); }
    catch(e){
      var start = el.scrollLeft, to = start + delta, t0 = performance.now(), dur = 280;
      function step(t){ var k = Math.min(1, (t - t0) / dur); var e = 1 - Math.pow(1 - k, 3);
        el.scrollLeft = start + (to - start) * e; if(k < 1) requestAnimationFrame(step); }
      requestAnimationFrame(step);
    }
  }
  function tabScrollStep(){ return Math.round(Math.max(120, tablist.clientWidth * 0.7)); }

  if(tabs){
    tabs.addEventListener("click", function(e){
      var t = e.target.closest(".chpc__tab"); if(!t) return;
      setActiveTab(t);
      loadTab(t.getAttribute("data-tab"));
    });
    if(btnPrev) btnPrev.addEventListener("click", function(){ smoothScrollBy(tablist, -tabScrollStep()); });
    if(btnNext) btnNext.addEventListener("click", function(){ smoothScrollBy(tablist, tabScrollStep()); });
    if(tablist){
      tablist.addEventListener("scroll", updateTabOverflow, { passive:true });
      window.addEventListener("resize", updateTabOverflow);
      window.addEventListener("orientationchange", function(){ setTimeout(updateTabOverflow, 250); });
      [0, 60, 240].forEach(function(ms){ setTimeout(updateTabOverflow, ms); });
    }
  }

  var btnPrevPg = root.querySelector(".chpc__arrow--prev");
  var btnNextPg = root.querySelector(".chpc__arrow--next");
  var currentPage = 0;
  var anchors = [];
  var EPS = 2;

  function isMobile(){ return window.innerWidth < 740; }
  function pages(){ return Array.prototype.slice.call(track.querySelectorAll(".chpc__page")); }
  function slides(){ return Array.prototype.slice.call(track.querySelectorAll(".chpc__slide")); }

  function groupMobilePages(){
    var grouped = pages();
    if(grouped.length){
      var frag0 = document.createDocumentFragment();
      grouped.forEach(function(p){ Array.prototype.slice.call(p.children).forEach(function(ch){ frag0.appendChild(ch); }); });
      track.innerHTML = ""; track.appendChild(frag0);
    }
    if(isMobile()){
      var cards = slides();
      var frag = document.createDocumentFragment();
      for(var i=0;i<cards.length;i+=2){
        var page = document.createElement("div"); page.className = "chpc__page";
        if(cards[i]) page.appendChild(cards[i]);
        if(cards[i+1]) page.appendChild(cards[i+1]);
        frag.appendChild(page);
      }
      track.innerHTML = ""; track.appendChild(frag);
    }
  }

  function buildAnchors(){
    anchors = [];
    if(isMobile()){
      pages().forEach(function(p){ anchors.push(Math.round(p.offsetLeft)); });
    } else {
      var per = parseInt(root.dataset.perDesktop || "5", 10);
      if(window.innerWidth >= 740 && window.innerWidth < 1100){ per = parseInt(root.dataset.perTablet || "3", 10); }
      if(window.innerWidth < 740){ per = parseInt(root.dataset.perMobile || "4", 10); }
      var list = slides();
      for(var i=0;i<list.length;i+=per){ anchors.push(Math.round(list[i].offsetLeft)); }
      var maxScroll = Math.max(0, Math.round(track.scrollWidth - track.clientWidth));
      if(!anchors.length || Math.abs(anchors[anchors.length-1]-maxScroll) > EPS){ anchors.push(maxScroll); }
    }
    if(!anchors.length){ anchors = [0]; }
  }

  function nearestIndex(L){
    var idx = 0, min = Infinity;
    for(var i=0;i<anchors.length;i++){
      var d = Math.abs(anchors[i]-L);
      if(d < min){ min = d; idx = i; }
    }
    return idx;
  }

  function updatePgArrows(){
    if(!btnPrevPg || !btnNextPg) return;
    var n = anchors.length;
    btnPrevPg.disabled = currentPage <= 0;
    btnNextPg.disabled = currentPage >= n-1;
  }

  function scrollToPage(idx, smooth){
    if(idx < 0) idx = 0;
    if(idx > anchors.length - 1) idx = anchors.length - 1;
    currentPage = idx;
    track.scrollTo({ left: anchors[idx] || 0, behavior: smooth ? "smooth" : "auto" });
    updatePgArrows();
  }

  function rebuildPager(){
    groupMobilePages();
    buildAnchors();
    currentPage = Math.min(currentPage, anchors.length-1);
    updatePgArrows();
  }

  if(btnPrevPg) btnPrevPg.addEventListener("click", function(){ scrollToPage(currentPage - 1, true); });
  if(btnNextPg) btnNextPg.addEventListener("click", function(){ scrollToPage(currentPage + 1, true); });
  track.addEventListener("scroll", function(){ currentPage = nearestIndex(Math.round(track.scrollLeft)); updatePgArrows(); }, { passive:true });
  window.addEventListener("resize", function(){ rebuildPager(); updateTabOverflow(); });

  rebuildPager();
  updateTabOverflow();
})();
</script>
</section>

{% schema %}
{
  "name": "productcarousel",
  "class": "section",
  "settings": [
    { "type": "range", "id": "padding_top", "label": "Padding top", "min": 0, "max": 120, "step": 4, "default": 12 },
    { "type": "range", "id": "padding_bottom", "label": "Padding bottom", "min": 0, "max": 120, "step": 4, "default": 16 },

    { "type": "text", "id": "heading", "label": "Heading", "default": "Featured Products" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "Shop Camerahaus’ trending picks" },

    { "type": "range", "id": "max_items", "label": "Max items", "min": 4, "max": 24, "step": 1, "default": 12 },

    { "type": "range", "id": "items_per_view_desktop", "label": "Items per view (desktop)", "min": 3, "max": 5, "step": 1, "default": 5 },
    { "type": "range", "id": "items_per_view_tablet",  "label": "Items per view (tablet)",  "min": 2, "max": 4, "step": 1, "default": 3 },
    { "type": "range", "id": "items_per_view_mobile",  "label": "Items per view (mobile)",  "min": 1, "max": 6, "step": 1, "default": 4 },

    { "type": "checkbox", "id": "enable_loop", "label": "Loop pages", "default": false },
    { "type": "checkbox", "id": "enable_autoplay", "label": "Autoplay", "default": false },
    { "type": "range", "id": "autoplay_ms", "label": "Autoplay interval (ms)", "min": 3000, "max": 9000, "step": 500, "default": 5000 },

    { "type": "checkbox", "id": "show_arrows", "label": "Show arrows (desktop/tablet)", "default": true },
    { "type": "checkbox", "id": "show_dots", "label": "Show pagination dots", "default": true },

    { "type": "select", "id": "card_ratio", "label": "Card image ratio", "default": "square", "options": [
      { "value": "square", "label": "1:1 (Square)" },
      { "value": "4:3", "label": "4:3" },
      { "value": "3:4", "label": "3:4" }
    ]},
    { "type": "select", "id": "image_fit", "label": "Image fit", "default": "contain", "options": [
      { "value": "contain", "label": "Contain (recommended)" },
      { "value": "cover",   "label": "Cover" }
    ]},

    { "type": "range", "id": "mobile_bleed_px", "label": "Mobile bleed (px)", "min": 0, "max": 48, "step": 1, "default": 0 },
    { "type": "checkbox", "id": "mobile_full_bleed", "label": "Force 100vw full-bleed on mobile", "default": false },
    { "type": "range", "id": "mobile_side_gutter", "label": "Mobile side gutter (px)", "min": 8, "max": 24, "step": 2, "default": 16 },
