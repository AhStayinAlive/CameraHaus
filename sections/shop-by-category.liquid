{% comment %} 
Home — Shop by Category (Camerahaus)
Dawn OS 2.0 · Liquid/HTML/CSS/vanilla JS only
This version removes the full-bleed grid. The grid is now contained
inside the theme’s .page-width like the header above.
{% endcomment %}

<section id="homecats-{{ section.id }}" class="homecats" aria-labelledby="homecats-heading-{{ section.id }}">
  <div class="homecats__inner page-width">
    <header class="homecats__head">
      <h2 id="homecats-heading-{{ section.id }}" class="homecats__title">
        {{ section.settings.heading | default: 'Shop by Category' }}
      </h2>
      {%- if section.settings.subheading != blank -%}
        <p class="homecats__sub">{{ section.settings.subheading }}</p>
      {%- endif -%}
    </header>
  </div>

  <div class="homecats__grid-wrap page-width">
    <div class="homecats__grid" role="list">
      {%- for block in section.blocks -%}
        {%- assign t = block.settings -%}
        {%- assign img = t.image -%}

        <a role="listitem"
           class="hc-card"
           id="hc-card-{{ block.id }}"
           href="{{ t.link | default: '#' }}"
           aria-label="Shop {{ t.title }}"
           data-title="{{ t.title | escape }}"
           data-pos="{{ forloop.index }}"
           onclick="window.dataLayer=window.dataLayer||[];dataLayer.push({event:'category_click',section:'home_shop_by_category',category:'{{ t.title | escape }}',position:{{ forloop.index }}});"
           {{ block.shopify_attributes }}>

          {%- if img != blank -%}
            {{ img
              | image_url: width: 1600
              | image_tag:
                loading: 'lazy',
                widths: '480,720,960,1200,1600',
                sizes: '(max-width: 749px) 50vw, (max-width: 989px) 33vw, 25vw',
                alt: t.title
            }}
          {%- else -%}
            {{ 'image' | placeholder_svg_tag: 'hc-card__ph' }}
          {%- endif -%}

          <span class="hc-card__overlay" aria-hidden="true"></span>

          <span class="hc-card__label">
            {{ t.title | escape }}
          </span>

          {%- assign show_chips = section.settings.show_chips -%}
          {%- assign has_chips = false -%}
          {%- if t.chip1 != blank or t.chip2 != blank or t.chip3 != blank -%}
            {%- assign has_chips = true -%}
          {%- endif -%}
          {%- if show_chips and has_chips -%}
            <span class="hc-card__chips" aria-label="Popular links">
              {%- if t.chip1 != blank -%}
                {%- if t.chip1_url != blank -%}
                  <span class="hc-chip"><a href="{{ t.chip1_url }}">{{ t.chip1 }}</a></span>
                {%- else -%}
                  <span class="hc-chip"><span>{{ t.chip1 }}</span></span>
                {%- endif -%}
              {%- endif -%}
              {%- if t.chip2 != blank -%}
                {%- if t.chip2_url != blank -%}
                  <span class="hc-chip"><a href="{{ t.chip2_url }}">{{ t.chip2 }}</a></span>
                {%- else -%}
                  <span class="hc-chip"><span>{{ t.chip2 }}</span></span>
                {%- endif -%}
              {%- endif -%}
              {%- if t.chip3 != blank -%}
                {%- if t.chip3_url != blank -%}
                  <span class="hc-chip"><a href="{{ t.chip3_url }}">{{ t.chip3 }}</a></span>
                {%- else -%}
                  <span class="hc-chip"><span>{{ t.chip3 }}</span></span>
                {%- endif -%}
              {%- endif -%}
            </span>
          {%- endif -%}

          {%- if section.settings.show_cta -%}
            <span class="hc-card__cta" aria-hidden="true">Shop now →</span>
          {%- endif -%}
        </a>
      {%- endfor -%}
    </div>
  </div>

  {%- if section.settings.view_all_url != blank -%}
    <div class="homecats__cta">
      <a class="button button--primary" href="{{ section.settings.view_all_url }}">
        {{ section.settings.view_all_text | default: 'View all categories' }}
      </a>
    </div>
  {%- endif -%}

  <style>
    #homecats-{{ section.id }}{
      /* Layout + Branding tokens */
      --cols-d: {{ section.settings.columns_desktop | default: 3 }};
      --cols-m: {{ section.settings.columns_mobile | default: 2 }};
      --gap: 16px;
      --radius: 16px;
      --ratio: {% if section.settings.aspect_ratio == '1x1' %}1/1{% else %}4/3{% endif %};
      --brand: {{ section.settings.brand_color | default: '#E31E24' }};
      --brand-20: color-mix(in srgb, {{ section.settings.brand_color | default: '#E31E24' }} 20%, transparent);
      --text-50: var(--color-foreground-50, #6b7280);
    }

    /* Section spacing */
    #homecats-{{ section.id }} .homecats__inner{padding-block: clamp(16px, 3vw, 28px)}
    #homecats-{{ section.id }} .homecats__head{margin-bottom: clamp(12px, 2.5vw, 20px)}
    #homecats-{{ section.id }} .homecats__title{font-size:clamp(20px,3.2vw,28px);line-height:1.1;margin:0;text-wrap:balance}
    #homecats-{{ section.id }} .homecats__sub{color:var(--text-50);margin:.5rem 0 0}

    /* Contained grid (no full-bleed) */
    #homecats-{{ section.id }} .homecats__grid-wrap{padding-inline:0}
    #homecats-{{ section.id }} .homecats__grid{
      display:grid;
      gap: var(--gap);
      grid-template-columns: repeat(var(--cols-m), minmax(0,1fr));
    }
    @media (min-width: 990px){
      #homecats-{{ section.id }}{--gap: 20px}
      #homecats-{{ section.id }} .homecats__grid{grid-template-columns: repeat(var(--cols-d), minmax(0,1fr))}
    }

    /* Card */
    #homecats-{{ section.id }} .hc-card{
      position:relative;display:block;overflow:hidden;border-radius:var(--radius);
      aspect-ratio: var(--ratio); -webkit-tap-highlight-color:transparent;
      box-shadow: 0 1px 0 rgba(0,0,0,.06), 0 12px 24px -18px rgba(0,0,0,.35);
      background:#0b0b0b;
    }
    #homecats-{{ section.id }} .hc-card img{
      width:100%;height:100%;object-fit:cover;transform:scale(1.02);
      transition:transform .25s ease;
    }

    /* Camerahaus-ish overlay */
    #homecats-{{ section.id }} .hc-card__overlay{
      position:absolute;inset:0;pointer-events:none;
      background:
        linear-gradient(to top, rgba(0,0,0,.62) 0%, rgba(0,0,0,.28) 48%, rgba(0,0,0,0) 72%),
        radial-gradient(120% 60% at 80% 100%, var(--brand-20), transparent 60%);
    }

    #homecats-{{ section.id }} .hc-card__label{
      position:absolute;left:14px;right:14px;bottom:46px;color:#fff;font-weight:800;
      font-size:clamp(15px,2.3vw,20px);line-height:1.12;
      display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;
      text-shadow:0 1px 2px rgba(0,0,0,.35);
      letter-spacing:.1px;
    }

    #homecats-{{ section.id }} .hc-card__chips{
      position:absolute;left:12px;right:12px;bottom:10px;display:flex;gap:8px;flex-wrap:wrap
    }
    #homecats-{{ section.id }} .hc-chip{
      border:1px solid rgba(255,255,255,.28);
      background: rgba(17,17,17,.32);
      color:#fff;border-radius:999px;padding:6px 10px;font-size:12px;line-height:1;
      backdrop-filter:saturate(140%) blur(2px)
    }
    #homecats-{{ section.id }} .hc-chip a{color:inherit;text-decoration:none}
    #homecats-{{ section.id }} .hc-card__cta{
      position:absolute;right:12px;bottom:12px;color:#fff;opacity:.0;transition:opacity .2s
    }

    /* Interactions */
    #homecats-{{ section.id }} .hc-card:focus-visible{
      outline:3px solid {{ section.settings.brand_color | default: '#E31E24' }}; outline-offset:3px; border-radius:calc(var(--radius) + 2px);
    }
    @media (hover:hover){
      #homecats-{{ section.id }} .hc-card:hover img{transform:scale(1.06)}
      #homecats-{{ section.id }} .hc-card:hover .hc-card__cta{opacity:.95}
      #homecats-{{ section.id }} .hc-chip:hover{border-color: {{ section.settings.brand_color | default: '#E31E24' }}; box-shadow:0 0 0 2px color-mix(in srgb, {{ section.settings.brand_color | default: '#E31E24' }} 35%, transparent) inset}
    }
    @media (prefers-reduced-motion: reduce){
      #homecats-{{ section.id }} .hc-card img{transition:none}
    }

    /* View-all */
    #homecats-{{ section.id }} .homecats__cta{margin:clamp(12px,2.8vw,22px) auto 0;text-align:center}
    #homecats-{{ section.id }} .homecats__cta .button--primary{
      --alpha-button-background: 1;
      background: {{ section.settings.brand_color | default: '#E31E24' }};
      border-color: {{ section.settings.brand_color | default: '#E31E24' }};
    }
  </style>
</section>

{% schema %}
{
  "name": "Home — Shop by Category",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Shop by Category" },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "Explore our most popular categories." },

    { "type": "checkbox", "id": "full_bleed", "label": "Full-bleed grid (edge-to-edge)", "default": false },

    { "type": "color", "id": "brand_color", "label": "Brand color", "default": "#E31E24" },

    { "type": "select", "id": "columns_mobile", "label": "Columns (mobile)", "default": "2", "options": [
      { "value": "1", "label": "1" },
      { "value": "2", "label": "2" }
    ]},

    { "type": "range", "id": "columns_desktop", "min": 2, "max": 4, "step": 1, "label": "Columns (desktop)", "default": 3 },

    { "type": "select", "id": "aspect_ratio", "label": "Tile aspect ratio", "default": "4x3", "options": [
      { "value": "4x3", "label": "4 : 3" },
      { "value": "1x1", "label": "1 : 1" }
    ]},

    { "type": "checkbox", "id": "show_chips", "label": "Show sub-category chips", "default": true },
    { "type": "checkbox", "id": "show_cta", "label": "Show \"Shop now →\" hover hint", "default": true },

    { "type": "text", "id": "view_all_text", "label": "View-all button text", "default": "View all categories" },
    { "type": "url", "id": "view_all_url", "label": "View-all link" }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Mirrorless & DSLR" },
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "url", "id": "link", "label": "Link" },

        { "type": "text", "id": "chip1", "label": "Chip 1 (e.g., Mirrorless)" },
        { "type": "url", "id": "chip1_url", "label": "Chip 1 link" },

        { "type": "text", "id": "chip2", "label": "Chip 2 (e.g., DSLR)" },
        { "type": "url", "id": "chip2_url", "label": "Chip 2 link" },

        { "type": "text", "id": "chip3", "label": "Chip 3 (e.g., Lenses)" },
        { "type": "url", "id": "chip3_url", "label": "Chip 3 link" }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    {
      "name": "Home — Shop by Category (Camerahaus)",
      "blocks": [
        { "type": "category", "settings": { "title": "Mirrorless & DSLR" } },
        { "type": "category", "settings": { "title": "Compact Cameras" } },
        { "type": "category", "settings": { "title": "Action & 360 Cameras" } },
        { "type": "category", "settings": { "title": "Drones" } },
        { "type": "category", "settings": { "title": "Lenses" } },
        { "type": "category", "settings": { "title": "Accessories" } }
      ]
    }
  ]
}
{% endschema %}
