  box-shadow: 0 18px 40px rgba(17,17,17,.12);
  overflow: hidden;
  opacity: 0;
  pointer-events: none;
  transform: translateY(-4px);
  transition: opacity .12s ease, transform .12s ease;
  max-height: 270px;
}
