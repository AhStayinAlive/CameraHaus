}
.ch-optionbar__list {
  list-style: none;
  margin: 0;
  padding: 6px 0;
  max-height: 270px;
  overflow-y: auto;
}
.ch-optionbar__item {
  padding: 9px 14px 9px 36px;
  position: relative;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10px;
  cursor: pointer;
  transition: background .12s ease;
}
.ch-optionbar__item:hover {
  background: #f9fafb;
}
.ch-optionbar__item.is-active {
  background: #fff1f0;
  color: var(--ch-red);
  font-weight: 500;
}
.ch-optionbar__item.is-active::before {
  content: "";
  position: absolute;
  left: 12px;
  top: 7px;
  bottom: 7px;
  width: 3px;
  border-radius: 16px;
  background: var(--ch-red);
}
.ch-vp-line {
  display: flex;
  flex-direction: column;
  gap: 2px;
}
.ch-vp-name { font-size: .8rem; }
.ch-vp-price { font-size: .75rem; color: #6b7280; }
.ch-optionbar__item.is-disabled {
  opacity: .5;
  background: #fafafa;
  cursor: not-allowed;
}
.ch-vp-badge { font-size: .65rem; color: #b91c1c; }

.ch-cta-row{
  display:grid;
  grid-template-columns:140px minmax(0,1fr);
  gap:14px;
  align-items:center;
  margin-top:.7rem;
  position:relative;
  z-index:25;
}

.ch-qty{
  display:flex;
  align-items:center;
  border:1px solid #1f2937;
  border-radius:9999px;
  overflow:hidden;
  height:42px;
  background:#fff;
  flex:0 0 140px;
}
.ch-qty__btn{
  width:44px;
  flex:0 0 44px;
  background:transparent;
  border:0;
  font-size:22px;
  font-weight:700;
  cursor:pointer;
  display:flex;
  align-items:center;
  justify-content:center;
  line-height:0;
}
.ch-qty__input{
  flex:1 1 auto;
  min-width:42px;
  border:0;
  text-align:center;
  font-weight:600;
  background:#fff;
  font-size:.9rem;
  height:42px;
  line-height:42px;
}
.ch-qty__input::-webkit-outer-spin-button,
.ch-qty__input::-webkit-inner-spin-button{ -webkit-appearance:none; margin:0; }

.ch-atc-btn{
  height:42px;
