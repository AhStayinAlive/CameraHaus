.ch-media-nav{
  position:absolute;top:50%;transform:translateY(-50%);width:34px;height:34px;border-radius:999px;
  border:1px solid rgba(0,0,0,.08);background:rgba(255,255,255,.7);display:grid;place-items:center;cursor:pointer;
  transition:background .12s ease, box-shadow .12s ease;z-index:5;
}
.ch-media-nav--prev{left:12px;}
.ch-media-nav--next{right:12px;}
.ch-media-nav:hover{background:#fff; box-shadow:0 6px 18px rgba(17,17,17,.08);}
.ch-media-thumbs{display:flex;gap:10px;flex-wrap:wrap}
.ch-media-thumb{background:#fff;border:1px solid #efefef;border-radius:6px;padding:3px;cursor:pointer}
