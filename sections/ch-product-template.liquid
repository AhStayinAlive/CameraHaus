  .ch-info-col{position:sticky;top:78px;}
}
.ch-vendor{margin:0;font-size:.8rem;color:#9CA3AF;text-transform:capitalize;letter-spacing:.02em;}
.ch-title{margin:0;font-size:1.85rem;line-height:1.04;font-weight:600;color:var(--ch-text);}
.ch-price-block{margin:.25rem 0 .15rem;display:flex;flex-direction:column;gap:.25rem;}
.ch-price-line{display:flex;align-items:baseline;gap:.7rem;flex-wrap:wrap;}
.ch-price{color:var(--ch-red);font-weight:700;font-size:1.5rem;}
.ch-price--compare-top{color:#9ca3af;text-decoration:line-through;font-size:1.02rem;}
.ch-price-save{color:#B42318;font-weight:600;font-size:.78rem;opacity:.85;}

/* description under price */
.ch-topdesc{
  margin-top:.4rem;
  margin-bottom:.45rem;
  font-size:.9rem;
  line-height:1.4;
  color:#6B7280;
  max-width:38rem;
}

.ch-rating-row{display:flex;align-items:center;gap:.6rem;color:#6B7280;}
.ch-rating-row--muted{font-size:.7rem;opacity:.55;margin-top:.15rem;}
.ch-stars-outline{display:inline-flex;gap:2px;}
.ch-stars-outline span{font-size:.9rem;color:transparent;-webkit-text-stroke:1px var(--ch-red);text-stroke:1px var(--ch-red);}

/* OPTIONBAR – show on mobile too */
.ch-optionbar {
  position: relative;
  margin-top: .4rem;
  margin-bottom: .35rem;
  z-index: 40;
}
.ch-optionbar__btn {
  width: 100%;
  background: #fff;
