  cursor: progress;
}
.ch-atc-btn.is-loading .ch-atc-label {
  opacity: 0;
}

/* spinner element */
.ch-atc-spinner{
  position:absolute;
  inset:0;
  margin:auto;
  width:16px;
  height:16px;
  border-radius:999px;
  border:2px solid rgba(255,255,255,.4);
  border-top-color:#fff;
  animation:ch-spin .7s linear infinite;
  pointer-events:none;
  opacity:0;
  transition:opacity .1s ease;
}
.ch-atc-btn.is-loading .ch-atc-spinner{
  opacity:1;
}



.ch-atc-btn.is-added{animation:ch-pulse .6s ease;}


/* TRUST CARD */
.ch-trust-card{
  margin-top:.5rem;
  background:#fff;
  border:1px solid rgba(15,23,42,.03);
  border-radius:18px;
  box-shadow:0 6px 28px rgba(15,23,42,.02);
  overflow:hidden;
}
.ch-trust-head{
  display:flex;
  align-items:center;
  justify-content:space-between;
  padding:.5rem .75rem .4rem .75rem;
  gap:12px;
}
.ch-trust-title{margin:0;font-weight:600;font-size:.9rem;color:#0f172a;}
.ch-trust-toggle{
  display:inline-flex;
  align-items:center;
  gap:6px;
  background:#fff;
  border:1px solid rgba(148,163,184,.6);
  border-radius:999px;
  padding:3px 14px 3px 15px;
  font-size:.72rem;
  color:#0f172a;
  cursor:pointer;
}
.ch-trust-toggle__ico{
  display:inline-block;
  font-size:.6rem;
  color:#94a3b8;
  line-height:1;
}
.ch-trust-body{
  overflow:hidden;
  transition:max-height .18s ease;
}
.ch-trust{
  display:flex;
  flex-direction:column;
  gap:.35rem;
  padding:0 .75rem .65rem .75rem;
}
.ch-trust__item{
  display:flex;
  gap:.55rem;
  align-items:flex-start;
}
.ch-trust__icon{
  width:24px;height:24px;border-radius:999px;background:rgba(209,47,36,.06);display:grid;place-items:center;color:var(--ch-red);flex:0 0 24px;
}
.ch-trust__title{margin:0;font-weight:600;font-size:.77rem;color:#0f172a;}
.ch-trust__sub{margin:2px 0 0;font-size:.66rem;color:#94A3B8;}
.ch-trust__item--link .ch-trust__title{color:var(--ch-red);}

/* ZOOM – desktop only */
.ch-media-zoom-fixed{
  position:absolute;
  top:-6px;
  right:-8px;
  left:-8px;
  bottom:210px;
  background:#fff;
  background-size:170% auto;
  background-repeat:no-repeat;
  background-position:center;
  border-radius:26px;
  box-shadow:0 18px 40px rgba(17,17,17,.14);
  opacity:0;
  transform:translateY(14px);
  transition:opacity .14s ease, transform .14s ease;
  pointer-events:none;
  z-index:120;
  display:none;
}
@media (hover:hover) and (min-width: 992px){
  .ch-media-zoom-fixed{display:block;}
  .ch-media-zoom-fixed.is-show{
    opacity:1;
    transform:translateY(0);
  }
}

/* MOBILE */
@media (max-width: 991px){
  .ch-media-main{min-height:380px;}
  .ch-pdp .ch-pdp-grid{grid-template-columns:1fr;}
  .ch-info-col{position:static;}

  .ch-optionbar{display:block;}
  .ch-trust-card{margin-top:.45rem;}
  .ch-media-zoom-fixed{display:none !important;}
}
@media (max-width: 749px){
  .ch-cta-row{
    display:grid;
    grid-template-columns: 1fr;
    grid-template-areas:
      "qty"
      "atc";
    row-gap: 10px;
    align-items:center;
  }

  .ch-qty{
    grid-area: qty;
    width: 100%;
    max-width: none;
  }

  .ch-atc-btn{
    grid-area: atc;
    width: 100%;
  }
}

/* very small screens */
@media (max-width: 520px){
  .ch-media-main{min-height:340px;}
}
/* Make the CTA row its own stacking context */
.ch-cta-row{
  isolation: isolate;
  z-index: 25;
}

/* Ensure qty is always “above” the ATC in case of any overlap */
.ch-qty{
  position: relative;
  z-index: 2;
}

.ch-atc-btn{
  position: relative;
  z-index: 1;
}

/* Slightly more breathing room for the qty on tablet-ish widths */
@media (min-width: 750px) and (max-width: 1024px){
  .ch-cta-row{
    grid-template-columns: 160px minmax(0,1fr);
  }
}

/* Optional: better tap behavior for +/- buttons on mobile */
.ch-qty__btn{
  touch-action: manipulation;
  user-select: none;
  -webkit-user-select: none;
}

/* spacing tweaks */
:root { --cta-gap: 10px; }
.ch-cta-row{ column-gap: var(--cta-gap); }
@media (min-width: 901px){
  .ch-tabs{
    padding-top:0px;
    padding-bottom:0px;
  }

  .ch-pdp{
    padding-top:1rem;
  }
}
/* Kill the random 46px padding on the mobile drawer ONLY on PDP */
body.template-product #ch-menu-drawer .ch-mdrawer__panel{
  padding-top: 0 !important;
  margin-top: 0 !important;
}

