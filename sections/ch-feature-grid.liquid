{% comment %}
  CameraHaus Feature Grid (mobile 2-up + mobile text overrides)
{% endcomment %}

<section class="ch-feature-grid-section" id="section-{{ section.id }}">
  <div class="ch-feature-grid-wrapper">
    {% if section.settings.heading != blank %}
      <h2 class="ch-grid-heading">{{ section.settings.heading }}</h2>
    {% endif %}

    <div
      class="ch-feature-grid"
      style="
        --ch-cols: {{ section.settings.columns_desktop }};
        --ch-gap: {{ section.settings.gap | times: 0.1 }}rem;
        --ch-radius: {{ section.settings.corner_radius }}px;
        --ch-hover: {{ section.settings.hover_color }};
        --ch-bg: {{ section.settings.base_bg }};
        --ch-text: {{ section.settings.base_text }};
      "
    >
      {% for block in section.blocks %}
        {% assign style = block.settings.card_style | default: 'mosaic' %}
        {% assign card_classes = 'ch-card' %}
        {% if block.settings.image != blank %}{% assign has_image = true %}{% else %}{% assign has_image = false %}{% endif %}
        {% if style == 'service' %}
          {% assign card_classes = card_classes | append: ' ch-card--service' %}
        {% elsif has_image %}
          {% assign card_classes = card_classes | append: ' ch-card--image' %}
        {% else %}
          {% assign card_classes = card_classes | append: ' ch-card--text' %}
        {% endif %}
        {% if section.settings.enable_shadow %}{% assign card_classes = card_classes | append: ' ch-card--shadow' %}{% endif %}

        {% assign col = block.settings.col_span | default: 1 %}
        {% assign row = block.settings.row_span | default: 1 %}

        {% capture card_link_start %}
          {% if block.settings.link != blank %}
            <a href="{{ block.settings.link }}" class="ch-card__link" aria-label="{{ block.settings.title | escape }}">
          {% else %}
            <div class="ch-card__link" role="group" aria-label="{{ block.settings.title | escape }}">
          {% endif %}
        {% endcapture %}
        {% capture card_link_end %}{% if block.settings.link != blank %}</a>{% else %}</div>{% endif %}{% endcapture %}

        <div class="{{ card_classes }} ch-span-{{ col }}"
             style="grid-column: span {{ col }}; grid-row: span {{ row }};"
             {{ block.shopify_attributes }}>
          {{ card_link_start }}

            {% if has_image %}
              <div class="ch-card__media {% if style == 'mosaic' %}ch-ratio ch-ratio--{{ section.settings.card_ratio }}{% endif %}">
                {% assign img = block.settings.image %}
                <img src="{{ img | image_url: width: 1200 }}"
                     alt="{{ block.settings.image_alt | default: block.settings.title | escape }}"
                     loading="lazy" class="ch-card__img" width="{{ img.width }}" height="{{ img.height }}">
                <span class="ch-card__tint" aria-hidden="true"></span>
              </div>
            {% endif %}

            <div class="ch-card__content ch-content--{{ block.settings.align }}">
              {% if block.settings.icon_name != blank %}
                <div class="ch-card__icon">{% render 'ch-icon', name: block.settings.icon_name, size: 40 %}</div>
              {% endif %}

              {%- comment -%} Kicker (mobile override/hide) {%- endcomment -%}
              {% if block.settings.mobile_kicker != blank %}
                <p class="ch-card__kicker only-mobile">{{ block.settings.mobile_kicker }}</p>
                {% if block.settings.hide_kicker_on_mobile != true %}
                  <p class="ch-card__kicker only-desktop">{{ block.settings.kicker }}</p>
                {% endif %}
              {% else %}
                <p class="ch-card__kicker {% if block.settings.hide_kicker_on_mobile %}only-desktop{% endif %}">
                  {{ block.settings.kicker }}
                </p>
              {% endif %}

              {%- comment -%} Title (mobile override) {%- endcomment -%}
              {% if block.settings.mobile_title != blank %}
                <h3 class="ch-card__title only-mobile">{{ block.settings.mobile_title }}</h3>
                <h3 class="ch-card__title only-desktop">{{ block.settings.title }}</h3>
              {% else %}
                <h3 class="ch-card__title">{{ block.settings.title }}</h3>
              {% endif %}

              {%- comment -%} Big number (hide on mobile if toggled) {%- endcomment -%}
              {% if block.settings.big_text != blank %}
                <div class="ch-card__big {% if block.settings.hide_big_on_mobile %}only-desktop{% endif %}">
                  {{ block.settings.big_text }}
                </div>
              {% endif %}

              {%- comment -%} Subtitle (mobile override/hide) {%- endcomment -%}
              {% if block.settings.mobile_subtitle != blank %}
                <p class="ch-card__subtitle only-mobile">{{ block.settings.mobile_subtitle }}</p>
                {% unless block.settings.hide_subtitle_on_mobile %}
                  <p class="ch-card__subtitle only-desktop">{{ block.settings.subtitle }}</p>
                {% endunless %}
              {% else %}
                <p class="ch-card__subtitle {% if block.settings.hide_subtitle_on_mobile %}only-desktop{% endif %}">
                  {{ block.settings.subtitle }}
                </p>
              {% endif %}

              {% if block.settings.description != blank %}
                <div class="ch-card__desc rte {% if block.settings.hide_desc_on_mobile %}only-desktop{% endif %}">
                  {{ block.settings.description }}
                </div>
              {% endif %}

              {% if block.settings.cta_label != blank and block.settings.link != blank %}
                <span class="ch-card__cta">{{ block.settings.cta_label }}</span>
              {% endif %}
            </div>

          {{ card_link_end }}
        </div>
      {% endfor %}
    </div>
  </div>
</section>

<style>
  /* Wrapper */
  #section-{{ section.id }} .ch-feature-grid-wrapper{ max-width: {{ section.settings.max_width }}px; margin:0 auto; padding: clamp(16px,2.5vw,32px); }
#section-{{ section.id }} .ch-grid-heading{
  margin:0;
  font-weight:700;
  letter-spacing:-.01em;
  line-height:1.15;
  font-size:clamp(24px, 3vw + 8px, 32px);
  color: var(--heading-color, var(--ch-text));
}

  /* Grid */
  #section-{{ section.id }} .ch-feature-grid{ display:grid; grid-template-columns:repeat(var(--ch-cols),minmax(0,1fr)); gap:var(--ch-gap); }
  @media (max-width: 990px){ #section-{{ section.id }} .ch-feature-grid{ grid-template-columns:repeat(2,1fr); } }

  /* Mobile = 2-up grid (DJI style). Wide cards take full row. */
  @media (max-width: 768px){
    #section-{{ section.id }} .ch-feature-grid{ grid-template-columns: repeat(2, minmax(0,1fr)); gap:10px; }
    #section-{{ section.id }} .ch-card.ch-span-2,
    #section-{{ section.id }} .ch-card.ch-span-3,
    #section-{{ section.id }} .ch-card.ch-span-4{ grid-column:1 / -1 !important; }
    #section-{{ section.id }} .ch-card{ border-radius:14px; }
    #section-{{ section.id }} .ch-card--image .ch-card__content{ padding:12px 14px; }
    #section-{{ section.id }} .ch-card--text .ch-card__link{ padding:14px; }
    #section-{{ section.id }} .ch-card__icon svg{ width:28px; height:28px; }
    #section-{{ section.id }} .ch-card__kicker{ font-size:.72rem; letter-spacing:.05em; }
    #section-{{ section.id }} .ch-card__title{ font-size:1rem; }
    #section-{{ section.id }} .ch-card__subtitle{ font-size:.9rem; }
    #section-{{ section.id }} .ch-card__big{ font-size:1.75rem; }
    #section-{{ section.id }} .ch-card__desc{ display:-webkit-box; -webkit-line-clamp:2; -webkit-box-orient:vertical; overflow:hidden; }
    /* Show/hide helpers */
    #section-{{ section.id }} .only-mobile{ display: initial; }
    #section-{{ section.id }} .only-desktop{ display: none !important; }
  }
  @media (min-width: 769px){
    #section-{{ section.id }} .only-mobile{ display: none !important; }
  }
  /* Ultra-narrow fallback */
  @media (max-width: 360px){ #section-{{ section.id }} .ch-feature-grid{ grid-template-columns:1fr; } }

  /* Card base */
  #section-{{ section.id }} .ch-card{ position:relative; overflow:hidden; border-radius:var(--ch-radius); background:var(--ch-bg); color:var(--ch-text); border:1px solid rgba(0,0,0,.06); transition:transform .25s, box-shadow .25s, background-color .25s, color .25s; }
  #section-{{ section.id }} .ch-card--shadow{ box-shadow:0 8px 24px rgba(0,0,0,.06); }
  #section-{{ section.id }} .ch-card__link{ display:block; height:100%; }

  /* Media */
  #section-{{ section.id }} .ch-card__media{ position:relative; }
  #section-{{ section.id }} .ch-card__img{ width:100%; height:100%; object-fit:cover; display:block; }
  #section-{{ section.id }} .ch-card__tint{ position:absolute; inset:0; background:rgba(0,0,0,.15); pointer-events:none; transition: background .25s, opacity .25s; }

  /* Aspect helpers */
  #section-{{ section.id }} .ch-ratio{ position:relative; } #section-{{ section.id }} .ch-ratio::before{ content:''; display:block; }
  #section-{{ section.id }} .ch-ratio--square::before{ padding-top:100%; } #section-{{ section.id }} .ch-ratio--video::before{ padding-top:56.25%; } #section-{{ section.id }} .ch-ratio--auto::before{ display:none; }

  /* Content */
  #section-{{ section.id }} .ch-card__content{ display:flex; flex-direction:column; gap:.4rem; }
  #section-{{ section.id }} .ch-card--image .ch-card__content{ position:absolute; inset:auto 0 0 0; padding:clamp(14px,2vw,22px); }
  #section-{{ section.id }} .ch-card--text .ch-card__link{ display:flex; align-items:center; gap:clamp(12px,1.6vw,16px); padding:clamp(18px,2vw,22px); width:100%; }
  #section-{{ section.id }} .ch-card--text .ch-card__content{ position:static; padding:0; }
  #section-{{ section.id }} .ch-card--service .ch-card__media .ch-card__tint{ opacity:0; }
  #section-{{ section.id }} .ch-card--service .ch-card__content{ position:static; padding:16px 16px 18px; }
  #section-{{ section.id }} .ch-card--service .ch-card__img{ aspect-ratio:16/9; }

  /* Typography */
  #section-{{ section.id }} .ch-card__icon{ color:#d12f24; }
  #section-{{ section.id }} .ch-card__kicker{ font-size:.8rem; letter-spacing:.06em; text-transform:uppercase; opacity:.85; margin:0; }
  #section-{{ section.id }} .ch-card__title{ margin:0; line-height:1.2; font-weight:700; font-size:clamp(1rem,.9rem + .6vw,1.35rem); }
  #section-{{ section.id }} .ch-card__big{ font-weight:800; line-height:1; font-size:clamp(2rem,1.5rem + 4vw,3.2rem); }
  #section-{{ section.id }} .ch-card__subtitle{ margin:0; opacity:.9; font-size:.98rem; }
  #section-{{ section.id }} .ch-card__desc{ margin-top:.25rem; opacity:.95; }
  #section-{{ section.id }} .ch-card__cta{ margin-top:.35rem; font-weight:600; font-size:.92rem; text-decoration:underline; }

  /* Hide Tabler reset rectangles (prevent red square) */
  #section-{{ section.id }} .ch-card__icon svg path[d="M0 0h24v24H0z"]{ stroke:none !important; fill:none !important; }

  /* Hover: everything → white */
  #section-{{ section.id }} .ch-card:hover{ transform:translateY(-2px); box-shadow:0 12px 28px rgba(0,0,0,.10); color:#fff; }
  #section-{{ section.id }} .ch-card:hover .ch-card__icon{ color:#fff; }
  #section-{{ section.id }} .ch-card:hover .ch-card__title,
  #section-{{ section.id }} .ch-card:hover .ch-card__kicker,
  #section-{{ section.id }} .ch-card:hover .ch-card__subtitle,
  #section-{{ section.id }} .ch-card:hover .ch-card__big,
  #section-{{ section.id }} .ch-card:hover .ch-card__cta,
  #section-{{ section.id }} .ch-card:hover .ch-card__desc{ color:#fff !important; opacity:1; }
  #section-{{ section.id }} .ch-card--text:hover,
  #section-{{ section.id }} .ch-card--service:hover{ background:var(--ch-hover); border-color:transparent; }
  #section-{{ section.id }} .ch-card--image:hover .ch-card__tint{ background:var(--ch-hover); opacity:.55; }
  @media (hover:none){
    #section-{{ section.id }} .ch-card--text:hover,
    #section-{{ section.id }} .ch-card--service:hover{ background:var(--ch-bg); color:var(--ch-text); border-color:rgba(0,0,0,.06); }
    #section-{{ section.id }} .ch-card--image:hover .ch-card__tint{ background:rgba(0,0,0,.15); opacity:1; }
  }
</style>

{% schema %}
{
  "name": "CameraHaus Feature Grid",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Why shop with CameraHaus" },
    { "type": "select", "id": "heading_align", "label": "Heading alignment", "default": "left", "options": [
      { "value": "left", "label": "Left" }, { "value": "center", "label": "Center" }
    ]},
    { "type": "range", "id": "max_width", "label": "Max width (px)", "min": 800, "max": 1600, "step": 10, "default": 1200 },

    { "type": "range", "id": "columns_desktop", "label": "Columns (desktop)", "min": 2, "max": 6, "step": 1, "default": 4 },
    { "type": "range", "id": "gap", "label": "Grid gap (px)", "min": 6, "max": 28, "step": 1, "default": 16 },

    { "type": "select", "id": "card_ratio", "label": "Image card ratio (mosaic)", "default": "auto", "options": [
      { "value": "auto", "label": "Auto (use image height)" },
      { "value": "square", "label": "Square 1:1" },
      { "value": "video", "label": "16:9" }
    ]},

    { "type": "checkbox", "id": "enable_shadow", "label": "Soft shadow", "default": true },
    { "type": "range", "id": "corner_radius", "label": "Corner radius", "min": 0, "max": 28, "step": 1, "default": 16 },

    { "type": "color", "id": "hover_color", "label": "Hover brand red", "default": "#d12f24" },
    { "type": "color", "id": "base_bg", "label": "Base background", "default": "#ffffff" },
    { "type": "color", "id": "base_text", "label": "Base text color", "default": "#111111" }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Feature / Service item",
      "settings": [
        { "type": "select", "id": "card_style", "label": "Card style", "default": "mosaic", "options": [
          { "value": "mosaic", "label": "Mosaic (image overlay)" },
          { "value": "service", "label": "Service (image on top, text below)" },
          { "value": "text", "label": "Text-only" }
        ]},
        { "type": "image_picker", "id": "image", "label": "Image (optional)" },

        { "type": "select", "id": "icon_name", "label": "Icon",
          "options": [
            { "value": "camera", "label": "Camera" },
            { "value": "badge-check", "label": "Brand warranty (check)" },
            { "value": "circle-percent", "label": "Discount (circle)" },
            { "value": "boxes", "label": "Accessories (boxes)" },
            { "value": "store", "label": "Store" },
            { "value": "wreath", "label": "Laurel / History" },
            { "value": "pavilion", "label": "Events / Pavilion" },
            { "value": "ticket", "label": "Ticket / Voucher" },
            { "value": "tag", "label": "Discount tag" },
            { "value": "headset", "label": "Headset / Service" },
            { "value": "package-import", "label": "Returns" }
          ],
          "default": "camera"
        },

        { "type": "text", "id": "kicker", "label": "Kicker (desktop)" },
        { "type": "text", "id": "mobile_kicker", "label": "Kicker (mobile override)" },

        { "type": "text", "id": "title", "label": "Title (desktop)", "default": "Feature" },
        { "type": "text", "id": "mobile_title", "label": "Title (mobile override)" },

        { "type": "text", "id": "big_text", "label": "Big number/word" },

        { "type": "text", "id": "subtitle", "label": "Subtitle (desktop)" },
        { "type": "text", "id": "mobile_subtitle", "label": "Subtitle (mobile override)" },

        { "type": "richtext", "id": "description", "label": "Description (service cards)" },
        { "type": "text", "id": "cta_label", "label": "CTA label (optional)" },

        { "type": "checkbox", "id": "hide_big_on_mobile", "label": "Hide big number on mobile", "default": false },
        { "type": "checkbox", "id": "hide_subtitle_on_mobile", "label": "Hide subtitle on mobile", "default": false },
        { "type": "checkbox", "id": "hide_kicker_on_mobile", "label": "Hide kicker on mobile", "default": false },
        { "type": "checkbox", "id": "hide_desc_on_mobile", "label": "Hide description on mobile", "default": false },

        { "type": "url", "id": "link", "label": "Link (optional)" },
        { "type": "text", "id": "image_alt", "label": "Image alt text" },

        { "type": "select", "id": "align", "label": "Content alignment", "default": "left", "options": [
          { "value": "left", "label": "Left" }, { "value": "center", "label": "Center" }
        ]},

        { "type": "range", "id": "col_span", "label": "Grid columns to span", "min": 1, "max": 4, "step": 1, "default": 1 },
        { "type": "range", "id": "row_span", "label": "Grid rows to span", "min": 1, "max": 3, "step": 1, "default": 1 }
      ]
    }
  ],
  "presets": [
    {
      "name": "CameraHaus Feature Grid (mobile 2-up)",
      "blocks": [
        { "type": "item", "settings": { "card_style":"text", "icon_name":"tag", "kicker":"PROMOS & DEALS", "mobile_kicker":"PROMOS", "title":"New Promos Every Week", "mobile_title":"Weekly Promos", "subtitle":"Bundles, vouchers, and flash deals—don’t miss out.", "hide_subtitle_on_mobile": false } },
        { "type": "item", "settings": { "card_style":"text", "icon_name":"boxes", "kicker":"UP TO 30-DAY RETURNS", "title":"Official Accessories", "big_text":"30" } },
        { "type": "item", "settings": { "card_style":"text", "icon_name":"headset", "kicker":"COMMITTED AFTER-SALES", "mobile_kicker":"AFTER-SALES", "title":"Great Customer Service", "mobile_title":"Customer Service" } },
        { "type": "item", "settings": { "card_style":"text", "icon_name":"store", "kicker":"30+ YEARS OF TRUSTED SERVICE", "mobile_kicker":"TRUSTED", "title":"60+ Stores Across the Philippines", "mobile_title":"60+ Stores", "subtitle":"Find a CameraHaus near you", "mobile_subtitle":"Find a store" } },
        { "type": "item", "settings": { "card_style":"text", "icon_name":"badge-check", "kicker":"CONVENIENCE GUARANTEED", "mobile_kicker":"WARRANTY", "title":"Official Brand Warranty", "col_span":2 } },
        { "type": "item", "settings": { "card_style":"text", "icon_name":"wreath", "kicker":"ESTABLISHED", "title":"Serving Photographers Since 1994", "mobile_title":"Since 1994", "subtitle":"30+ years of trusted service.", "mobile_subtitle":"30+ years of service", "col_span":2 } }
      ]
    }
  ]
}
{% endschema %}
