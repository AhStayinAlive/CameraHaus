<script>
(() => {
  const root = document.getElementById('ch-header-{{ section.id }}'); if (!root) return;
  const qs = (s, sc = root) => sc.querySelector(s);

  const bar   = qs('.bar');
  const nav   = qs('.nav-band');
  const spacer= qs('.nav-spacer');
  const mq    = window.matchMedia('(min-width: 992px)');

  let lastY = window.pageYOffset || 0;
  let ticking = false;

  const isDesktop = () => mq.matches;

  function setVars(){
    // keep a fresh bar height for offsets
    const barH = bar ? bar.getBoundingClientRect().height : 0;
    root.style.setProperty('--barH', `${barH}px`);
  }

function positionNav(){
  if (!nav) return;
  if (!isDesktop()){
    nav.style.top = '';
    return;
  }
  const navIsFixed   = nav.classList.contains('is-fixed');
  const barIsVisible = !root.classList.contains('is-shy');
  const offsetPx = barIsVisible ? Math.round((bar?.getBoundingClientRect().bottom || 0)) : 0;

  // When fixed, sit the nav exactly under the red bar; otherwise clear inline style
  nav.style.top = navIsFixed ? `${offsetPx}px` : '';
}

function measure(){
  if (!nav || !spacer) return;

  // keep a fresh bar height for consistency
  const barH = bar ? bar.getBoundingClientRect().height : 0;
  root.style.setProperty('--barH', `${barH}px`);

  if (!isDesktop()){
    // mobile never uses the desktop spacer
    spacer.classList.remove('show');
    return;
  }

  // compute spacer usage
  const navH = nav.getBoundingClientRect().height || 44;
  root.style.setProperty('--navH', `${navH}px`);

  const navIsFixed   = nav.classList.contains('is-fixed');
  const barIsVisible = !root.classList.contains('is-shy');

  // Show spacer ONLY when nav is fixed AND the bar is hidden (shy).
  // This prevents the red gap between the bar and the fixed nav.
  if (navIsFixed && !barIsVisible){
    spacer.classList.add('show');
  } else {
    spacer.classList.remove('show');
  }
}


  function applySticky(){
    if (!bar || !nav || !spacer) return;

    if (!isDesktop()){
      // mobile: float the red bar so the search pill stays sticky
      const y = window.pageYOffset || 0;
      const barH = bar?.offsetHeight || 0;
      const shouldFloat = (y > barH / 2) || root.classList.contains('is-shy');

      if (shouldFloat){
        root.classList.add('bar-floating');
      } else {
        root.classList.remove('bar-floating');
      }

      // desktop nav isn’t used on mobile
      nav.classList.remove('is-fixed');
      spacer.classList.remove('show');
      positionNav();
      return;
    }


    const y = window.pageYOffset || 0;
    const barH = bar.offsetHeight || 0;

    // fix the lower nav whenever the bar is shy OR we've scrolled past the bar height
    const shouldFix = (y > barH) || root.classList.contains('is-shy');

    if (shouldFix){
      if (!nav.classList.contains('is-fixed')){
        nav.classList.add('is-fixed');
        spacer.classList.add('show');
      }
      root.classList.add('bar-floating');
    } else {
      if (nav.classList.contains('is-fixed')){
        nav.classList.remove('is-fixed');
        spacer.classList.remove('show');
      }
      root.classList.remove('bar-floating');
    }

    positionNav();  // keep it under (or at top without) the red bar
  }

  function onScroll(){
    const y = window.pageYOffset || 0;

    // shy behavior: scroll down hides, scroll up shows
    if (Math.abs(y - lastY) > 6){
      const goingDown = y > lastY;
      if (goingDown && y > 60){
        root.classList.add('is-shy');
      } else {
        root.classList.remove('is-shy');
      }
      lastY = y;
    }

    applySticky();
    measure();
    ticking = false;
  }

  window.addEventListener('scroll', () => {
    if (!ticking){
      window.requestAnimationFrame(onScroll);
      ticking = true;
    }
  }, { passive: true });

  window.addEventListener('resize', () => {
    setVars();
    applySticky();
    measure();
  }, { passive: true });

  // initial pass
  setVars();
  applySticky();
  measure();
})();
</script>


<script>
  /* — unified typewriter: shows ONE phrase at a time, pauses while typing — */
  (function(){
    function getPrompts(){
      try {
        const raw = document.getElementById('ps-prompts-{{ section.id }}')?.textContent || '[]';
        const parsed = JSON.parse(raw);
        if (Array.isArray(parsed)) {
          const clean = parsed.map(s => String(s||'').trim()).filter(Boolean);
          if (clean.length >= 2) return clean;
        } else if (typeof parsed === 'string') {
          const clean = parsed.split(/\r?\n|<br\s*\/?>|[|]/i).map(s => s.trim()).filter(Boolean);
          if (clean.length >= 2) return clean;
        }
      } catch(e){}
      return [
        "Search Canon products",
        "Search Nikon products",
        "Search Sony E-mount lenses",
        "Search gimbals",
        "Search 128GB SD cards"
      ];
    }

    function attachTypewriter(input, phrases){
      if (!input || input.dataset.tw === '1') return;
      input.dataset.tw = '1';
      let i = 0, j = 0, del = false, hold = 0;

      function tick(){
        // pause while the user is actually typing in the field
        if (document.activeElement === input && input.value){
          input.setAttribute('placeholder','');
          return setTimeout(tick, 600);
        }
        const phrase = phrases[i] || '';
        input.setAttribute('placeholder', phrase.slice(0, j));

        if (!del){
          if (j < phrase.length) { j++; return setTimeout(tick, 55); }
          if (hold < 12) { hold++; return setTimeout(tick, 80); }
          hold = 0; del = true; return setTimeout(tick, 250);
        } else {
          if (j > 0) { j--; return setTimeout(tick, 28); }
          del = false; i = (i + 1) % phrases.length; return setTimeout(tick, 300);
        }
      }
      tick();
    }

    const phrases = getPrompts();
    // desktop input inside predictive search form
    attachTypewriter(document.querySelector('#ch-header-{{ section.id }} [data-ps-input]'), phrases);
    // mobile pill input
    attachTypewriter(document.querySelector('#ch-header-{{ section.id }} .m-search input'), phrases);
  })();
</script>
<script>
  (function(){
    function readJSON(id, fallback){
      try { return JSON.parse(document.getElementById(id)?.textContent || JSON.stringify(fallback)); }
      catch { return fallback; }
    }

    const phrases = readJSON('ps-prompts-{{ section.id }}', [
      "Search Canon products",
      "Search Nikon products",
      "Search Sony E-mount lenses",
      "Search gimbals",
      "Search 128GB SD cards"
    ]);

    function startTypewriter(input){
      if (!input || input.dataset.tw === '1' || !phrases.length) return;
      input.dataset.tw = '1';
      let i=0, j=0, del=false, hold=0;

      (function tick(){
        if (document.activeElement === input && input.value){
          input.placeholder = '';
          return setTimeout(tick, 600);
        }
        const p = phrases[i] || '';
        input.placeholder = p.slice(0, j);

        if (!del){
          if (j < p.length){ j++; return setTimeout(tick, 55); }
          if (hold < 12){ hold++; return setTimeout(tick, 80); }
          hold = 0; del = true; return setTimeout(tick, 250);
        } else {
          if (j > 0){ j--; return setTimeout(tick, 28); }
          del = false; i = (i + 1) % phrases.length; return setTimeout(tick, 300);
        }
      })();
    }

    // run after DOM for this section exists
    requestAnimationFrame(function(){
      startTypewriter(document.querySelector('#ch-header-{{ section.id }} [data-ps-input]'));   // desktop
      startTypewriter(document.querySelector('#ch-header-{{ section.id }} .m-search input'));   // mobile
    });
  })();
</script>

<script>
(() => {
  const root = document.getElementById('ch-header-{{ section.id }}'); if (!root) return;
  const qs = (s, sc = root) => sc.querySelector(s);

  const bar = qs('.bar');
  const nav = root.querySelector('.nav-band');
  const mq  = window.matchMedia('(min-width: 992px)');

  let lastY = window.pageYOffset || 0;
  let shy = false;
  let shyAnchor = 0;
  const HIDE_AFTER = 80; // px down before hiding
  const SHOW_AFTER = 32; // px up before showing
  let ticking = false;

  const isDesktop = () => mq.matches;

  function updateNavTop(){
    // If bar is visible on desktop, nav should sit just under it; otherwise at 0.
    let topPx = 0;
    if (isDesktop()){
      const barVisible = !root.classList.contains('is-shy');
      if (barVisible && bar){
        const r = bar.getBoundingClientRect();
        // Using height is more stable than bottom when the bar is sticky
        topPx = Math.max(0, Math.round(r.height));
      }
    }
    root.style.setProperty('--navTop', `${topPx}px`);
  }

  function onScroll(){
    const y  = window.pageYOffset || 0;
    const dy = y - lastY;

    // Hysteresis + duration tuning (longer hide, shorter show)
    if (dy > 0) { // scrolling down
      if (!shy && (y - shyAnchor) > HIDE_AFTER) {
        shy = true;
        shyAnchor = y;
        root.style.setProperty('--tw', '.36s'); // slightly longer for hide
        root.classList.add('is-shy');
      }
    } else if (dy < 0) { // scrolling up
      if (shy && (shyAnchor - y) > SHOW_AFTER) {
        shy = false;
        shyAnchor = y;
        root.style.setProperty('--tw', '.24s'); // quicker for show
        root.classList.remove('is-shy');
      }
    }

    if (y > 2) root.classList.add('has-scrolled'); else root.classList.remove('has-scrolled');

    updateNavTop();
    lastY = y;
    ticking = false;
  }

  function onResize(){
    updateNavTop();
  }

  window.addEventListener('scroll', () => {
    if (!ticking){
      ticking = true;
      requestAnimationFrame(onScroll);
    }
  }, { passive:true });

  window.addEventListener('resize', () => {
    requestAnimationFrame(onResize);
  }, { passive:true });

  // Initial pass
  root.style.setProperty('--tw', '.28s');
  updateNavTop();
})();
</script>


<script>
(() => {
  const root = document.getElementById('ch-header-{{ section.id }}');
  if (!root) return;

  const mq = matchMedia('(min-width: 992px)');
  const isDesktop = () => mq.matches;

  const HOVER_OPEN  = 140;   // ms – open delay (tune here)
  const HOVER_CLOSE = 260;   // ms – close delay (tune here)

  const wraps = [...root.querySelectorAll('.mmg-wrap[data-mega]')];

  let current = null;
  let timers  = new Map();   // {wrap: {open, close}}

  function getTimers(w){
    if (!timers.has(w)) timers.set(w, {open:0, close:0});
    return timers.get(w);
  }
  function clearOpen(w){ const t=getTimers(w); clearTimeout(t.open); t.open=0; }
  function clearClose(w){ const t=getTimers(w); clearTimeout(t.close); t.close=0; }
  function closeAll(except){
    wraps.forEach(w => { if (w !== except) { w.dataset.open = 'false'; } });
    if (except) current = except; else current = null;
  }
  function openWrap(w){
    if (!isDesktop()) return;     // let mobile behave normally
    if (current === w && w.dataset.open === 'true') return;
    closeAll(w);
    w.dataset.open = 'true';
    current = w;
  }
  function scheduleOpen(w){
    const t = getTimers(w);
    clearOpen(w); clearClose(w);
    t.open = setTimeout(() => openWrap(w), HOVER_OPEN);
  }
  function scheduleClose(w){
    const t = getTimers(w);
    clearOpen(w); clearClose(w);
    t.close = setTimeout(() => {
      // don’t close if pointer is over this wrap or its panel
      const over = document.querySelector(':hover');
      if (over && (over === w || w.contains(over))) return;
      w.dataset.open = 'false';
      if (current === w) current = null;
    }, HOVER_CLOSE);
  }

  // Wire hover intent on trigger + panel (works anywhere on the page)
  wraps.forEach(wrap => {
    const link  = wrap.querySelector(':scope > a');
    const panel = wrap.querySelector(':scope > .mmg');

    // Open on hover/focus
    wrap.addEventListener('mouseenter', () => isDesktop() && scheduleOpen(wrap));
    wrap.addEventListener('focusin',    () => isDesktop() && openWrap(wrap));

    // Keep open while inside panel
    panel?.addEventListener('mouseenter', () => isDesktop() && scheduleOpen(wrap));

    // Close after a short grace when pointer leaves both trigger and panel
    wrap.addEventListener('mouseleave', () => isDesktop() && scheduleClose(wrap));
    panel?.addEventListener('mouseleave', () => isDesktop() && scheduleClose(wrap));

    // Click should NAVIGATE now (no toggle) on desktop
    link?.addEventListener('click', (e) => {
      if (!isDesktop()) return;  // mobile: allow default
      // if the href is '#', don’t navigate; keep open for a11y
      if (!link.getAttribute('href') || link.getAttribute('href') === '#') {
        e.preventDefault();
        openWrap(wrap);
      }
      // else: let it navigate
    });

    // Esc to close
    wrap.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') { wrap.dataset.open = 'false'; if (current === wrap) current = null; link?.focus(); }
    });
  });

  // Click outside to close (desktop only)
  document.addEventListener('click', (e) => {
    if (!isDesktop()) return;
    if (!e.target.closest('#ch-header-{{ section.id }} .nav-band')) closeAll();
  });

  // If layout switches (responsive), close everything
  mq.addEventListener('change', () => closeAll());
})();
</script>

