{% comment %}
  Events – Featured + Switcher (non–full-bleed)
  - Simple cards (no blog/article links)
  - Sidebar list switches the main featured event
  - Container wrapper to keep content within a max width
{% endcomment %}

<section
  id="events-switcher-{{ section.id }}"
  class="events-switcher"
  data-section-id="{{ section.id }}"
  style="
    --sidebar-w: {{ section.settings.sidebar_width | default: 35 }}%;
    --accent: {{ section.settings.accent | default: '#e11d48' }};
    --content-max: {{ section.settings.content_max | default: 1200 }}px;
    --gutter: {{ section.settings.gutter | default: 20 }}px;
  "
>
  {% assign active_index = 0 %}
  {%- for b in section.blocks -%}
    {%- if b.settings.featured -%}
      {% assign active_index = forloop.index0 %}
      {%- break -%}
    {%- endif -%}
  {%- endfor -%}

  <div class="events-switcher__container">
    <div class="events-switcher__inner {% if section.settings.sidebar_position == 'left' %}is-left{% else %}is-right{% endif %}">
      {%- if section.settings.sidebar_position == 'left' -%}
        <!-- Sidebar (Left) -->
        <div class="events-switcher__sidebar" role="tablist" aria-label="Past events list">
          {%- for block in section.blocks -%}
            {%- assign idx = forloop.index0 -%}
            <button
              id="event-tab-{{ section.id }}-{{ idx }}"
              class="event-tab"
              data-event-tab
              data-index="{{ idx }}"
              role="tab"
              aria-controls="event-panel-{{ section.id }}-{{ idx }}"
              aria-selected="{% if active_index == idx %}true{% else %}false{% endif %}"
              tabindex="{% if active_index == idx %}0{% else %}-1{% endif %}"
              {{ block.shopify_attributes }}
            >
              <div class="event-tab__media">
                {%- assign thumb = block.settings.thumb | default: block.settings.image -%}
                {%- if thumb != blank -%}
                  <img
                    src="{{ thumb | image_url: width: 300 }}"
                    alt="{{ block.settings.title | escape }}"
                    loading="lazy"
                    decoding="async"
                  >
                {%- else -%}
                  <div class="event-tab__placeholder" aria-hidden="true"></div>
                {%- endif -%}
              </div>
              <div class="event-tab__info">
                {%- if section.settings.show_label and block.settings.label != blank -%}
                  <div class="event-tab__eyebrow">{{ block.settings.label }}</div>
                {%- endif -%}
                <div class="event-tab__title">{{ block.settings.title | default: 'Untitled event' }}</div>
                {%- if section.settings.show_date and block.settings.date != blank -%}
                  <div class="event-tab__date">{{ block.settings.date }}</div>
                {%- endif -%}
              </div>
            </button>
          {%- endfor -%}
        </div>
      {%- endif -%}

      <!-- Featured -->
      <div class="events-switcher__featured">
        {%- if section.settings.heading != blank -%}
          <h2 class="events-switcher__heading">{{ section.settings.heading }}</h2>
        {%- endif -%}

        {%- if section.blocks.size == 0 -%}
          <div class="events-switcher__empty">
            <p>Add some event blocks to populate this section.</p>
          </div>
        {%- else -%}
          {%- for block in section.blocks -%}
            {%- assign idx = forloop.index0 -%}
            <article
              id="event-panel-{{ section.id }}-{{ idx }}"
              class="event-card {% if idx != active_index %}is-hidden{% else %}is-active{% endif %}"
              role="tabpanel"
              aria-labelledby="event-tab-{{ section.id }}-{{ idx }}"
              tabindex="0"
              {{ block.shopify_attributes }}
            >
              <div class="event-card__media">
                {%- assign img = block.settings.image | default: block.settings.thumb -%}
                {%- if img != blank -%}
                  <img
                    src="{{ img | image_url: width: 1600 }}"
                    srcset="{{ img | image_url: width: 800 }} 800w, {{ img | image_url: width: 1200 }} 1200w, {{ img | image_url: width: 1600 }} 1600w"
                    sizes="(min-width: 990px) 900px, 100vw"
                    alt="{{ block.settings.title | escape }}"
                    loading="lazy"
                    decoding="async"
                  >
                {%- else -%}
                  <div class="event-card__placeholder" aria-hidden="true"></div>
                {%- endif -%}
              </div>

              <div class="event-card__body">
                <div class="event-card__meta">
                  {%- if section.settings.show_label and block.settings.label != blank -%}
                    <span class="event-card__label">{{ block.settings.label }}</span>
                  {%- endif -%}
                  {%- if section.settings.show_date and block.settings.date != blank -%}
                    <time class="event-card__date">{{ block.settings.date }}</time>
                  {%- endif -%}
                </div>

                <h3 class="event-card__title">{{ block.settings.title | default: 'Untitled event' }}</h3>

                {%- if block.settings.excerpt != blank -%}
                  <p class="event-card__excerpt" style="--lines: {{ section.settings.excerpt_lines | default: 3 }}">{{ block.settings.excerpt }}</p>
                {%- endif -%}
              </div>
            </article>
          {%- endfor -%}
        {%- endif -%}
      </div>

      {%- if section.settings.sidebar_position != 'left' -%}
        <!-- Sidebar (Right) -->
        <div class="events-switcher__sidebar" role="tablist" aria-label="Past events list">
          {%- for block in section.blocks -%}
            {%- assign idx = forloop.index0 -%}
            <button
              id="event-tab-{{ section.id }}-{{ idx }}"
              class="event-tab"
              data-event-tab
              data-index="{{ idx }}"
              role="tab"
              aria-controls="event-panel-{{ section.id }}-{{ idx }}"
              aria-selected="{% if active_index == idx %}true{% else %}false{% endif %}"
              tabindex="{% if active_index == idx %}0{% else %}-1{% endif %}"
              {{ block.shopify_attributes }}
            >
              <div class="event-tab__media">
                {%- assign thumb = block.settings.thumb | default: block.settings.image -%}
                {%- if thumb != blank -%}
                  <img
                    src="{{ thumb | image_url: width: 300 }}"
                    alt="{{ block.settings.title | escape }}"
                    loading="lazy"
                    decoding="async"
                  >
                {%- else -%}
                  <div class="event-tab__placeholder" aria-hidden="true"></div>
                {%- endif -%}
              </div>
              <div class="event-tab__info">
                {%- if section.settings.show_label and block.settings.label != blank -%}
                  <div class="event-tab__eyebrow">{{ block.settings.label }}</div>
                {%- endif -%}
                <div class="event-tab__title">{{ block.settings.title | default: 'Untitled event' }}</div>
                {%- if section.settings.show_date and block.settings.date != blank -%}
                  <div class="event-tab__date">{{ block.settings.date }}</div>
                {%- endif -%}
              </div>
            </button>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>
  </div>

  <style>
    #events-switcher-{{ section.id }} {
      --radius: 16px;
      --shadow: 0 10px 30px rgba(0,0,0,.06);
      --border: 1px solid rgba(0,0,0,.08);
      --text: var(--color-foreground, #111);
      --muted: rgba(0,0,0,.6);
    }
    /* container to avoid full-bleed */
    #events-switcher-{{ section.id }} .events-switcher__container{
      max-width: var(--content-max);
      margin: 0 auto;
      padding-left: var(--gutter);
      padding-right: var(--gutter);
    }

    #events-switcher-{{ section.id }} .events-switcher__inner{
      display:grid; gap:28px;
      grid-template-columns: 1fr var(--sidebar-w);
    }
    #events-switcher-{{ section.id }} .events-switcher__inner.is-left{
      grid-template-columns: var(--sidebar-w) 1fr;
    }
    @media (max-width: 990px){
      #events-switcher-{{ section.id }} .events-switcher__inner{ grid-template-columns: 1fr; }
    }

    .events-switcher__heading{ margin:0 0 14px; font-size:clamp(20px, 2.4vw, 32px); line-height:1.2; }

    /* Featured card */
    .event-card{ border-radius: var(--radius); overflow:hidden; box-shadow: var(--shadow); border: var(--border); background:#fff; display:none; }
    .event-card.is-active{ display:block; }
    .event-card__media img, .event-card__placeholder{ display:block; width:100%; height:auto; aspect-ratio: 16/9; object-fit:cover; background: #f2f2f2; }
    .event-card__body{ padding:18px 20px 22px; }
    .event-card__meta{ display:flex; gap:10px; align-items:center; margin-bottom:8px; flex-wrap:wrap; }
    .event-card__label{ display:inline-flex; align-items:center; font-size:12px; padding:4px 8px; border-radius:999px; background: color-mix(in oklab, var(--accent) 16%, white); color: var(--accent); border: 1px solid color-mix(in oklab, var(--accent) 36%, white); }
    .event-card__date{ font-size:12px; color: var(--muted); }
    .event-card__title{ margin:4px 0 8px; font-size: clamp(18px, 2vw, 24px); line-height:1.25; }
    .event-card__excerpt{
      margin:0; color: var(--muted);
      display:-webkit-box; -webkit-line-clamp: var(--lines, 3); -webkit-box-orient: vertical; overflow:hidden;
    }

    /* Sidebar list */
    .events-switcher__sidebar{ display:flex; flex-direction:column; gap:12px; }
    .event-tab{
      display:grid; grid-template-columns: 116px 1fr; gap:14px; align-items:center;
      padding:10px; border-radius:14px; background:#fff; border: var(--border); box-shadow: var(--shadow);
      cursor:pointer; text-align:left; width:100%;
    }
    .event-tab[aria-selected="true"]{ outline:2px solid var(--accent); outline-offset: 2px; }
    .event-tab__media img, .event-tab__placeholder{ width:100%; height:auto; aspect-ratio:4/3; object-fit:cover; border-radius:10px; background:#f2f2f2; }
    .event-tab__eyebrow{ font-size:12px; color: var(--accent); }
    .event-tab__title{ margin:2px 0 4px; font-size:14px; line-height:1.35; }
    .event-tab__date{ font-size:12px; color: var(--muted); }
    .event-tab:focus-visible{ box-shadow:0 0 0 3px color-mix(in oklab, var(--accent), white 70%); }

    .is-hidden{ display:none; }
  </style>

  <script>
    (function(){
      const root = document.getElementById('events-switcher-{{ section.id }}');
      if(!root) return;

      const tabs = root.querySelectorAll('[data-event-tab]');
      const panels = root.querySelectorAll('.event-card');

      function activate(index){
        panels.forEach((p,i)=>{
          p.classList.toggle('is-active', i === index);
          p.classList.toggle('is-hidden', i !== index);
        });
        tabs.forEach((t,i)=>{
          t.setAttribute('aria-selected', String(i === index));
          t.setAttribute('tabindex', i === index ? '0' : '-1');
        });
        const activePanel = root.querySelector('#event-panel-{{ section.id }}-' + index);
        if(activePanel){ activePanel.focus({preventScroll:true}); }
      }

      tabs.forEach(tab=>{
        tab.addEventListener('click', () => activate(parseInt(tab.dataset.index,10)));
        tab.addEventListener('keydown', (e)=>{
          const current = parseInt(tab.dataset.index,10);
          if(e.key === 'ArrowDown' || e.key === 'ArrowRight'){
            e.preventDefault();
            const next = (current + 1) % tabs.length; tabs[next].focus(); activate(next);
          } else if(e.key === 'ArrowUp' || e.key === 'ArrowLeft'){
            e.preventDefault();
            const prev = (current - 1 + tabs.length) % tabs.length; tabs[prev].focus(); activate(prev);
          }
        });
      });
    })();
  </script>
</section>
{% schema %}
{
  "name": "Events",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Events & News" },
    { "type": "checkbox", "id": "show_label", "label": "Show label", "default": true },
    { "type": "checkbox", "id": "show_date", "label": "Show date", "default": true },
    { "type": "range", "id": "excerpt_lines", "label": "Excerpt lines", "min": 2, "max": 8, "step": 1, "default": 3 },
    {
      "type": "radio",
      "id": "sidebar_position",
      "label": "Sidebar position",
      "default": "right",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "right", "label": "Right" }
      ]
    },
    { "type": "range", "id": "sidebar_width", "label": "Sidebar width (%)", "min": 30, "max": 50, "step": 1, "default": 35 },
    { "type": "color", "id": "accent", "label": "Accent color", "default": "#e11d48" },

    { "type": "range", "id": "content_max", "label": "Content max width (px)", "min": 800, "max": 1600, "step": 10, "default": 1200 },
    { "type": "range", "id": "gutter", "label": "Side padding (px)", "min": 0, "max": 60, "step": 2, "default": 20 }
  ],
  "blocks": [
    {
      "type": "event",
      "name": "Event",
      "settings": [
        { "type": "text", "id": "label", "label": "Eyebrow / Category", "default": "Mobile" },
        { "type": "text", "id": "title", "label": "Title", "default": "Sample Event Title" },
        { "type": "text", "id": "date", "label": "Date", "default": "Jul 4, 2025" },
        { "type": "textarea", "id": "excerpt", "label": "Short description", "default": "A quick one-line description about this past event or announcement." },
        { "type": "image_picker", "id": "image", "label": "Featured image" },
        { "type": "image_picker", "id": "thumb", "label": "Sidebar image (optional)" },
        { "type": "checkbox", "id": "featured", "label": "Start as featured", "default": false }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    { "name": "Events – Featured w/ Switcher" }
  ]
}
{% endschema %}
