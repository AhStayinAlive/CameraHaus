{% comment %}
Shop by Brands — Carousel (shared controls; arrows outside, dots inside)
{% endcomment %}

<section id="ch-brands-{{ section.id }}" class="ch-brands ch-brands--photo" role="region" aria-labelledby="ch-brands-heading-{{ section.id }}">
  {%- assign heading_tag = section.settings.heading_level | default: 'h2' -%}
  {%- if heading_tag != 'h2' and heading_tag != 'h3' and heading_tag != 'h4' -%}{% assign heading_tag = 'h2' %}{%- endif -%}

  <div class="page-width">
    {%- if section.blocks.size > 0 -%}
      {%- assign letters = '|' -%}
      {%- for block in section.blocks -%}
        {%- assign L = block.settings.brand_name | strip | slice: 0, 1 | upcase -%}
        {%- assign key = '|' | append: L | append: '|' -%}
        {%- unless letters contains key -%}{%- assign letters = letters | append: L | append: '|' -%}{%- endunless -%}
      {%- endfor -%}

      <{{ heading_tag }} id="ch-brands-heading-{{ section.id }}" class="chb-heading">
        {{ section.settings.heading_text | default: 'Brands We Love' }}
      </{{ heading_tag }}>

      <div class="chb-controls" role="group" aria-label="Brand filters">
        {%- if section.settings.enable_search -%}
        <div class="chb-search">
          <label class="sr-only" for="chb-search-{{ section.id }}">Search brands</label>
          <input id="chb-search-{{ section.id }}" data-search type="search" inputmode="search" autocomplete="off" spellcheck="false"
                 placeholder="Search brands…" aria-label="Search brands"/>
        </div>
        {%- endif -%}

        {%- if section.settings.enable_az_filter -%}
        {%- assign letters_arr = letters | split: '|' -%}
        <div class="chb-az" data-az aria-label="Filter by first letter">
          <ul role="list" class="chb-az-list">
            <li role="listitem"><button type="button" class="chb-chip is-active" data-letter="all" aria-pressed="true">All</button></li>
            {%- for L in letters_arr -%}{% if L != '' %}
              <li role="listitem"><button type="button" class="chb-chip" data-letter="{{ L }}" aria-pressed="false">{{ L }}</button></li>
            {% endif %}{% endfor %}
          </ul>
        </div>
        {%- endif -%}
      </div>

      <div class="chb-viewport">
        <ul role="list" class="chb-track" data-track tabindex="0" aria-label="Brands We Love">
          {%- for block in section.blocks -%}
            {%- if block.settings.pin_to_top -%}
              {%- assign bname = block.settings.brand_name | strip -%}
              {%- assign bname_down = bname | downcase -%}
              {%- assign bletter = bname | slice: 0, 1 | upcase -%}
              {%- assign alt_text = block.settings.alt_text | default: bname -%}
              {%- assign link_url = block.settings.brand_url | default: '#' -%}
              <li role="listitem" class="chb-tile" data-tile data-brand="{{ bname_down | escape }}" data-letter="{{ bletter }}" data-featured="true">
                <a class="chb-photo-card" href="{{ link_url }}" aria-label="Shop {{ bname | escape }}">
                  <span class="chb-photo-wrap" aria-hidden="true">
                    {%- if block.settings.brand_photo -%}
                      {%- assign src_360  = block.settings.brand_photo | image_url: width: 360 -%}
                      {%- assign src_720  = block.settings.brand_photo | image_url: width: 720 -%}
                      {%- assign src_1080 = block.settings.brand_photo | image_url: width: 1080 -%}
                      {%- assign src_1440 = block.settings.brand_photo | image_url: width: 1440 -%}
                      <img class="chb-photo" loading="lazy" decoding="async" alt=""
                           src="{{ src_720 }}"
                           srcset="{{ src_360 }} 360w, {{ src_720 }} 720w, {{ src_1080 }} 1080w, {{ src_1440 }} 1440w"
                           sizes="(min-width:1100px) 300px, (min-width:740px) 44vw, 80vw">
                    {%- endif -%}
                  </span>
                  <span class="chb-gradient" aria-hidden="true"></span>
                  <span class="chb-logo-wrap" aria-hidden="true">
                    {%- if block.settings.brand_logo -%}
                      {%- assign lg_240 = block.settings.brand_logo | image_url: width: 240 -%}
                      {%- assign lg_480 = block.settings.brand_logo | image_url: width: 480 -%}
                      <img class="chb-logo" loading="lazy" decoding="async" alt="{{ alt_text | escape }}"
                           src="{{ lg_480 }}" srcset="{{ lg_240 }} 240w, {{ lg_480 }} 480w" sizes="40vw">
                    {%- else -%}
                      <span class="chb-text-logo">{{ bname }}</span>
                    {%- endif -%}
                  </span>
                  <span class="chb-badge" aria-hidden="true">Featured</span>
                </a>
              </li>
            {%- endif -%}
          {%- endfor -%}

          {%- for block in section.blocks -%}
            {%- unless block.settings.pin_to_top -%}
              {%- assign bname = block.settings.brand_name | strip -%}
              {%- assign bname_down = bname | downcase -%}
              {%- assign bletter = bname | slice: 0, 1 | upcase -%}
              {%- assign alt_text = block.settings.alt_text | default: bname -%}
              {%- assign link_url = block.settings.brand_url | default: '#' -%}
              <li role="listitem" class="chb-tile" data-tile data-brand="{{ bname_down | escape }}" data-letter="{{ bletter }}" data-featured="false">
                <a class="chb-photo-card" href="{{ link_url }}" aria-label="Shop {{ bname | escape }}">
                  <span class="chb-photo-wrap" aria-hidden="true">
                    {%- if block.settings.brand_photo -%}
                      {%- assign src_360  = block.settings.brand_photo | image_url: width: 360 -%}
                      {%- assign src_720  = block.settings.brand_photo | image_url: width: 720 -%}
                      {%- assign src_1080 = block.settings.brand_photo | image_url: width: 1080 -%}
                      {%- assign src_1440 = block.settings.brand_photo | image_url: width: 1440 -%}
                      <img class="chb-photo" loading="lazy" decoding="async" alt=""
                           src="{{ src_720 }}"
                           srcset="{{ src_360 }} 360w, {{ src_720 }} 720w, {{ src_1080 }} 1080w, {{ src_1440 }} 1440w"
                           sizes="(min-width:1100px) 300px, (min-width:740px) 44vw, 80vw">
                    {%- endif -%}
                  </span>
                  <span class="chb-gradient" aria-hidden="true"></span>
                  <span class="chb-logo-wrap" aria-hidden="true">
                    {%- if block.settings.brand_logo -%}
                      {%- assign lg_240 = block.settings.brand_logo | image_url: width: 240 -%}
                      {%- assign lg_480 = block.settings.brand_logo | image_url: width: 480 -%}
                      <img class="chb-logo" loading="lazy" decoding="async" alt="{{ alt_text | escape }}"
                           src="{{ lg_480 }}" srcset="{{ lg_240 }} 240w, {{ lg_480 }} 480w" sizes="40vw">
                    {%- else -%}
                      <span class="chb-text-logo">{{ bname }}</span>
                    {%- endif -%}
                  </span>
                </a>
              </li>
            {%- endunless -%}
          {%- endfor -%}
        </ul>

        <!-- Dots INSIDE the container -->
        <div class="chpc__dots chb-dots" data-dots></div>
      </div><!-- /.chb-viewport -->

    {%- else -%}
      <{{ heading_tag }} id="ch-brands-heading-{{ section.id }}" class="chb-heading">{{ section.settings.heading_text | default: 'Brands We Love' }}</{{ heading_tag }}>
      <p class="chb-empty">No brands to show.</p>
    {%- endif -%}
  </div><!-- /.page-width -->

  {% comment %} Arrows OUTSIDE the container so they sit at section edges {% endcomment %}
  {% render 'chpc-controls',
      id: section.id,
      show_dots: false,
      show_arrows: true,
      mobile_hide_arrows: true,
      placement: 'outside' %}

  <style>
    #ch-brands-{{ section.id }}{
      --ch-red:#E0302A; --ink:#111; --muted:#6b7280; --border:#e5e7eb;
      --gap: {{ section.settings.tile_gap | default: 14 }}px;
      --radius: {{ section.settings.tile_radius | default: 16 }}px;
      --shadow: 0 2px 10px rgba(0,0,0,.08);
      --container-pad: 28px;
      --edge: 12px;
      --arrow-size: 36px; --arrow-border: 2px;
      position: relative;
      color:var(--ink);
    }
    @media (max-width:739.98px){ #ch-brands-{{ section.id }}{ --container-pad: 16px; } }

    /* hide any legacy controls */
    #ch-brands-{{ section.id }} .chb-arrow,
    #ch-brands-{{ section.id }} .chb-dots-legacy{ display:none !important; }

    .page-width{ max-width:1440px; margin:0 auto; padding:0 var(--container-pad); }

    .sr-only{position:absolute!important;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}
    .chb-heading{font-weight:800;font-size:clamp(1.2rem,1.8vw,1.5rem);margin:0 0 12px}

    .chb-controls{display:flex;gap:12px;align-items:center;flex-wrap:wrap;justify-content:space-between;margin-bottom:12px}
    .chb-search{flex:1 1 220px;min-width:220px;max-width:460px}
    [data-search]{width:100%;padding:10px 12px;border:1px solid var(--border);border-radius:10px;background:#fff}
    [data-search]:focus{outline:3px solid transparent;box-shadow:0 0 0 3px rgba(224,48,42,.28)}
    .chb-az .chb-az-list{display:flex;gap:8px;align-items:center;flex-wrap:wrap;margin:0;padding:0;list-style:none}
    .chb-chip{border:1px solid var(--border);background:#fff;border-radius:999px;padding:6px 10px;font-size:.85rem;line-height:1;cursor:pointer}
    .chb-chip:is(:hover,:focus){box-shadow:0 0 0 3px rgba(224,48,42,.18);outline:none}
    .chb-chip.is-active{border-color:var(--ch-red);color:var(--ch-red)}

    .chb-viewport{position:relative}
    .chb-track{
      display:flex; gap:var(--gap);
      overflow-x:auto; padding:4px 8px 10px;
      scroll-snap-type:x mandatory; -webkit-overflow-scrolling:touch;
      scrollbar-width:none; align-items:stretch;
    }
    .chb-track::-webkit-scrollbar{display:none}
    .chb-track > .chb-tile{flex:0 0 min(300px, 33.33%); scroll-snap-align:start}
    @media (max-width:1099.98px){ .chb-track > .chb-tile{flex-basis:44%} }
    @media (max-width:739.98px){  .chb-track > .chb-tile{flex-basis:80%} }

    .chb-tile{list-style:none}
    .chb-photo-card{position:relative;display:block;width:100%;aspect-ratio:4/3;border-radius:var(--radius);overflow:hidden;background:#f3f4f6;box-shadow:var(--shadow);text-decoration:none;color:inherit}
    .chb-photo{width:100%;height:100%;object-fit:cover;display:block;transform:scale(1.001);transition:transform .35s ease}
    .chb-photo-card:hover .chb-photo{transform:scale(1.03)}
    .chb-gradient{position:absolute;inset:0;z-index:1;background:linear-gradient(180deg, rgba(0,0,0,0.00) 55%, rgba(0,0,0,0.35) 100%)}
    .chb-photo-card:focus-visible{outline:3px solid transparent;box-shadow:0 0 0 3px rgba(224,48,42,.38), var(--shadow)}
    .chb-logo-wrap{position:absolute;z-index:2;left:12px;right:12px;bottom:10px;display:flex;align-items:flex-end;gap:10px}
    .chb-logo{max-width:84%;max-height:clamp(56px,10vw,96px);width:auto;height:auto;filter:drop-shadow(0 1px 6px rgba(0,0,0,.55))}
    .chb-text-logo{display:inline-block;padding:6px 10px;border-radius:10px;background:rgba(0,0,0,.5);color:#fff;font-weight:700;font-size:.95rem;backdrop-filter:saturate(120%) blur(2px)}
    .chb-badge{position:absolute;top:10px;left:10px;z-index:2;font-size:.75rem;color:#fff;background:#E0302A;border-radius:999px;padding:4px 8px;box-shadow:0 4px 10px rgba(0,0,0,.16)}

    /* ARROWS: outside (full-bleed) */
    #ch-brands-{{ section.id }} .chpc__arrows[data-placement="outside"]{ position:absolute; inset:0; pointer-events:none; }
    #ch-brands-{{ section.id }} .chpc__arrow{
      pointer-events:auto; position:absolute; top:50%; transform:translateY(-50%);
      width:var(--arrow-size); height:var(--arrow-size);
      border-radius:999px; border:var(--arrow-border) solid var(--ch-red);
      background:#fff; color:var(--ch-red); display:grid; place-items:center;
      box-shadow:0 2px 8px rgba(224,48,42,.12); z-index:10; cursor:pointer;
      transition:background .2s ease, color .2s ease, box-shadow .2s ease, border-color .2s ease;
    }
    #ch-brands-{{ section.id }} .chpc__arrow--prev{ left: calc(var(--container-pad) * -1 + var(--edge)); }
    #ch-brands-{{ section.id }} .chpc__arrow--next{ right: calc(var(--container-pad) * -1 + var(--edge)); }
    #ch-brands-{{ section.id }} .chpc__arrow:hover{ background:var(--ch-red); color:#fff; }
    #ch-brands-{{ section.id }} .chpc__arrow[disabled]{ opacity:.38; pointer-events:none; }
    @media (max-width:739.98px){
      #ch-brands-{{ section.id }} .chpc__arrows[data-hide-mobile="true"]{ display:none !important; }
    }

    /* DOTS: inside container; tight spacing + pill active */
    #ch-brands-{{ section.id }} .chb-dots{ display:flex; justify-content:center; gap:0; margin:8px 0 0; }
    #ch-brands-{{ section.id }} .chb-dots .chpc__dot{ position:relative; width:10px; height:10px; margin:0 1px; border:0; background:transparent; cursor:pointer; }
    #ch-brands-{{ section.id }} .chb-dots .chpc__dot::before{ content:""; position:absolute; inset:-18px; }
    #ch-brands-{{ section.id }} .chb-dots .chpc__dot::after{ content:""; position:absolute; left:50%; top:50%; transform:translate(-50%,-50%); width:4px; height:4px; border-radius:9999px; background:#d1d5db; transition:width .25s ease, background-color .25s ease; }
    #ch-brands-{{ section.id }} .chb-dots .chpc__dot[aria-current="true"]::after{ width:14px; height:4px; background:#E0302A; }
    #ch-brands-{{ section.id }} .chb-dots .chpc__count{ display:none !important; }

    .chb-empty{color:var(--muted);margin:8px 0}
  </style>

  <script>
  (function(){
    var root = document.getElementById('ch-brands-{{ section.id }}');
    if(!root) return;

    var searchEl = root.querySelector('[data-search]');
    var azWrap   = root.querySelector('[data-az]');
    var track    = root.querySelector('[data-track]');
    var btnPrev  = root.querySelector('.chpc__arrow--prev');
    var btnNext  = root.querySelector('.chpc__arrow--next');
    var dotsWrap = root.querySelector('[data-dots]');
    var tiles    = root.querySelectorAll('[data-tile]');

    function isMobile(){ return window.innerWidth < 740; }

    function applyFilters(){
      var term   = searchEl ? searchEl.value.trim().toLowerCase() : '';
      var letter = root.getAttribute('data-letter') || 'all';
      tiles.forEach(function(tile){
        var name  = tile.getAttribute('data-brand') || '';
        var first = tile.getAttribute('data-letter') || '';
        var show  = true;
        if(term && name.indexOf(term) === -1) show = false;
        if(letter !== 'all' && first !== letter) show = false;
        tile.hidden = !show;
      });
      rebuildPager();
    }
    if(searchEl){ searchEl.addEventListener('input', applyFilters, { passive:true }); }
    if(azWrap){
      azWrap.addEventListener('click', function(e){
        var btn = e.target.closest('.chb-chip'); if(!btn) return;
        var letter = btn.getAttribute('data-letter'); root.setAttribute('data-letter', letter);
        azWrap.querySelectorAll('.chb-chip').forEach(function(b){
          var active = b === btn; b.classList.toggle('is-active', active); b.setAttribute('aria-pressed', active ? 'true' : 'false');
        });
        applyFilters();
      });
    }

    var currentPage = 0;
    function pageWidth(){ return track ? track.clientWidth : 1; }
    function pagesCount(){
      if(!track) return 1;
      var w = pageWidth() || 1;
      return Math.max(1, Math.ceil(track.scrollWidth / w));
    }
    function updateArrows(){
      if(!btnPrev || !btnNext) return;
      var n = pagesCount();
      btnPrev.disabled = (currentPage <= 0);
      btnNext.disabled = (currentPage >= n - 1);
      var needArrows = n > 1 && !isMobile();
      btnPrev.style.display = needArrows ? 'grid' : 'none';
      btnNext.style.display = needArrows ? 'grid' : 'none';
    }
    function scrollToPage(idx, smooth){
      var total = pagesCount();
      if(idx < 0) idx = 0;
      if(idx > total - 1) idx = total - 1;
      var left = idx * (pageWidth() || 1);
      track.scrollTo({ left:left, behavior: smooth ? 'smooth' : 'auto' });
      currentPage = idx; updateDots(); updateArrows();
    }
    function onScroll(){
      var w = pageWidth() || 1;
      currentPage = Math.round(track.scrollLeft / w);
      updateDots(); updateArrows();
    }

    var MAX_DOTS = 5;
    function windowStartFor(page, total, maxDots){
      if (total <= maxDots) return 0;
      var half = Math.floor(maxDots/2), start = page - half;
      if (start < 0) start = 0;
      if (start > total - maxDots) start = total - maxDots;
      return start;
    }
    function buildDots(){
      if(!dotsWrap) return;
      var total = pagesCount();
      dotsWrap.innerHTML = '';
      if(total <= 1){ dotsWrap.style.display = 'none'; return; }
      dotsWrap.style.display = 'flex';
      var start = windowStartFor(currentPage, total, MAX_DOTS);
      var count = Math.min(total, MAX_DOTS);
      for (var i=0;i<count;i++){
        var real = start + i;
        var b = document.createElement('button');
        b.type='button'; b.className='chpc__dot'; b.setAttribute('role','tab');
        b.dataset.page = String(real);
        b.setAttribute('aria-label','Go to page ' + (real+1));
        b.addEventListener('click', function(e){
          var p = parseInt(e.currentTarget.dataset.page,10);
          scrollToPage(p, true);
        });
        dotsWrap.appendChild(b);
      }
      updateDots();
    }
    function updateDots(){
      if(!dotsWrap) return;
      var total = pagesCount();
      if(total <= 1){ dotsWrap.style.display = 'none'; return; }
      var start = windowStartFor(currentPage, total, MAX_DOTS);
      var dots = dotsWrap.querySelectorAll('.chpc__dot');
      if(dots.length !== Math.min(total, MAX_DOTS)){ buildDots(); return; }
      dots.forEach(function(b, i){
        var real = start + i;
        b.dataset.page = String(real);
        b.setAttribute('aria-current', real === currentPage ? 'true' : 'false');
        b.setAttribute('aria-label','Go to page ' + (real+1));
      });
    }
    function rebuildPager(){
      if(track){
        var needPages = pagesCount() > 1;
        if(!needPages){ track.scrollLeft = 0; currentPage = 0; }
      }
      buildDots(); updateDots(); updateArrows();
    }

    if(track){
      track.addEventListener('scroll', onScroll, { passive:true });
      if(btnPrev) btnPrev.addEventListener('click', function(){ scrollToPage(currentPage - 1, true); });
      if(btnNext) btnNext.addEventListener('click', function(){ scrollToPage(currentPage + 1, true); });
      window.addEventListener('resize', function(){ rebuildPager(); });
      rebuildPager();
    }

    root.addEventListener('click', function(e){
      var link = e.target.closest('.chb-photo-card'); if(!link) return;
      var tile = link.closest('[data-tile]'); if(!tile) return;
      if(typeof window.gtag === 'function'){ try{
        window.gtag('event','brand_click',{
          event_category:'Shop by Brands',
          event_label:(tile.getAttribute('data-brand')||'').toUpperCase(),
          location:'carousel',
          section_id:'{{ section.id }}'
        });
      }catch(err){} }
    });

    applyFilters();
  })();
  </script>
</section>

{% schema %}
{
  "name": "Shop by Brands — Carousel",
  "settings": [
    { "type": "text", "id": "heading_text", "label": "Heading", "default": "Brands We Love" },
    { "type": "select", "id": "heading_level", "label": "Heading level", "default": "h2", "options": [{"value":"h2","label":"H2"},{"value":"h3","label":"H3"},{"value":"h4","label":"H4"}] },
    { "type": "checkbox", "id": "enable_search", "label": "Enable search", "default": true },
    { "type": "checkbox", "id": "enable_az_filter", "label": "Enable A–Z filter chips", "default": true },
    { "type": "range", "id": "tile_gap", "label": "Gap (px)", "min": 6, "max": 24, "step": 2, "default": 14 },
    { "type": "range", "id": "tile_radius", "label": "Tile corner radius (px)", "min": 8, "max": 28, "step": 2, "default": 16 }
  ],
  "blocks": [
    {
      "type": "brand",
      "name": "Brand",
      "settings": [
        { "type": "text", "id": "brand_name", "label": "Brand name", "default": "Brand" },
        { "type": "image_picker", "id": "brand_photo", "label": "Lifestyle photo (background)" },
        { "type": "image_picker", "id": "brand_logo", "label": "Brand logo" },
        { "type": "url", "id": "brand_url", "label": "Brand link" },
        { "type": "text", "id": "alt_text", "label": "Logo alt text (optional)" },
        { "type": "checkbox", "id": "pin_to_top", "label": "Mark as Featured", "default": false }
      ]
    }
  ],
  "presets": [{ "name": "Shop by Brands — Carousel" }]
}
{% endschema %}
