{% comment %}
SECTION: Product page (Sticky bar shows whenever CTA is off-screen)
- Sticky bar appears the moment the main CTA row leaves the viewport
- No tab/recommendations stop — it stays visible through those sections
- Teleported to <body> and super-high z-index so nothing covers it
{% endcomment %}

{% comment %} ================================ {% endcomment %}
{% comment %} File: sections/product-pages.liquid (FINAL — show-through tabs) {% endcomment %}
{% comment %} ================================ {% endcomment %}

<div class="page-width ch-pdp"
     itemscope itemtype="http://schema.org/Product"
     id="ProductSection-{{ section.id }}"
     data-section-id="{{ section.id }}"
     data-section-type="product"
     data-enable-history-state="true"
     data-ajax="{{ section.settings.enable_ajax }}"
     data-stock="{{ section.settings.stock_enable }}">

  {% assign product_image_size = '480x480' %}
  <meta itemprop="name" content="{{ product.title }}">
  <meta itemprop="url" content="{{ shop.url }}{{ product.url }}">
  <meta itemprop="image" content="{{ product.featured_image.src | img_url: '600x600' }}">
  {% if settings.product_vendor_enable %}<meta itemprop="brand" content="{{ product.vendor }}">{% endif %}

  {% assign current_variant = product.selected_or_first_available_variant %}
  {% assign variants_with_unit_price = product.variants | where: "unit_price_measurement" %}

  {% assign rating = product.metafields.reviews.rating.value | default: product.metafields.okendo.average_rating | default: 0 %}
  {% assign rating_count = product.metafields.reviews.rating_count.value | default: product.metafields.okendo.review_count | default: 0 %}

  <div class="grid product-single">

    {%- comment -%} LEFT: MEDIA (thumbs below main) {%- endcomment -%}
    <div class="grid__item medium-up--one-half">
      <div class="photos ch-media" data-ch-gallery aria-label="{{ 'products.product.product_images' | t }}">
        <!-- Zoom UI -->
        <div class="ch-zoom" data-ch-zoom aria-hidden="true">
          <div class="ch-zoom__lens" aria-hidden="true"></div>
          <div class="ch-zoom__pane" aria-hidden="true"></div>
        </div>

        <div class="photos__item photos__item--main">
          {% assign featured_image = current_variant.featured_image | default: product.featured_image %}
          {% for image in product.images %}
            <div class="product-single__photo product__photo-container product__photo-container-{{ section.id }} js{% unless image == featured_image %} hide{% endunless %}"
                 id="ProductPhoto"
                 style="max-width: {% render 'image-width', image: image, width: 720 %}px;"
                 data-image-id="{{ image.id }}">
              <a href="{{ image | img_url: '1200x1200' }}"
                 class="product__photo-wrapper product__photo-wrapper-{{ section.id }}"
                 style="padding-top:{{ 1 | divided_by: image.aspect_ratio | times: 100}}%;"
                 data-full="{{ image | img_url: '2048x2048' }}"
                 data-pswp-width="{{ image.width }}"
                 data-pswp-height="{{ image.height }}">
                {% assign img_url = image | img_url: '1x1' | replace: '_1x1.', '_{width}x.' %}
                <img class="lazyload{% unless image == featured_image %} lazypreload{% endunless %}"
                     src="{{ image | img_url: '300x300' }}"
                     data-src="{{ img_url }}"
                     data-widths="[360,480,720,960,1200,1600,2048]"
                     data-aspectratio="{{ image.aspect_ratio }}"
                     data-sizes="auto"
                     alt="{{ image.alt | escape }}">
              </a>

              <!-- Zoom toggle UI (hidden via CSS; behavior remains) -->
              <button type="button" class="ch-zoom__toggle" aria-pressed="true">
                <span class="ch-zoom__toggle-text">Zoom: On</span>
              </button>
            </div>
          {% endfor %}
          <noscript>
            <a href="{{ featured_image | img_url: '1024x1024' }}">
              <img src="{{ featured_image | img_url: product_image_size }}" alt="{{ featured_image.alt | escape }}">
            </a>
          </noscript>
        </div>

        {% if product.images.size > 1 %}
          <div class="photos__item photos__item--thumbs ch-thumbs-below">
            <div class="product-single__thumbnails product-single__thumbnails-{{ section.id }}">
              {% for image in product.images %}
                <div class="product-single__thumbnail-item product-single__thumbnail-item-{{ section.id }}{% if image == featured_image %} is-active{% endif %}" data-image-id="{{ image.id }}">
                  <a href="{{ image.src | img_url: product_image_size }}"
                     data-zoom="{{ image.src | img_url: '1200x1200' }}"
                     class="product-single__thumbnail product-single__thumbnail-{{ section.id }}">
                    <img src="{{ image.src | img_url: '200x200' }}" alt="{{ image.alt | escape }}">
                  </a>
                </div>
              {% endfor %}
            </div>
          </div>
        {% endif %}
      </div>
    </div>

    {%- comment -%} RIGHT: INFO / CTA {%- endcomment -%}
    <div class="grid__item medium-up--one-half" itemprop="offers" itemscope itemtype="http://schema.org/Offer">
      <div class="product-single__info-wrapper ch-info-col">
        <meta itemprop="priceCurrency" content="{{ cart.currency.iso_code }}">
        <link itemprop="availability" href="http://schema.org/{% if product.available %}InStock{% else %}OutOfStock{% endif %}">

        <div class="product-single__meta small--text-left">
          {% if settings.product_vendor_enable %}
            <p class="product-single__vendor">{{ product.vendor }}</p>
          {% endif %}

        <h1 itemprop="name" class="product-single__title">{{ product.title }}</h1>

          <ul class="product-single__meta-list list--no-bullets list--inline product-single__price-container">
            <li>
              <span id="ProductPrice-{{ section.id }}" class="product-single__price ch-price-red" itemprop="price" content="{{ current_variant.price | divided_by: 100.00 }}">
                {{ current_variant.price | money }}
              </span>
            </li>
            {% if product.compare_at_price_max > product.price %}
              <li>
                <s id="ComparePrice-{{ section.id }}" class="product-single__price product-single__price--compare">
                  {{ current_variant.compare_at_price | money }}
                </s>
              </li>
            {% endif %}
          </ul>

          <!-- Ratings row (Okendo → fallback) -->
          <div class="ch-rating-row" id="ChRatingRow-{{ section.id }}">
            {% assign oke_avg = product.metafields.okendo.average_rating | default: 0 %}
            {% assign oke_cnt = product.metafields.okendo.review_count | default: 0 %}
            {% if oke_cnt > 0 %}
              <a href="#tab-reviews" class="ch-rating ch-rating--okendo"
                 aria-label="{{ oke_avg | round: 1 }} out of 5 stars based on {{ oke_cnt }} reviews">
                <div class="okeReviews-starRating" data-oke-reviews-product-id="{{ product.id }}"></div>
                <span class="ch-stars__count">({{ oke_cnt }})</span>
              </a>
            {% else %}
              <a href="#tab-reviews" class="ch-rating ch-rating--empty"
                 aria-label="No reviews yet — be the first">
                <span class="ch-stars__base" aria-hidden="true">★★★★★</span>
                <span class="ch-stars__fill" aria-hidden="true" style="width:0%">★★★★★</span>
                <span class="ch-no-r-msg">No reviews yet — be the first</span>
              </a>
            {% endif %}
          </div>
        </div>

        {%- assign sdesc = product.metafields.custom.short_description.value | default: product.metafields.custom.short_description -%}
        <div class="product-single__details" id="ChDetails-{{ section.id }}">
          {% if sdesc != blank %}
            <div class="ch-shortdesc rte">{{ sdesc | metafield_tag }}</div>
          {% endif %}

          <ul class="ch-stack" aria-label="Store info">
            <li class="ch-stack__item">
              <svg class="ch-stack__icon" width="18" height="18" viewBox="0 0 24 24"><path d="M12 2 1 7l11 5 9-4.09V17h2V7L12 2Z"/><path d="M11 12.08 3 8.5V17l8 3.64V12.08Z"/></svg>
              Official Brand Warranty
            </li>
            <li class="ch-stack__item">
              <svg class="ch-stack__icon" width="18" height="18" viewBox="0 0 24 24"><path d="M12 17.27 18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21 12 17.27Z"/></svg>
              Since 1980
            </li>
            <li class="ch-stack__item">
              <svg class="ch-stack__icon" width="18" height="18" viewBox="0 0 24 24"><path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7Zm0 9.5A2.5 2.5 0 1 1 12 6a2.5 2.5 0 0 1 0 5Z"/></svg>
              Pick up near you — <a class="ch-link" href="{{ routes.root_url }}pages/store-locator">Store Finder</a>
            </li>
          </ul>

          {% if shop.taxes_included or shop.shipping_policy.body != blank %}
            <div class="product-single__policies rte">
              {% if shop.taxes_included %}{{ 'products.product.include_taxes' | t }}{% endif %}
              {% if shop.shipping_policy.body != blank %}{{ 'products.product.shipping_policy_html' | t: link: shop.shipping_policy.url }}{% endif %}
            </div>
          {% endif %}
        </div>

        {% capture form_class %}product-form{% endcapture %}
        {% capture form_id %}AddToCartForm-{{ section.id }}{% endcapture %}
        {% form 'product', product, class:form_class, id:form_id %}

          {% unless product.has_only_default_variant %}
            {% for option in product.options_with_values %}
              <div class="selector-wrapper js product-form__item">
                <label {% if option.name == 'default' %}class="label--hidden"{% endif %} for="SingleOptionSelector-{{ section.id }}-{{ forloop.index0 }}">{{ option.name }}</label>
                <select class="single-option-selector single-option-selector-{{ section.id }} product-form__input"
                        id="SingleOptionSelector-{{ forloop.index0 }}"
                        data-name="{{ option.name }}"
                        data-index="option{{ forloop.index }}">
                  {% for value in option.values %}
                    <option value="{{ value | escape }}"{% if option.selected_value == value %} selected="selected"{% endif %}>{{ value }}</option>
                  {% endfor %}
                </select>
              </div>
            {% endfor %}
          {% endunless %}

          <select name="id" id="ProductSelect-{{ section.id }}" class="product-form__variants no-js">
            {% for variant in product.variants %}
              <option {% if variant == current_variant %}selected="selected"{% endif %} data-sku="{{ variant.sku }}" value="{{ variant.id }}" {% unless variant.available %}disabled="disabled"{% endunless %}>
                {% if variant.available %}
                  {{ variant.title }} - {{ variant.price | money_with_currency }}
                {% else %}
                  {{ variant.title }} - {{ 'products.product.sold_out' | t }}
                {% endif %}
              </option>
            {% endfor %}
          </select>

          <!-- CTA row -->
          <div class="product-form__item product-form__item--submit">
            <div class="ch-cta-row" id="ChCtaRow-{{ section.id }}">
              <div class="ch-qty" data-for="Quantity">
                <button type="button" class="ch-qty__btn" aria-label="Decrease" data-act="minus">−</button>
                <input type="number" id="Quantity" name="quantity" value="1" min="1" class="ch-qty__input" aria-label="{{ 'products.product.quantity' | t }}">
                <button type="button" class="ch-qty__btn" aria-label="Increase" data-act="plus">+</button>
              </div>

              <button type="submit"
                      name="add"
                      id="AddToCart-{{ section.id }}"
                      class="btn product-form__cart-submit ch-atc{% unless current_variant.available %} btn--sold-out{% endunless %}"
                      {% unless current_variant.available %}disabled="disabled"{% endunless %}>
                <span id="AddToCartText-{{ section.id }}">{{ 'products.product.add_to_cart' | t }}</span>
              </button>

              <button type="button"
                      class="ch-wishlist-btn"
                      id="WishlistButton-{{ section.id }}"
                      aria-label="Add to wishlist">
                {% render 'icon-wishlist' %}
              </button>
            </div>

            {%- comment -%} PAYMENTS (snippet) {%- endcomment -%}
            {% render 'ch-payments',
              section_id: section.id,
              ext: 'svg',
              all: 'visa,mastercard,amex,jcb,gcash,maya,shopeepay,grabpay,coinsph,billease,bpi,bdo,unionbank,rcbc,hsbc,maybank,711,ecpay',
              pinned: 'visa,mastercard,amex,jcb,bpi,gcash,maya'
            %}
          </div>
        {% endform %}

        {% if section.settings.social_sharing_products %}
          <div class="ch-social-share">
            {% render 'social-sharing', share_title: product.title, share_permalink: product.url, share_image: product.featured_image %}
          </div>
        {% endif %}
      </div>
    </div>
  </div>

  <!-- Keep accessories container (hidden) to preserve DOM order -->
  <div id="w3-product-accessories" data-product-handle="{{ product.handle }}">
    <div id="w3-money-format" style="display:none;">{{ shop.money_format }}</div>
  </div>

  <!-- Sticky Buy Bar -->
  {% render 'ch-sticky-buy-bar', section_id: section.id, product: product, current_variant: current_variant %}
</div>

{% unless product == empty %}
  <script type="application/json" id="ProductJson-{{ section.id }}">{{ product | json }}</script>
  {% if section.settings.stock_enable %}
    <script type="application/json" id="VariantJson-{{ section.id }}">
      [
        {% for variant in product.variants %}
          { "incoming": {{ variant.incoming | default: false | json }},
            "next_incoming_date": {{ variant.next_incoming_date | date: format: 'date' | json }},
            "inventory_policy": {{ variant.inventory_policy | json }},
            "inventory_quantity": {{ variant.inventory_quantity | json }} }{% unless forloop.last %},{% endunless %}
        {% endfor %}
      ]
    </script>
  {% endif %}
{% endunless %}

<script>
/* ==== Zoom (side-pane above UI + smooth animation) & Qty ==== */
(function () {
  var root = document.getElementById('ProductSection-{{ section.id }}'); if (!root) return;

  /* Hide duplicate third-party badges in DETAILS (we show ours under price) */
  root.querySelectorAll('.product-single__details .spr-badge, .product-single__details [class*="okeReviews-starRating"]').forEach(function(n){ n.style.display='none'; });

  /* ====== ZOOM (side-pane; smooth show; highest stacking) ====== */
  var zoomRoot = root.querySelector('[data-ch-zoom]');
  var pane  = root.querySelector('.ch-zoom__pane');
  var lens  = root.querySelector('.ch-zoom__lens');
  var wraps = root.querySelectorAll('.product__photo-wrapper-{{ section.id }}');

  var zoomEnabled = true;
  var hiW=0, hiH=0, scaleX=1, scaleY=1;
  var currentImgRect = null;

  var isTouch = ('ontouchstart' in window) || window.matchMedia('(hover: none)').matches;
  var isSmall = window.matchMedia('(max-width: 749px)').matches;
  if (isTouch || isSmall) {
    zoomEnabled = false;
    if (pane) pane.classList.remove('is-active');
    root.querySelectorAll('.ch-zoom__toggle').forEach(function(btn){
      btn.setAttribute('aria-pressed','false');
      var t = btn.querySelector('.ch-zoom__toggle-text'); if (t) t.textContent = 'Zoom: Off';
      btn.style.display = 'none';
    });
  }

  function hideLens(){ if(lens){ lens.style.transform = 'translate(-9999px,-9999px)'; } }
  function clamp(v,a,b){ return Math.max(a, Math.min(b, v)); }

  function preloadHi(url, r){
    var hi = new Image();
    hi.onload = function(){
      hiW = hi.naturalWidth; hiH = hi.naturalHeight;
      scaleX = hiW / r.width;
      scaleY = hiH / r.height;
      if (pane){
        pane.style.backgroundImage = 'url('+url+')';
        pane.style.backgroundSize  = hiW + 'px ' + hiH + 'px';
      }
    };
    hi.src = url;
  }

  function positionPane(rect){
    if (!pane) return;
    var gap = 16;
    var paneW = pane.clientWidth || 420;
    var paneH = pane.clientHeight || 420;

    var rightX = rect.right + gap;
    var leftX  = rect.left - gap - paneW;
    var canRight = (rightX + paneW) <= window.innerWidth;

    var px = canRight ? rightX : Math.max(12, leftX);
    var py = Math.max(12, Math.min(rect.top, window.innerHeight - paneH - 12));

    pane.style.left = px + 'px';
    pane.style.top  = py + 'px';
  }

  function onEnter(wrap){
    if (!zoomEnabled || !pane) return;
    var img = wrap.querySelector('img'); if (!img) return;
    currentImgRect = img.getBoundingClientRect();

    // show + animate
    if (zoomRoot) zoomRoot.classList.add('zoom-on');
    void pane.offsetWidth; // reflow to ensure animation
    pane.classList.add('is-active');

    positionPane(currentImgRect);
    var full = wrap.getAttribute('data-full') || wrap.getAttribute('href') || img.currentSrc || img.src;
    preloadHi(full, currentImgRect);
  }

  function onMove(e, wrap){
    if (!zoomEnabled || !hiW || !pane || !lens) return;
    if (!currentImgRect) currentImgRect = wrap.querySelector('img').getBoundingClientRect();

    var r = currentImgRect;
    var x = clamp(e.clientX - r.left, 0, r.width);
    var y = clamp(e.clientY - r.top,  0, r.height);

    var lensW = clamp(pane.clientWidth  / scaleX, 40, r.width);
    var lensH = clamp(pane.clientHeight / scaleY, 40, r.height);

    lens.style.width  = lensW + 'px';
    lens.style.height = lensH + 'px';
    lens.style.transform = 'translate(' + (r.left + x - lensW/2) + 'px,' + (r.top + y - lensH/2) + 'px)';

    var bgX = clamp(x*scaleX - pane.clientWidth/2,  0, Math.max(0, hiW - pane.clientWidth));
    var bgY = clamp(y*scaleY - pane.clientHeight/2, 0, Math.max(0, hiH - pane.clientHeight));
    pane.style.backgroundPosition = (-bgX) + 'px ' + (-bgY) + 'px';
  }

  function onLeave(){
    hideLens();
    pane && pane.classList.remove('is-active');
    if (zoomRoot) zoomRoot.classList.remove('zoom-on');
    currentImgRect = null;
  }

  wraps.forEach(function (wrap) {
    var btn = wrap.parentElement.querySelector('.ch-zoom__toggle');
    if (btn) btn.addEventListener('click', function(e){
      e.preventDefault();
      if (isTouch || isSmall) return;
      zoomEnabled = !zoomEnabled;
      btn.setAttribute('aria-pressed', zoomEnabled ? 'true':'false');
      btn.querySelector('.ch-zoom__toggle-text').textContent = 'Zoom: ' + (zoomEnabled ? 'On':'Off');
      if (!zoomEnabled) { onLeave(); }
    });

    wrap.addEventListener('mouseenter', function(){ onEnter(wrap); });
    wrap.addEventListener('mousemove', function(e){ onMove(e, wrap); });
    wrap.addEventListener('mouseleave', onLeave);
  });

  ['scroll','resize'].forEach(function(evt){
    window.addEventListener(evt, function(){
      if (!pane || !pane.classList.contains('is-active')) return;
      var mainImg = root.querySelector('.product__photo-container-{{ section.id }}:not(.hide) .product__photo-wrapper-{{ section.id }} img') || (wraps[0] && wraps[0].querySelector('img'));
      if (!mainImg) return;
      currentImgRect = mainImg.getBoundingClientRect();
      positionPane(currentImgRect);
    }, { passive: true });
  });

  root.querySelectorAll('.product-single__thumbnail').forEach(function (t) {
    t.addEventListener('click', function () {
      var main = root.querySelector('.product__photo-container-{{ section.id }}:not(.hide) .product__photo-wrapper-{{ section.id }} img')
              || root.querySelector('.product__photo-wrapper-{{ section.id }} img');
      if (!main || !pane) return;
      var z = t.getAttribute('data-zoom') || t.getAttribute('href');
      if (z){
        var r = main.getBoundingClientRect();
        preloadHi(z, r);
        currentImgRect = r;
        positionPane(r);
      }
    });
  });
  /* ====== /ZOOM ====== */

  /* Quantity +/- */
  (function(){
    var qtys = root.querySelectorAll('.ch-qty');
    qtys.forEach(function(qty){
      var input = qty.querySelector('input');
      qty.addEventListener('click', function(e){
        var b = e.target.closest('[data-act]'); if(!b) return;
        var v = parseInt(input.value || '1', 10);
        if (b.getAttribute('data-act') === 'minus') v = Math.max(1, v-1);
        if (b.getAttribute('data-act') === 'plus')  v = v+1;
        input.value = v;
        input.dispatchEvent(new Event('change', { bubbles: true }));
      });
    });
  })();

})();
</script>

<style>
.ch-pdp{ font-family: var(--font-sans); }

/* Thumbs below main */
.ch-thumbs-below .product-single__thumbnails{display:flex;gap:10px;flex-wrap:wrap;margin-top:12px}
.ch-thumbs-below .product-single__thumbnail img{width:90px;height:auto;border-radius:8px}

/* Zoom (side pane, highest z-index + smooth appear) */
.ch-pdp .ch-zoom{position:relative}
.ch-pdp .ch-zoom__pane{
  position:fixed;            /* anchored to viewport */
  left:0; top:0;             /* JS repositions beside image */
  width:420px; height:420px;
  overflow:hidden;
  border:1px solid #eee;
  background:#fff no-repeat 0 0 / cover;
  box-shadow:0 12px 32px rgba(0,0,0,.12);
  border-radius:8px;

  /* on-top of everything (incl. ratings/share/wishlist & sticky bar) */
  z-index:2147483605;

  /* smooth show */
  opacity:0; visibility:hidden; transform:translateY(8px) scale(.985);
  transition:opacity .18s ease, transform .18s ease;
  will-change:opacity, transform;
  pointer-events:none;
}
.ch-pdp .ch-zoom__pane.is-active{
  opacity:1; visibility:visible; transform:translateY(0) scale(1);
  pointer-events:auto;
}
.ch-pdp .ch-zoom__lens{
  position:fixed; top:0; left:0;
  border:1px solid rgba(0,0,0,.25);
  background:rgba(255,255,255,.25);
  backdrop-filter:blur(1px);
  pointer-events:none;
  transform:translate(-9999px,-9999px);
  z-index:2147483606;     /* above pane */
  opacity:0; transition:opacity .12s ease;
}
.ch-zoom.zoom-on .ch-zoom__lens{ opacity:1; }
.ch-pdp .ch-zoom__toggle{display:none !important;}
@media (hover:none), (max-width: 749px){ .ch-pdp .ch-zoom__pane{ display:none !important; } }

/* Title & price */
.product-single__vendor{color:#6b7280;margin:0 0 .25rem}
.product-single__title{margin:0 0 .25rem}
.ch-price-red{ color:#d12f24; font-weight:800; font-size:1.4rem }

/* Ratings visuals */
.ch-rating-row{ margin:.25rem 0 .25rem; }
.ch-rating, .ch-stars{ display:inline-flex; align-items:center; gap:.35rem; color:#222; text-decoration:none; position:relative; }
.ch-stars__base,.ch-stars__fill{letter-spacing:.15em}
.ch-rating--empty .ch-stars__base{color:#d12f24;}
.ch-rating--empty .ch-stars__fill{color:#d12f24;position:absolute;overflow:hidden;white-space:nowrap;width:0}
.ch-rating--empty .ch-no-r-msg{font-size:.9rem;color:#555;margin-left:.25rem}

/* Short desc */
.ch-shortdesc{color:#4b5563;margin:.35rem 0 .5rem}

/* Stacked info */
.ch-stack{ list-style:none;margin:.25rem 0 1rem;padding:0;display:grid;gap:.35rem }
.ch-stack__item{ display:flex;align-items:center;gap:.5rem;color:#374151;font-size:.95rem }
.ch-stack__icon{ fill:#9CA3AF }
.ch-link{ color:#ef4444;text-decoration:none } .ch-link:hover{ text-decoration:underline }

/* Policies spacing */
.ch-pdp .product-single__policies{ margin-bottom:12px; }

/* CTA baseline */
.ch-pdp .ch-cta-row{display:flex;align-items:center;gap:12px;flex-wrap:nowrap}

/* Quantity */
.ch-qty{
  box-sizing:border-box;
  display:grid; grid-template-columns:44px 56px 44px;
  align-items:stretch; height:44px;
  border:1.5px solid #1f2937; border-radius:9999px;
  background:#fff; overflow:hidden; padding:0;
}
.ch-qty__btn{ display:flex; align-items:center; justify-content:center; width:44px; height:44px; border:0; background:transparent !important; color:#111; font-size:22px; font-weight:900; line-height:1; }
.ch-qty__btn:hover,.ch-qty__btn:focus{color:#d12f24 !important;}
.ch-qty__input{ width:56px; height:44px; border:0; margin:0; padding:0; background:transparent !important; text-align:center; font-weight:700; font-size:16px; line-height:1; font-variant-numeric:tabular-nums; }
.ch-qty__input::-webkit-outer-spin-button,.ch-qty__input::-webkit-inner-spin-button{ -webkit-appearance:none; margin:0 }

/* ATC & Wishlist */
.ch-pdp .ch-atc{height:40px;padding:0 20px;border-radius:999px;background:#d12f24;color:#fff;font-weight:700;letter-spacing:.02em;text-transform:uppercase}
.ch-pdp .ch-atc:hover{background:#b51f18}
.ch-pdp .ch-wishlist-btn{width:40px;height:40px;border-radius:999px;background:#fff;border:1px solid #E5E7EB;display:inline-grid;place-items:center;box-shadow:0 1px 0 rgba(0,0,0,.02)}
.ch-pdp .ch-wishlist-btn:hover{ border-color:#d12f24; color:#d12f24 }

/* PAYMENTS (chips + +N popover) */
.ch-payments{margin-top:.75rem;position:relative}
.ch-payments__row{display:flex;flex-wrap:wrap;gap:.35rem;align-items:center}
.ch-chip{display:inline-grid;place-items:center;height:22px;padding:0 8px;border:1px solid #E5E7EB;border-radius:6px;background:#fff;font-weight:700}
.ch-chip__img{height:16px;width:auto;display:block;object-fit:contain}
.ch-payments__morebtn{min-width:34px;line-height:1;cursor:pointer}
.ch-pdp .ch-payments .ch-payments__popover{
  position:absolute; top:-10px; left:0; transform:translateY(-100%);
  z-index:40; background:#111; color:#fff; border-radius:10px; padding:12px;
  box-shadow:0 12px 32px rgba(0,0,0,.35)
}
.ch-pdp .ch-payments .ch-payments__popover::after{
  content:""; position:absolute; bottom:-8px; left:28px; width:0; height:0;
  border-left:8px solid transparent; border-right:8px solid transparent; border-top:8px solid #111;
}
.ch-payments__grid{display:grid;grid-template-columns:repeat(3,80px);gap:8px}
.ch-payments__tile{width:80px;height:40px;border-radius:6px;background:#fff;display:grid;place-items:center;box-shadow:inset 0 0 0 1px rgba(0,0,0,.08)}
.ch-payments__tile img{max-width:74px;max-height:34px;object-fit:contain}

/* Social icons */
.ch-social-share{ margin-top:.75rem; }
.ch-social-share .grid{ display:flex; gap:12px; align-items:center; }
.ch-social-share .grid__item{ width:auto; }
.ch-social-share .medium-up--text-right{ text-align:left !important; }
.ch-social-share .social-sharing__title{ display:none !important; }
.ch-social-share a.social-sharing__link{ display:inline-flex; padding:6px 8px; width:auto; height:auto; background:transparent !important; border:none !important; box-shadow:none !important; border-radius:8px; }
.ch-social-share a.social-sharing__link svg{ width:22px; height:22px; fill:#6b7280; transition:fill .15s; }
.ch-social-share a.social-sharing__link:hover svg,
.ch-social-share a.social-sharing__link:focus svg{ fill:#d12f24; }

/* Hide dynamic checkout buttons */
.ch-pdp .product-form__payment-container,
.ch-pdp .product-form__item--payment-button,
.ch-pdp .shopify-payment-button,
.ch-pdp .shopify-payment-button__button,
.ch-pdp .shopify-payment-button__button--unbranded,
.ch-pdp .shopify-payment-button__more-options,
.ch-pdp [data-shopify="payment-button"],
.ch-pdp .gpay-card-info-container,
.ch-pdp .google-pay-button,
.ch-pdp .apple-pay-button,
.ch-pdp .shopify-apple-pay-button,
.ch-pdp .additional-checkout-buttons{display:none!important;height:0!important;margin:0!important;padding:0!important}
.ch-pdp .product-form__item--submit{ margin-bottom:0!important; padding-bottom:0!important; }

/* Hide legacy desc */
#w3-product-accessories{ display:none!important; }
.js-tabs-ready .rte.product-single__description{display:none !important;}

/* ===== MOBILE HAVIT-STYLE STACK ===== */
@media (max-width: 749px){
  .ch-info-col{ display:flex; flex-direction:column; gap:8px; }
  .product-single__meta{ order:1; }
  .product-form{ order:2; }
  .product-single__details{ order:3; margin-top:.5rem; }

  .ch-cta-row{
    display: grid !important;
    width: 100%;
    grid-template-columns: max-content 1fr !important;
    grid-template-areas:
      "qty wish"
      "atc atc" !important;
    justify-items: start !important;
    column-gap: 8px !important;
    row-gap: 12px !important;
    align-items: center;
  }
  .ch-qty{ grid-area: qty; width:auto !important; }
  .ch-wishlist-btn{ grid-area: wish; justify-self:start !important; }
  .ch-atc{ grid-area: atc; width:100% !important; height:52px !important; border-radius:999px !important; }

  .ch-payments{ order:4; width:100%; margin-top:8px; }
  .ch-payments__row{ justify-content:center; gap:6px; }

  .ch-pdp .ch-payments .ch-payments__popover{
    position: fixed !important;
    left: 12px; right: 12px; bottom: 12px;
    top: auto; transform: none !important;
    border-radius: 12px; padding: 14px;
    max-height: 42vh; overflow: auto;
  }
  .ch-payments__grid{ grid-template-columns: repeat(4, 1fr); gap:10px; }
  .ch-payments__tile{ width:100%; height:56px; }
  .ch-payments__tile img{ max-width:90%; max-height:70%; }
  .ch-social-share{ order:5; text-align:center; }
  .ch-social-share .grid{ justify-content:center; }
}

/* Extra-small ergonomics */
@media (max-width: 400px){
  .ch-qty{ grid-template-columns:40px 52px 40px; height:40px; }
  .ch-qty__btn{ width:40px; height:40px; font-size:20px; }
  .ch-qty__input{ width:52px; height:40px; font-size:15px; }
  .ch-atc{ height:48px !important; }
}

/* --- Tabs full-bleed fix --- */
.ch-tabs{
  width:auto !important; margin-left:0 !important; margin-right:0 !important; padding-top:0 !important;
  position:relative; background:transparent !important;
}
.ch-tabs::before{ content:none !important; }
.ch-tabs{ box-shadow: 0 0 0 100vmax var(--ch-section-bg); clip-path: inset(0 -100vmax); }
.ch-tabs__bar[role="tablist"], .ch-tabpane{ max-width: var(--ch-content-max); margin-inline:auto; padding-inline:12px; }
.ch-tabs__bar[role="tablist"]{ position:static !important; background:transparent !important; border-bottom:0 !important; padding-top:6px; }

/* ATC rescue grid (all viewports) */
.ch-cta-row{
  display: grid !important;
  grid-template-columns: max-content 1fr max-content;
  grid-template-areas: "qty atc wish";
  align-items: center;
  gap: 12px;
}
.ch-qty{ grid-area: qty; width:auto !important; }
.ch-atc{
  grid-area: atc;
  display:flex !important; align-items:center; justify-content:center;
  width:100% !important; height:44px; border-radius:9999px;
  opacity:1 !important; visibility:visible !important; pointer-events:auto !important;
}
.ch-wishlist-btn{ grid-area: wish; }

/* Hard overrides in case theme hides ATC when dynamic checkout is present */
.product-form__cart-submit,
#AddToCart-{{ section.id }}{ display:inline-flex !important; }
.ch-payments__popover[hidden]{ display:none !important; }

</style>

{% schema %}
{
  "name": { "en": "Product pages" },
  "settings": [
    { "type": "checkbox", "id": "enable_ajax", "label": { "en": "Stay on current page when item is added to cart" }, "default": true },
    { "type": "checkbox", "id": "stock_enable", "label": { "en": "Show stock when less than 10 products available" }, "default": false },
    { "type": "checkbox", "id": "enable_payment_button", "label": { "en": "Show dynamic checkout button" }, "default": true },
    { "type": "checkbox", "id": "social_sharing_products", "label": { "en": "Enable product sharing" }, "default": true }
  ]
}
{% endschema %}
