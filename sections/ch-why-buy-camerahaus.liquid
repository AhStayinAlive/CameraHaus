{% comment %}
CMH · Feature Grid (3 big + 4 small)
- Same page-width container as other sections
- Row 1: exactly 3 LARGE cards
- Row 2: exactly 4 SMALL cards
- Icons via {% render 'ch-icon', name: '...' %} and inherit currentColor
{% endcomment %}

<section id="cmh-fg-{{ section.id }}" class="cmh-fg is-pre" role="region" aria-labelledby="fg-heading-{{ section.id }}">
  <div class="page-width">
    {% if section.settings.heading != blank %}
      <h2 id="fg-heading-{{ section.id }}" class="fg__heading">{{ section.settings.heading }}</h2>
    {% endif %}

    <!-- Row: Large (3-up fixed on desktop) -->
    {% assign lg_count = 0 %}
    <div class="fg__grid fg__grid--lg" role="list">
      {% for block in section.blocks %}
        {% assign t = block.settings %}
        {% if t.size == 'large' and lg_count < 3 %}
          {% assign lg_count = lg_count | plus: 1 %}
          {% assign alt_text = t.image_alt | default: t.title %}
          <article role="listitem" class="fg__card fg__card--lg" style="--lg-img-w: {{ t.center_img_w | default: 70 }}%;" {{ block.shopify_attributes }}>
            {% if t.link != blank %}<a class="fg__link fg__link--lg" href="{{ t.link }}">{% else %}<div class="fg__link fg__link--lg">{% endif %}
              <div class="fg__lg-center">
                {% if t.title != blank %}<h3 class="fg__lg-title">{{ t.title }}</h3>{% endif %}
                {% if t.subtitle != blank %}<p class="fg__lg-sub">{{ t.subtitle }}</p>{% endif %}
                {% if t.image != blank %}
                  <div class="fg__lg-media">
                    {{ t.image
                      | image_url: width: 1600
                      | image_tag:
                          widths: '600,900,1200,1600',
                          sizes: '(max-width: 740px) 90vw, (max-width: 1100px) 60vw, 30vw',
                          loading: 'lazy',
                          decoding: 'async',
                          alt: alt_text }}
                  </div>
                {% endif %}
              </div>
            {% if t.link != blank %}</a>{% else %}</div>{% endif %}
          </article>
        {% endif %}
      {% endfor %}
    </div>

    <!-- Row: Small (4-up fixed on desktop) -->
    {% assign sm_count = 0 %}
    <div class="fg__grid fg__grid--sm" role="list">
      {% for block in section.blocks %}
        {% assign t = block.settings %}
        {% if t.size == 'small' and sm_count < 4 %}
          {% assign sm_count = sm_count | plus: 1 %}
          <article role="listitem" class="fg__card fg__card--sm" {{ block.shopify_attributes }}>
            {% if t.link != blank %}<a class="fg__link fg__link--sm" href="{{ t.link }}">{% else %}<div class="fg__link fg__link--sm">{% endif %}
              <div class="fg__sm-main">
                {% if t.icon_name != blank %}
                  <div class="fg__sm-icon">{% render 'ch-icon', name: t.icon_name %}</div>
                {% endif %}
                <div class="fg__sm-text">
                  {% if t.title != blank %}<h3 class="fg__sm-title">{{ t.title }}</h3>{% endif %}
                  {% if t.subtitle != blank %}<p class="fg__sm-sub">{{ t.subtitle }}</p>{% endif %}
                </div>
                {% if t.big_text != blank %}
                  <div class="fg__sm-big">{{ t.big_text }}</div>
                {% endif %}
              </div>
            {% if t.link != blank %}</a>{% else %}</div>{% endif %}
          </article>
        {% endif %}
      {% endfor %}
    </div>
  </div>

  <style>
    /* ---------- CSS Vars & Section Spacing ---------- */
    #cmh-fg-{{ section.id }}{
      --brand: {{ section.settings.accent | default: '#d12f24' }};
      --ink: #0f172a;
      --muted: #6b7280;
      --card-bg: #fff;

      --gap-lg: 24px;
      --gap-sm: 20px;

      --pad-t: {{ section.settings.pad_t | default: 24 }}px;
      --pad-b: {{ section.settings.pad_b | default: 24 }}px;

      padding-top: var(--pad-t);
      padding-bottom: var(--pad-b);
    }

    /* Container parity with other sections */
    #cmh-fg-{{ section.id }} .page-width{
      max-width:1440px;
      margin:0 auto;
      padding:0 28px;
    }

    /* Mobile: smaller top gap + tighter heading + narrower side padding */
    @media (max-width: 740px){
      #cmh-fg-{{ section.id }}{
        padding-top:8px; /* reduce gap from previous section on mobile */
      }
      #cmh-fg-{{ section.id }} .page-width{
        padding:0 16px;
      }
      #cmh-fg-{{ section.id }} .fg__heading{
        margin-top:0;
        margin-bottom:12px;
      }
    }

    /* ---------- Grids ---------- */
    .fg__grid{ display:grid; align-items:stretch; }
    .fg__grid--lg{
      grid-template-columns: repeat(3, minmax(0,1fr));
      gap: var(--gap-lg);
      margin-bottom: 18px;
    }
    .fg__grid--sm{
      grid-template-columns: repeat(4, minmax(0,1fr));
      gap: var(--gap-sm);
    }

    @media (max-width:1100px){
      .fg__grid--lg{ grid-template-columns: repeat(2, minmax(0,1fr)); }
      .fg__grid--sm{ grid-template-columns: repeat(2, minmax(0,1fr)); }
    }
    @media (max-width:740px){
      .fg__grid--lg{ grid-template-columns: 1fr; }
      .fg__grid--sm{ grid-template-columns: 1fr; } /* stacked like your 2nd screenshot */
    }

    /* ---------- Card Base ---------- */
    .fg__card{
      position:relative;
      background:var(--card-bg);
      border:1px solid rgba(15,23,42,.06);
      border-radius:16px;
      box-shadow: 0 6px 18px rgba(0,0,0,.06);
      transition:
        transform .22s cubic-bezier(.22,.61,.36,1),
        box-shadow .22s cubic-bezier(.22,.61,.36,1),
        background-color .18s ease,
        color .18s ease;
      will-change: transform;
      color: var(--ink);
    }
    .fg__card--lg{ min-height:360px; }
    .fg__card--sm{ min-height:180px; border-radius:14px; }

    @media (max-width:1100px){
      .fg__card--lg{ min-height:320px; }
      .fg__card--sm{ min-height:170px; }
    }
    @media (max-width:740px){
      .fg__card--lg{ min-height:220px; }
      .fg__card--sm{ min-height:160px; border-radius:12px; }
    }

    /* Shared hover "expand" */
    .fg__card--lg:hover,
    .fg__card--sm:hover{
      transform: translateY(-3px) scale(1.02);
      box-shadow: 0 14px 32px rgba(0,0,0,.16);
    }

    /* Link wrapper padding */
    .fg__link{ display:block; height:100%; text-decoration:none; color:inherit; }
    .fg__link--lg{ padding: clamp(26px, 3vw, 40px); }
    .fg__link--sm{ padding: clamp(18px, 2.4vw, 24px); }

    @media (max-width:740px){
      .fg__link--lg{ padding: 18px 18px 20px; }
      .fg__link--sm{ padding: 14px 14px 16px; }
    }

    /* ---------- SMALL Cards (Affiliate/Wholesale/Rewards style) ---------- */
    .fg__sm-main{
      display:flex;
      align-items:center;
      gap:16px;
      height:100%;
    }

    .fg__sm-icon{
      color: var(--brand);
      flex-shrink:0;
      display:flex;
      align-items:center;
      justify-content:center;
    }
    .fg__sm-icon svg{
      width:32px;
      height:32px;
      display:block;
    }

    .fg__sm-text{
      display:flex;
      flex-direction:column;
      gap:4px;
      flex:1;
    }

    /* Desktop: strong headline + clean subtitle */
    .fg__sm-title{
      margin:0;
      font-weight:800;
      line-height:1.25;
      font-size: clamp(1.1rem, 1rem + 0.6vw, 1.5rem);
      color: var(--ink);
    }
    .fg__sm-sub{
      margin:0;
      line-height:1.45;
      color: var(--muted);
      font-size: clamp(.9rem, .85rem + 0.25vw, 1rem);
      white-space: normal;   /* never truncate */
      overflow: visible;
      text-overflow: clip;
    }

    .fg__sm-big{
      font-weight:800;
      line-height:1;
      font-size: clamp(2.2rem, 1.8rem + 1vw, 3rem); /* nice, bold number on desktop */
      color: var(--brand);
      white-space: nowrap;
    }

    /* SMALL hover colors */
    .fg__card--sm:hover{
      background: var(--brand);
      color:#fff;
    }
    .fg__card--sm:hover .fg__sm-title,
    .fg__card--sm:hover .fg__sm-sub,
    .fg__card--sm:hover .fg__sm-big{ color:#fff; }
    .fg__card--sm:hover .fg__sm-icon{ color:#fff; }

    /* MOBILE: stack like reference screenshot, center everything, number under text */
    @media (max-width:740px){
      .fg__sm-main{
        flex-direction:column;
        align-items:center;
        text-align:center;
        gap:10px;
      }
      .fg__sm-text{
        align-items:center;
      }
      .fg__sm-title{
        font-size: 1.2rem;   /* slightly bigger on mobile */
      }
      .fg__sm-sub{
        font-size: 0.9rem;
        line-height:1.4;
      }
      .fg__sm-icon svg{
        width:28px;
        height:28px;
      }
      .fg__sm-big{
        font-size: 2.4rem;   /* big number stands out more on mobile */
      }
    }

    /* ---------- LARGE Cards ---------- */
    .fg__lg-center{
      display:flex;
      flex-direction:column;
      align-items:center;
      text-align:center;
      gap: 12px;
      height:100%;
      justify-content:center;
    }
    .fg__lg-title{
      margin:0;
      font-weight:600;
      letter-spacing:-.01em;
      color:#111827;
      font-size: clamp(1.1rem, 1rem + 0.7vw, 1.6rem);
      line-height:1.3;
    }
    .fg__lg-sub{
      margin:0;
      color: var(--muted);
      font-weight:400;
      font-size: clamp(.95rem, .9rem + 0.25vw, 1.1rem);
    }
    .fg__lg-media img{
      display:block;
      width:100%;
      height:auto;
      max-width: var(--lg-img-w, 70%);
      margin-inline:auto;
      image-rendering: -webkit-optimize-contrast;
    }

    @media (max-width:740px){
      .fg__lg-media img{ max-width:60%; }
      .fg__lg-title{ font-size:1rem; }
      .fg__lg-sub{ font-size:.85rem; }
    }

    /* ---------- Appear (single run) ---------- */
    #cmh-fg-{{ section.id }}.is-pre .fg__card{
      opacity: 0;
      transform: translateY(10px);
    }
    #cmh-fg-{{ section.id }} .fg__card[data-reveal]{
      opacity: 0;
      transform: translateY(14px);
    }
    #cmh-fg-{{ section.id }} .fg__card.is-in{
      opacity: 1;
      transform: none;
    }

    /* ---------- Reduced Motion ---------- */
    @media (prefers-reduced-motion: reduce){
      #cmh-fg-{{ section.id }} .fg__card,
      #cmh-fg-{{ section.id }} .fg__card *{
        transition: none !important;
        animation: none !important;
      }
      #cmh-fg-{{ section.id }}.is-pre .fg__card{
        opacity:1;
        transform:none;
      }
    }

    .fg__heading{
      margin:0 0 16px;
      font-weight:700;
      letter-spacing:-.01em;
      line-height:1.15;
      font-size:clamp(24px, 3vw + 8px, 32px);
      color: var(--heading-color, inherit);
    }
        /* ---------- SMALL Cards (Affiliate/Wholesale/Rewards style) ---------- */
    /* DESKTOP layout: icon + title left, big number right, subtitle centered below */
    .fg__sm-main{
      display:grid;
      grid-template-columns:auto 1fr auto;
      grid-auto-rows:auto;
      column-gap:16px;
      row-gap:6px;
      align-items:center;
      height:100%;
    }

    /* flatten wrapper so we can place title + subtitle as grid items */
    .fg__sm-text{
      display:contents;
    }

    .fg__sm-icon{
      color: var(--brand);
      flex-shrink:0;
      display:flex;
      align-items:center;
      justify-content:center;
      grid-column:1;
      grid-row:1;
    }
    .fg__sm-icon svg{
      width:32px;
      height:32px;
      display:block;
    }

    /* title: left-aligned next to icon */
    .fg__sm-title{
      margin:0;
      font-weight:800;
      line-height:1.25;
      font-size: clamp(1.1rem, 1rem + 0.6vw, 1.5rem);
      color: var(--ink);
      grid-column:2;
      grid-row:1;
      text-align:left;
    }

    /* subtitle: full width, centered under everything */
    .fg__sm-sub{
      margin:0;
      line-height:1.45;
      color: var(--muted);
      font-size: clamp(.9rem, .85rem + 0.25vw, 1rem);
      white-space: normal;
      overflow: visible;
      text-overflow: clip;
      grid-column:1 / -1;    /* span whole card */
      grid-row:2;
      text-align:center;
    }

    /* big number: right side of top row (if present) */
    .fg__sm-big{
      font-weight:800;
      line-height:1;
      font-size: clamp(2.2rem, 1.8rem + 1vw, 3rem);
      color: var(--brand);
      white-space: nowrap;
      grid-column:3;
      grid-row:1;
    }

    /* SMALL hover colors */
    .fg__card--sm:hover{
      background: var(--brand);
      color:#fff;
    }
    .fg__card--sm:hover .fg__sm-title,
    .fg__card--sm:hover .fg__sm-sub,
    .fg__card--sm:hover .fg__sm-big{ color:#fff; }
    .fg__card--sm:hover .fg__sm-icon{ color:#fff; }
/* ---------- SMALL Cards (desktop & default) ---------- */
/* Desktop: icon + title left on top row, subtitle centered below, top-aligned */
.fg__card--sm{
  min-height: 150px;       /* you can go 130–150px to taste */
  border-radius:14px;
}

.fg__sm-main{
  display:grid;
  grid-template-columns:auto 1fr auto;
  grid-auto-rows:auto;
  column-gap:16px;
  row-gap:4px;
  align-items:flex-start;  /* TOP align instead of center */
  height:auto;             /* let content decide */
}

.fg__sm-text{
  display:contents;        /* lets title/sub act as grid items */
}

.fg__sm-icon{
  color: var(--brand);
  flex-shrink:0;
  display:flex;
  align-items:flex-start;
  justify-content:center;
  grid-column:1;
  grid-row:1;
}
.fg__sm-icon svg{
  width:32px;
  height:32px;
  display:block;
}

/* title: left next to icon */
.fg__sm-title{
  margin:0;
  font-weight:800;
  line-height:1.25;
  font-size: clamp(1.1rem, 1rem + 0.6vw, 1.5rem);
  color: var(--ink);
  grid-column:2;
  grid-row:1;
  text-align:left;
}

/* subtitle: centered under whole row */
.fg__sm-sub{
  margin:4px 0 0;
  line-height:1.45;
  color: var(--muted);
  font-size: clamp(.9rem, .85rem + 0.25vw, 1rem);
  white-space: normal;
  overflow: visible;
  text-overflow: clip;
  grid-column:1 / -1;
  grid-row:2;
  text-align:center;
}

/* big number: right side of top row (if present) */
.fg__sm-big{
  font-weight:800;
  line-height:1;
  font-size: clamp(2.1rem, 1.7rem + 1vw, 2.7rem);
  color: var(--brand);
  white-space: nowrap;
  grid-column:3;
  grid-row:1;
}

/* SMALL hover colors */
.fg__card--sm:hover{
  background: var(--brand);
  color:#fff;
}
.fg__card--sm:hover .fg__sm-title,
.fg__card--sm:hover .fg__sm-sub,
.fg__card--sm:hover .fg__sm-big{ color:#fff; }
.fg__card--sm:hover .fg__sm-icon{ color:#fff; }

/* ---------- MOBILE overrides (less white space, stacked) ---------- */
@media (max-width:740px){
  .fg__card--sm{
    min-height:auto;                /* shrink on mobile */
    border-radius:12px;
  }
  .fg__grid--sm{
    gap:12px;                       /* tighter between cards */
  }
  .fg__link--sm{
    padding:10px 12px 12px;         /* less vertical padding */
  }

  .fg__sm-main{
    display:flex;
    flex-direction:column;
    align-items:center;
    text-align:center;
    gap:6px;
  }

  .fg__sm-text{
    display:flex;
    flex-direction:column;
    align-items:center;
  }

  .fg__sm-title{
    font-size:1.1rem;
    text-align:center;
  }
  .fg__sm-sub{
    font-size:0.9rem;
    line-height:1.4;
    text-align:center;
    margin-top:2px;
  }

  .fg__sm-icon svg{
    width:28px;
    height:28px;
  }
  .fg__sm-big{
    font-size:2.2rem;
  }
}


  </style>

  <script>
  (function(){
    var root = document.getElementById('cmh-fg-{{ section.id }}');
    if(!root) return;

    var reduceMotion = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    var lg = Array.prototype.slice.call(root.querySelectorAll('.fg__grid--lg .fg__card'));
    var sm = Array.prototype.slice.call(root.querySelectorAll('.fg__grid--sm .fg__card'));
    var cards = lg.concat(sm);

    cards.forEach(function(c){ c.setAttribute('data-reveal',''); });

    function instantShow(){
      root.classList.remove('is-pre');
      cards.forEach(function(c){
        c.classList.add('is-in');
        c.removeAttribute('data-reveal');
      });
    }

    var ran = false;
    function revealOnce(){
      if(ran) return; ran = true;
      root.classList.remove('is-pre');

      cards.forEach(function(card, i){
        var delay = reduceMotion ? 0 : i * 120;
        setTimeout(function(){
          card.classList.add('is-in');
          card.removeAttribute('data-reveal');
        }, delay);
      });
    }

    if(reduceMotion){
      instantShow();
      return;
    }

    if('IntersectionObserver' in window){
      var io = new IntersectionObserver(function(entries){
        entries.forEach(function(entry){
          if(entry.isIntersecting){
            revealOnce();
            io.disconnect();
          }
        });
      }, { threshold: 0.35 });
      io.observe(root);
    } else {
      revealOnce();
    }
  })();
  </script>

</section>

{% schema %}
{
  "name": "CMH · Feature Grid (3+4)",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Why shop with CameraHaus" },
    { "type": "color", "id": "accent", "label": "Accent color", "default": "#d12f24" },
    { "type": "range", "id": "pad_t", "label": "Padding top", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 24 },
    { "type": "range", "id": "pad_b", "label": "Padding bottom", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 24 }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature",
      "settings": [
        {
          "type": "select",
          "id": "size",
          "label": "Card size",
          "default": "large",
          "options": [
            { "value": "large", "label": "Large (top row)" },
            { "value": "small", "label": "Small (bottom row)" }
          ]
        },
        { "type": "text", "id": "title", "label": "Title", "default": "Feature headline" },
        { "type": "text", "id": "subtitle", "label": "Subtitle (optional)" },

        { "type": "text", "id": "icon_name", "label": "Icon name (SMALL only)", "info": "Used by the 'ch-icon' snippet; leave blank for LARGE" },

        { "type": "image_picker", "id": "image", "label": "PNG image (LARGE only)" },
        { "type": "text", "id": "image_alt", "label": "Image alt text" },
        {
          "type": "range",
          "id": "center_img_w",
          "label": "PNG max width (LARGE)",
          "min": 30, "max": 100, "step": 5, "unit": "%", "default": 70
        },

        { "type": "text", "id": "big_text", "label": "Big number (SMALL)", "info": "Optional; shows as large red text" },
        { "type": "url", "id": "link", "label": "Link (optional)" }
      ]
    }
  ],
  "presets": [
    {
      "name": "CMH · Feature Grid (3+4)",
      "blocks": [
        { "type": "feature", "settings": { "size": "large", "title": "1% DJI Credit Reward", "subtitle": "Get value back on eligible DJI purchases" } },
        { "type": "feature", "settings": { "size": "large", "title": "Free Shipping Over ₱9,999", "subtitle": "Nationwide delivery with careful packing" } },
        { "type": "feature", "settings": { "size": "large", "title": "Official Accessories", "subtitle": "Genuine brands and authorized partners" } },

        { "type": "feature", "settings": { "size": "small", "icon_name": "store", "title": "60+ Stores Nationwide", "subtitle": "Find a branch near you" } },
        { "type": "feature", "settings": { "size": "small", "icon_name": "badge-check", "title": "Official Brand Warranty", "subtitle": "Hassle-free claims" } },
        { "type": "feature", "settings": { "size": "small", "icon_name": "tag", "title": "Weekly Deals", "subtitle": "Fresh promos every week", "big_text": "30" } },
        { "type": "feature", "settings": { "size": "small", "icon_name": "headset", "title": "After-Sales Support", "subtitle": "Chat, phone, and in-store help" } }
      ]
    }
  ]
}
{% endschema %}
