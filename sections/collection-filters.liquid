  // ---------- FETCH & UPDATE (single request) ----------
async function updateFromURL(urlLike) {
  console.log('[CH Filters] updateFromURL called with:', urlLike);
  const grid = liveGrid();
  const url = urlLike instanceof URL ? urlLike : new URL(urlLike, location.origin);

  const res = await fetch(url.toString(), {
    headers: { 'X-Requested-With': 'XMLHttpRequest' },
    credentials: 'same-origin',
  });
  if (!res.ok) throw new Error('HTTP ' + res.status);

  const html = await res.text();
  const tmp  = document.createElement('div');
  tmp.innerHTML = html;

  // 1️⃣ Update product grid
  if (grid) {
    let freshGrid = null;
    for (const sel of gridSelectors) {
      const cand = tmp.querySelector(sel);
      if (cand) { freshGrid = cand; break; }
    }
    console.log('[CH Filters] freshGrid found:', !!freshGrid, 'Selector used:', gridSelectors);
    if (freshGrid) {
      grid.innerHTML = freshGrid.innerHTML;

      // keep your lazy-load / animation behaviour
      const imgs = grid.querySelectorAll('img');
      imgs.forEach((img, i) => {
        if (!img.hasAttribute('loading')) img.loading = 'lazy';
        img.decoding = 'async';
        if (i < 6) img.fetchPriority = 'high';
      });

      const kids = grid.children;
      grid.classList.add('ch-grid-animate-in');
      Array.from(kids).forEach((el, i) => {
        el.style.animationDelay = (i * 0.045) + 's';
      });
      setTimeout(() => {
        grid.classList.remove('ch-grid-animate-in');
      }, 650);
    }
  }

  // 1.5️⃣ Update pagination
  const freshPag   = tmp.querySelector('nav.pagination');
  const currentPag = document.querySelector('nav.pagination');

  if (freshPag && currentPag) {
    currentPag.replaceWith(freshPag);
  } else if (freshPag && !currentPag && grid && grid.parentElement) {
    // if no existing nav, append after the grid
    grid.parentElement.appendChild(freshPag);
  }

  // 2️⃣ Update filters (this section’s form + count)
  const freshForm  = tmp.querySelector(`#ChForm-${SECTION_ID}`);
  const freshCount = tmp.querySelector(`#ChCount-${SECTION_ID}`);

  if (freshForm && freshForm.children.length) {
    $form.innerHTML = freshForm.innerHTML;
    attachPrice();
    limitAllLists($form);
    placeForm();
  }

  if (freshCount && $count) {
    $count.textContent = freshCount.textContent;
  }
}
