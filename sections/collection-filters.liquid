{%- comment -%}
  sections/collection-filters-havit.liquid — Havit-style Top Filters + Chips + Brand & Product Type
  • Desktop unchanged (in-page popover under controls).
  • Mobile (<990px): slide-in Filter drawer (left) + separate Sort drawer (right).
  • Progressive enhancement: if drawers fail, desktop popover still works.
  • Additive animations: results pulse + slide-up cards after apply.
{%- endcomment -%}

{%- assign _grid_id = section.settings.grid_section_id | default: 'main-collection-product-grid' -%}
{%- assign sort_by = collection.sort_by | default: collection.default_sort_by -%}

{%- assign has_product_type = false -%}
{%- assign has_vendor = false -%}

<section id="hv-filters-{{ section.id }}"
         class="hv"
         data-grid-section-id="{{ _grid_id }}"
         data-grid-selector="#CollectionProductGrid, #MainCollectionProductGrid, #main-collection-product-grid, #collection-product-grid, #product-grid, #ProductGrid, .collection__products, .product-grid"
         data-collection-url="{{ collection.url }}"
         aria-label="Collection controls and filters">

  <style>
    #hv-filters-{{ section.id }}{
      --line:#e5e7eb; --ink:#111827; --muted:#6b7280; --brand:#E0302A; --surface:#fff;
      --radius:14px; --gap:12px; --shadow:0 20px 40px rgba(17,17,17,.12);
      --z-pop: 60;              /* desktop popover */
      --z-scrim: 90;            /* mobile overlay */
      --z-drawer: 95;           /* mobile drawers above scrim */
      --drawer-w: min(360px, 92vw);
    }
    #hv-filters-{{ section.id }} .sr-only{position:absolute!important;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}

    /* Controls bar */
    #hv-filters-{{ section.id }} .hv-controls-wrap{position:relative}
    #hv-filters-{{ section.id }} .hv-controls{
      display:flex; align-items:center; gap:12px; flex-wrap:wrap;
      padding:10px 12px; border:1px solid var(--line); border-radius:var(--radius);
      background:var(--surface);
    }
    #hv-filters-{{ section.id }} .hv-filter-btn{
      display:inline-flex; align-items:center; gap:8px;
      border:1px solid var(--line); background:#fff; padding:10px 12px; border-radius:10px;
      cursor:pointer; font: inherit; color:var(--ink);
    }
    #hv-filters-{{ section.id }} .hv-filter-btn svg{width:18px;height:18px}

    /* Desktop sort select (hidden on mobile below) */
    #hv-filters-{{ section.id }} .hv-sort{margin-left:auto; display:flex; align-items:center; gap:8px}
    #hv-filters-{{ section.id }} .hv-sort label{font-size:14px; color:var(--muted)}
    #hv-filters-{{ section.id }} .hv-sort select{
      appearance:none; -webkit-appearance:none; -moz-appearance:none;
      padding:10px 28px 10px 12px; border:1px solid var(--line); border-radius:10px; background:#fff; color:var(--ink);
      background-image: linear-gradient(45deg, transparent 50%, var(--muted) 50%), linear-gradient(135deg, var(--muted) 50%, transparent 50%);
      background-position: right 10px top 16px, right 4px top 16px;
      background-size: 8px 8px, 8px 8px; background-repeat:no-repeat;
    }
    /* Mobile sort button (enabled only under 989px) */
    #hv-filters-{{ section.id }} .hv-sortbtn{display:none; align-items:center; gap:8px; border:1px solid var(--line); background:#fff; padding:10px 12px; border-radius:10px; cursor:pointer}
    #hv-filters-{{ section.id }} .hv-sortbtn svg{width:18px;height:18px}

    #hv-filters-{{ section.id }} .hv-count{font-size:14px; color:var(--muted)}

    /* Chips row */
    #hv-filters-{{ section.id }} .hv-bar-below{display:flex; flex-wrap:wrap; align-items:center; gap:8px; padding:8px 0 0}
    #hv-filters-{{ section.id }} .hv-chipbar{display:flex; flex-wrap:wrap; gap:8px}
    #hv-filters-{{ section.id }} .hv-chip{display:inline-flex; align-items:center; gap:8px; padding:8px 10px; border-radius:999px; background:#f3f4f6; font-size:13px}
    #hv-filters-{{ section.id }} .hv-chip button{border:none; background:transparent; cursor:pointer; line-height:1}
    #hv-filters-{{ section.id }} .hv-clearall{margin-left:auto; border:none; background:transparent; color:var(--brand); text-decoration:underline; display:none}

    /* In-page desktop panel (unchanged) */
    #hv-filters-{{ section.id }} .hv-pop{
      position:relative; margin-top:10px;
      background:#fff; border:1px solid var(--line); border-radius:var(--radius);
      box-shadow:var(--shadow); display:none; z-index:var(--z-pop);
    }
    #hv-filters-{{ section.id }} .hv-pop.is-open{display:block}
    #hv-filters-{{ section.id }} .hv-pop__inner{padding:16px}
    #hv-filters-{{ section.id }} .hv-grid{display:grid; gap:18px}
    @media(min-width: 990px){ #hv-filters-{{ section.id }} .hv-grid{grid-template-columns: 1fr 1fr 1fr} }
    @media(max-width: 989px){ #hv-filters-{{ section.id }} .hv-grid{grid-template-columns: 1fr 1fr} }

    #hv-filters-{{ section.id }} .hv-group h3{
      margin:0 0 8px; font-size:16px; color:var(--ink); border-bottom:2px solid #1111; padding-bottom:4px;
    }
    #hv-filters-{{ section.id }} .hv-list{list-style:none; margin:0; padding:0; display:grid; gap:8px; max-height:240px; overflow:auto}
    #hv-filters-{{ section.id }} .hv-check{display:grid; grid-template-columns:auto 1fr auto; align-items:center; gap:8px}
    #hv-filters-{{ section.id }} .hv-check input{width:18px;height:18px}
    #hv-filters-{{ section.id }} .hv-check .cnt{font-size:12px; color:var(--muted)}

    /* Price */
    #hv-filters-{{ section.id }} .hv-price{display:grid; gap:8px}
    #hv-filters-{{ section.id }} .hv-price__row{display:flex; gap:8px; align-items:center; flex-wrap:wrap}
    #hv-filters-{{ section.id }} .hv-price input[type="text"]{
      flex:1 1 120px; min-width:120px; padding:8px 10px; border:1px solid var(--line); border-radius:10px;
    }
    #hv-filters-{{ section.id }} .hv-range{display:grid; gap:8px}
    #hv-filters-{{ section.id }} input[type="range"]{width:100%}

    /* Footer inside form */
    #hv-filters-{{ section.id }} .hv-pop__footer{
      display:flex; flex-wrap:wrap; gap:10px; justify-content:flex-end; margin-top:12px; padding-top:12px; border-top:1px solid var(--line)
    }
    #hv-filters-{{ section.id }} .btn{border:none; cursor:pointer; padding:12px 16px; border-radius:999px; font-weight:600}
    #hv-filters-{{ section.id }} .btn--apply{background:var(--brand); color:#fff}
    #hv-filters-{{ section.id }} .btn--reset{background:#f3f4f6; color:var(--ink)}
    #hv-filters-{{ section.id }} .btn--clear{background:transparent; color:var(--brand); text-decoration:underline; padding:0 8px; border-radius:6px}

    /* Small phones */
    @media(max-width: 640px){
      #hv-filters-{{ section.id }} .hv-pop__inner{max-height:min(70vh, 560px); overflow:auto}
    }

    /* ───────────────── MOBILE-ONLY: drawers & compact layout ───────────────── */
    @media (max-width: 989px){

      /* Show mobile Sort button, hide desktop select */
      #hv-filters-{{ section.id }} .hv-sort{display:none !important}
      #hv-filters-{{ section.id }} .hv-sortbtn{display:inline-flex; margin-left:auto}

      /* Overlay (right side is tappable to dismiss) */
      #hv-filters-{{ section.id }} [data-hv-overlay]{
        position:fixed; inset:0; background:rgba(17,17,17,.44);
        opacity:0; pointer-events:none; transition:opacity .18s ease;
        z-index:var(--z-scrim);
      }
      #hv-filters-{{ section.id }} [data-hv-overlay].is-open{opacity:1; pointer-events:auto}

      /* Left drawer: FLUSH left; overlay occupies the right side */
      #hv-filters-{{ section.id }} .hv-drawer{
        position:fixed; top:0; bottom:0; left:0; right:auto;
        width:var(--drawer-w); height:100vh; background:var(--surface);
        box-shadow:0 24px 64px rgba(17,17,17,.24);
        transform:translate3d(-100%,0,0); transition:transform .24s ease;
        z-index:var(--z-drawer); display:flex; flex-direction:column;
        margin:0 !important; border-radius:0 14px 14px 0;
      }
      #hv-filters-{{ section.id }} .hv-drawer.is-open{ transform:translate3d(0,0,0); }

      /* Right drawer (Sort) */
      #hv-filters-{{ section.id }} .hv-drawer--right{
        right:0; left:auto; border-radius:14px 0 0 14px;
        transform:translate3d(100%,0,0);
      }
      #hv-filters-{{ section.id }} .hv-drawer--right.is-open{ transform:translate3d(0,0,0); }

      /* Drawer chrome */
      #hv-filters-{{ section.id }} .hv-drawer__hd{
        position:sticky; top:0; display:flex; align-items:center; justify-content:space-between; gap:8px;
        padding:12px; border-bottom:1px solid var(--line); background:var(--surface);
      }
      #hv-filters-{{ section.id }} .hv-drawer__hd h2{margin:0; font-size:16px}
      #hv-filters-{{ section.id }} .hv-drawer__close{border:none; background:#f3f4f6; border-radius:10px; padding:8px 10px; cursor:pointer}
      #hv-filters-{{ section.id }} .hv-drawer__bd{flex:1 1 auto; overflow:auto; padding:10px 12px}
      #hv-filters-{{ section.id }} .hv-drawer__ft{
        position:sticky; bottom:0; padding:10px 12px; border-top:1px solid var(--line);
        background:var(--surface); display:flex; gap:8px; justify-content:flex-end;
        padding-bottom:calc(12px + env(safe-area-inset-bottom));
      }

      /* Compact content while in drawers */
      #hv-filters-{{ section.id }} .hv-drawer .hv-grid{ grid-template-columns: 1fr !important; gap: 10px; }
      #hv-filters-{{ section.id }} .hv-group{ padding:10px !important; }
      #hv-filters-{{ section.id }} .hv-group h3{ font-size:14px; margin:0 0 6px; padding-bottom:4px; }
      #hv-filters-{{ section.id }} .hv-drawer [data-type="list"] .hv-list{ display:grid; grid-template-columns:1fr; gap:6px; max-height:none; }
      #hv-filters-{{ section.id }} .hv-check{ grid-template-columns:auto 1fr; gap:8px; font-size:13px; }
      #hv-filters-{{ section.id }} .hv-check .cnt{ display:none; }
      #hv-filters-{{ section.id }} .hv-price{ gap:6px; }
      #hv-filters-{{ section.id }} .hv-price__row{ gap:6px; }
      #hv-filters-{{ section.id }} .hv-price input[type="text"]{ min-width:0; flex:1 1 0; height:36px; padding:7px 10px; font-size:13px; }
      #hv-filters-{{ section.id }} .btn--clear{ padding:4px 8px; font-size:12px; }

      /* Overlapped dual sliders on one track */
      #hv-filters-{{ section.id }} .hv-range{ position:relative; height:36px; }
      #hv-filters-{{ section.id }} .hv-range input[type="range"]{
        position:absolute; inset:0; margin:0; background:transparent; pointer-events:none;
      }
      #hv-filters-{{ section.id }} .hv-range input[type="range"]::-webkit-slider-thumb{ pointer-events:auto; }
      #hv-filters-{{ section.id }} .hv-range input[type="range"]::-moz-range-thumb{ pointer-events:auto; }

      /* Calls-to-action sizing */
      #hv-filters-{{ section.id }} .hv-drawer__ft .btn{ padding:11px 14px; font-size:14px; }
      #hv-filters-{{ section.id }} .hv-drawer__ft .btn--apply{ flex:1 1 auto; }

      /* Better focus rings for chip-like triggers; stop left “bleed” */
      #hv-filters-{{ section.id }} .hv-filter-btn:focus-visible,
      #hv-filters-{{ section.id }} .hv-sortbtn:focus-visible{ outline-offset:-2px; }

      /* Safety: avoid any horizontal scroll while drawer is open */
      html, body{ overflow-x:hidden; }
    }

    /* Desktop guard: drawers/overlay completely inert on >=990px */
    @media (min-width: 990px){
      #hv-filters-{{ section.id }} [data-hv-overlay]{ display:none !important; }
      #hv-filters-{{ section.id }} .hv-drawer{ display:none !important; }
      #hv-filters-{{ section.id }} .hv-sortbtn{ display:none !important; }
    }

    /* === Results highlight + card entrance animation (additive) === */
    #hv-filters-{{ section.id }} .hv-count{ font-weight:600; }
    #hv-filters-{{ section.id }} .hv-count.is-pulse{
      background: linear-gradient(90deg, rgba(224,48,42,.18), transparent);
      padding: 2px 6px; border-radius: 8px;
      animation: hvPulse .9s ease;
    }
    @keyframes hvPulse { from{background:rgba(224,48,42,.25)} to{background:transparent} }

    .hv-card-enter{
      opacity: 0;
      transform: translateY(14px);
      will-change: transform, opacity;
    }
    .hv-card-enter.hv-card-enter-active{
      transition: transform .28s ease, opacity .28s ease;
      opacity: 1;
      transform: translateY(0);
    }
      /* === Mobile: Sort as a bottom sheet (slide-up) === */
  @media (max-width: 989px){
    #hv-filters-{{ section.id }} .hv-drawer--bottom{
      position: fixed;
      left: 0; right: 0; bottom: 0; top: auto;
      width: 100vw; height: auto;
      max-height: min(70vh, 520px);           /* keeps it compact */
      margin: 0 !important;
      background: var(--surface);
      border-radius: 14px 14px 0 0;
      box-shadow: 0 -24px 64px rgba(17,17,17,.24);
      transform: translate3d(0,100%,0);       /* start hidden below */
      transition: transform .24s ease;
      z-index: var(--z-drawer);
      display: flex; flex-direction: column;
    }
    #hv-filters-{{ section.id }} .hv-drawer--bottom.is-open{
      transform: translate3d(0,0,0);          /* slide up */
    }
    #hv-filters-{{ section.id }} .hv-drawer--bottom .hv-drawer__hd{
      padding: 12px 16px; border-bottom: 1px solid var(--line);
    }
    #hv-filters-{{ section.id }} .hv-drawer--bottom .hv-drawer__bd{
      flex: 1 1 auto; overflow: auto; -webkit-overflow-scrolling: touch;
      padding: 6px 16px;
    }
    #hv-filters-{{ section.id }} .hv-drawer--bottom .hv-drawer__ft{
      position: sticky; bottom: 0; padding: 10px 16px;
      border-top: 1px solid var(--line);
      padding-bottom: calc(12px + env(safe-area-inset-bottom));
      background: var(--surface);
    }
  }

  </style>

  <div class="hv-controls-wrap" role="region" aria-label="Collection controls">
    <div class="hv-controls">
      <!-- Filter trigger (reused; desktop toggles popover, mobile opens drawer) -->
      <button type="button" class="hv-filter-btn" id="HavitOpen-{{ section.id }}" aria-expanded="false" aria-controls="HavitPop-{{ section.id }}">
        <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M4 6h16M7 12h10M10 18h4" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
        Filter
      </button>

      <!-- Mobile-only Sort trigger (desktop keeps the select) -->
      <button type="button" class="hv-filter-btn hv-sortbtn" id="HavitSortOpen-{{ section.id }}" aria-expanded="false" aria-controls="HavitDrawerSort-{{ section.id }}">
        <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M6 7h12M6 12h8M6 17h4" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
        Sort
      </button>

      <!-- Desktop Sort -->
      <div class="hv-sort">
        <label for="HavitSort-{{ section.id }}">Sort by</label>
        <select id="HavitSort-{{ section.id }}">
          <option value="best-selling" {% if sort_by == 'best-selling' %}selected{% endif %}>Best selling</option>
          <option value="price-ascending" {% if sort_by == 'price-ascending' %}selected{% endif %}>Price: Low → High</option>
          <option value="price-descending" {% if sort_by == 'price-descending' %}selected{% endif %}>Price: High → Low</option>
          <option value="created-descending" {% if sort_by == 'created-descending' %}selected{% endif %}>Newest</option>
          <option value="title-ascending" {% if sort_by == 'title-ascending' %}selected{% endif %}>A → Z</option>
          <option value="title-descending" {% if sort_by == 'title-descending' %}selected{% endif %}>Z → A</option>
        </select>
      </div>

      <span class="hv-count" id="HavitCount-{{ section.id }}" aria-live="polite">{{ collection.products_count }} results</span>
    </div>

    <div class="hv-bar-below">
      <div class="hv-chipbar" data-chips></div>
      <button type="button" class="hv-clearall" data-clear-all>Clear all</button>
    </div>

    <!-- In-page collapsible panel (desktop) -->
    <div id="HavitPop-{{ section.id }}" class="hv-pop" role="dialog" aria-modal="true" aria-label="Filters" aria-hidden="true">
      <div class="hv-pop__inner" data-form-home>
        <form id="HavitForm-{{ section.id }}" class="hv-form" novalidate>
          <div class="hv-grid">
            {%- for filter in collection.filters -%}
              {%- assign _lbl_norm = filter.label | strip | downcase -%}
              {%- if _lbl_norm == 'product type' -%}{% assign has_product_type = true %}{% endif -%}
              {%- if _lbl_norm == 'brand' or _lbl_norm == 'vendor' or filter.param_name == 'filter.p.vendor' -%}{% assign has_vendor = true %}{% endif -%}

              {%- if filter.type == 'price_range' -%}
                <fieldset class="hv-group hv-price" data-type="price">
                  <legend class="sr-only">Price</legend>
                  <h3>Price</h3>
                  <div class="hv-price__row">
                    <label class="sr-only" for="min-{{ section.id }}">Min</label>
                    <input id="min-{{ section.id }}" name="{{ filter.min_value.param_name }}" type="text"
                           inputmode="numeric"
                           value="{% if filter.min_value.value %}{{ filter.min_value.value | divided_by: 100 | floor }}{% endif %}"
                           placeholder="{{ cart.currency.symbol }}0">

                    <span aria-hidden="true">–</span>

                    <label class="sr-only" for="max-{{ section.id }}">Max</label>
                    <input id="max-{{ section.id }}" name="{{ filter.max_value.param_name }}" type="text"
                           inputmode="numeric"
                           value="{% if filter.max_value.value %}{{ filter.max_value.value | divided_by: 100 | ceil }}{% endif %}"
                           placeholder="{{ cart.currency.symbol }}0">

                    <button class="btn--clear" type="button" data-clear-price>Clear</button>
                  </div>

                  <div class="hv-range">
                    <input type="range" min="0" max="{{ filter.range_max | default: 10000000 }}" step="100" data-range="min">
                    <input type="range" min="0" max="{{ filter.range_max | default: 10000000 }}" step="100" data-range="max">
                  </div>
                </fieldset>

              {%- elsif filter.type == 'list' -%}
                <fieldset class="hv-group" data-type="list">
                  <legend class="sr-only">{{ filter.label }}</legend>
                  <h3>{{ filter.label }}</h3>
                  <ul class="hv-list">
                    {%- for val in filter.values -%}
                      <li>
                        <label class="hv-check">
                          <input type="checkbox"
                                 name="{{ val.param_name }}"
                                 value="{{ val.value | escape }}"
                                 {% if val.active %}checked{% endif %}
                                 {% if val.count == 0 and val.active == false %}disabled{% endif %}>
                          <span>{{ val.label }}</span>
                          <span class="cnt" aria-hidden="true">{{ val.count }}</span>
                        </label>
                      </li>
                    {%- endfor -%}
                  </ul>
                </fieldset>
              {%- endif -%}
            {%- endfor -%}

            {%- comment -%} Featured brands (top 5). Uses the official Vendor filter when present; otherwise groups current products. {%- endcomment -%}
            {%- assign _vendor_filter = blank -%}
            {%- for f in collection.filters -%}
              {%- assign _n = f.label | strip | downcase -%}
              {%- if f.param_name == 'filter.p.vendor' or _n == 'brand' or _n == 'vendor' -%}
                {%- assign _vendor_filter = f -%}{%- break -%}
              {%- endif -%}
            {%- endfor -%}

            {%- if _vendor_filter and _vendor_filter.values.size > 0 -%}
              {%- assign _pack = '' -%}
              {%- for v in _vendor_filter.values -%}
                {%- assign _c = v.count | plus: 0 -%}
                {%- capture _pad -%}{% if _c < 10 %}000000{% elsif _c < 100 %}00000{% elsif _c < 1000 %}0000{% elsif _c < 10000 %}000{% elsif _c < 100000 %}00{% else %}0{% endif %}{%- endcapture -%}
                {%- capture _entry -%}{{ _pad }}{{ _c }}|{{ v.label | replace:'|','‖' }}|{{ v.value | replace:'|','‖' }}|{{ v.active }}{%- endcapture -%}
                {%- assign _pack = _pack | append: _entry | append: ';;' -%}
              {%- endfor -%}
              {%- assign _sorted = _pack | split:';;' | sort | reverse -%}
              <fieldset class="hv-group" data-type="list">
                <legend class="sr-only">Featured brands</legend>
                <h3>Featured brands</h3>
                <ul class="hv-list">
                  {%- assign _shown = 0 -%}
                  {%- for row in _sorted -%}
                    {%- if row != blank and _shown < 5 -%}
                      {%- assign p = row | split:'|' -%}
                      {%- assign _label = p[1] -%}
                      {%- assign _value = p[2] -%}
                      {%- assign _active = p[3] -%}
                      <li>
                        <label class="hv-check">
                          <input type="checkbox"
                                name="{{ _vendor_filter.param_name }}"
                                value="{{ _value }}"
                                {% if _active == 'true' %}checked{% endif %}>
                          <span>{{ _label }}</span>
                        </label>
                      </li>
                      {%- assign _shown = _shown | plus: 1 -%}
                    {%- endif -%}
                  {%- endfor -%}
                </ul>
              </fieldset>

            {%- else -%}
              {%- assign _products_for_brands = collection.products | slice: 0, 250 -%}
              {%- assign _groups = _products_for_brands | group_by: 'vendor' -%}
              {%- assign _vendor_pack = '' -%}
              {%- for g in _groups -%}
                {%- assign _c = g.items | size -%}
                {%- if g.name != blank and _c > 0 -%}
                  {%- capture _pad -%}{% if _c < 10 %}0000{% elsif _c < 100 %}000{% elsif _c < 1000 %}00{% elsif _c < 10000 %}0{% endif %}{%- endcapture -%}
                  {%- capture _entry -%}{{ _pad }}{{ _c }}|{{ g.name | replace:'|','‖' }}|{{ _c }}{%- endcapture -%}
                  {%- assign _vendor_pack = _vendor_pack | append: _entry | append: ';;' -%}
                {%- endif -%}
              {%- endfor -%}
              {%- assign _sorted = _vendor_pack | split:';;' | reject:'' | sort | reverse -%}
              <fieldset class="hv-group" data-type="list" data-fallback-vendors>
                <legend class="sr-only">Featured brands</legend>
                <h3>Featured brands</h3>
                <ul class="hv-list">
                  {%- assign _shown = 0 -%}
                  {%- for row in _sorted -%}
                    {%- if row != blank and _shown < 5 -%}
                      {%- assign parts = row | split:'|' -%}
                      {%- assign _name = parts[1] -%}
                      {%- assign _cnt  = parts[2] -%}
                      <li>
                        <label class="hv-check">
                          <input type="checkbox"
                                name="filter.p.vendor"
                                value="{{ _name | escape }}">
                          <span>{{ _name }}</span>
                          <span class="cnt" aria-hidden="true">{{ _cnt }}</span>
                        </label>
                      </li>
                      {%- assign _shown = _shown | plus: 1 -%}
                    {%- endif -%}
                  {%- endfor -%}
                </ul>
              </fieldset>
            {%- endif -%}


          </div>

          <div class="hv-pop__footer">
            <button type="button" class="btn btn--reset" data-reset>Reset</button>
            <button type="button" class="btn btn--apply" data-apply>FILTER</button>
          </div>

          <p class="sr-only" role="status" data-announce></p>
        </form>
      </div>
    </div>
  </div>

  <!-- Overlay shared by both drawers -->
  <div data-hv-overlay aria-hidden="true"></div>

  <!-- FILTER Drawer (mobile) -->
  <aside id="HavitDrawerFilter-{{ section.id }}" class="hv-drawer" role="dialog" aria-modal="true" aria-hidden="true" aria-labelledby="HavitDrawerFilterLabel-{{ section.id }}">
    <div class="hv-drawer__hd">
      <h2 id="HavitDrawerFilterLabel-{{ section.id }}">Filter</h2>
      <button type="button" class="hv-drawer__close" data-hv-close>&times;<span class="sr-only">Close</span></button>
    </div>
    <div class="hv-drawer__bd" data-form-slot><!-- the existing #HavitForm-… moves here on mobile --></div>
    <!-- We reuse the form’s own sticky footer; nothing duplicated here -->
  </aside>

  <!-- SORT Drawer (mobile) -->
  <aside id="HavitDrawerSort-{{ section.id }}" class="hv-drawer hv-drawer--right" role="dialog" aria-modal="true" aria-hidden="true" aria-labelledby="HavitDrawerSortLabel-{{ section.id }}">
    <div class="hv-drawer__hd">
      <h2 id="HavitDrawerSortLabel-{{ section.id }}">Sort by</h2>
      <button type="button" class="hv-drawer__close" data-hv-close>&times;<span class="sr-only">Close</span></button>
    </div>
    <div class="hv-drawer__bd">
      <form id="HavitSortForm-{{ section.id }}" role="group" aria-labelledby="HavitDrawerSortLabel-{{ section.id }}">
        <div data-sort-options></div>
      </form>
    </div>
    <div class="hv-drawer__ft">
      <button type="button" class="btn btn--apply" data-apply-sort>Apply</button>
    </div>
  </aside>

  <template data-chip-skel><span class="hv-chip" aria-hidden="true" style="width:80px;height:30px;background:linear-gradient(90deg,#eee,#f5f5f5,#eee);background-size:200% 100%;animation:sh 1.1s linear infinite;border-radius:999px"></span><style>@keyframes sh{to{background-position:-200% 0}}</style></template>

  <script>
  (() => {
    const $root = document.querySelector('#hv-filters-{{ section.id }}');
    if (!$root) return;

    /* ---------- DOM ---------- */
    const $openBtn   = $root.querySelector('#HavitOpen-{{ section.id }}');
    const $popover   = $root.querySelector('#HavitPop-{{ section.id }}');
    const $form      = $root.querySelector('#HavitForm-{{ section.id }}');
    const $formHome  = $root.querySelector('[data-form-home]');          // desktop host
    const $formSlot  = $root.querySelector('[data-form-slot]');          // mobile drawer host

    const $sort      = $root.querySelector('#HavitSort-{{ section.id }}');
    const $sortBtn   = $root.querySelector('#HavitSortOpen-{{ section.id }}');
    const $sortDrawer= $root.querySelector('#HavitDrawerSort-{{ section.id }}');
    $sortDrawer?.classList.add('hv-drawer--bottom'); // make sort open as a bottom sheet on mobile
    const $sortForm  = $root.querySelector('#HavitSortForm-{{ section.id }}');
    const $sortOptionsWrap = $root.querySelector('[data-sort-options]');

    const $count     = $root.querySelector('#HavitCount-{{ section.id }}');
    const $announce  = $root.querySelector('[data-announce]');
    const $chips     = $root.querySelector('[data-chips]');
    const $clearAll  = $root.querySelector('[data-clear-all]');
    const $chipSkel  = $root.querySelector('template[data-chip-skel]');

    const $overlay   = $root.querySelector('[data-hv-overlay]');
    const $filterDrawer = $root.querySelector('#HavitDrawerFilter-{{ section.id }}');

    const gridSectionId = $root.dataset.gridSectionId;
    const collectionUrl = $root.dataset.collectionUrl;
    const gridSelectorList = ($root.dataset.gridSelector || '#CollectionProductGrid').split(',').map(s=>s.trim()).filter(Boolean);

    const findLiveGridEl = () => {
      for (const sel of gridSelectorList){ const el = document.querySelector(sel); if (el) return el; }
      return null;
    };

    const candidateIds = [
      gridSectionId,
      'main-collection-product-grid','MainCollectionProductGrid',
      'collection-product-grid','CollectionProductGrid',
      'product-grid','ProductGrid','CollectionProductGrid'
    ].filter(Boolean);

    const fmtMoney = (cents) => {
      const s = {{ cart.currency.symbol | json }};
      return s + (Number(cents||0)/100).toLocaleString(undefined,{maximumFractionDigits:0});
    };

    /* ---------- Responsive breakpoint ---------- */
    const mq = window.matchMedia('(max-width: 989px)');
    const isMobile = () => mq.matches;

    function placeFormForMode(){
      try{
        if (isMobile()){
          if ($formSlot && !$formSlot.contains($form)) $formSlot.appendChild($form);
        } else {
          if ($formHome && !$formHome.contains($form)) $formHome.appendChild($form);
        }
      }catch(e){}
    }
    placeFormForMode();
    mq.addEventListener?.('change', () => {
      placeFormForMode();
      // Ensure popover state is correct when crossing breakpoints
      closeAllDrawers();
      closePop(true);
    });

    /* ---------- Popover (desktop) open/close ---------- */
    function openPop(){
      if (isMobile()) { openFilterDrawer($openBtn); return; } // progressive: route to drawer on mobile
      $popover.classList.add('is-open');
      $popover.setAttribute('aria-hidden','false');
      $openBtn.setAttribute('aria-expanded','true');
      trapFocus($popover);
    }
    function closePop(silent){
      $popover.classList.remove('is-open');
      $popover.setAttribute('aria-hidden','true');
      $openBtn.setAttribute('aria-expanded','false');
      releaseFocus();
      if(!silent) $openBtn.focus();
    }
    $openBtn.addEventListener('click', () => ($popover.classList.contains('is-open') && !isMobile()) ? closePop() : openPop());

    /* ---------- Drawers: open/close + overlay + focus trap ---------- */
    let lastOpener = null;
    function lockScroll(yes){
      try{ document.documentElement.style.overflow = yes ? 'hidden' : ''; }catch(e){}
    }
    function openOverlay(){ $overlay?.classList.add('is-open'); $overlay?.setAttribute('aria-hidden','false'); lockScroll(true); }
    function closeOverlay(){ $overlay?.classList.remove('is-open'); $overlay?.setAttribute('aria-hidden','true'); lockScroll(false); }

    function openDrawer($drawer, openerBtn){
      if (!$drawer) return;
      lastOpener = openerBtn || lastOpener || $openBtn;
      $drawer.classList.add('is-open');
      $drawer.setAttribute('aria-hidden','false');
      openOverlay();
      trapFocus($drawer);
    }
    function closeDrawer($drawer){
      if (!$drawer) return;
      $drawer.classList.remove('is-open');
      $drawer.setAttribute('aria-hidden','true');
      releaseFocus();
    }
    function closeAllDrawers(){
      closeDrawer($filterDrawer);
      closeDrawer($sortDrawer);
      closeOverlay();
      (lastOpener || $openBtn)?.focus?.();
    }

    function openFilterDrawer(opener){ if (!isMobile()) { openPop(); return; } openDrawer($filterDrawer, opener); }
    function openSortDrawer(opener){ if (!isMobile()) return; syncSortDrawerFromSelect(); openDrawer($sortDrawer, opener); }

    $overlay?.addEventListener('click', closeAllDrawers);
    document.addEventListener('keydown', (e)=>{
      if (e.key === 'Escape'){
        if ($filterDrawer.classList.contains('is-open') || $sortDrawer.classList.contains('is-open')){
          e.stopPropagation(); closeAllDrawers(); return;
        }
        if ($popover.classList.contains('is-open')){ e.stopPropagation(); closePop(); }
      }
    });
    $root.querySelectorAll('[data-hv-close]').forEach(btn => btn.addEventListener('click', closeAllDrawers));

    /* Focus trap (reused) */
    let trapHandler=null;
    function getFocusable(el){ return Array.from(el.querySelectorAll('a,button,input,select,textarea,[tabindex]:not([tabindex="-1"])')).filter(n=>!n.disabled && n.offsetParent!==null); }
    function trapFocus(el){
      const f = getFocusable(el); if(!f.length) return;
      const first=f[0], last=f[f.length-1];
      trapHandler = (e)=>{ if(e.key!=='Tab') return; if(e.shiftKey && document.activeElement===first){ last.focus(); e.preventDefault(); } else if(!e.shiftKey && document.activeElement===last){ first.focus(); e.preventDefault(); } };
      document.addEventListener('keydown', trapHandler);
      first.focus();
    }
    function releaseFocus(){ if(trapHandler){ document.removeEventListener('keydown', trapHandler); trapHandler=null; } }

    /* ---------- Price bindings (unchanged API) ---------- */
    let rMin, rMax, iMin, iMax;

    function readCents(src){
      const val = (typeof src === 'string') ? src : (src && typeof src.value === 'string' ? src.value : '');
      const raw = String(val).replace(/[^\d]/g, '');
      return raw ? Number(raw) * 100 : null;
    }
    function writeTxt(el, cents){ if(!el) return; el.value = cents==null ? '' : Math.round(Number(cents)/100).toLocaleString(); }

    function clampRanges(){
      if(!rMin || !rMax) return;
      const cap = Number(rMax.max || 0);
      let a = Math.max(0, Math.min(Number(rMin.value || 0), cap));
      let b = Math.max(0, Math.min(Number(rMax.value || 0), cap));
      if (a > b) [a, b] = [b, a];
      rMin.value = String(a);
      rMax.value = String(b);
    }

    function syncInputsFromRanges(){ if(rMin&&rMax&&iMin&&iMax){ writeTxt(iMin, rMin.value); writeTxt(iMax, rMax.value); } }

    function syncRangesFromInputs(){
      if(!rMin || !rMax || !iMin || !iMax) return;
      const minC = readCents(iMin);
      const maxC = readCents(iMax);

      const cap = Number(rMax.max || 0);
      const lo = (minC == null) ? 0 : minC;
      const hi = (maxC == null) ? cap : maxC;

      let a = Math.max(0, Math.min(lo, cap));
      let b = Math.max(0, Math.min(hi, cap));
      if (a > b) [a, b] = [b, a];

      rMin.value = String(a);
      rMax.value = String(b);
    }

    function attachPriceBindings(){
      rMin = $form.querySelector('input[data-range="min"]');
      rMax = $form.querySelector('input[data-range="max"]');
      iMin = $form.querySelector('#min-{{ section.id }}');
      iMax = $form.querySelector('#max-{{ section.id }}');

      if (rMin && rMax && iMin && iMax){
        rMin.value = String(readCents(iMin) ?? 0);
        rMax.value = String(readCents(iMax) ?? (Number(rMax.max||0)));

        const cap = Number(rMax.max || 0);
        rMin.value = String(Math.min(Number(rMin.value || 0), cap));
        rMax.value = String(Math.min(Number(rMax.value || cap), cap));
        clampRanges();
        syncInputsFromRanges();

        [rMin, rMax].forEach(r => {
          r.addEventListener('input', () => { clampRanges(); syncInputsFromRanges(); });
          r.addEventListener('change', () => { applyFilters(); }); // apply on drag end
        });
        [iMin, iMax].forEach(inp => {
          inp.addEventListener('focus', () => inp.value = String(inp.value).replace(/[^\d]/g,''));
          inp.addEventListener('blur', () => writeTxt(inp, readCents(inp)));
          inp.addEventListener('input', () => syncRangesFromInputs());
        });
      }
    }
    attachPriceBindings();

    /* ---------- Chips helpers & builder ---------- */
    function isFullSpan(minVal, maxVal){
      const cap = Number(rMax?.max || 0);
      const isMinZero = !minVal || Number(minVal) === 0;
      const isMaxCap  = !!cap && Number(maxVal) === cap;
      return isMinZero && isMaxCap;
    }

    function buildChips(){
      if(!$chips) return;
      $chips.innerHTML = '';
      if($chipSkel){ $chips.appendChild($chipSkel.content.cloneNode(true)); }

      const entries = [];

      // list facets
      $form.querySelectorAll('fieldset[data-type="list"] input[type="checkbox"]').forEach(cb => {
        if(cb.checked){
          const label = cb.closest('label')?.querySelector('span')?.textContent?.trim() || cb.value;
          entries.push({type:'list', name:cb.name, value:cb.value, label});
        }
      });

      // price from ranges (cents)
      const minC = rMin ? Number(rMin.value || 0) : 0;
      const maxC = rMax ? Number(rMax.value || 0) : 0;

      // hide chip when full span OR degenerate min==max (>0)
      if (!(isFullSpan(minC, maxC) || (minC > 0 && minC === maxC))) {
        const cap = Number(rMax?.max || 0);
        const hasMin = minC > 0;
        const showMax = maxC > 0 && (!cap || maxC < cap);
        if (hasMin || showMax){
          const label = (hasMin ? fmtMoney(minC) : '') + ' – ' + (showMax ? fmtMoney(maxC) : '');
          entries.push({type:'price', label});
        }
      }

      $chips.innerHTML = '';
      entries.forEach(e=>{
        const chip = document.createElement('span');
        chip.className = 'hv-chip';
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.setAttribute('aria-label','Remove');
        btn.textContent = '×';
        chip.appendChild(document.createTextNode(e.label));
        chip.appendChild(btn);
        btn.addEventListener('click', ()=>{
          if(e.type==='list'){
            $form.querySelectorAll(`input[name="${CSS.escape(e.name)}"][value="${CSS.escape(e.value)}"]`).forEach(x=>x.checked=false);
          }else if(e.type==='price'){
            if(iMin) iMin.value=''; if(iMax) iMax.value='';
            if(rMin) rMin.value='0';
            if(rMax) rMax.value=String(rMax?.max||0);
            syncInputsFromRanges();
          }
          applyFilters();
        });
        $chips.appendChild(chip);
      });

      if($clearAll) $clearAll.style.display = entries.length>0 ? 'inline-block' : 'none';
    }

    $clearAll?.addEventListener('click', ()=>{
      $form.querySelectorAll('input[type="checkbox"]').forEach(cb => cb.checked = false);
      if(iMin) iMin.value=''; if(iMax) iMax.value='';
      if(rMin) rMin.value='0'; if(rMax) rMax.value=String(rMax?.max||0);
      syncInputsFromRanges();
      applyFilters();
    });

    /* ---------- Results polish (animations) ---------- */
    function animateGridEntrance(container){
      if (!container) return;
      let cards = Array.from(container.children);
      if (!cards.length) cards = Array.from(container.querySelectorAll('.grid__item, .product-grid__item, li, article, .card, .product-card'));
      cards.forEach((el, i) => {
        el.classList.add('hv-card-enter');
        void el.offsetWidth; // force layout
        el.classList.add('hv-card-enter-active');
        el.style.transitionDelay = (i * 30) + 'ms';
        setTimeout(() => {
          el.classList.remove('hv-card-enter', 'hv-card-enter-active');
          el.style.transitionDelay = '';
        }, 450 + (i*30));
      });
    }
    function pulseResultsCount(){
      $count?.classList.add('is-pulse');
      setTimeout(()=> $count?.classList.remove('is-pulse'), 900);
    }
    function scrollControlsIntoView(){
      if (window.matchMedia('(max-width: 989px)').matches){
        $root.scrollIntoView({behavior:'smooth', block:'start'});
      }
    }

    /* ---------- URL build + fetch/render (unchanged API) ---------- */
    function serializeParams() {
      const p = new URLSearchParams(location.search);
      // wipe previous facets/sort/pagination
      Array.from(p.keys()).forEach(k => { if (k.startsWith('filter.') || k === 'sort_by' || k === 'page') p.delete(k); });

      // list facets
      $form.querySelectorAll('input[type="checkbox"]').forEach(cb => { if (cb.checked) p.append(cb.name, cb.value); });

      // price (ranges store cents; server expects whole pesos)
      const minName = iMin?.name;
      const maxName = iMax?.name;
      const capCents = Number(rMax?.max || 0);

      const minC = rMin ? Number(rMin.value || 0) : 0;
      const maxC = rMax ? Number(rMax.value || 0) : 0;

      const userTouchedPrice = (minC > 0) || (maxC > 0 && maxC < capCents);
      if (minName && maxName && userTouchedPrice) {
        const toPesos = (c) => Math.round(Number(c) / 100);
        const lo = toPesos(minC);
        const hi = toPesos(maxC > 0 ? maxC : capCents);
        p.set(minName, String(lo));   // inclusive >=
        p.set(maxName, String(hi));   // inclusive <=
      }

      if ($sort?.value) p.set('sort_by', $sort.value);
      return p;
    }

    function currentSectionsURL(params){
      const url = new URL(collectionUrl, location.origin);
      url.search = params.toString();
      return url;
    }

    async function fetchSectionHTMLStrict(url, sectionId){
      if(sectionId){
        try{
          const u = new URL(url); u.searchParams.set('section_id', sectionId);
          const t = await fetch(u, {headers:{'X-Requested-With':'XMLHttpRequest'}}).then(r=>r.text());
          if (t && (t.includes(`id="${sectionId}"`) || t.includes(`data-section-id="${sectionId}"`))) return t;
        }catch(e){}
        try{
          const u2 = new URL(url); u2.searchParams.set('sections', sectionId);
          const j2 = await fetch(u2, {headers:{'X-Requested-With':'XMLHttpRequest'}}).then(r=>r.json());
          if(j2){ if(j2[sectionId]) return j2[sectionId]; if(j2.sections && j2.sections[sectionId]) return j2.sections[sectionId]; }
        }catch(e){}
      }
      try{ return await fetch(url).then(r=>r.text()); }catch(e){ return ''; }
    }

    function extractGridInner(html){
      if(!html) return null;
      const tmp = document.createElement('div'); tmp.innerHTML = html;
      for (const sel of gridSelectorList){ const node = tmp.querySelector(sel); if (node) return node.innerHTML; }
      return null;
    }

    async function updateGridFromURL(url){
      const liveGrid = findLiveGridEl();
      if (!liveGrid) return false;

      // skeleton
      const sk = document.createElement('div');
      sk.style.cssText='display:grid;grid-template-columns:repeat(2,1fr);gap:16px';
      for(let i=0;i<8;i++){
        const c=document.createElement('div');
        c.style.cssText='border:1px solid #eee;border-radius:12px;padding:10px;background:#fff';
        c.innerHTML='<div style="height:160px;border-radius:10px;background:linear-gradient(90deg,#eee,#f5f5f5,#eee);background-size:200% 100%;animation:sh 1.1s linear infinite"></div><div style="height:12px;margin:10px 6px;border-radius:8px;background:linear-gradient(90deg,#eee,#f5f5f5,#eee);background-size:200% 100%;animation:sh 1.1s linear infinite"></div><div style="height:36px;margin:10px 6px;border-radius:10px;background:linear-gradient(90deg,#eee,#f5f5f5,#eee);background-size:200% 100%;animation:sh 1.1s linear infinite"></div><style>@keyframes sh{to{background-position:-200% 0}}</style>';
        sk.appendChild(c);
      }
      liveGrid.innerHTML=''; liveGrid.appendChild(sk);

      for (const id of candidateIds){
        const html = await fetchSectionHTMLStrict(url, id);
        if (!html) continue;
        const inner = extractGridInner(html);
        if (inner != null){
          liveGrid.innerHTML = inner;
          animateGridEntrance(liveGrid);   // NEW: slide-up cards
          return true;
        }
      }
      return false;
    }

    async function applyFilters(){
      // reflect latest text inputs into ranges before serializing
      syncRangesFromInputs();
      clampRanges();

      if($chipSkel && $chips){ $chips.innerHTML=''; $chips.appendChild($chipSkel.content.cloneNode(true)); }

      const params = serializeParams();
      const url = currentSectionsURL(params);
      history.pushState({hv:true}, '', url.toString());
      $announce.textContent = 'Updating results…';

      const ok = await updateGridFromURL(url);
      if (!ok) { window.location.href = url; return; }

      await refreshSelfFromURL(url);

      // clamp once more after refresh
      syncRangesFromInputs();
      clampRanges();

      $announce.textContent = 'Results updated';
      closePop(true);
      closeAllDrawers();
      buildChips();

      // NEW polish
      pulseResultsCount();
      scrollControlsIntoView();
    }

    async function refreshSelfFromURL(url){
      // 1) Snapshot current state
      const activePairs = Array.from($form.querySelectorAll('input[type="checkbox"]:checked'))
        .map(cb => ({ name: cb.name, value: cb.value }));

      const saved = {
        rmin: rMin ? String(rMin.value || '0') : null,
        rmax: rMax ? String(rMax.value || (rMax?.max || '0')) : null
      };

      // 2) Fetch fresh section HTML
      const html = await fetchSectionHTMLStrict(url, '{{ section.id }}');
      if (!html) return;
      const tmp = document.createElement('div'); tmp.innerHTML = html;

      // 3) Replace count
      const freshCount = tmp.querySelector('#HavitCount-{{ section.id }}')?.textContent?.trim();
      if (freshCount) $count.textContent = freshCount;

      // 4) Replace form with fresh markup (keep same node)
      const newForm = tmp.querySelector('#HavitForm-{{ section.id }}');
      if (!newForm) return;
      $form.innerHTML = newForm.innerHTML;

      // 5) Re-bind price widgets and re-impose saved range values
      attachPriceBindings();

      if (saved.rmin != null && saved.rmax != null) {
        if (rMin) rMin.value = saved.rmin;
        if (rMax) rMax.value = saved.rmax;
        syncInputsFromRanges();
      } else {
        syncInputsFromRanges();
      }

      // 6) Re-check previous list selections (covers fallback vendors)
      activePairs.forEach(({ name, value }) => {
        $form.querySelectorAll(`input[name="${CSS.escape(name)}"][value="${CSS.escape(value)}"]`)
          .forEach(cb => cb.checked = true);
      });

      // 7) Final guard + rebuild chips
      syncRangesFromInputs();
      clampRanges();
      buildChips();

      // Ensure the form is still in the correct container after refresh
      placeFormForMode();
    }

    /* ---------- Delegated clicks + keys ---------- */
    // Apply / Reset / Clear Price via delegation (survives form re-render)
    $form.addEventListener('click', (e) => {
      const applyBtn = e.target.closest('[data-apply]');
      const resetBtn = e.target.closest('[data-reset]');
      const clearPriceBtn = e.target.closest('[data-clear-price]');

      if (applyBtn) {
        e.preventDefault();
        applyFilters();
        return;
      }
      if (resetBtn) {
        e.preventDefault();
        $form.querySelectorAll('input[type="checkbox"]').forEach(cb => cb.checked = false);
        if (iMin) iMin.value = '';
        if (iMax) iMax.value = '';
        if (rMin) rMin.value = '0';
        if (rMax) rMax.value = String(rMax?.max || 0);
        syncInputsFromRanges();
        applyFilters();
        return;
      }
      if (clearPriceBtn) {
        e.preventDefault();
        if (iMin) iMin.value = '';
        if (iMax) iMax.value = '';
        if (rMin) rMin.value = '0';
        if (rMax) rMax.value = String(rMax?.max || 0);
        syncInputsFromRanges();
        buildChips();
        return;
      }
    });

    // Enter key submits filters (no full page reload)
    $form.addEventListener('keydown', (e) => {
      if (e.key === 'Enter') {
        e.preventDefault();
        applyFilters();
      }
    });

    // Live chip preview on ticking list checkboxes
    $form.addEventListener('change', (e) => {
      if (e.target.matches('input[type="checkbox"]')) buildChips();
    });

    /* ---------- Sort logic (desktop select remains source of truth) ---------- */
    $sort?.addEventListener('change', applyFilters);

    // Build radios inside Sort drawer from the existing select, once per open
    function syncSortDrawerFromSelect(){
      if (!$sort || !$sortOptionsWrap) return;
      $sortOptionsWrap.innerHTML = '';
      Array.from($sort.options).forEach((opt, i) => {
        const id = `hv-sortopt-{{ section.id }}-${i}`;
        const row = document.createElement('div');
        row.style.cssText = 'display:flex;align-items:center;gap:10px;padding:8px 0;border-bottom:1px solid var(--line)';
        row.innerHTML = `
          <input type="radio" id="${id}" name="hv-sort-radio-{{ section.id }}" value="${opt.value}" ${opt.selected ? 'checked' : ''}>
          <label for="${id}" style="flex:1 1 auto">${opt.text}</label>
        `;
        $sortOptionsWrap.appendChild(row);
      });
    }

    // Openers
    $sortBtn?.addEventListener('click', () => openSortDrawer($sortBtn));
    $openBtn?.addEventListener('click', () => { if (isMobile()) lastOpener = $openBtn; });

    // Apply from Sort drawer
    $sortForm?.addEventListener('click', (e) => {
      if (e.target.closest('[data-apply-sort]')) {
        const chosen = $sortForm.querySelector('input[name="hv-sort-radio-{{ section.id }}"]:checked');
        if (chosen && $sort){
          $sort.value = chosen.value;
        }
        applyFilters();
      }
    });

    /* ---------- Back/forward ---------- */
    addEventListener('popstate', () => {
      const url = new URL(location.href);
      const sp = new URLSearchParams(url.search);
      const s = sp.get('sort_by') || '{{ sort_by | default: "best-selling" }}';
      if ($sort) $sort.value = s;
      updateGridFromURL(url).then(async ()=>{
        await refreshSelfFromURL(url);
        buildChips();
        closeAllDrawers();  // drawers remain closed after navigation
        closePop(true);
        pulseResultsCount(); // NEW: pulse count on navigation restore
      });
    });

    /* ---------- Init ---------- */
    buildChips();
  })();
  </script>

  {% schema %}
  {
    "name": "Collection Filters",
    "settings": [
      {
        "type": "text",
        "id": "grid_section_id",
        "label": "Product grid section ID",
        "default": "main-collection-product-grid",
        "info": "ID of the product grid section to target for updates."
      }
    ],
    "blocks": [],
    "presets": [
      { "name": "Collection Filters — Havit Top + Chips" }
    ]
  }
  {% endschema %}
</section>
