  function getVisibleTop(listEl){
    const hardTop = parseInt(listEl.dataset.limitTop || '5', 10);
    return isNaN(hardTop) ? 5 : hardTop;
  }
  function getExpandedCapPx(el){
    const raw = getComputedStyle(el).getPropertyValue('--list-expanded-max').trim();
    const m = raw.match(/([\d.]+)px/);
    return m ? parseFloat(m[1]) : 280;
  }
  function applyLimitState(listEl, expanded){
    const topN = getVisibleTop(listEl);
    // compute collapsed height by summing top N items (visible only)
    const items = Array.from(listEl.children).filter(li => li.nodeType === 1 && getComputedStyle(li).display !== 'none');
    const count = Math.min(topN, items.length);
    let collapsedPx = 0;
    for (let i = 0; i < count; i++){
      const li = items[i];
      const cs = getComputedStyle(li);
      collapsedPx += li.offsetHeight + parseFloat(cs.marginTop) + parseFloat(cs.marginBottom);
    }
    collapsedPx = Math.ceil(collapsedPx + 2);

    if (!expanded){
      listEl.dataset.limitExpanded = 'false';
      listEl.style.overflowY = 'hidden';
      listEl.style.maxHeight = collapsedPx + 'px';
      return;
    }
    const full = listEl.scrollHeight;
    const cap = getExpandedCapPx(listEl);
    const expandedPx = Math.min(full, cap);
    listEl.dataset.limitExpanded = 'true';
    listEl.style.maxHeight = expandedPx + 'px';
    listEl.style.overflowY = expandedPx < full ? 'auto' : 'hidden';
  }
  function refreshToggleText(btn, listEl){
    const expanded = listEl.dataset.limitExpanded === 'true';
    btn.textContent = expanded ? 'Show less' : 'Show more';
  }
  function limitOneList(listEl){
    // Sort: active first, then by count desc
    const items = Array.from(listEl.querySelectorAll(':scope > li'));
    const parseCount = li => parseInt((li.querySelector('.ch-count')?.textContent || '0').replace(/[^\d]/g,''), 10) || 0;
    const isActive = li => !!li.querySelector('input[type="checkbox"]')?.checked;
    items.sort((a,b) => {
      const da = isActive(a) ? 1 : 0;
      const db = isActive(b) ? 1 : 0;
      if (da !== db) return db - da;
      return parseCount(b) - parseCount(a);
    }).forEach(li => listEl.appendChild(li));

    // Build/find a single toggle
    let btn = listEl.parentElement.querySelector('[data-limit-toggle]');
    if(!btn){
      btn = document.createElement('button');
      btn.type='button';
      btn.className='ch-more';
      btn.setAttribute('data-limit-toggle','');
      listEl.parentElement.appendChild(btn);
    }

    const totalVisible = items.filter(li => getComputedStyle(li).display !== 'none').length;
    const topN = getVisibleTop(listEl);
    if (totalVisible <= topN){
      btn.style.display = 'none';
      listEl.dataset.limitExpanded = 'true';
      listEl.style.maxHeight = '';
      listEl.style.overflow = 'visible';
      return;
    }

    btn.style.display = 'inline';
    applyLimitState(listEl, false);
    refreshToggleText(btn, listEl);

    btn.onclick = () => {
      const nowExpanded = listEl.dataset.limitExpanded === 'true';
      applyLimitState(listEl, !nowExpanded);
      refreshToggleText(btn, listEl);
    };

    // keep layout correct on resize
    let to;
    window.addEventListener('resize', () => {
      clearTimeout(to);
