function serializeParams() {
  console.log('--- serializeParams START ---');
  console.log('[serializeParams] forceClearPrice at entry:', forceClearPrice);

  const params = new URLSearchParams(location.search);

  // 1) Wipe old filter + page + (optionally) old price params from the CURRENT URL
Array.from(params.keys()).forEach((k) => {
  const isFilter = k.startsWith('filter.');
  const isPage   = k === 'page';
  const isPrice  = /price/i.test(k);

  if (isFilter || isPage || (forceClearPrice && isPrice)) {
    params.delete(k);
  }
});


  // 2) sort_by
  const sv = getSortValue();
  if (sv) {
    params.set('sort_by', sv);
  } else {
    params.delete('sort_by');
  }

  // 3) list filters (checkboxes)
  $form.querySelectorAll('input[type="checkbox"]').forEach((cb) => {
    if (cb.checked) {
      params.append(cb.name, cb.value);
      console.log('[serializeParams] adding filter checkbox:', cb.name, cb.value);
    }
  });

  // 4) price range
  const rMinNow = $form.querySelector('input[data-range="min"]');
  const rMaxNow = $form.querySelector('input[data-range="max"]');

  if (rMinNow && rMaxNow) {
    const cap = Number(rMaxNow.max || 0) || 0;
    const lo  = Number(rMinNow.value || 0);
    const hi  = Number(rMaxNow.value || 0);
    const iMinNow = $form.querySelector(`#min-${SECTION_ID}`);
    const iMaxNow = $form.querySelector(`#max-${SECTION_ID}`);

    const minName = iMinNow?.name;
    const maxName = iMaxNow?.name;

    const isDefault = (lo === 0 && (hi >= cap - 100));
    console.log('[serializeParams] price state:', { lo, hi, cap, isDefault, forceClearPrice, minName, maxName });

    if (!isDefault && !forceClearPrice) {
      // normal case: actively filtered price
      if (minName) {
        params.set(minName, Math.round(lo / 100));
        console.log('[serializeParams] setting min price:', minName, Math.round(lo / 100));
      }
      if (maxName) {
        params.set(maxName, Math.round(hi / 100));
        console.log('[serializeParams] setting max price:', maxName, Math.round(hi / 100));
      }
    } else {
      // safety: make absolutely sure no stale price params survive
      if (minName) {
        params.delete(minName);
        console.log('[serializeParams] forcibly deleting min price param:', minName);
      }
      if (maxName) {
        params.delete(maxName);
        console.log('[serializeParams] forcibly deleting max price param:', maxName);
      }
    }
  }

  console.log('[serializeParams] final query:', params.toString());

  // reset flag for next run
  forceClearPrice = false;
  console.log('[serializeParams] forceClearPrice after reset:', forceClearPrice);
  console.log('--- serializeParams END ---');

  return params;
}

  function captureFilterState() {
    const savedChecks = Array.from($form.querySelectorAll('input[type="checkbox"]:checked'))
      .map(cb => ({ name: cb.name, value: cb.value }));

    const rMinNow = $form.querySelector('input[data-range="min"]');
    const rMaxNow = $form.querySelector('input[data-range="max"]');
    const savedPrice = {
      min: rMinNow ? rMinNow.value : null,
      max: rMaxNow ? rMaxNow.value : null
    };
    return { savedChecks, savedPrice };
  }

  let _applyTO = null;
  function applyFiltersDebounced(delay = 0) {
    clearTimeout(_applyTO);
    _applyTO = setTimeout(() => applyFilters(), delay);
  }

  async function applyFilters() {
    console.log('[CH Filters] applyFilters called');
    const params = serializeParams();
    const url = new URL(collectionUrl, location.origin);
    url.search = params.toString();

    showGridMask();
    history.pushState({ ch: true }, '', url.toString());
    if ($announce) $announce.textContent = 'updating results…';

    try {
      await updateFromURL(url);      // 🔴 single request here
    } catch (e) {
      console.error('[CH filters] applyFilters failed', e);
    } finally {
      hideGridMask();
    }

    buildChips();
    if ($announce) $announce.textContent = 'results updated.';
    if (!isMobile()) closeAll();
  }

  window.applyFilters = applyFilters;



  window.applyFilters = applyFilters;

  $form.addEventListener('change', (e)=>{
if (e.target.matches('input[type="checkbox"]')) {
  console.log('[CH Filters] Checkbox changed:', e.target.name, e.target.checked);
  buildChips();

  if (isMobile()) {
    showGridMask();
    closeDrawer();
    closeOverlay();
  }
  applyFiltersDebounced(0);
}

  });
  // ---------- PAGINATION CLICKS → AJAX via updateFromURL ----------
  document.addEventListener('click', (e) => {
    const link = e.target.closest('nav.pagination a[href][data-page]');
    if (!link) return;

    // respect "open in new tab" etc
    if (link.target === '_blank' || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) {
      return;
    }

    e.preventDefault();

    const url = new URL(link.href, location.origin);

    showGridMask();
    history.pushState({ ch: true }, '', url.toString());

    updateFromURL(url)
      .then(() => {
        buildChips();          // keep chips + count in sync
        syncSortSelectToURL(url);
      })
      .catch((err) => {
        console.error('[CH filters] pagination failed', err);
      })
      .finally(() => {
        hideGridMask();
      });
  }, true); // capture phase so we intercept early

  window.addEventListener('popstate', async () => {
    const url = new URL(location.href);

    showGridMask();
    try {
      await updateFromURL(url);     // same single fetch
    } catch (e) {
      console.error('[CH filters] popstate failed', e);
    } finally {
      hideGridMask();
    }

    syncSortSelectToURL(url);
    buildChips();
    syncCollectionCollapse();
  });



  // external toggle hook
  window.addEventListener('ch:toggle-filters', (ev) => {
    const wanted = ev.detail && ev.detail.id;
    if (wanted && wanted !== SECTION_ID && wanted !== 'search') return;
    if (isMobile()) { openDrawer(); }
    else { $panel.classList.toggle('is-collapsed'); syncCollectionCollapse(); }
  });

  // init
  buildChips();
  syncCollectionCollapse();
  limitAllLists($form);
})();
</script>


<script>
/* === Chipbar patch for Dawn toolbar host ==============================
   Exposes: ensureGlobalChipBar(), mountIntoToolbarIfAvailable(), makeClearAll()
   Internals: observeToolbar()
   -------------------------------------------------------------------- */
(function () {
  var HOST_SEL = '.active-facets, .active-facets-vertical, .facets__wrapper .active-facets';
  var HIDE_SEL = '.active-facets__list, .active-facets__button, .active-facets__button-remove, .active-facets-vertical-browse';
  var DEFAULT_GRID_SELECTORS = [
    '#CollectionProductGrid',
    '#MainCollectionProductGrid',
    '#main-collection-product-grid',
    '#collection-product-grid',
    '#product-grid',
    '#ProductGrid',
    '.collection__products',
    '.product-grid'
  ];

  var globalChipBar = null;
  var toolbarObserver = null;

  function findToolbarHost() {
    return document.querySelector(HOST_SEL);
  }

  function hideDawnChipsInside(host) {
    if (!host) return;
    host.querySelectorAll(HIDE_SEL).forEach(function (n) {
      n.style.setProperty('display', 'none', 'important');
    });
  }

  function findGridElement() {
    var gridSectionId = (window.gridSectionId || window.chGridSectionId || '').toString().trim();
    var gridSelectors = (window.gridSelectors || window.chGridSelectors || DEFAULT_GRID_SELECTORS).slice();

    var scope = document;
    if (gridSectionId) {
      var scoped = document.getElementById(gridSectionId);
      if (scoped) scope = scoped;
    }
    for (var i = 0; i < gridSelectors.length; i++) {
      var el = scope.querySelector(gridSelectors[i]);
      if (el) return el;
    }
    for (var j = 0; j < DEFAULT_GRID_SELECTORS.length; j++) {
      var el2 = document.querySelector(DEFAULT_GRID_SELECTORS[j]);
      if (el2) return el2;
    }
    return null;
  }

  function ensureBarInstance() {
    if (globalChipBar && globalChipBar.nodeType === 1) return globalChipBar;
    globalChipBar = document.querySelector('.ch-chipbar-global') || document.createElement('div');
    globalChipBar.classList.add('ch-chipbar-global');
    return globalChipBar;
  }

  function mountIntoToolbarIfAvailable() {
    var host = findToolbarHost();
    if (!host) return false;

    host.classList.add('ch-chipbar-host');
    hideDawnChipsInside(host);

    var bar = ensureBarInstance();
    if (bar.parentNode !== host) {
      try { bar.parentNode && bar.parentNode.removeChild(bar); } catch(e) {}
      host.appendChild(bar);
    }
    return true;
  }

  function observeToolbar() {
    if (toolbarObserver) return;
    toolbarObserver = new MutationObserver(function () {
      if (!globalChipBar || !globalChipBar.isConnected || !globalChipBar.closest(HOST_SEL)) {
        mountIntoToolbarIfAvailable();
      } else {
        var host = globalChipBar.closest(HOST_SEL);
        hideDawnChipsInside(host);
      }
    });
    toolbarObserver.observe(document.body, { childList: true, subtree: true });
  }

  function ensureGlobalChipBar() {
    var mounted = mountIntoToolbarIfAvailable();
    if (!mounted) {
      var bar = ensureBarInstance();
      if (!bar.isConnected) {
        var gridEl = findGridElement();
        if (gridEl && gridEl.parentElement) {
          gridEl.parentElement.insertBefore(bar, gridEl);
        }
      }
    }
    observeToolbar();
    return ensureBarInstance();
  }
// Reset price only (from header chipline)
document.addEventListener('ch:reset-price', () => {
  // 1) Reset slider + inputs to full range
  resetPriceToDefault();

  // 2) Tell serializer to completely drop all price params
  forceClearPrice = true;

  // 3) Rebuild chips AFTER the new state is applied
  if (isMobile()) {
    showGridMask();
    closeDrawer();
    closeOverlay();
  }

  applyFilters(); // not debounced, we want this to fire once
});

  function makeClearAll(bar, hasChips) {
    var root = bar || ensureGlobalChipBar();
    var btn = root.querySelector('[data-clear-all]');
    if (!btn) {
      btn = document.createElement('button');
      btn.type = 'button';
      btn.setAttribute('data-clear-all', '');
      btn.innerHTML = '<span aria-hidden="true">×</span> Clear all';
      btn.addEventListener('click', function () {
        document.dispatchEvent(new CustomEvent('ch:clear-all'));
      });
      root.appendChild(btn);
    }
    btn.style.display = hasChips ? 'inline-flex' : 'none';
    return btn;
  }

  window.ensureGlobalChipBar = ensureGlobalChipBar;
  window.mountIntoToolbarIfAvailable = mountIntoToolbarIfAvailable;
  window.makeClearAll = makeClearAll;
})();
</script>

