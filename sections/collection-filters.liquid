{% comment %}
  sections/collection-filters-ch.liquid — unified for Collections AND Search
  - Auto-detects context (collection vs search)
  - Uses `search.filters` on search pages, `collection.filters` otherwise
  - Preserves `q` and `type` in URLs automatically
  - Avoids `section_id` fetch on search pages to prevent nested section errors
{% endcomment %}

{% liquid
  assign is_search = false
  if search and search.performed
    assign is_search = true
  endif
  if is_search
    assign _filters = search.filters
  else
    assign _filters = collection.filters
  endif
%}
<script>
  console.log('[CH Filters] Liquid Render - is_search: {{ is_search }}, filters size: {{ _filters.size }}');
</script>

{%- assign _grid_id = section.settings.grid_section_id | default: 'main-collection-product-grid' -%}

{{ 'ch-filters.css' | asset_url | stylesheet_tag }}
<section id="ch-filters-{{ section.id }}"
  class="ch ch-sidebar-nav"
  data-grid-section-id="{{ _grid_id }}"
  data-grid-selector="#CollectionProductGrid, #MainCollectionProductGrid, #main-collection-product-grid, #collection-product-grid, #product-grid, #ProductGrid, .collection__products, .product-grid"
  data-collection-url="{% if search %}{{ routes.search_url }}?q={{ search.terms | url_encode }}&type=product{% else %}{{ collection.url }}{% endif %}"
  data-mode="{% if search %}search{% else %}collection{% endif %}"
  aria-label="Collection controls and filters">



  <div class="ch-controls-wrap" role="region" aria-label="Collection controls">
    <div class="ch-controls">
<button type="button" class="ch-filter-btn ch-open-btn" id="ChOpen-{{ section.id }}" aria-expanded="false" aria-controls="ChPanel-{{ section.id }}">
  <!-- Desktop icon -->
  <span class="ch-ic--desk" aria-hidden="true">
    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 6h9.75M10.5 6a1.5 1.5 0 1 1-3 0m3 0a1.5 1.5 0 1 0-3 0M3.75 6H7.5m3 12h9.75m-9.75 0a1.5 1.5 0 0 1-3 0m3 0a1.5 1.5 0 0 0-3 0m-3.75 0H7.5m9-6h3.75m-3.75 0a1.5 1.5 0 0 1-3 0m3 0a1.5 1.5 0 0 0-3 0m-9.75 0h9.75" />
    </svg>
  </span>

  <!-- Mobile icon (same SVG now) -->
  <span class="ch-ic--mob" aria-hidden="true">
    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 6h9.75M10.5 6a1.5 1.5 0 1 1-3 0m3 0a1.5 1.5 0 1 0-3 0M3.75 6H7.5m3 12h9.75m-9.75 0a1.5 1.5 0 0 1-3 0m3 0a1.5 1.5 0 0 0-3 0m-3.75 0H7.5m9-6h3.75m-3.75 0a1.5 1.5 0 0 1-3 0m3 0a1.5 1.5 0 0 0-3 0m-9.75 0h9.75" />
    </svg>
  </span>

  Filters
</button>


    </div>

    <!-- DESKTOP PANEL -->
    <div id="ChPanel-{{ section.id }}" class="ch-panel" aria-hidden="false">
      <div class="ch-panel-body" data-form-home>
{%- assign _category_param = '' -%}
{%- assign _type_param = '' -%}
{%- assign _vendor_param = '' -%}
{%- assign _availability_param = '' -%}

{%- if _filters and _filters.size > 0 -%}
  {%- for f in _filters -%}
    {%- assign _lb = f.label | strip | downcase -%}

    {%- comment %} TYPE: detect Shopify Product type facet {%- endcomment -%}
    {%- if _type_param == '' -%}
      {%- if f.param_name contains 'product_type' or _lb == 'product type' or _lb == 'type' -%}
        {%- assign _type_param = f.param_name -%}
      {%- endif -%}
    {%- endif -%}

    {%- comment %} CATEGORY: only if it’s not the product_type facet {%- endcomment -%}
    {%- if _category_param == '' -%}
      {%- if _lb == 'category' -%}
        {%- unless f.param_name contains 'product_type' -%}
          {%- assign _category_param = f.param_name -%}
        {%- endunless -%}
      {%- endif -%}
    {%- endif -%}

    {%- comment %} BRAND / VENDOR {%- endcomment -%}
    {%- if _vendor_param == '' -%}
      {%- if f.param_name contains 'vendor' or _lb == 'vendor' or _lb == 'brand' -%}
        {%- assign _vendor_param = f.param_name -%}
      {%- endif -%}
    {%- endif -%}

    {%- comment %} AVAILABILITY {%- endcomment -%}
    {%- if _availability_param == '' -%}
      {%- if f.param_name contains 'availability' or _lb == 'availability' -%}
        {%- assign _availability_param = f.param_name -%}
      {%- endif -%}
    {%- endif -%}
  {%- endfor -%}
{%- endif -%}


        <form id="ChForm-{{ section.id }}" class="ch-form" novalidate>
          <div class="ch-groups">

            {%- comment -%} AVAILABILITY {%- endcomment -%}
            {%- if _filters and _filters.size > 0 -%}
              {%- for filter in _filters -%}
                {%- assign _lb = filter.label | strip | downcase -%}
                {%- assign _is_av = false -%}
                {%- if filter.param_name == _availability_param -%}
                  {%- assign _is_av = true -%}
                {%- elsif _lb == 'availability' -%}
                  {%- assign _is_av = true -%}
                {%- endif -%}
                {%- if _is_av and filter.type == 'list' -%}
                  <fieldset class="ch-group" data-type="list" data-order="availability">
                    <div class="ch-group-hd" data-toggle>
                      <span class="ch-group-title">Availability</span>
                      <button type="button" class="ch-group-toggle" aria-label="toggle group">▾</button>
                    </div>
                    <div class="ch-group-bd">
                     <ul class="ch-list" data-limit-list data-limit-top="5">
                        {%- for v in filter.values -%}
                          {%- assign _zero = false -%}
                          {%- if v.count == 0 and v.active == false -%}
                            {%- assign _zero = true -%}
                          {%- endif -%}
                          {%- unless _zero -%}
                          <li>
                            <label class="ch-option">
                              <input class="ch-option-input" type="checkbox" name="{{ v.param_name }}" value="{{ v.value | escape }}" {% if v.active %}checked{% endif %}>
                              <span class="ch-dot"></span>
                              <span class="ch-label">{{ v.label }}</span>
                              <span class="ch-count">{{ v.count }}</span>
                            </label>
                          </li>
                          {%- endunless -%}
                        {%- endfor -%}
                        {%- for v in filter.values -%}
                          {%- assign _zero2 = false -%}
                          {%- if v.count == 0 and v.active == false -%}
                            {%- assign _zero2 = true -%}
                          {%- endif -%}
                          {%- if _zero2 -%}
                          <li>
                            <label class="ch-option is-disabled">
                              <input class="ch-option-input" type="checkbox" name="{{ v.param_name }}" value="{{ v.value | escape }}" disabled>
                              <span class="ch-dot"></span>
                              <span class="ch-label">{{ v.label }}</span>
                              <span class="ch-count">{{ v.count }}</span>
                            </label>
                          </li>
                          {%- endif -%}
                        {%- endfor -%}
                      </ul>
                    </div>
                  </fieldset>
                {%- endif -%}
              {%- endfor -%}
            {%- endif -%}

            {%- comment -%} PRICE {%- endcomment -%}
            {%- if _filters and _filters.size > 0 -%}
              {%- for filter in _filters -%}
                {%- if filter.type == 'price_range' -%}
                <fieldset class="ch-group" data-type="price" data-order="price">
                  <div class="ch-group-hd" data-toggle>
                    <span class="ch-group-title">Price</span>
                    <button type="button" class="ch-group-toggle" aria-label="toggle group">▾</button>
                  </div>
                  <div class="ch-group-bd">
                    <div class="ch-price-card">
                      {% assign current_min = filter.min_value.value | default: 0 %}
                      {% assign current_max = filter.max_value.value | default: filter.range_max %}

                      <div class="ch-price-rows">
                        <input
                          id="min-{{ section.id }}"
                          name="{{ filter.min_value.param_name }}"
                          type="text"
                          inputmode="numeric"
                          value="{{ current_min | divided_by: 100 | floor }}"
                          placeholder="0"
                        >
                        <input
                          id="max-{{ section.id }}"
                          name="{{ filter.max_value.param_name }}"
                          type="text"
                          inputmode="numeric"
                          value="{{ current_max | divided_by: 100 | floor }}"
                          placeholder="{{ filter.range_max | divided_by: 100 | floor }}"
                        >
                      </div>
{% assign current_min = filter.min_value.value | default: 0 %}
{% assign current_max = filter.max_value.value | default: filter.range_max %}

<div class="ch-range">
  <input
    type="range"
    min="0"
    max="{{ filter.range_max | default: 10000000 }}"
    step="100"
    data-range="min"
    value="{{ current_min }}"       
  >
  <input
    type="range"
    min="0"
    max="{{ filter.range_max | default: 10000000 }}"
    step="100"
    data-range="max"
    value="{{ current_max }}"         
  >
</div>

                      <div class="ch-price-note">Price: <span class="price-current">₱0 — ₱{{ filter.range_max | divided_by: 100 | floor }}</span></div>
                      <button type="button" class="ch-price-apply">Filter</button>
                    </div>
                  </div>
                </fieldset>
                {%- endif -%}
              {%- endfor -%}
            {%- endif -%}

            {%- comment -%} CATEGORY (custom/other facet) {%- endcomment -%}
            {%- if _filters and _filters.size > 0 -%}
              {%- for filter in _filters -%}
                {%- assign _lb = filter.label | strip | downcase -%}
                {%- assign _is_cat = false -%}
                {%- if filter.param_name == _category_param -%}
                  {%- assign _is_cat = true -%}
                {%- elsif _lb == 'category' and filter.param_name != _type_param -%}
                  {%- assign _is_cat = true -%}
                {%- endif -%}
                {%- if _is_cat and filter.type == 'list' and filter.param_name != _type_param -%}
                  <fieldset class="ch-group" data-type="list" data-order="category">
                    <div class="ch-group-hd" data-toggle>
                      <span class="ch-group-title">Category</span>
                      <button type="button" class="ch-group-toggle" aria-label="toggle group">▾</button>
                    </div>
                    <div class="ch-group-bd">
                      <ul class="ch-list" data-limit-list data-limit-top="5">
                        {%- for v in filter.values -%}
                          {%- assign _zero = false -%}
                          {%- if v.count == 0 and v.active == false -%}
                            {%- assign _zero = true -%}
                          {%- endif -%}
                          {%- unless _zero -%}
                          <li>
                            <label class="ch-option">
                              <input class="ch-option-input" type="checkbox" name="{{ v.param_name }}" value="{{ v.value | escape }}" {% if v.active %}checked{% endif %}>
                              <span class="ch-dot"></span>
                              <span class="ch-label">{{ v.label }}</span>
                              <span class="ch-count">{{ v.count }}</span>
                            </label>
                          </li>
                          {%- endunless -%}
                        {%- endfor -%}
                        {%- for v in filter.values -%}
                          {%- assign _zero2 = false -%}
                          {%- if v.count == 0 and v.active == false -%}
                            {%- assign _zero2 = true -%}
                          {%- endif -%}
                          {%- if _zero2 -%}
                          <li>
                            <label class="ch-option is-disabled">
                              <input class="ch-option-input" type="checkbox" name="{{ v.param_name }}" value="{{ v.value | escape }}" disabled>
                              <span class="ch-dot"></span>
                              <span class="ch-label">{{ v.label }}</span>
                              <span class="ch-count">{{ v.count }}</span>
                            </label>
                          </li>
                          {%- endif -%}
                        {%- endfor -%}
                      </ul>
                      <button type="button" class="ch-more" data-limit-toggle>Show all</button>
                    </div>
                  </fieldset>
                {%- endif -%}
              {%- endfor -%}
            {%- endif -%}

            {%- comment -%} TYPE (Product type) — separate from Category {%- endcomment -%}
            {%- if _type_param != '' and _filters and _filters.size > 0 -%}
              {%- for filter in _filters -%}
                {%- if filter.param_name == _type_param and filter.type == 'list' -%}
                  <fieldset class="ch-group" data-type="list" data-order="type">
                    <div class="ch-group-hd" data-toggle>
                      <span class="ch-group-title">Product Type</span>
                      <button type="button" class="ch-group-toggle" aria-label="toggle group">▾</button>
                    </div>
                    <div class="ch-group-bd">
                      <ul class="ch-list" data-limit-list data-limit-top="5">
                        {%- for v in filter.values -%}
                          {%- assign _zero = false -%}
                          {%- if v.count == 0 and v.active == false -%}
                            {%- assign _zero = true -%}
                          {%- endif -%}
                          {%- unless _zero -%}
                          <li>
                            <label class="ch-option">
                              <input class="ch-option-input" type="checkbox" name="{{ v.param_name }}" value="{{ v.value | escape }}" {% if v.active %}checked{% endif %}>
                              <span class="ch-dot"></span>
                              <span class="ch-label">{{ v.label }}</span>
                              <span class="ch-count">{{ v.count }}</span>
                            </label>
                          </li>
                          {%- endunless -%}
                        {%- endfor -%}
                        {%- for v in filter.values -%}
                          {%- assign _zero2 = false -%}
                          {%- if v.count == 0 and v.active == false -%}
                            {%- assign _zero2 = true -%}
                          {%- endif -%}
                          {%- if _zero2 -%}
                          <li>
                            <label class="ch-option is-disabled">
                              <input class="ch-option-input" type="checkbox" name="{{ v.param_name }}" value="{{ v.value | escape }}" disabled>
                              <span class="ch-dot"></span>
                              <span class="ch-label">{{ v.label }}</span>
                              <span class="ch-count">{{ v.count }}</span>
                            </label>
                          </li>
                          {%- endif -%}
                        {%- endfor -%}
                      </ul>
                      <button type="button" class="ch-more" data-limit-toggle>Show all</button>
                    </div>
                  </fieldset>
                {%- endif -%}
              {%- endfor -%}
            {%- endif -%}

            {%- comment -%} BRAND / VENDOR {%- endcomment -%}
            {%- if _vendor_param != '' and _filters and _filters.size > 0 -%}
              {%- for filter in _filters -%}
                {%- if filter.param_name == _vendor_param and filter.type == 'list' -%}
                  <fieldset class="ch-group" data-type="list" data-order="brand">
                    <div class="ch-group-hd" data-toggle>
                      <span class="ch-group-title">Brand</span>
                      <button type="button" class="ch-group-toggle" aria-label="toggle group">▾</button>
                    </div>
                    <div class="ch-group-bd" data-brand-scope>
                      <div class="ch-brand-searchwrap" style="margin-bottom:6px;">
                        <input type="text" class="ch-brand-search" data-brand-search placeholder="Search brand…" style="width:100%;border:1px solid rgba(17,17,17,.05);border-radius:999px;padding:5px 10px 4px;font-size:12.25px;background:#f3f4f6;">
                      </div>
                      <ul class="ch-list" data-limit-list data-limit-top="5">
                        {%- for v in filter.values -%}
                          {%- assign _zero = false -%}
                          {%- if v.count == 0 and v.active == false -%}
                            {%- assign _zero = true -%}
                          {%- endif -%}
                          {%- unless _zero -%}
                          <li data-brand-item data-label="{{ v.label | downcase | escape }}">
                            <label class="ch-option">
                              <input class="ch-option-input" type="checkbox" name="{{ v.param_name }}" value="{{ v.value | escape }}" {% if v.active %}checked{% endif %}>
                              <span class="ch-dot"></span>
                              <span class="ch-label">{{ v.label }}</span>
                              <span class="ch-count">{{ v.count }}</span>
                            </label>
                          </li>
                          {%- endunless -%}
                        {%- endfor -%}
                      </ul>
                      <button type="button" class="ch-more" data-limit-toggle>Show all</button>
                    </div>
                  </fieldset>
                {%- endif -%}
              {%- endfor -%}
            {%- endif -%}

            {%- comment -%} OTHER LIST FILTERS {%- endcomment -%}
            {%- if _filters and _filters.size > 0 -%}
              {%- for filter in _filters -%}
                {%- assign _lb = filter.label | strip | downcase -%}
                {%- assign _is_core = false -%}
                {%- if filter.param_name == _category_param or filter.param_name == _type_param or filter.param_name == _vendor_param or filter.param_name == _availability_param -%}
                  {%- assign _is_core = true -%}
                {%- else -%}
                  {%- if _lb == 'category' or _lb == 'product type' or _lb == 'type' or _lb == 'brand' or _lb == 'vendor' or _lb == 'availability' -%}
                    {%- assign _is_core = true -%}
                  {%- endif -%}
                {%- endif -%}
                {%- if _is_core -%}{%- continue -%}{%- endif -%}

                {%- if filter.type == 'list' -%}
                <fieldset class="ch-group" data-type="list">
                  <div class="ch-group-hd" data-toggle>
                    <span class="ch-group-title">{{ filter.label | downcase }}</span>
                    <button type="button" class="ch-group-toggle" aria-label="toggle group">▾</button>
                  </div>
                  <div class="ch-group-bd">
                   <ul class="ch-list" data-limit-list data-limit-top="5">
                      {%- for v in filter.values -%}
                        {%- assign _zero = false -%}
                        {%- if v.count == 0 and v.active == false -%}
                          {%- assign _zero = true -%}
                        {%- endif -%}
                        {%- unless _zero -%}
                        <li>
                          <label class="ch-option">
                            <input class="ch-option-input" type="checkbox" name="{{ v.param_name }}" value="{{ v.value | escape }}" {% if v.active %}checked{% endif %}>
                            <span class="ch-dot"></span>
                            <span class="ch-label">{{ v.label }}</span>
                            <span class="ch-count">{{ v.count }}</span>
                          </label>
                        </li>
                        {%- endunless -%}
                      {%- endfor -%}
                      {%- for v in filter.values -%}
                        {%- assign _zero2 = false -%}
                        {%- if v.count == 0 and v.active == false -%}
                          {%- assign _zero2 = true -%}
                        {%- endif -%}
                        {%- if _zero2 -%}
                        <li>
                          <label class="ch-option is-disabled">
                            <input class="ch-option-input" type="checkbox" name="{{ v.param_name }}" value="{{ v.value | escape }}" disabled>
                            <span class="ch-dot"></span>
                            <span class="ch-label">{{ v.label }}</span>
                            <span class="ch-count">{{ v.count }}</span>
                          </label>
                        </li>
                        {%- endif -%}
                      {%- endfor -%}
                    </ul>
                  </div>
                </fieldset>
                {%- endif -%}
              {%- endfor -%}
            {%- endif -%}
          </div>

          <p class="sr-only" role="status" data-announce></p>
        </form>
      </div>
    </div>
  </div>

  <div data-ch-overlay aria-hidden="true"></div>

  <aside id="ChDrawerFilter-{{ section.id }}" class="ch-drawer ch" aria-hidden="true" role="dialog" aria-label="Filters">
    <div class="ch-drawer__hd">
      <h2>filter</h2>
      <button type="button" class="ch-drawer__close" data-ch-close aria-label="Close filters">
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M18 6 6 18M6 6l12 12" stroke="currentColor" stroke-width="1.6" fill="none" stroke-linecap="round" stroke-linejoin="round"></path>
        </svg>
      </button>
    </div>
    <div class="ch-drawer__bd" data-form-slot></div>
  </aside>
  
  <script>
(() => {
  console.log('[CH Filters] Script starting...');
  const SECTION_ID = '{{ section.id }}';
  let gridFetchController = null;
  let forceClearPrice = false;
  let filterFetchController = null;
  const $root = document.querySelector(`#ch-filters-${SECTION_ID}`);
  if (!$root) return;

  const $openBtn  = $root.querySelector(`#ChOpen-${SECTION_ID}`);
  const $panel    = $root.querySelector(`#ChPanel-${SECTION_ID}`);
  const $form     = $root.querySelector(`#ChForm-${SECTION_ID}`);
  const $formHome = $root.querySelector('[data-form-home]');
  const $formSlot = $root.querySelector('[data-form-slot]');
  const $count =
    document.querySelector('.product-count__text, .facets__results .product-count__text, .product-count .results, [data-product-count]');

  const $overlay  = $root.querySelector('[data-ch-overlay]');
  const $drawer   = $root.querySelector(`#ChDrawerFilter-${SECTION_ID}`);
  const $announce = $root.querySelector('[data-announce]');

  const collectionUrl = $root.dataset.collectionUrl;
  const mode = $root.dataset.mode || 'collection';
  const isSearch = mode === 'search';
  const gridSelectors = ($root.dataset.gridSelector || '#CollectionProductGrid')
    .split(',')
    .map(s => s.trim())
    .filter(Boolean);
  const gridSectionIdAttr = $root.dataset.gridSectionId;

  const SORT_SELECTORS = 'select[name="sort_by"], .facet-filters__sort select, #SortBy';

  // Make selectors/id visible to the chipbar helper
  window.chGridSelectors = gridSelectors.slice();

  // ---------- SORT ----------
  function getSortValue() {
    const sel = document.querySelector(SORT_SELECTORS);
    if (sel && typeof sel.value !== 'undefined') return sel.value || '';
    const u = new URL(location.href);
    return u.searchParams.get('sort_by') || '';
  }
  function syncSortSelectToURL(uLike) {
    const u = uLike instanceof URL ? uLike : new URL(uLike, location.origin);
    const current = u.searchParams.get('sort_by') || '';
    document.querySelectorAll(SORT_SELECTORS).forEach(s => {
      if (s && 'value' in s) s.value = current;
    });
  }
  function wireSortControls(){
    document.addEventListener('change', (e)=>{
      const t = e.target;
      if (!t || !t.matches(SORT_SELECTORS)) return;
      e.preventDefault();
      if (typeof e.stopImmediatePropagation === 'function') e.stopImmediatePropagation();
      e.stopPropagation();
if (isMobile()) { showGridMask(); closeDrawer(); closeOverlay(); }
applyFiltersDebounced(0);

    }, true);
  }
  wireSortControls();

  // ---------- VIEWPORT/PLUMBING ----------
  const mq = window.matchMedia('(max-width: 989px)');
  const isMobile = () => mq.matches;
  let lastAppliedUrl = location.href;

  let chPortal = document.querySelector('.ch-portal');
  if(!chPortal){
    chPortal = document.createElement('div');
    chPortal.className = 'ch-portal';
    document.body.appendChild(chPortal);
  }

  function placeForm(){
    if(isMobile()){
      if($formSlot && !$formSlot.contains($form)) $formSlot.appendChild($form);
    } else {
      if($formHome && !$formHome.contains($form)) $formHome.appendChild($form);
    }
  }

  function setDVH(){
    const h = window.visualViewport ? visualViewport.height : window.innerHeight;
    document.documentElement.style.setProperty('--dvh', (h / 100) + 'px');
  }
  setDVH();
  window.addEventListener('resize', setDVH, { passive: true });
  window.addEventListener('orientationchange', setDVH, { passive: true });
  if (window.visualViewport){
    visualViewport.addEventListener('resize', setDVH, { passive: true });
    visualViewport.addEventListener('scroll', setDVH, { passive: true });
  }

  function moveForMode(){
    if($overlay && !chPortal.contains($overlay)) chPortal.appendChild($overlay);
    if($drawer && !chPortal.contains($drawer)) chPortal.appendChild($drawer);
    placeForm();
  }
  mq.addEventListener('change', ()=>{ moveForMode(); closeAll(); syncCollectionCollapse(); });
