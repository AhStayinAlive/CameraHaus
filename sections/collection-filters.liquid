  const cap = Number(rMax.max || 0) || 0;

    // Initialise from current text inputs (or fall back to full range)
    // Initialise from current text inputs (or fall back to full range)
    let initialLo = Number((iMin.value || '').replace(/[^\d]/g, '')) * 100 || 0;

    let initialHi;
    const rawMaxStr = (iMax.value || '').replace(/[^\d]/g, '');
    const capFloor = Math.floor(cap / 100);

    if (rawMaxStr) {
      const val = Number(rawMaxStr);
      // If the user's input matches the floored max, assume they mean "max"
      if (val === capFloor) {
