    return { rMin: rMinEl, rMax: rMaxEl, iMin: iMinEl, iMax: iMaxEl, note: noteEl, rangeBox: rangeBoxEl };
  }

  function normalizePrice(loRaw, hiRaw, cap) {
    let lo = Math.max(0, Number(loRaw || 0));
    let hi = Number(hiRaw || 0);
    if (!hi && cap) hi = cap;
    hi = Math.min(cap || 0, hi || (cap || 0));
    if (lo > hi) hi = lo;
    return { lo, hi };
  }

  function setPriceUI(lo, hi, cap) {
    const { rMin: rMinEl, rMax: rMaxEl, iMin: iMinEl, iMax: iMaxEl, note, rangeBox } = getPriceElements();
    if (!rMinEl || !rMaxEl) return;

    const capVal = cap || Number(rMaxEl.max || 0) || 0;
    const norm = normalizePrice(lo, hi, capVal);
    lo = norm.lo;
    hi = norm.hi;

    rMinEl.value = String(lo);
    rMaxEl.value = String(hi);

    if (iMinEl) iMinEl.value = Math.round(lo / 100).toLocaleString();
    if (iMaxEl) iMaxEl.value = Math.round(hi / 100).toLocaleString();

    if (note) {
      note.textContent = '₱' + (lo / 100).toLocaleString() + ' — ₱' + (hi / 100).toLocaleString();
    }
    if (rangeBox) {
      const s = capVal ? Math.min(100, (lo / capVal) * 100) : 0;
      const e = capVal ? Math.min(100, (hi / capVal) * 100) : 100;
      rangeBox.style.setProperty('--start', s.toFixed(2));
      rangeBox.style.setProperty('--end', e.toFixed(2));
    }
  }

  function resetPriceToDefault() {
    const { rMax: rMaxEl } = getPriceElements();
    const cap = Number(rMaxEl?.max || 0) || 0;
    setPriceUI(0, cap, cap);
