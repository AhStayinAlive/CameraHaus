  function getPriceElements() {
    const rMinEl = $form.querySelector('input[data-range="min"]');
    const rMaxEl = $form.querySelector('input[data-range="max"]');
    const iMinEl = $form.querySelector(`#min-${SECTION_ID}`);
    const iMaxEl = $form.querySelector(`#max-${SECTION_ID}`);
    const noteEl = $form.querySelector('.ch-price-note .price-current');
