{%- comment -%} 
  Slideshow — Havit-style (mobile-optimized w/ mobile width + fit controls)
{%- endcomment -%}

{%- if section.settings.hero_home_height == 'adapt' -%}
  {%- assign first_block = section.blocks[0] -%}
  {%- if first_block.settings.image.aspect_ratio == blank -%}
    {%- assign min_aspect_ratio = 2.0 -%}
  {%- else -%}
    {%- assign min_aspect_ratio = first_block.settings.image.aspect_ratio -%}
  {%- endif -%}
  {% assign wrapper_height = 100 | divided_by: min_aspect_ratio %}
{%- endif -%}

{% if section.blocks.size > 0 %}
  <div class="hero-wrapper hero-wrapper--{{ section.settings.hero_home_height }} {% if section.settings.layout == 'bleed' %}is-bleed{% else %}is-contained{% endif %}"
       role="region"
       aria-label="slideshow"
       aria-describedby="a11y-slideshow-info"
       style="
         background-color: {{ section.settings.bg | default: '#ffffff' }};
         /* Card look */
         --card-outline-w: {{ section.settings.card_outline_w | default: 10 }}px;
         --card-outline-color: {{ section.settings.card_outline_color | default: '#ffffff' }};
         --card-radius: {{ section.settings.card_radius | default: 20 }}px;
         --card-shadow-opacity: {{ section.settings.card_shadow_opacity | default: 0.1 }};
         /* Width & spacing (Theme Editor) */
         --hero-max-w: {{ section.settings.hero_max_w | default: 1440 }}px;
         --hero-gutter: {{ section.settings.hero_side_gutter | default: 24 }}px;
         --hero-top-gap: {{ section.settings.hero_margin_top | default: 16 }}px;
         --hero-bottom-gap: {{ section.settings.hero_margin_bottom | default: 28 }}px;
         /* Mobile-specific width controls */
         --hero-max-w-m: {{ section.settings.hero_max_w_mobile | default: 560 }}px;
         --hero-gutter-m: {{ section.settings.hero_side_gutter_mobile | default: 16 }}px;
       ">

    <style>
      :root { --tap-target: 44px; }

      .shopify-section--slideshow{ overflow: visible; margin:0 !important; padding-top:0.1px; }

      /* Full-bleed */
      .is-bleed{
        position: relative; display:block;
        width:100vw; max-width:100vw; min-width:100vw;
        left:50%; transform:translateX(-50%);
        margin: var(--hero-top-gap, 0px) 0 var(--hero-bottom-gap, 0px);
        padding:0; overflow:hidden; box-sizing:border-box;
      }

      /* Contained card */
      .is-contained{
        position:relative; display:block;
        width:min(var(--hero-max-w, 1440px), calc(100vw - (2 * var(--hero-gutter, 24px))));
        margin: var(--hero-top-gap, 16px) auto var(--hero-bottom-gap, 28px);
        border-radius:var(--card-radius, 20px);
        overflow:hidden;
        box-shadow:
          0 0 0 var(--card-outline-w, 10px) var(--card-outline-color, #fff),
          0 12px 40px rgba(0,0,0,var(--card-shadow-opacity, .1));
        background-clip:padding-box;
      }

      #Slideshow-{{ section.id }}{ position:relative; overflow:hidden; width:100%; }
      #Slideshow-{{ section.id }} .hero__track{ display:flex; width:100%; height:100%; transition:transform .5s ease; will-change: transform; }
      #Slideshow-{{ section.id }} .hero__slide{ position:relative; flex:0 0 100%; width:100%; height:100%; }

      /* Height modes */
      .hero--small{ height:45vh; min-height:360px; }
      .hero--large{ height:60vh; min-height:420px; }
      .hero--fit{   height: calc(100svh - var(--header-offset, 0px) - var(--fit-margin, 36px)); min-height:420px; }
      .hero--full{  height:clamp(70vh, 86vh, 92vh); }
      .hero--adapt-height{ height:auto; }
      .hero--custom{ height:var(--hero-h, 86vh); min-height:var(--hero-min, 420px); }

      /* Images */
      #Slideshow-{{ section.id }} .hero__image,
      #Slideshow-{{ section.id }} .hero__image-bg{
        position:absolute; inset:0; width:100%; height:100%;
        object-fit:cover; display:block; z-index:0; opacity:1 !important;
      }

      /* Clean overlays */
      #Slideshow-{{ section.id }} .hero__slide,
      #Slideshow-{{ section.id }} .hero__image,
      #Slideshow-{{ section.id }} .hero__image-bg { background:none !important; }
      #Slideshow-{{ section.id }} .hero__slide::before,
      #Slideshow-{{ section.id }} .hero__slide::after { content:none !important; }

      /* Caption */
      #Slideshow-{{ section.id }} .hero__caption{
        position:absolute; max-width:var(--cap-w, 680px);
        color:var(--cap-ink, #111); z-index:5;
        padding:clamp(12px, 2vw, 20px);
        display:flex; flex-direction:column; gap:10px;
        text-align:var(--cap-align, left);
        background: var(--cap-bg, transparent);
        border-radius: 12px;
      }
      #Slideshow-{{ section.id }} .hero__title{ font-weight:800; line-height:1.05; margin:0; font-size:clamp(22px, 5vw, 56px); color:var(--cap-ink); }
      #Slideshow-{{ section.id }} .hero__subtitle{ margin:2px 0 8px; font-size:clamp(14px, 2.1vw, 20px); line-height:1.35; opacity:.96; color:var(--cap-ink); }

      /* Placement presets */
      .pos-top-left    { top:calc(4% + var(--cap-off-y, 0%)); left:calc(4% + var(--cap-off-x, 0%)); }
      .pos-top-center  { top:calc(4% + var(--cap-off-y, 0%)); left:50%; transform:translateX(-50%); text-align:center; --cap-align:center; }
      .pos-top-right   { top:calc(4% + var(--cap-off-y, 0%)); right:calc(4% - var(--cap-off-x, 0%)); text-align:right; --cap-align:right; }
      .pos-middle-left { top:50%; left:calc(4% + var(--cap-off-x, 0%)); transform:translateY(-50%); }
      .pos-middle-center{ top:50%; left:50%; transform:translate(-50%, -50%); text-align:center; --cap-align:center; }
      .pos-middle-right{ top:50%; right:calc(4% - var(--cap-off-x, 0%)); transform:translateY(-50%); text-align:right; --cap-align:right; }
      .pos-bottom-left { bottom:calc(4% - var(--cap-off-y, 0%)); left:calc(4% + var(--cap-off-x, 0%)); }
      .pos-bottom-center{ bottom:calc(4% - var(--cap-off-y, 0%)); left:50%; transform:translateX(-50%); text-align:center; --cap-align:center; }
      .pos-bottom-right{ bottom:calc(4% - var(--cap-off-y, 0%)); right:calc(4% - var(--cap-off-x, 0%)); text-align:right; --cap-align:right; }

      /* Scrim */
      #Slideshow-{{ section.id }} .hero__scrim{ position:absolute; inset:0; pointer-events:none; z-index:3; }
      .scrim-bottom{ background:linear-gradient(to top, rgba(0,0,0,var(--scrim, .35)) 0%, rgba(0,0,0,0) 60%); }
      .scrim-top{    background:linear-gradient(to bottom, rgba(0,0,0,var(--scrim, .35)) 0%, rgba(0,0,0,0) 60%); }
      .scrim-radial{ background:radial-gradient(60% 60% at 50% 60%, rgba(0,0,0,var(--scrim, .35)) 0%, rgba(0,0,0,0) 70%); }

      /* Button */
      #Slideshow-{{ section.id }} .hero__btn{
        display:inline-flex; align-items:center; justify-content:center; gap:.5rem;
        min-height:44px; padding:.6rem 1.1rem; border-radius:999px; border:2px solid transparent;
        font-weight:700; text-decoration:none; width:max-content;
        background:var(--btn-bg,#E0302A); color:var(--btn-ink,#fff);
      }
      #Slideshow-{{ section.id }} .hero__btn--outline{ background:transparent; color:var(--btn-ink,#111); border-color:var(--btn-ink,#111); }

      /* Arrows + dots */
      #Slideshow-{{ section.id }} .hero__arrow{
        position:absolute; top:50%; transform:translateY(-50%); z-index:6;
        width:44px; height:44px; border-radius:50%; border:0; cursor:pointer;
        background:#fff; box-shadow:0 4px 18px rgba(0,0,0,.18);
        display:flex; align-items:center; justify-content:center;
      }
      .hero__arrow--prev{ left:12px; } .hero__arrow--next{ right:12px; }

      #Slideshow-{{ section.id }} .hero__dots{
        position:absolute; left:50%; bottom: var(--dots-offset, 14px); transform:translateX(-50%);
        display:flex; gap:8px; z-index:6;
      }
      #Slideshow-{{ section.id }} .hero__dot{ width:10px; height:10px; border-radius:999px; background:#d1d5db; border:none; cursor:pointer; }
      #Slideshow-{{ section.id }} .hero__dot[aria-current="true"]{ width:22px; border-radius:999px; background:{{ section.settings.brand | default: '#E0302A' }}; }

      @media (prefers-reduced-motion: reduce){ #Slideshow-{{ section.id }} .hero__track{ transition:none } }

      /* ---- Mobile improvements ---- */
      @media (max-width: 768px){
        /* Use mobile-specific width + gutter */
        .is-contained{
          width: min(var(--hero-max-w-m, 100vw), calc(100vw - (2 * var(--hero-gutter-m, 16px))));
          border-radius: clamp(12px, 4vw, var(--card-radius, 20px));
          --card-outline-w: clamp(4px, 2.2vw, 10px);
          box-shadow:
            0 0 0 var(--card-outline-w) var(--card-outline-color, #fff),
            0 8px 26px rgba(0,0,0, .12);
        }

        #Slideshow-{{ section.id }} .hero__caption{
          max-width: min(92vw, var(--cap-w, 680px));
          --cap-bg: rgba(0,0,0,.35);
          --cap-ink: #fff;
          backdrop-filter: saturate(1.1) blur(2px);
        }
        .hero__arrow--prev{ left:8px; } .hero__arrow--next{ right:8px; }
        .hero--small{ min-height:320px; } .hero--large{ min-height:380px; }
        .hero--custom{ height:var(--hero-h-m, 70vh); min-height:var(--hero-min-m, 360px); }

        #Slideshow-{{ section.id }} .hero__title{ font-size: clamp(20px, 7vw, 32px); }
        #Slideshow-{{ section.id }} .hero__subtitle{ font-size: clamp(13px, 4vw, 16px); }

        #Slideshow-{{ section.id }} .hero__btn{
          min-height: var(--tap-target);
          padding:.55rem .95rem;
          font-weight: 700;
          font-size: clamp(13px, 3.6vw, 15px);
        }

        #Slideshow-{{ section.id }} .hero__dots{
          bottom: calc(var(--dots-offset, 14px) + env(safe-area-inset-bottom, 0px));
          gap:10px;
        }
        #Slideshow-{{ section.id }} .hero__dot{ width:12px; height:12px; }

        /* Hide arrows on phones; swipe handles nav */
        #Slideshow-{{ section.id }} .hero__arrow{ display:none; }

        /* Contain mode: stop deformation on mobile */
        #Slideshow-{{ section.id }}[data-mobile-fit="contain"]{ height:auto; }
        #Slideshow-{{ section.id }}[data-mobile-fit="contain"] .hero__slide{
          height:auto; aspect-ratio: var(--slide-ar, 1.5);
        }
        #Slideshow-{{ section.id }}[data-mobile-fit="contain"] .hero__image,
        #Slideshow-{{ section.id }}[data-mobile-fit="contain"] .hero__image-bg{
          object-fit: contain;
        }
        #Slideshow-{{ section.id }}[data-mobile-fit="contain"] .hero__image-bg{
          background-size: contain; background-position:center; background-repeat:no-repeat;
        }
      }
    </style>

    {%- capture hero_style -%}
      --header-offset: {{ section.settings.header_offset | default: 72 }}px;
      --fit-margin: {{ section.settings.fit_margin | default: 36 }}px;
      --dots-offset: {{ section.settings.dots_offset | default: 14 }}px;
      {%- if section.settings.hero_home_height == 'adapt' -%}
        height: {{ wrapper_height }}vw;
      {%- endif -%}
      {%- if section.settings.hero_home_height == 'custom' -%}
        --hero-h: {{ section.settings.hero_custom_h_vh | default: 86 }}vh;
        --hero-min: {{ section.settings.hero_min_px | default: 420 }}px;
        --hero-h-m: {{ section.settings.hero_custom_h_vh_m | default: 70 }}vh;
        --hero-min-m: {{ section.settings.hero_min_px_m | default: 360 }}px;
      {%- endif -%}
    {%- endcapture -%}

    <div id="Slideshow-{{ section.id }}"
         class="hero hero--{{ section.settings.hero_home_height }}"
         style="{{ hero_style | strip }}"
         data-autoplay="{{ section.settings.hero_home_auto }}"
         data-speed="{{ section.settings.hero_home_auto_speed | times: 1000 }}"
         data-mobile-fit="{{ section.settings.mobile_image_fit | default: 'contain' }}">

      <div class="hero__track" data-track>
        {%- for block in section.blocks -%}
          {%- assign ar_auto = block.settings.image.aspect_ratio | default: 1.6 -%}
          {%- assign ar_choice = section.settings.mobile_aspect_ratio | default: 'auto' -%}
          {%- if ar_choice != 'auto' -%}
            {%- assign mobile_ar = ar_choice -%}
          {%- else -%}
            {%- assign mobile_ar = ar_auto -%}
          {%- endif -%}

          <div class="hero__slide hero__slide--{{ block.id }}" data-index="{{ forloop.index0 }}" style="--slide-ar: {{ mobile_ar }};" {{ block.shopify_attributes }}>

            {%- if block.settings.image != blank -%}
              <div class="hero__image-bg"
                   style="background-image:url('{{ block.settings.image | image_url: width: 2048 }}');
                          background-size:cover;
                          background-position: {{ block.settings.image_position }};">
              </div>

              {%- assign loading_attr = 'lazy' -%}
              {%- assign fetch_attr = 'auto' -%}
              {%- if forloop.first -%}
                {%- assign loading_attr = 'eager' -%}
                {%- assign fetch_attr = 'high' -%}
              {%- endif -%}

              {{ block.settings.image
                 | image_url: width: 2048
                 | image_tag:
                    widths: '540,720,900,1080,1296,1512,1728,1944,2048',
                    sizes: '100vw',
                    class: 'hero__image',
                    alt: block.settings.alt | default: '',
                    loading: loading_attr,
                    fetchpriority: fetch_attr }}
            {%- endif -%}

            {%- if block.settings.scrim_enabled -%}
              <div class="hero__scrim scrim-{{ block.settings.scrim_direction }}" style="--scrim: {{ block.settings.scrim_opacity | default: 0.3 }};"></div>
            {%- endif -%}

            {%- unless block.settings.title == blank and block.settings.subtitle == blank and block.settings.button_label == blank -%}
              {%- assign _preset = block.settings.position_preset | default: 'middle-left' -%}
              <div class="hero__caption pos-{{ _preset | replace: '_','-' }}"
                   style="
                     --cap-w: {{ block.settings.content_width | default: 680 }}px;
                     --cap-ink: {{ block.settings.text_color | default: '#ffffff' }};
                     --btn-bg: {{ block.settings.button_bg | default: section.settings.brand | default: '#E0302A' }};
                     --btn-ink: {{ block.settings.button_text | default: '#ffffff' }};
                     --cap-off-x: {{ block.settings.offset_x | default: 0 }}%;
                     --cap-off-y: {{ block.settings.offset_y | default: 0 }}%;
                   ">
                {%- unless block.settings.title == blank -%}
                  <h2 class="hero__title">{{ block.settings.title | escape }}</h2>
                {%- endunless -%}
                {%- unless block.settings.subtitle == blank -%}
                  <div class="hero__subtitle">{{ block.settings.subtitle }}</div>
                {%- endunless -%}
                {%- if block.settings.button_label != blank and block.settings.button_link != blank -%}
                  <a href="{{ block.settings.button_link }}"
                     class="hero__btn {% if block.settings.button_style == 'outline' %}hero__btn--outline{% endif %}">
                    {{ block.settings.button_label | escape }}
                  </a>
                {%- endif -%}
              </div>
            {%- endunless -%}
          </div>
        {%- endfor -%}
      </div>

      {%- if section.settings.show_arrows and section.blocks.size > 1 -%}
        <button class="hero__arrow hero__arrow--prev" type="button" aria-label="{{ 'homepage.hero.previous_slide' | t }}" data-prev>
          {% include 'icon-arrow-left' %}
        </button>
        <button class="hero__arrow hero__arrow--next" type="button" aria-label="{{ 'homepage.hero.next_slide' | t }}" data-next>
          {% include 'icon-arrow-right' %}
        </button>
      {%- endif -%}

      {%- if section.settings.show_dots and section.blocks.size > 1 -%}
        <div class="hero__dots" role="tablist" aria-label="Slideshow pagination">
          {%- for block in section.blocks -%}
            <button class="hero__dot" role="tab" aria-label="Go to slide {{ forloop.index }}" data-dot="{{ forloop.index0 }}" {% if forloop.first %}aria-current="true"{% endif %}></button>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>

    <script>
      (function(){
        const root  = document.getElementById('Slideshow-{{ section.id }}');
        if(!root) return;

        const track = root.querySelector('[data-track]');
        const slides = Array.from(track.children);
        const prevBtn = root.querySelector('[data-prev]');
        const nextBtn = root.querySelector('[data-next]');
        const dots = Array.from(root.querySelectorAll('[data-dot]'));

        let index = 0;
        let auto  = root.dataset.autoplay === 'true';
        let speed = parseInt(root.dataset.speed || 5000, 10);
        let timer;

        function go(i){
          index = (i + slides.length) % slides.length;
          track.style.transform = `translateX(-${index*100}%)`;
          dots.forEach((d,di)=> d.setAttribute('aria-current', di===index ? 'true':'false'));
        }
        function nextSlide(){ go(index+1); }
        function prevSlide(){ go(index-1); }

        nextBtn && nextBtn.addEventListener('click', nextSlide);
        prevBtn && prevBtn.addEventListener('click', prevSlide);
        dots.forEach(d => d.addEventListener('click', e => go(parseInt(e.currentTarget.dataset.dot,10))));

        function start(){
          if(window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
          if(!auto || slides.length < 2) return;
          stop(); timer = setInterval(nextSlide, speed);
        }
        function stop(){ if(timer) clearInterval(timer); }

        root.addEventListener('mouseenter', stop);
        root.addEventListener('mouseleave', start);
        root.addEventListener('focusin', stop);
        root.addEventListener('focusout', start);
        document.addEventListener('visibilitychange', ()=> document.hidden ? stop() : start());

        /* Swipe */
        let sx = 0, sy = 0, dx = 0, dy = 0, swiping = false;
        const THRESH = 40;

        root.addEventListener('touchstart', (e)=>{
          if(e.touches.length !== 1) return;
          sx = e.touches[0].clientX; sy = e.touches[0].clientY;
          dx = dy = 0; swiping = true; stop();
        }, {passive:true});

        root.addEventListener('touchmove', (e)=>{
          if(!swiping) return;
          dx = e.touches[0].clientX - sx;
          dy = e.touches[0].clientY - sy;
        }, {passive:true});

        root.addEventListener('touchend', ()=>{
          if(!swiping) return;
          if(Math.abs(dx) > Math.abs(dy) && Math.abs(dx) > THRESH){
            dx < 0 ? nextSlide() : prevSlide();
          }
          swiping = false; start();
        }, {passive:true});

        start();
      })();
    </script>
  </div>
{% endif %}

{% if section.blocks.size == 0 %}
  {% include 'no-blocks' %}
{% endif %}

{% schema %}
{
  "name": "Slideshow (Havit-style)",
  "class": "shopify-section--slideshow",
  "max_blocks": 20,
  "settings": [
    { "type":"select","id":"layout","label":"Layout","default":"contained","options":[{"value":"contained","label":"Contained (rounded, floating)"},{"value":"bleed","label":"Full-bleed (edge-to-edge)"}] },
    { "type":"select","id":"hero_home_height","label":"Slide height","default":"fit","options":[{"value":"small","label":"Small"},{"value":"large","label":"Large"},{"value":"fit","label":"Fit to viewport (minus header)"},{"value":"full","label":"Full viewport"},{"value":"adapt","label":"Adapt to first image"},{"value":"custom","label":"Custom (use sliders below)"}] },
    { "type":"range","id":"header_offset","label":"Header offset (px) to subtract","min":0,"max":160,"step":2,"default":72 },
    { "type":"range","id":"fit_margin","label":"Fit margin (extra pixels to subtract)","min":0,"max":160,"step":2,"default":36 },
    { "type":"range","id":"dots_offset","label":"Pagination dots offset (px from bottom)","min":0,"max":60,"step":2,"default":14 },

    /* Custom height controls */
    { "type":"range","id":"hero_custom_h_vh","label":"Custom height – desktop (vh)","min":40,"max":100,"step":1,"default":86 },
    { "type":"range","id":"hero_custom_h_vh_m","label":"Custom height – mobile (vh)","min":40,"max":100,"step":1,"default":70 },
    { "type":"range","id":"hero_min_px","label":"Minimum height – desktop (px)","min":240,"max":1000,"step":10,"default":420 },
    { "type":"range","id":"hero_min_px_m","label":"Minimum height – mobile (px)","min":240,"max":900,"step":10,"default":360 },

    /* Card styling */
    { "type":"range","id":"card_outline_w","label":"Card outline width (px)","min":0,"max":32,"step":1,"default":10 },
    { "type":"color","id":"card_outline_color","label":"Card outline color","default":"#ffffff" },
    { "type":"range","id":"card_radius","label":"Card corner radius (px)","min":0,"max":48,"step":1,"default":20 },
    { "type":"range","id":"card_shadow_opacity","label":"Card shadow strength","min":0,"max":0.3,"step":0.1,"default":0.1 },

    /* Desktop width */
    { "type":"range","id":"hero_max_w","label":"Hero max width – desktop (px)","min":960,"max":1920,"step":10,"default":1440 },
    { "type":"range","id":"hero_side_gutter","label":"Side gutter – desktop (px)","min":0,"max":80,"step":2,"default":24 },

    /* Mobile width */
    { "type":"range","id":"hero_max_w_mobile","label":"Hero max width – mobile (px)","min":320,"max":960,"step":10,"default":560 },
    { "type":"range","id":"hero_side_gutter_mobile","label":"Side gutter – mobile (px)","min":0,"max":40,"step":1,"default":16 },

    /* Mobile fit behavior */
    { "type":"select","id":"mobile_image_fit","label":"Mobile image fit","default":"contain","options":[{"value":"contain","label":"Contain (no crop)"},{"value":"cover","label":"Cover (fill, may crop)"}] },
    { "type":"select","id":"mobile_aspect_ratio","label":"Mobile aspect ratio (contain mode)","default":"auto","options":[
      {"value":"auto","label":"Auto (use image)"},
      {"value":"1.7778","label":"16:9"},{"value":"1.3333","label":"4:3"},{"value":"1","label":"1:1"},{"value":"0.8","label":"4:5"}
    ]},

    /* Spacing */
    { "type":"range","id":"hero_margin_top","label":"Top margin (px)","min":0,"max":200,"step":2,"default":16 },
    { "type":"range","id":"hero_margin_bottom","label":"Bottom margin (px)","min":0,"max":200,"step":2,"default":28 },

    { "type":"checkbox","id":"hero_home_auto","label":"Auto-rotate slides","default":true },
    { "type":"range","id":"hero_home_auto_speed","label":"Change slides every","min":3,"max":9,"step":2,"unit":" s","default":5 },
    { "type":"checkbox","id":"show_arrows","label":"Show arrows","default":true },
    { "type":"checkbox","id":"show_dots","label":"Show pagination dots","default":true },
    { "type":"color","id":"brand","label":"Brand color (active dot & default button)","default":"#E0302A" },
    { "type":"color","id":"bg","label":"Background color","default":"#ffffff" }
  ],
  "blocks": [
    {
      "type":"slide",
      "name":"Slide",
      "settings":[
        { "type":"image_picker","id":"image","label":"Image" },
        { "type":"select","id":"image_position","label":"Image focal point","default":"center center","options":[
          {"value":"left top","label":"Top left"},{"value":"center top","label":"Top center"},{"value":"right top","label":"Top right"},
          {"value":"left center","label":"Middle left"},{"value":"center center","label":"Middle center"},{"value":"right center","label":"Middle right"},
          {"value":"left bottom","label":"Bottom left"},{"value":"center bottom","label":"Bottom center"},{"value":"right bottom","label":"Bottom right"} ]},

        { "type":"header","content":"Overlay content" },
        { "type":"text","id":"title","label":"Heading","default":"Dominate Every Game" },
        { "type":"richtext","id":"subtitle","label":"Subtitle" },
